# Eco resolves this declared browser dependency from expose.additional in
# production and to the corresponding local backend port in development.
# PUBLIC_RAG_URL routes through the estate gateway's /api/rag/* (no
# expose.additional hostname needed) and is filled automatically by Eco.
PUBLIC_RAG_URL=
PUBLIC_CHAT_URL=
PUBLIC_PHOTOS_URL=
PUBLIC_PROFILE_URL=
PUBLIC_INVENTORY_URL=
PUBLIC_MARKETPLACE_URL=
PUBLIC_BIDDING_URL=

# Max photo upload size in MB shown by the UI and enforced client-side.
PUBLIC_MAX_PHOTO_MB=10
