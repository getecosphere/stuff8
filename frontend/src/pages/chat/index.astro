---
import Layout from '../../layouts/Layout.astro';
---

<Layout>
  <div class="mx-auto flex h-full min-h-0 w-full max-w-6xl flex-col px-4 py-5 sm:px-6 lg:px-8">
    <div class="mb-4">
      <h1 class="page-heading">Nego sampai deal</h1>
    </div>
    <div id="chat-app" class="grid min-h-0 flex-1 overflow-hidden rounded-2xl border border-navy-100 bg-white shadow-xs md:grid-cols-[minmax(0,20rem)_minmax(0,1fr)]">
      <aside class="min-h-0 max-h-44 overflow-y-auto border-b border-navy-100 bg-paper-100 p-3 md:max-h-none md:border-b-0 md:border-r">
        <div id="conversation-list" class="space-y-2">
          <div class="flex items-center gap-3 rounded-xl border border-navy-100 bg-white p-3"><div class="skeleton size-10 rounded-full"></div><div class="min-w-0 flex-1 space-y-2"><div class="skeleton h-3 w-3/4"></div><div class="skeleton h-2.5 w-1/2"></div></div></div>
          <div class="flex items-center gap-3 rounded-xl border border-navy-100 bg-white p-3"><div class="skeleton size-10 rounded-full"></div><div class="min-w-0 flex-1 space-y-2"><div class="skeleton h-3 w-2/3"></div><div class="skeleton h-2.5 w-1/3"></div></div></div>
          <div class="flex items-center gap-3 rounded-xl border border-navy-100 bg-white p-3"><div class="skeleton size-10 rounded-full"></div><div class="min-w-0 flex-1 space-y-2"><div class="skeleton h-3 w-3/4"></div><div class="skeleton h-2.5 w-1/2"></div></div></div>
        </div>
      </aside>
      <section id="conversation-panel" class="flex min-h-0 min-w-0 flex-col">
        <div class="m-auto w-full max-w-sm space-y-4 p-6">
          <div class="flex items-center gap-3"><div class="skeleton size-10 rounded-full"></div><div class="flex-1 space-y-2"><div class="skeleton h-3 w-1/2"></div><div class="skeleton h-2.5 w-1/3"></div></div></div>
          <div class="space-y-2"><div class="skeleton h-10 w-2/3"></div><div class="skeleton h-10 w-3/4"></div><div class="skeleton h-10 w-1/2"></div></div>
        </div>
      </section>
    </div>
  </div>
  <div id="chat-media-viewer" class="fixed inset-0 z-[100] hidden items-center justify-center bg-navy-950/95 p-4" role="dialog" aria-modal="true" aria-label="Pratinjau gambar chat">
    <button id="chat-media-close" type="button" class="absolute right-5 top-5 inline-flex size-11 items-center justify-center rounded-full bg-white/15 text-3xl leading-none text-white hover:bg-white/25" aria-label="Tutup gambar">×</button>
    <button id="chat-media-prev" type="button" class="absolute left-4 inline-flex size-11 items-center justify-center rounded-full bg-white/15 text-3xl text-white hover:bg-white/25 sm:left-8" aria-label="Gambar sebelumnya">‹</button>
    <figure class="flex max-h-full max-w-full flex-col items-center gap-3"><img id="chat-media-image" class="max-h-[82vh] max-w-full rounded-xl object-contain shadow-2xl" alt="" /><figcaption id="chat-media-caption" class="max-w-[90vw] truncate text-sm font-semibold text-white"></figcaption></figure>
    <button id="chat-media-next" type="button" class="absolute right-4 inline-flex size-11 items-center justify-center rounded-full bg-white/15 text-3xl text-white hover:bg-white/25 sm:right-8" aria-label="Gambar berikutnya">›</button>
  </div>
  <div id="attachment-source-dialog" class="fixed inset-0 z-[90] hidden items-end justify-center bg-navy-950/35 p-4 sm:items-center" role="dialog" aria-modal="true" aria-label="Pilih sumber lampiran">
    <div class="w-full max-w-sm rounded-2xl bg-white p-4 shadow-2xl">
      <p class="mb-3 text-sm font-bold text-navy-900">Tambahkan lampiran</p>
      <div class="grid grid-cols-2 gap-3"><button id="attachment-camera" type="button" class="rounded-xl bg-navy-900 px-4 py-3 text-sm font-bold text-white">Kamera</button><button id="attachment-gallery" type="button" class="rounded-xl border border-navy-100 px-4 py-3 text-sm font-bold text-navy-900">Galeri</button></div>
      <button id="attachment-source-cancel" type="button" class="mt-3 w-full rounded-xl px-4 py-2 text-sm font-semibold text-slate-500">Batal</button>
    </div>
  </div>
  <div id="chat-complete-sale-dialog" class="fixed inset-0 z-[95] hidden items-center justify-center bg-navy-950/45 p-4" role="dialog" aria-modal="true" aria-label="Tandai barang terjual">
    <form id="chat-complete-sale-form" class="w-full max-w-md rounded-2xl bg-white p-5 shadow-2xl">
      <div class="flex items-start justify-between gap-4"><div><h2 class="text-lg font-bold text-navy-900">Tandai barang terjual</h2><p id="chat-sale-buyer" class="mt-1 text-sm text-slate-500"></p></div><button id="chat-complete-sale-close" type="button" class="text-2xl leading-none text-slate-400" aria-label="Tutup">×</button></div>
      <label class="mt-5 block text-sm font-bold text-navy-900" for="chat-sale-price">Harga jual akhir</label>
      <input id="chat-sale-price" inputmode="numeric" class="mt-2 w-full rounded-xl border border-navy-100 px-3 py-2.5 text-base font-semibold text-navy-900" />
      <p class="mt-2 text-xs leading-5 text-slate-500">Barang berpindah ke inventaris pembeli. Semua penawar akan menerima kabar penutup melalui Inbox dan email.</p>
      <p id="chat-sale-error" class="mt-3 hidden rounded-lg bg-rose-50 px-3 py-2 text-sm text-rose-700" role="alert"></p>
      <div class="mt-5 flex justify-end gap-2"><button id="chat-complete-sale-cancel" type="button" class="rounded-xl px-4 py-2.5 text-sm font-bold text-slate-600">Batal</button><button class="rounded-xl bg-navy-900 px-4 py-2.5 text-sm font-bold text-white">Konfirmasi terjual</button></div>
    </form>
  </div>

  <style is:global>
    .typing-visual { position: relative; display: inline-flex; align-items: center; justify-content: center; height: 2.25rem; width: 3.25rem; }
    .typing-visual img { position: absolute; inset: 0; height: 100%; width: 100%; object-fit: contain; }
    .typing-dots { position: relative; z-index: 1; display: inline-flex; gap: 0.18rem; padding-top: 0.08rem; }
    .typing-dots i { display: block; width: 0.25rem; height: 0.25rem; border-radius: 9999px; background: #0f172a; animation: stuff8-typing 1s ease-in-out infinite; }
    .typing-dots i:nth-child(2) { animation-delay: 0.14s; }
    .typing-dots i:nth-child(3) { animation-delay: 0.28s; }
    @keyframes stuff8-typing { 0%, 60%, 100% { transform: translateY(0); opacity: .35; } 30% { transform: translateY(-0.22rem); opacity: 1; } }
  </style>

  <script>
    import { marketplaceDetailPath } from '../../lib/slug';
    const CHAT = import.meta.env.PUBLIC_CHAT_URL || '/api/chat';
    const STORAGE = import.meta.env.PUBLIC_PHOTOS_URL || '/api';
    const PROFILE = import.meta.env.PUBLIC_PROFILE_URL || '/api';
    const AUTH = `${import.meta.env.PUBLIC_AUTH_URL || '/auth-api'}/auth`;
    const MARKETPLACE = import.meta.env.PUBLIC_MARKETPLACE_URL || '/api/marketplace';
    const listRoot = document.getElementById('conversation-list')!;
    const panel = document.getElementById('conversation-panel')!;
    const chatApp = document.getElementById('chat-app')!;
    const escapeHtml = (value: string) => value.replace(/[&<>"']/g, char => ({ '&': '&amp;', '<': '&gt;', '>': '&lt;', '"': '&quot;', "'": '&#039;' }[char] || char));
    const money = (amount: number) => `Rp ${Number(amount || 0).toLocaleString('id-ID')}`;
    const parseMoney = (value: string) => Number(value.replace(/[^0-9]/g, '')) || 0;
    const session = () => { try { return JSON.parse(localStorage.getItem('stuff8_session') || 'null'); } catch { return null; } };
    const isSessionValid = () => { const s = session(); return s?.token && (!s.expires_at || Date.now() < s.expires_at); };
    const user = () => session()?.user;
    const chatHeaders = () => ({ 'Authorization': `Bearer ${session()?.token}` });
    const attachmentUrl = (key: string) => `${STORAGE}/storage/content/${key.split('/').map(encodeURIComponent).join('/')}`;
    let conversations: any[] = [];
    let activeConversation: any;
    let websocket: WebSocket | undefined;
    let typingTimeout: number | undefined;
    let socketReconnectTimer: number | undefined;
    let socketReconnectAttempt = 0;
    let socketGeneration = 0;
    const profiles = new Map<string, any>();
    const listingOwners = new Map<string, string | undefined>();
    const listings = new Map<string, any>();
    const expandedProductTrees = new Set<string>();
    const wsUrlFor = (conversationId: string) => `${CHAT.replace(/^http/, 'ws')}/conversations/${encodeURIComponent(conversationId)}/ws?token=${encodeURIComponent(session()?.token || '')}`;
    const sendWs = (payload: any) => { if (websocket && websocket.readyState === WebSocket.OPEN) websocket.send(JSON.stringify(payload)); };
    const toDate = (value: any) => new Date(typeof value === 'string' ? value : value?.$date || value?.date || 0);
    const displayDate = (value: any) => {
      const date = toDate(value);
      return Number.isNaN(date.getTime()) ? '' : date.toLocaleString('id-ID', { dateStyle: 'medium', timeStyle: 'short' });
    };
    const relativeTime = (value: any) => {
      const date = toDate(value);
      if (Number.isNaN(date.getTime())) return '';
      const seconds = Math.max(0, Math.floor((Date.now() - date.getTime()) / 1000));
      if (seconds < 45) return 'Baru saja';
      if (seconds < 3600) return `${Math.floor(seconds / 60)} menit yang lalu`;
      if (seconds < 86400) return `${Math.floor(seconds / 3600)} jam yang lalu`;
      if (seconds < 604800) return `${Math.floor(seconds / 86400)} hari yang lalu`;
      return date.toLocaleDateString('id-ID', { day: 'numeric', month: 'short' });
    };
    const profileName = (profile: any) => profile?.name || profile?.full_name || profile?.username || 'Pengguna Stuff8';
    async function profileFor(id: string) {
      if (id === user()?.id) return user();
      if (profiles.has(id)) return profiles.get(id);
      try {
        const response = await fetch(`${PROFILE}/users/${encodeURIComponent(id)}`, { headers: chatHeaders() });
        const profile = response.ok ? await response.json() : { id };
        // Auth owns identity data. This fallback keeps old conversations
        // complete before a Profile row has been hydrated.
        const needsIdentity = !profile?.name || !profile?.avatarUrl;
        const identityResponse = needsIdentity ? await fetch(`${AUTH}/users/${encodeURIComponent(id)}`, { headers: chatHeaders() }) : undefined;
        const identity = identityResponse?.ok ? await identityResponse.json() : undefined;
        const resolved = { ...profile, ...identity, avatarUrl: identity?.avatarUrl || profile?.avatarUrl || profile?.avatar_url };
        profiles.set(id, resolved);
        return resolved;
      } catch { return { id }; }
    }
    async function listingOwnerFor(referenceId?: string) {
      if (!referenceId) return undefined;
      if (listingOwners.has(referenceId)) return listingOwners.get(referenceId);
      try {
        const response = await fetch(`${MARKETPLACE}/listings/${encodeURIComponent(referenceId)}`);
        const item = response.ok ? await response.json() : undefined;
        const ownerId = item?.seller_id;
        listingOwners.set(referenceId, ownerId);
        return ownerId;
      } catch {
        listingOwners.set(referenceId, undefined);
        return undefined;
      }
    }
    async function listingFor(referenceId?: string) {
      if (!referenceId) return undefined;
      if (listings.has(referenceId)) return listings.get(referenceId);
      try {
        const response = await fetch(`${MARKETPLACE}/listings/${encodeURIComponent(referenceId)}`);
        const listing = response.ok ? await response.json() : undefined;
        listings.set(referenceId, listing);
        if (listing?.seller_id) listingOwners.set(referenceId, listing.seller_id);
        return listing;
      } catch {
        listings.set(referenceId, undefined);
        return undefined;
      }
    }
    const customerIdFor = (conversation: any) => conversation.participant_ids?.find((id: string) => id !== user()?.id) || '';
    const avatar = (profile: any, className = 'size-8') => `<img src="${escapeHtml(profile?.avatarUrl || profile?.avatar_url || '/images/avatar-fallback.webp')}" onerror="this.onerror=null;this.src='/images/avatar-fallback.webp'" alt="" class="${className} shrink-0 rounded-full object-cover" />`;
    const listingCover = (listing: any, className = 'size-10') => `<img src="${escapeHtml(listing?.photos?.[0] ? attachmentUrl(listing.photos[0]) : '/images/no-item-image.webp')}" onerror="this.onerror=null;this.src='/images/no-item-image.webp'" alt="" class="${className} shrink-0 rounded-lg object-cover" />`;
    let uploadSequence = 0;
    let filePickerOpen = false;
    const MAX_CHAT_ATTACHMENT_BYTES = 2 * 1024 * 1024;
    let mediaGallery: { url: string; filename: string }[] = [];
    let mediaIndex = 0;
    let activeMessages: any[] = [];
    // The browser does not dispatch `change` when the picker is cancelled.
    // Release the guard when focus returns so the attachment button remains usable.
    window.addEventListener('focus', () => {
      if (filePickerOpen) window.setTimeout(() => { filePickerOpen = false; }, 0);
    });

    function attachmentMarkup(file: any, extraImages = 0) {
      const url = attachmentUrl(file.key);
      const filename = escapeHtml(file.filename || 'Lampiran');
      if (String(file.content_type || '').startsWith('image/')) {
        return `<button type="button" data-chat-image="${escapeHtml(url)}" data-chat-image-name="${filename}" class="relative mt-2 block w-full overflow-hidden rounded-xl border border-white/20 bg-white/10 text-left" title="Buka gambar ${filename}"><img src="${url}" alt="${filename}" class="mx-auto max-h-64 w-auto max-w-full object-contain" />${extraImages ? `<span class="absolute inset-0 flex items-center justify-center bg-navy-950/55 text-2xl font-bold text-white">+${extraImages}</span>` : ''}<span class="block truncate px-2 py-1.5 text-xs font-semibold">${filename}</span></button>`;
      }
      return `<a class="mt-2 flex items-center gap-2 rounded-xl border border-white/20 bg-white/10 px-3 py-2 text-xs font-semibold underline" target="_blank" rel="noopener" href="${url}" title="Buka atau unduh ${filename}"><span aria-hidden="true">📎</span><span class="truncate">${filename}</span></a>`;
    }

    function attachmentsMarkup(files: any[]) {
      const images = files.filter(file => String(file.content_type || '').startsWith('image/'));
      const documents = files.filter(file => !String(file.content_type || '').startsWith('image/'));
      const displayedImages = images.length > 4 ? [...images.slice(0, 3), images[3]] : images;
      return displayedImages.map((file, index) => attachmentMarkup(file, images.length > 4 && index === 3 ? images.length - 3 : 0)).join('') + documents.map(file => attachmentMarkup(file)).join('');
    }

    function renderMediaViewer() {
      const viewer = document.getElementById('chat-media-viewer')!;
      const current = mediaGallery[mediaIndex];
      if (!current) return;
      (document.getElementById('chat-media-image') as HTMLImageElement).src = current.url;
      (document.getElementById('chat-media-image') as HTMLImageElement).alt = current.filename;
      document.getElementById('chat-media-caption')!.textContent = mediaGallery.length > 1 ? `${current.filename} · ${mediaIndex + 1}/${mediaGallery.length}` : current.filename;
      const previous = document.getElementById('chat-media-prev') as HTMLButtonElement;
      const next = document.getElementById('chat-media-next') as HTMLButtonElement;
      previous.classList.toggle('hidden', mediaGallery.length < 2);
      next.classList.toggle('hidden', mediaGallery.length < 2);
      previous.disabled = mediaIndex === 0;
      next.disabled = mediaIndex === mediaGallery.length - 1;
      previous.classList.toggle('opacity-35', previous.disabled);
      next.classList.toggle('opacity-35', next.disabled);
      viewer.classList.remove('hidden'); viewer.classList.add('flex');
    }

    function openMediaGallery(url: string) {
      mediaGallery = activeMessages.flatMap(message => (message.attachments || [])
        .filter((file: any) => String(file.content_type || '').startsWith('image/'))
        .map((file: any) => ({ url: attachmentUrl(file.key), filename: file.filename || 'Gambar' })));
      mediaIndex = Math.max(0, mediaGallery.findIndex(item => item.url === url));
      renderMediaViewer();
    }

    function bindMediaGallery(root: ParentNode = document) {
      root.querySelectorAll<HTMLButtonElement>('[data-chat-image]').forEach(button => {
        button.onclick = () => openMediaGallery(button.dataset.chatImage || '');
      });
    }

    function closeMediaGallery() {
      const viewer = document.getElementById('chat-media-viewer')!;
      viewer.classList.add('hidden'); viewer.classList.remove('flex');
    }

    document.getElementById('chat-media-close')?.addEventListener('click', closeMediaGallery);
    document.getElementById('chat-media-prev')?.addEventListener('click', () => { if (mediaIndex > 0) { mediaIndex -= 1; renderMediaViewer(); } });
    document.getElementById('chat-media-next')?.addEventListener('click', () => { if (mediaIndex < mediaGallery.length - 1) { mediaIndex += 1; renderMediaViewer(); } });
    document.getElementById('chat-media-viewer')?.addEventListener('click', event => { if (event.target === event.currentTarget) closeMediaGallery(); });
    document.addEventListener('keydown', event => { if (document.getElementById('chat-media-viewer')?.classList.contains('hidden')) return; if (event.key === 'Escape') closeMediaGallery(); if (event.key === 'ArrowLeft') document.getElementById('chat-media-prev')?.dispatchEvent(new MouseEvent('click')); if (event.key === 'ArrowRight') document.getElementById('chat-media-next')?.dispatchEvent(new MouseEvent('click')); });

    function showAttachmentError(file: File, message: string) {
      const id = `chat-upload-error-${++uploadSequence}`;
      const root = document.getElementById('messages');
      root?.insertAdjacentHTML('beforeend', `<div id="${id}" class="flex justify-end"><div class="w-full max-w-sm rounded-2xl rounded-br-sm border border-rose-200 bg-rose-50 p-3"><div class="flex items-start gap-3"><div class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-white text-lg" aria-hidden="true">📄</div><div class="min-w-0 flex-1"><p class="truncate text-sm font-bold text-navy-900">${escapeHtml(file.name)}</p><p class="mt-0.5 text-xs text-rose-700">${escapeHtml(message)}</p></div><button type="button" class="inline-flex size-7 shrink-0 items-center justify-center rounded-md text-rose-700 hover:bg-rose-100" aria-label="Hapus pesan upload">×</button></div></div></div>`);
      document.querySelector(`#${id} button`)?.addEventListener('click', () => document.getElementById(id)?.remove());
      if (root) root.scrollTop = root.scrollHeight;
    }

    function uploadAttachment(file: File): Promise<any> {
      if (!activeConversation || !user()?.id) return Promise.reject(new Error('Percakapan belum siap.'));
      const uploadId = `chat-upload-${++uploadSequence}`;
      const root = document.getElementById('messages');
      root?.insertAdjacentHTML('beforeend', `<div id="${uploadId}" class="flex justify-end"><div class="w-full max-w-sm rounded-2xl rounded-br-sm border border-navy-100 bg-white p-3 shadow-xs"><div class="flex items-start gap-3"><div class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-brand-50 text-lg" aria-hidden="true">${file.type.startsWith('image/') ? '🖼️' : '📄'}</div><div class="min-w-0 flex-1"><p class="truncate text-sm font-bold text-navy-900">${escapeHtml(file.name)}</p><p data-upload-status class="mt-0.5 text-xs text-slate-500">Menyiapkan upload…</p></div><button type="button" data-upload-cancel class="inline-flex size-7 shrink-0 items-center justify-center rounded-md text-slate-500 hover:bg-rose-50 hover:text-rose-700" aria-label="Batalkan atau hapus upload">×</button></div><div class="mt-3 h-1.5 overflow-hidden rounded-full bg-navy-100"><span data-upload-progress class="block h-full w-0 rounded-full bg-brand-600 transition-[width] duration-150"></span></div><div data-upload-actions class="mt-3 hidden items-center gap-2"><button type="button" data-upload-retry class="rounded-lg bg-navy-900 px-3 py-1.5 text-xs font-bold text-white">Coba lagi</button><button type="button" data-upload-remove class="rounded-lg px-2 py-1.5 text-xs font-semibold text-slate-600 hover:bg-navy-100">Hapus</button></div></div></div>`);
      root && (root.scrollTop = root.scrollHeight);
      return new Promise((resolve, reject) => {
        const card = document.getElementById(uploadId);
        const status = card?.querySelector<HTMLElement>('[data-upload-status]');
        const progress = card?.querySelector<HTMLElement>('[data-upload-progress]');
        const actions = card?.querySelector<HTMLElement>('[data-upload-actions]');
        const retry = card?.querySelector<HTMLButtonElement>('[data-upload-retry]');
        let xhr: XMLHttpRequest | undefined;
        let settled = false;
        const remove = () => card?.remove();
        const fail = (message: string) => { if (status) status.textContent = message; if (progress) { progress.className = 'block h-full w-full rounded-full bg-rose-500'; progress.style.width = '100%'; } actions?.classList.remove('hidden'); actions?.classList.add('flex'); xhr = undefined; };
        const start = () => {
          actions?.classList.add('hidden'); actions?.classList.remove('flex');
          if (progress) { progress.className = 'block h-full w-0 rounded-full bg-brand-600 transition-[width] duration-150'; progress.style.width = '0'; }
          if (status) status.textContent = 'Menyiapkan upload…';
          xhr = new XMLHttpRequest();
          xhr.timeout = 60000;
          xhr.open('POST', `${CHAT}/conversations/${encodeURIComponent(activeConversation.conversation_id)}/attachments`);
          const token = session()?.token;
          if (token) xhr.setRequestHeader('Authorization', `Bearer ${token}`);
          xhr.upload.onprogress = event => { if (!event.lengthComputable) return; const percent = Math.min(95, Math.round((event.loaded / event.total) * 95)); if (progress) progress.style.width = `${percent}%`; if (status) status.textContent = `Mengunggah ke Storage… ${percent}%`; };
          xhr.upload.onload = () => { if (status) status.textContent = 'Storage sedang menyiapkan file…'; };
          xhr.onerror = () => fail('Upload gagal. Coba lagi.');
          xhr.ontimeout = () => fail('Upload terlalu lama. Coba lagi.');
          xhr.onabort = () => { if (!settled) { settled = true; remove(); reject(new DOMException('Upload dibatalkan.', 'AbortError')); } };
          xhr.onload = () => {
            if (xhr!.status < 200 || xhr!.status >= 300) {
              let message = 'Upload ditolak. Coba lagi.';
              try { message = JSON.parse(xhr!.responseText).error || message; } catch {}
              fail(message);
              return;
            }
            try { const attachment = JSON.parse(xhr!.responseText); if (progress) progress.style.width = '100%'; if (status) status.textContent = 'Upload selesai. Mengirim ke percakapan…'; settled = true; resolve({ attachment, remove }); } catch { fail('Respons Storage tidak valid.'); }
          };
          const form = new FormData(); form.append('owner_id', user().id); form.append('file', file); xhr.send(form);
        };
        card?.querySelector<HTMLButtonElement>('[data-upload-cancel]')?.addEventListener('click', () => xhr ? xhr.abort() : (remove(), !settled && reject(new DOMException('Upload dibatalkan.', 'AbortError'))));
        card?.querySelector<HTMLButtonElement>('[data-upload-remove]')?.addEventListener('click', () => { remove(); if (!settled) reject(new DOMException('Upload dibatalkan.', 'AbortError')); });
        retry?.addEventListener('click', start);
        start();
      });
    }

    function signedOut() {
      listRoot.innerHTML = '';
      panel.innerHTML = `<div class="m-auto max-w-sm p-6 text-center"><h2 class="font-bold text-navy-900">Masuk untuk melihat chat</h2><p class="mt-1 text-sm text-slate-500">Offer dan negosiasi hanya tersedia untuk akun aktif.</p><a href="/auth/signup/?return_to=/chat/" class="mt-4 inline-flex rounded-lg bg-navy-900 px-4 py-2.5 text-sm font-bold text-white">Daftar atau masuk</a></div>`;
    }

    function renderEmptyInbox() {
      chatApp.className = 'flex min-h-[32rem] flex-1 items-center justify-center overflow-hidden rounded-2xl border border-navy-100 bg-white px-6 py-10 text-center shadow-xs';
      chatApp.innerHTML = `<div class="flex max-w-sm flex-col items-center"><img src="/images/empty-inbox.webp" alt="Belum ada offer marketplace" class="mb-4 size-36 object-contain sm:size-40" /><h2 class="text-base font-bold text-navy-900">Belum ada offer</h2><p class="mt-1 text-sm leading-6 text-slate-500">Mulai dengan menawar barang incaranmu di <a href="/marketplace/" class="font-bold text-brand-700 hover:underline">Marketplace</a> — begitu ada offer, percakapan produk muncul di sini.</p></div>`;
    }

    async function renderList() {
      if (!conversations.length) { listRoot.innerHTML = `<div class="rounded-xl border border-dashed border-navy-100 bg-white p-4 text-center"><p class="text-sm font-bold text-navy-900">Belum ada offer</p><p class="mt-1 text-xs text-slate-500">Mulai dengan menawar barang incaranmu di Marketplace.</p></div>`; return; }
      const updatedAt = (conversation: any) => toDate(conversation.updated_at).getTime() || 0;
      const ownerGroups = new Map<string, any[]>();
      const regularConversations: any[] = [];
      for (const conversation of conversations) {
        const referenceId = conversation.context?.reference_id || conversation.conversation_id;
        const sellerId = conversation.context?.seller_id || await listingOwnerFor(conversation.context?.reference_id);
        if (sellerId && sellerId === user()?.id) {
          const group = ownerGroups.get(referenceId) || [];
          group.push(conversation);
          ownerGroups.set(referenceId, group);
        } else {
          regularConversations.push(conversation);
        }
      }
      const ownerMarkup = await Promise.all([...ownerGroups.entries()]
        .sort(([, left], [, right]) => Math.max(...right.map(updatedAt)) - Math.max(...left.map(updatedAt)))
        .map(async ([referenceId, group]) => {
          group.sort((left, right) => updatedAt(right) - updatedAt(left));
          const isExpanded = expandedProductTrees.has(referenceId);
          const title = escapeHtml(group[0].context?.title || 'Produk marketplace');
          const listing = await listingFor(referenceId);
          const nodes = await Promise.all(group.map(async conversation => {
            const customer = await profileFor(customerIdFor(conversation));
            const name = escapeHtml(profileName(customer));
            const selected = activeConversation?.conversation_id === conversation.conversation_id;
            return `<button type="button" data-conversation="${escapeHtml(conversation.conversation_id)}" class="ml-2 flex w-[calc(100%-0.5rem)] items-center gap-2 rounded-lg border px-3 py-2 text-left transition ${selected ? 'border-navy-900 bg-white shadow-xs' : 'border-navy-100 bg-white hover:border-navy-200'}">${avatar(customer, 'size-8')}<span class="min-w-0"><span class="block truncate text-xs font-bold text-navy-900">${name}</span><span class="mt-0.5 block text-[11px] text-slate-500">${relativeTime(conversation.updated_at)}</span></span></button>`;
          }));
          return `<div class="rounded-xl border border-navy-100 bg-white"><button type="button" data-product-tree="${escapeHtml(referenceId)}" aria-expanded="${isExpanded}" class="flex w-full items-center justify-between gap-3 p-3 text-left">${listingCover(listing)}<span class="min-w-0 flex-1"><span class="block truncate text-sm font-bold text-navy-900">${title}</span><span class="mt-1 block text-xs text-slate-500">${group.length} penawar aktif</span></span><span class="text-lg text-slate-500 transition-transform ${isExpanded ? 'rotate-180' : ''}" aria-hidden="true">⌄</span></button><div data-product-nodes="${escapeHtml(referenceId)}" class="space-y-2 border-t border-navy-100 p-2 ${isExpanded ? '' : 'hidden'}">${nodes.join('')}</div></div>`;
        }));
      const regularMarkup = (await Promise.all(regularConversations.sort((left, right) => updatedAt(right) - updatedAt(left)).map(async conversation => {
        const listing = await listingFor(conversation.context?.reference_id);
        return `<button type="button" data-conversation="${escapeHtml(conversation.conversation_id)}" class="flex w-full items-center gap-3 rounded-xl border p-3 text-left transition ${activeConversation?.conversation_id === conversation.conversation_id ? 'border-navy-900 bg-white shadow-xs' : 'border-transparent hover:border-navy-100 hover:bg-white'}">${listingCover(listing)}<span class="min-w-0"><span class="block truncate text-sm font-bold text-navy-900">${escapeHtml(conversation.context?.title || 'Produk marketplace')}</span><span class="mt-1 block text-xs text-slate-500">${relativeTime(conversation.updated_at)}</span></span></button>`;
      }))).join('');
      listRoot.innerHTML = `${ownerMarkup.join('')}${regularMarkup}`;
      document.querySelectorAll<HTMLButtonElement>('[data-product-tree]').forEach(button => button.addEventListener('click', () => {
        const referenceId = button.dataset.productTree!;
        expandedProductTrees.has(referenceId) ? expandedProductTrees.delete(referenceId) : expandedProductTrees.add(referenceId);
        renderList();
      }));
      document.querySelectorAll<HTMLButtonElement>('[data-conversation]').forEach(button => button.addEventListener('click', () => openConversation(conversations.find(conversation => conversation.conversation_id === button.dataset.conversation))));
    }

    // Marketplace sale announcements are persisted once per conversation but
    // read by every participant. The same stored message is rendered
    // differently for the seller, the winning buyer, and the losing bidders.
    const saleNoticeText = (message: any) => {
      const sale = message.sale || {};
      const viewer = user()?.id;
      if (viewer === sale.buyer_id) {
        return `Terima kasih, ${sale.title} sudah terjual kepadamu seharga ${money(sale.final_price)}. Barangnya sekarang masuk ke inventarismu. Semoga bermanfaat!`;
      }
      if (viewer === message.sender_id) {
        return `Barang ${sale.title} sudah terjual kepada ${sale.buyer_name} seharga ${money(sale.final_price)}. Terima kasih sudah bertransaksi di Stuff8!`;
      }
      return `Terima kasih sudah mengajukan penawaran untuk ${sale.title}. Barang ini sudah terjual kepada ${sale.buyer_name}, jadi negosiasi ini kami tutup. Semoga segera menemukan barang yang pas.`;
    };

    async function renderMessage(message: any) {
      if (message.kind === 'sale') {
        return `<div id="message-${message.message_id}" class="flex justify-center px-2"><div class="max-w-[92%] rounded-xl border border-emerald-200 bg-emerald-50 px-3 py-2 text-center text-xs font-semibold leading-relaxed text-emerald-800">${escapeHtml(saleNoticeText(message))}</div></div>`;
      }
      const mine = message.sender_id === user()?.id;
      const profile = await profileFor(message.sender_id);
      const files = attachmentsMarkup(message.attachments || []);
      return `<div id="message-${message.message_id}" class="flex items-end gap-2 ${mine ? 'justify-end' : 'justify-start'}">${mine ? '' : avatar(profile)}<div class="max-w-[78%]"><p class="mb-1 text-[11px] font-semibold text-slate-500 ${mine ? 'text-right' : ''}">${escapeHtml(profileName(profile))}</p><div class="rounded-2xl px-3 py-2 text-sm ${mine ? 'rounded-br-sm bg-navy-900 text-white' : 'rounded-bl-sm bg-navy-100 text-navy-900'}">${message.offer_amount ? `<p class="mb-1 text-xs font-bold">Offer: ${money(message.offer_amount)}</p>` : ''}${message.body ? `<p>${escapeHtml(message.body)}</p>` : ''}${message.sticker_id ? `<p class="text-lg" aria-label="Stiker">💬 <span class="text-xs font-bold">${escapeHtml(message.sticker_id.replaceAll('-', ' '))}</span></p>` : ''}${files}</div><p class="mt-1 text-[10px] text-slate-400 ${mine ? 'text-right' : ''}">${relativeTime(message.created_at)}</p></div>${mine ? avatar(profile) : ''}</div>`;
    }

    // One live socket per conversation. Sending is guarded by readyState so a
    // stale socket can never surface the browser's "WebSocket is already in
    // CLOSING or CLOSED state" error, and an unexpected close reconnects with
    // exponential backoff instead of leaving the chat silently dead.
    function openSocket() {
      if (!isSessionValid()) { localStorage.removeItem('stuff8_session'); return; }
      if (!activeConversation || !user()?.id) return;
      window.clearTimeout(socketReconnectTimer);
      const targetId = activeConversation.conversation_id;
      const generation = ++socketGeneration;
      if (websocket) {
        websocket.onclose = null; websocket.onerror = null; websocket.onmessage = null;
        try { websocket.close(); } catch {}
      }
      const socket = new WebSocket(wsUrlFor(targetId));
      websocket = socket;
      socket.onopen = () => { socketReconnectAttempt = 0; };
      socket.onmessage = async event => { const payload = JSON.parse(event.data); const root = document.getElementById('messages'); if (payload.type === 'typing') { const indicator = document.getElementById('typing-indicator'); if (indicator && payload.sender_id !== user()?.id) { const profile = await profileFor(payload.sender_id); indicator.setAttribute('aria-label', `${profileName(profile)} sedang mengetik`); indicator.classList.toggle('hidden', !payload.is_typing); indicator.classList.toggle('flex', payload.is_typing); } return; } const message = payload.type === 'message' ? payload.message : payload; const matchingConversation = conversations.find(candidate => candidate.conversation_id === activeConversation?.conversation_id); if (matchingConversation) matchingConversation.updated_at = message.created_at || new Date().toISOString(); if (root && !document.getElementById(`message-${message.message_id}`)) { activeMessages.push(message); root.insertAdjacentHTML('beforeend', await renderMessage(message)); bindMediaGallery(root); root.scrollTop = root.scrollHeight; } await renderList(); };
      socket.onclose = () => {
        if (websocket === socket) websocket = undefined;
        if (generation !== socketGeneration) return;
        const delay = Math.min(15000, 1000 * 2 ** socketReconnectAttempt);
        socketReconnectAttempt += 1;
        socketReconnectTimer = window.setTimeout(openSocket, delay);
      };
      socket.onerror = () => { socket.close(); };
    }

    async function openConversation(conversation: any, focusComposer = false) {
      if (!conversation || !user()?.id) return;
      activeConversation = conversation;
      if (conversation.context?.reference_id) expandedProductTrees.add(conversation.context.reference_id);
      await renderList();
      const listing = await listingFor(conversation.context?.reference_id);
      const description = escapeHtml(listing?.description || 'Percakapan tentang barang ini.');
      const referenceId = conversation.context?.reference_id || '';
      const itemLink = referenceId
        ? marketplaceDetailPath({ id: referenceId, title: listing?.title || conversation.context?.title || '' })
        : `/marketplace/detail/?id=${encodeURIComponent(referenceId)}`;
      const canCompleteSale = listing?.seller_id === user()?.id && !listing?.is_sold;
      panel.innerHTML = `<div class="flex items-center justify-between border-b border-navy-100 p-4"><p class="line-clamp-2 text-xs leading-5 text-slate-500">${description}</p><div class="ml-4 flex shrink-0 items-center gap-3"><a href="${itemLink}" class="text-xs font-bold text-navy-900 hover:underline">Lihat barang</a>${canCompleteSale ? '<button id="chat-complete-sale" type="button" class="rounded-lg bg-navy-900 px-3 py-2 text-xs font-bold text-white">Terjual</button>' : ''}</div></div><div id="messages" class="flex-1 min-w-0 space-y-3 overflow-y-auto bg-paper-100 p-4"></div><p id="typing-indicator" class="hidden min-h-16 items-center px-6 py-3" aria-live="polite"><span class="typing-visual" aria-hidden="true"><img src="/images/typing-bubble.webp" alt="" /><span class="typing-dots"><i></i><i></i><i></i></span></span><span class="sr-only">Pengguna sedang mengetik</span></p><div class="sticky bottom-0 z-10 border-t border-navy-100 bg-white"><form id="message-form" class="flex min-w-0 gap-2 p-3"><input id="message-input" class="min-w-0 flex-1 rounded-lg border border-navy-100 px-3 py-2 text-sm" placeholder="Tulis pesan" /><input id="message-file" type="file" multiple accept="image/jpeg,image/png,image/webp,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/plain" class="hidden" /><input id="message-camera" type="file" multiple accept="image/jpeg,image/png,image/webp" capture="environment" class="hidden" /><button id="message-file-button" type="button" class="shrink-0 rounded-lg border border-navy-100 px-3 text-sm" aria-label="Lampirkan gambar atau dokumen, maksimal 2 MB per file">＋</button><button class="shrink-0 whitespace-nowrap rounded-lg bg-navy-900 px-4 text-sm font-bold text-white">Kirim</button></form></div>`;
      const messagesResponse = await fetch(`${CHAT}/conversations/${conversation.conversation_id}/messages?participant_id=${encodeURIComponent(user().id)}`, { headers: chatHeaders() });
      const messages = messagesResponse.ok ? await messagesResponse.json() : [];
      activeMessages = messages;
      const messagesRoot = document.getElementById('messages')!;
      messagesRoot.innerHTML = (await Promise.all(messages.map(renderMessage))).join('');
      bindMediaGallery(messagesRoot);
      requestAnimationFrame(() => { messagesRoot.scrollTop = messagesRoot.scrollHeight; });
      const messageInput = document.getElementById('message-input') as HTMLInputElement;
      if (focusComposer) requestAnimationFrame(() => messageInput.focus());
      const completeSaleButton = document.getElementById('chat-complete-sale') as HTMLButtonElement | null;
      if (completeSaleButton && listing) {
        const buyerId = customerIdFor(conversation);
        const buyer = await profileFor(buyerId);
        const dialog = document.getElementById('chat-complete-sale-dialog')!;
        const priceInput = document.getElementById('chat-sale-price') as HTMLInputElement;
        const highestOffer = Math.max(Number(listing.asking_price || 0), ...messages.map((message: any) => Number(message.offer_amount || 0)));
        priceInput.value = money(highestOffer);
        document.getElementById('chat-sale-buyer')!.textContent = `Pembeli: ${profileName(buyer)}`;
        const closeSaleDialog = () => { dialog.classList.add('hidden'); dialog.classList.remove('flex'); };
        completeSaleButton.onclick = () => { dialog.classList.remove('hidden'); dialog.classList.add('flex'); priceInput.focus(); priceInput.select(); };
        document.getElementById('chat-complete-sale-close')!.onclick = closeSaleDialog;
        document.getElementById('chat-complete-sale-cancel')!.onclick = closeSaleDialog;
        (document.getElementById('chat-complete-sale-form') as HTMLFormElement).onsubmit = async event => {
          event.preventDefault();
          const finalPrice = parseMoney(priceInput.value);
          if (!finalPrice) { priceInput.focus(); return; }
          const response = await fetch(`${MARKETPLACE}/listings/${encodeURIComponent(listing.id)}/complete-sale`, { method: 'POST', headers: { ...chatHeaders(), 'Content-Type': 'application/json' }, body: JSON.stringify({ buyer_id: buyerId, buyer_name: profileName(buyer), final_price: finalPrice }) });
          if (!response.ok) {
            const body = await response.text();
            const error = document.getElementById('chat-sale-error')!;
            error.textContent = body.trim() || 'Barang belum dapat ditandai terjual. Coba lagi.';
            error.classList.remove('hidden');
            return;
          }
          closeSaleDialog();
          window.stuff8Toast?.('Barang sudah terjual dan masuk ke inventaris pembeli.', { variant: 'success', title: 'Transaksi selesai' });
          // Stay on the chat page. Invalidate the cached listing so the sold
          // item re-renders without the Terjual button and the conversation
          // list reflects the new ownership.
          listings.delete(listing.id);
          listingOwners.delete(listing.id);
          await renderList();
          if (activeConversation) await openConversation(activeConversation);
        };
      }
      (document.getElementById('message-form') as HTMLFormElement).onsubmit = event => { event.preventDefault(); if (messageInput.value.trim()) { sendMessage({ body: messageInput.value }); messageInput.value = ''; sendWs({ type: 'typing', is_typing: false }); } };
      messageInput.addEventListener('input', () => { sendWs({ type: 'typing', is_typing: true }); window.clearTimeout(typingTimeout); typingTimeout = window.setTimeout(() => sendWs({ type: 'typing', is_typing: false }), 1200); });
      const fileInput = document.getElementById('message-file') as HTMLInputElement;
      const cameraInput = document.getElementById('message-camera') as HTMLInputElement;
      const fileButton = document.getElementById('message-file-button') as HTMLButtonElement;
      const sourceDialog = document.getElementById('attachment-source-dialog')!;
      const closeSourceDialog = () => { sourceDialog.classList.add('hidden'); sourceDialog.classList.remove('flex'); };
      const chooseInput = (input: HTMLInputElement) => { filePickerOpen = true; closeSourceDialog(); input.click(); };
      fileButton.onclick = event => {
        event.preventDefault();
        event.stopPropagation();
        if (filePickerOpen) return;
        if (window.matchMedia('(pointer: coarse)').matches) { sourceDialog.classList.remove('hidden'); sourceDialog.classList.add('flex'); }
        else chooseInput(fileInput);
      };
      document.getElementById('attachment-gallery')?.addEventListener('click', () => chooseInput(fileInput));
      document.getElementById('attachment-camera')?.addEventListener('click', () => chooseInput(cameraInput));
      document.getElementById('attachment-source-cancel')?.addEventListener('click', closeSourceDialog);
      sourceDialog.onclick = event => { if (event.target === sourceDialog) closeSourceDialog(); };
      const handleSelectedFiles = async (input: HTMLInputElement) => {
        filePickerOpen = false;
        const selected = [...(input.files || [])];
        if (!selected.length) return;
        const allowed = selected.filter(file => {
          if (file.size <= MAX_CHAT_ATTACHMENT_BYTES) return true;
          showAttachmentError(file, 'Ukuran lampiran maksimal 2 MB per file.');
          return false;
        });
        try {
          const outcomes = await Promise.allSettled(allowed.map(file => uploadAttachment(file)));
          const completed = outcomes.filter((outcome): outcome is PromiseFulfilledResult<any> => outcome.status === 'fulfilled').map(outcome => outcome.value);
          if (completed.length) {
            await sendMessage({ attachments: completed.map(uploaded => uploaded.attachment) });
            completed.forEach(uploaded => uploaded.remove());
          }
          outcomes.filter((outcome): outcome is PromiseRejectedResult => outcome.status === 'rejected' && outcome.reason?.name !== 'AbortError').forEach(outcome => console.error(outcome.reason));
        } finally { input.value = ''; }
      };
      fileInput.onchange = () => handleSelectedFiles(fileInput);
      cameraInput.onchange = () => handleSelectedFiles(cameraInput);
      openSocket();
    }

    async function sendMessage(payload: any) {
      if (!activeConversation || !user()?.id) return;
      const response = await fetch(`${CHAT}/conversations/${activeConversation.conversation_id}/messages`, { method: 'POST', headers: { ...chatHeaders(), 'Content-Type': 'application/json' }, body: JSON.stringify({ sender_id: user().id, ...payload }) });
      if (!response.ok) throw new Error('Pesan belum dapat dikirim.');
      const message = await response.json();
      const root = document.getElementById('messages');
      if (root && !document.getElementById(`message-${message.message_id}`)) {
        activeMessages.push(message);
        root.insertAdjacentHTML('beforeend', await renderMessage(message));
        bindMediaGallery(root);
        root.scrollTop = root.scrollHeight;
      }
    }

    async function load() {
      if (!user()?.id) { signedOut(); return; }
      const response = await fetch(`${CHAT}/conversations?participant_id=${encodeURIComponent(user().id)}`, { headers: chatHeaders() });
      if (!response.ok) throw new Error('Chat belum tersedia.');
      const seen = new Set<string>();
      conversations = (await response.json()).filter((conversation: any) => conversation.context?.domain === 'marketplace').filter((conversation: any) => { const key = `${conversation.context?.reference_id}:${[...conversation.participant_ids].sort().join(':')}`; if (seen.has(key)) return false; seen.add(key); return true; });
      if (!conversations.length) { renderEmptyInbox(); return; }
      await renderList();
      const requested = new URLSearchParams(location.search).get('conversation');
      const item = new URLSearchParams(location.search).get('item');
      if (conversations.length) await openConversation(conversations.find(conversation => conversation.conversation_id === requested) || conversations.find(conversation => conversation.context?.reference_id === item) || conversations[0], Boolean(requested || item));
    }
    load().catch(error => { panel.innerHTML = `<div class="m-auto p-6 text-center text-sm text-rose-700">${escapeHtml(error.message)}</div>`; });
  </script>
</Layout>
