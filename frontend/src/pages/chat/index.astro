---
import Layout from '../../layouts/Layout.astro';
---

<Layout>
  <div class="mx-auto flex h-full min-h-0 w-full max-w-6xl flex-col px-4 py-5 sm:px-6 lg:px-8">
    <div class="mb-4">
      <h1 class="page-heading">Nego sampai deal</h1>
    </div>
    <div id="chat-app" class="grid min-h-0 flex-1 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-xs md:grid-cols-[minmax(0,20rem)_minmax(0,1fr)]">
      <aside class="min-h-0 overflow-y-auto border-b border-slate-200 bg-slate-50 p-3 md:border-b-0 md:border-r"><div id="conversation-list" class="space-y-2"><p class="p-3 text-sm text-slate-500">Memuat percakapan…</p></div></aside>
      <section id="conversation-panel" class="flex min-h-0 min-w-0 flex-col"><div class="m-auto max-w-sm p-6 text-center"><h2 class="font-bold text-slate-900">Pilih percakapan</h2><p class="mt-1 text-sm text-slate-500">Offer dan pesan produk akan muncul di sini.</p></div></section>
    </div>
  </div>

  <style is:global>
    .typing-visual { position: relative; display: inline-flex; align-items: center; justify-content: center; height: 2.25rem; width: 3.25rem; }
    .typing-visual img { position: absolute; inset: 0; height: 100%; width: 100%; object-fit: contain; }
    .typing-dots { position: relative; z-index: 1; display: inline-flex; gap: 0.18rem; padding-top: 0.08rem; }
    .typing-dots i { display: block; width: 0.25rem; height: 0.25rem; border-radius: 9999px; background: #0f172a; animation: stuff8-typing 1s ease-in-out infinite; }
    .typing-dots i:nth-child(2) { animation-delay: 0.14s; }
    .typing-dots i:nth-child(3) { animation-delay: 0.28s; }
    @keyframes stuff8-typing { 0%, 60%, 100% { transform: translateY(0); opacity: .35; } 30% { transform: translateY(-0.22rem); opacity: 1; } }
  </style>

  <script>
    const CHAT = `${import.meta.env.PUBLIC_CHAT_URL || '/api'}/chat`;
    const STORAGE = import.meta.env.PUBLIC_PHOTOS_URL || '/api';
    const PROFILE = import.meta.env.PUBLIC_PROFILE_URL || '/api';
    const listRoot = document.getElementById('conversation-list')!;
    const panel = document.getElementById('conversation-panel')!;
    const chatApp = document.getElementById('chat-app')!;
    const escapeHtml = (value: string) => value.replace(/[&<>"']/g, char => ({ '&': '&amp;', '<': '&gt;', '>': '&lt;', '"': '&quot;', "'": '&#039;' }[char] || char));
    const money = (amount: number) => `Rp ${Number(amount || 0).toLocaleString('id-ID')}`;
    const session = () => { try { return JSON.parse(localStorage.getItem('stuff8_session') || 'null'); } catch { return null; } };
    const user = () => session()?.user;
    const chatHeaders = () => ({ 'Authorization': `Bearer ${session()?.token}` });
    const attachmentUrl = (key: string) => `${STORAGE}/storage/content/${key.split('/').map(encodeURIComponent).join('/')}`;
    let conversations: any[] = [];
    let activeConversation: any;
    let websocket: WebSocket | undefined;
    let typingTimeout: number | undefined;
    const profiles = new Map<string, any>();
    const toDate = (value: any) => new Date(typeof value === 'string' ? value : value?.$date || value?.date || 0);
    const displayDate = (value: any) => {
      const date = toDate(value);
      return Number.isNaN(date.getTime()) ? '' : date.toLocaleString('id-ID', { dateStyle: 'medium', timeStyle: 'short' });
    };
    async function profileFor(id: string) {
      if (id === user()?.id) return user();
      if (profiles.has(id)) return profiles.get(id);
      try {
        const response = await fetch(`${PROFILE}/users/${encodeURIComponent(id)}`, { headers: chatHeaders() });
        const profile = response.ok ? await response.json() : { id };
        profiles.set(id, profile);
        return profile;
      } catch { return { id }; }
    }
    const avatar = (profile: any, className = 'size-8') => `<img src="${escapeHtml(profile?.avatarUrl || '/images/avatar-fallback.webp')}" onerror="this.onerror=null;this.src='/images/avatar-fallback.webp'" alt="" class="${className} shrink-0 rounded-full object-cover" />`;
    let uploadSequence = 0;

    function attachmentMarkup(file: any) {
      const url = attachmentUrl(file.key);
      const filename = escapeHtml(file.filename || 'Lampiran');
      if (String(file.content_type || '').startsWith('image/')) {
        return `<a class="mt-2 block overflow-hidden rounded-xl border border-white/20 bg-white/10" target="_blank" rel="noopener" href="${url}" title="Buka gambar ${filename}"><img src="${url}" alt="${filename}" class="max-h-52 w-full object-cover" /><span class="block truncate px-2 py-1.5 text-xs font-semibold">${filename}</span></a>`;
      }
      return `<a class="mt-2 flex items-center gap-2 rounded-xl border border-white/20 bg-white/10 px-3 py-2 text-xs font-semibold underline" target="_blank" rel="noopener" href="${url}" title="Buka atau unduh ${filename}"><span aria-hidden="true">📎</span><span class="truncate">${filename}</span></a>`;
    }

    function uploadAttachment(file: File): Promise<any> {
      if (!activeConversation || !user()?.id) return Promise.reject(new Error('Percakapan belum siap.'));
      const uploadId = `chat-upload-${++uploadSequence}`;
      const root = document.getElementById('messages');
      root?.insertAdjacentHTML('beforeend', `<div id="${uploadId}" class="flex justify-end"><div class="w-full max-w-sm rounded-2xl rounded-br-sm border border-slate-200 bg-white p-3 shadow-xs"><div class="flex items-start gap-3"><div class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-brand-50 text-lg" aria-hidden="true">${file.type.startsWith('image/') ? '🖼️' : '📄'}</div><div class="min-w-0 flex-1"><p class="truncate text-sm font-bold text-slate-900">${escapeHtml(file.name)}</p><p data-upload-status class="mt-0.5 text-xs text-slate-500">Menyiapkan upload…</p></div><button type="button" data-upload-cancel class="inline-flex size-7 shrink-0 items-center justify-center rounded-md text-slate-500 hover:bg-rose-50 hover:text-rose-700" aria-label="Batalkan upload">×</button></div><div class="mt-3 h-1.5 overflow-hidden rounded-full bg-slate-100"><span data-upload-progress class="block h-full w-0 rounded-full bg-brand-600 transition-[width] duration-150"></span></div></div></div>`);
      root && (root.scrollTop = root.scrollHeight);
      return new Promise((resolve, reject) => {
        const card = document.getElementById(uploadId);
        const status = card?.querySelector<HTMLElement>('[data-upload-status]');
        const progress = card?.querySelector<HTMLElement>('[data-upload-progress]');
        const xhr = new XMLHttpRequest();
        const remove = () => card?.remove();
        const fail = (message: string) => { if (status) status.textContent = message; if (progress) progress.className = 'block h-full w-full rounded-full bg-rose-500'; };
        xhr.open('POST', `${CHAT}/conversations/${encodeURIComponent(activeConversation.conversation_id)}/attachments`);
        const token = session()?.token;
        if (token) xhr.setRequestHeader('Authorization', `Bearer ${token}`);
        xhr.upload.onprogress = event => {
          if (!event.lengthComputable) return;
          const percent = Math.min(95, Math.round((event.loaded / event.total) * 95));
          if (progress) progress.style.width = `${percent}%`;
          if (status) status.textContent = `Mengunggah ke Storage… ${percent}%`;
        };
        xhr.upload.onload = () => { if (status) status.textContent = 'Storage sedang menyiapkan file…'; };
        xhr.onerror = () => { fail('Upload gagal. Coba lagi.'); reject(new Error('Upload gagal.')); };
        xhr.onabort = () => { remove(); reject(new DOMException('Upload dibatalkan.', 'AbortError')); };
        xhr.onload = () => {
          if (xhr.status < 200 || xhr.status >= 300) { fail('Upload ditolak. Coba lagi.'); reject(new Error('Upload ditolak.')); return; }
          try {
            const attachment = JSON.parse(xhr.responseText);
            if (progress) progress.style.width = '100%';
            if (status) status.textContent = 'Upload selesai. Mengirim ke percakapan…';
            resolve({ attachment, remove });
          } catch { fail('Respons Storage tidak valid.'); reject(new Error('Respons Storage tidak valid.')); }
        };
        card?.querySelector<HTMLButtonElement>('[data-upload-cancel]')?.addEventListener('click', () => xhr.abort());
        const form = new FormData();
        form.append('owner_id', user().id);
        form.append('file', file);
        xhr.send(form);
      });
    }

    function signedOut() {
      listRoot.innerHTML = '';
      panel.innerHTML = `<div class="m-auto max-w-sm p-6 text-center"><h2 class="font-bold text-slate-900">Masuk untuk melihat chat</h2><p class="mt-1 text-sm text-slate-500">Offer dan negosiasi hanya tersedia untuk akun aktif.</p><a href="/auth/signup/?return_to=/chat/" class="mt-4 inline-flex rounded-lg bg-navy-900 px-4 py-2.5 text-sm font-bold text-white">Daftar atau masuk</a></div>`;
    }

    function renderEmptyInbox() {
      chatApp.className = 'flex min-h-[32rem] flex-1 items-center justify-center overflow-hidden rounded-2xl border border-slate-200 bg-white px-6 py-10 text-center shadow-xs';
      chatApp.innerHTML = `<div class="flex max-w-sm flex-col items-center"><img src="/images/empty-inbox.webp" alt="Belum ada offer marketplace" class="mb-4 size-36 object-contain sm:size-40" /><h2 class="text-base font-bold text-slate-900">Belum ada offer</h2><p class="mt-1 text-sm leading-6 text-slate-500">Saat kamu mengirim atau menerima offer, chat produk muncul di sini.</p></div>`;
    }

    function renderList() {
      if (!conversations.length) { listRoot.innerHTML = `<div class="rounded-xl border border-dashed border-slate-200 bg-white p-4 text-center"><p class="text-sm font-bold text-slate-800">Belum ada offer</p><p class="mt-1 text-xs text-slate-500">Saat kamu mengirim atau menerima offer, chat produk muncul di sini.</p></div>`; return; }
      listRoot.innerHTML = conversations.map(conversation => `<button type="button" data-conversation="${escapeHtml(conversation.conversation_id)}" class="w-full rounded-xl border p-3 text-left transition ${activeConversation?.conversation_id === conversation.conversation_id ? 'border-navy-900 bg-white shadow-xs' : 'border-transparent hover:border-slate-200 hover:bg-white'}"><p class="truncate text-sm font-bold text-slate-900">${escapeHtml(conversation.context?.title || 'Produk marketplace')}</p><p class="mt-1 text-xs text-slate-500">${displayDate(conversation.updated_at)}</p></button>`).join('');
      document.querySelectorAll<HTMLButtonElement>('[data-conversation]').forEach(button => button.addEventListener('click', () => openConversation(conversations.find(conversation => conversation.conversation_id === button.dataset.conversation))));
    }

    async function renderMessage(message: any) {
      const mine = message.sender_id === user()?.id;
      const profile = await profileFor(message.sender_id);
      const files = (message.attachments || []).map(attachmentMarkup).join('');
      return `<div id="message-${message.message_id}" class="flex items-end gap-2 ${mine ? 'justify-end' : 'justify-start'}">${mine ? '' : avatar(profile)}<div class="max-w-[78%]"><p class="mb-1 text-[11px] font-semibold text-slate-500 ${mine ? 'text-right' : ''}">${escapeHtml(profile.name || profile.username || 'Pengguna Stuff8')}</p><div class="rounded-2xl px-3 py-2 text-sm ${mine ? 'rounded-br-sm bg-navy-900 text-white' : 'rounded-bl-sm bg-slate-100 text-slate-800'}">${message.offer_amount ? `<p class="mb-1 text-xs font-bold">Offer: ${money(message.offer_amount)}</p>` : ''}${message.body ? `<p>${escapeHtml(message.body)}</p>` : ''}${message.sticker_id ? `<p class="text-lg" aria-label="Stiker">💬 <span class="text-xs font-bold">${escapeHtml(message.sticker_id.replaceAll('-', ' '))}</span></p>` : ''}${files}</div><p class="mt-1 text-[10px] text-slate-400 ${mine ? 'text-right' : ''}">${displayDate(message.created_at)}</p></div>${mine ? avatar(profile) : ''}</div>`;
    }

    async function openConversation(conversation: any, focusComposer = false) {
      if (!conversation || !user()?.id) return;
      activeConversation = conversation;
      renderList();
      const title = escapeHtml(conversation.context?.title || 'Produk marketplace');
      const itemLink = `/marketplace/detail?id=${encodeURIComponent(conversation.context?.reference_id || '')}`;
      panel.innerHTML = `<div class="flex items-center justify-between border-b border-slate-200 p-4"><div><h2 class="text-sm font-bold text-navy-900">${title}</h2><p class="text-xs text-slate-500">Negosiasi tersimpan otomatis</p></div><a href="${itemLink}" class="text-xs font-bold text-navy-900 hover:underline">Lihat barang</a></div><div id="messages" class="flex-1 min-w-0 space-y-3 overflow-y-auto bg-slate-50 p-4"></div><p id="typing-indicator" class="hidden min-h-16 items-center px-6 py-3" aria-live="polite"><span class="typing-visual" aria-hidden="true"><img src="/images/typing-bubble.webp" alt="" /><span class="typing-dots"><i></i><i></i><i></i></span></span><span class="sr-only">Pengguna sedang mengetik</span></p><div class="sticky bottom-0 z-10 border-t border-slate-100 bg-white"><div id="stickers" class="flex min-w-0 gap-1 overflow-x-auto px-3 pt-2"></div><form id="message-form" class="flex min-w-0 gap-2 p-3"><input id="message-input" class="min-w-0 flex-1 rounded-lg border border-slate-200 px-3 py-2 text-sm" placeholder="Tulis pesan" /><input id="message-file" type="file" class="hidden" /><button id="message-file-button" type="button" class="shrink-0 rounded-lg border border-slate-200 px-3 text-sm" aria-label="Lampirkan gambar atau dokumen">＋</button><button class="shrink-0 whitespace-nowrap rounded-lg bg-navy-900 px-4 text-sm font-bold text-white">Kirim</button></form></div>`;
      const messagesResponse = await fetch(`${CHAT}/conversations/${conversation.conversation_id}/messages?participant_id=${encodeURIComponent(user().id)}`, { headers: chatHeaders() });
      const messages = messagesResponse.ok ? await messagesResponse.json() : [];
      const messagesRoot = document.getElementById('messages')!;
      messagesRoot.innerHTML = (await Promise.all(messages.map(renderMessage))).join('');
      requestAnimationFrame(() => { messagesRoot.scrollTop = messagesRoot.scrollHeight; });
      const stickerPayload = await fetch(`${CHAT}/stickers`).then(response => response.ok ? response.json() : { packs: [] });
      document.getElementById('stickers')!.innerHTML = stickerPayload.packs.flatMap((pack: any) => pack.stickers.slice(0, 8)).map((sticker: any) => `<button type="button" data-sticker="${escapeHtml(sticker.id)}" class="shrink-0 rounded-md border border-slate-200 bg-white px-2 py-1 text-xs">${escapeHtml(sticker.label)}</button>`).join('');
      document.querySelectorAll<HTMLButtonElement>('[data-sticker]').forEach(button => button.addEventListener('click', () => sendMessage({ sticker_id: button.dataset.sticker })));
      const messageInput = document.getElementById('message-input') as HTMLInputElement;
      if (focusComposer) requestAnimationFrame(() => messageInput.focus());
      (document.getElementById('message-form') as HTMLFormElement).onsubmit = event => { event.preventDefault(); if (messageInput.value.trim()) { sendMessage({ body: messageInput.value }); messageInput.value = ''; websocket?.send(JSON.stringify({ type: 'typing', is_typing: false })); } };
      messageInput.addEventListener('input', () => { websocket?.send(JSON.stringify({ type: 'typing', is_typing: true })); window.clearTimeout(typingTimeout); typingTimeout = window.setTimeout(() => websocket?.send(JSON.stringify({ type: 'typing', is_typing: false })), 1200); });
      document.getElementById('message-file-button')?.addEventListener('click', () => (document.getElementById('message-file') as HTMLInputElement).click());
      (document.getElementById('message-file') as HTMLInputElement).onchange = async event => { const input = event.target as HTMLInputElement; const file = input.files?.[0]; if (!file) return; try { const uploaded: any = await uploadAttachment(file); await sendMessage({ attachments: [uploaded.attachment] }); uploaded.remove(); } catch (error: any) { if (error?.name !== 'AbortError') console.error(error); } finally { input.value = ''; } };
      websocket?.close();
      websocket = new WebSocket(`${CHAT.replace(/^http/, 'ws')}/conversations/${conversation.conversation_id}/ws?token=${encodeURIComponent(session().token)}`);
      websocket.onmessage = async event => { const payload = JSON.parse(event.data); const root = document.getElementById('messages'); if (payload.type === 'typing') { const indicator = document.getElementById('typing-indicator'); if (indicator && payload.sender_id !== user()?.id) { const profile = await profileFor(payload.sender_id); indicator.setAttribute('aria-label', `${profile.name || profile.username || 'Pengguna'} sedang mengetik`); indicator.classList.toggle('hidden', !payload.is_typing); indicator.classList.toggle('flex', payload.is_typing); } return; } const message = payload.type === 'message' ? payload.message : payload; if (root && !document.getElementById(`message-${message.message_id}`)) { root.insertAdjacentHTML('beforeend', await renderMessage(message)); root.scrollTop = root.scrollHeight; } };
    }

    async function sendMessage(payload: any) {
      if (!activeConversation || !user()?.id) return;
      const response = await fetch(`${CHAT}/conversations/${activeConversation.conversation_id}/messages`, { method: 'POST', headers: { ...chatHeaders(), 'Content-Type': 'application/json' }, body: JSON.stringify({ sender_id: user().id, ...payload }) });
      if (!response.ok) throw new Error('Pesan belum dapat dikirim.');
      const message = await response.json();
      const root = document.getElementById('messages');
      if (root && !document.getElementById(`message-${message.message_id}`)) {
        root.insertAdjacentHTML('beforeend', await renderMessage(message));
        root.scrollTop = root.scrollHeight;
      }
    }

    async function load() {
      if (!user()?.id) { signedOut(); return; }
      const response = await fetch(`${CHAT}/conversations?participant_id=${encodeURIComponent(user().id)}`, { headers: chatHeaders() });
      if (!response.ok) throw new Error('Chat belum tersedia.');
      const seen = new Set<string>();
      conversations = (await response.json()).filter((conversation: any) => conversation.context?.domain === 'marketplace').filter((conversation: any) => { const key = `${conversation.context?.reference_id}:${[...conversation.participant_ids].sort().join(':')}`; if (seen.has(key)) return false; seen.add(key); return true; });
      if (!conversations.length) { renderEmptyInbox(); return; }
      renderList();
      const requested = new URLSearchParams(location.search).get('conversation');
      const item = new URLSearchParams(location.search).get('item');
      if (conversations.length) await openConversation(conversations.find(conversation => conversation.conversation_id === requested) || conversations.find(conversation => conversation.context?.reference_id === item) || conversations[0], Boolean(requested || item));
    }
    load().catch(error => { panel.innerHTML = `<div class="m-auto p-6 text-center text-sm text-rose-700">${escapeHtml(error.message)}</div>`; });
  </script>
</Layout>
