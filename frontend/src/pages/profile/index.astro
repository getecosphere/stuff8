---
import Layout from '../../layouts/Layout.astro';
---

<Layout>
  <div class="mx-auto w-full max-w-2xl px-4 py-6 sm:px-6">
    <div id="profile-app" class="rounded-2xl border border-navy-100 bg-white p-5 shadow-[0_1px_2px_rgba(15,30,25,0.04)]">
      <div class="border-b border-navy-100 pb-4"><div class="skeleton h-3 w-16"></div><div class="skeleton mt-2 h-6 w-48"></div></div>
      <div class="mt-5 flex items-center gap-4"><div class="skeleton size-16 rounded-full"></div><div class="space-y-2"><div class="skeleton h-4 w-40"></div><div class="skeleton h-3 w-28"></div></div></div>
      <div class="mt-6 space-y-3 border-t border-navy-100 pt-5"><div class="skeleton h-10 w-full rounded-full"></div><div class="skeleton h-10 w-full rounded-full"></div><div class="skeleton h-10 w-full rounded-full"></div></div>
    </div>
  </div>
  <script>
    const AUTH = `${import.meta.env.PUBLIC_AUTH_URL || '/auth-api'}/auth`;
    const PROFILE = import.meta.env.PUBLIC_PROFILE_URL || '/api';
    const root = document.getElementById('profile-app')!;
    const session = () => { try { return JSON.parse(localStorage.getItem('stuff8_session') || 'null'); } catch { return null; } };
    const user = () => session()?.user;
    const headers = () => ({ 'Authorization': `Bearer ${session()?.token}`, 'Content-Type': 'application/json' });
    const escapeHtml = (value: string) => value.replace(/[&<>"']/g, char => ({ '&': '&amp;', '<': '&gt;', '>': '&lt;', '"': '&quot;', "'": '&#039;' }[char] || char));
    const showStatus = (message: string, success = false) => { const el = document.getElementById('profile-error'); if (el) { el.textContent = message; el.className = `mt-4 rounded-lg border p-3 text-sm ${success ? 'border-emerald-200 bg-emerald-50 text-emerald-800' : 'border-rose-200 bg-rose-50 text-rose-700'}`; } };
    const showError = (message: string) => showStatus(message);
    const saveSessionUser = (patch: any) => { const value = session(); value.user = { ...value.user, ...patch }; localStorage.setItem('stuff8_session', JSON.stringify(value)); };
    async function load() {
      if (!user()?.id) { root.innerHTML = `<div class="py-8 text-center"><h1 class="font-display text-xl font-extrabold text-navy-900">Profile & security</h1><p class="mt-2 text-sm text-slate-600">Sign in first to manage your account.</p><a href="/auth/signup/?return_to=/profile/" class="mt-4 inline-flex rounded-full bg-navy-900 px-4 py-2.5 text-sm font-bold text-white">Sign up or sign in</a></div>`; return; }
      const response = await fetch(`${PROFILE}/users/${encodeURIComponent(user().id)}`, { headers: { Authorization: `Bearer ${session().token}` } });
      const profile = response.ok ? await response.json() : user();
      root.innerHTML = `<div class="border-b border-navy-100 pb-4"><p class="text-xs font-bold uppercase tracking-wider text-clay-600">Account</p><h1 class="mt-1 font-display text-xl font-extrabold text-navy-900">Profile & security</h1></div><div id="profile-error" class="mt-4 hidden rounded-lg border border-rose-200 bg-rose-50 p-3 text-sm text-rose-700"></div><section class="mt-5 flex items-center gap-4"><div class="flex size-16 shrink-0 items-center justify-center overflow-hidden rounded-full bg-navy-900 text-xl font-bold text-white" id="avatar">${profile.avatarUrl ? `<img src="${escapeHtml(profile.avatarUrl)}" alt="Profile photo" class="size-full object-cover" />` : escapeHtml((profile.name || profile.username || 'U').charAt(0))}</div><div><p class="font-bold text-navy-900">${escapeHtml(profile.name || '')}</p><p class="text-sm text-slate-500">@${escapeHtml(profile.username || '')}</p><label class="mt-2 inline-flex cursor-pointer rounded-full border border-navy-100 px-3 py-2 text-xs font-bold text-slate-700 hover:bg-clay-50">Change photo<input id="avatar-input" type="file" accept="image/jpeg,image/png,image/webp" class="hidden" /></label></div></section><form id="identity-form" class="mt-6 space-y-3 border-t border-navy-100 pt-5"><h2 class="font-bold text-navy-900">Identity</h2><input id="profile-name" required value="${escapeHtml(profile.name || '')}" class="w-full rounded-full border border-navy-100 px-3 py-2.5 text-sm" placeholder="Name" /><div class="rounded-full border border-navy-100 bg-paper-100 px-3 py-2.5"><p class="text-xs font-semibold text-slate-500">Registered email</p><p class="mt-1 text-sm text-navy-900">${escapeHtml(profile.email || user().email || '')}</p></div><p class="text-xs text-slate-500">Email is managed by Auth and cannot be changed from this page.</p><button class="rounded-full bg-navy-900 px-4 py-2.5 text-sm font-bold text-white">Save name</button></form><form id="password-form" class="mt-6 space-y-3 border-t border-navy-100 pt-5"><h2 class="font-bold text-navy-900">Change password</h2><p class="text-xs text-slate-500">For security, enter your current password before choosing a new one.</p><input id="current-password" type="password" required autocomplete="current-password" class="w-full rounded-full border border-navy-100 px-3 py-2.5 text-sm" placeholder="Current password" /><input id="new-password" type="password" required autocomplete="new-password" class="w-full rounded-full border border-navy-100 px-3 py-2.5 text-sm" placeholder="New password" /><button class="rounded-full border border-navy-900 px-4 py-2.5 text-sm font-bold text-navy-900">Change password</button></form>`;
      (document.getElementById('identity-form') as HTMLFormElement).onsubmit = async event => { event.preventDefault(); const name = (document.getElementById('profile-name') as HTMLInputElement).value.trim(); const result = await fetch(`${PROFILE}/users/${user().id}`, { method: 'PUT', headers: headers(), body: JSON.stringify({ name }) }); if (!result.ok) return showError('Name could not be saved.');       const updated = await result.json(); saveSessionUser({ name: updated.name }); window.stuff8Toast?.('Name updated successfully.', { variant: 'success', title: 'Profile saved' }); location.reload(); };
      (document.getElementById('password-form') as HTMLFormElement).onsubmit = async event => { event.preventDefault(); const currentPassword = (document.getElementById('current-password') as HTMLInputElement).value; const newPassword = (document.getElementById('new-password') as HTMLInputElement).value; const result = await fetch(`${AUTH}/change-password?${new URLSearchParams({ currentPassword, newPassword })}`, { method: 'PUT', headers: { Authorization: `Bearer ${session().token}` } }); if (!result.ok) return showError('Password could not be changed. Make sure your current password is correct and the new password meets the requirements.'); (document.getElementById('password-form') as HTMLFormElement).reset(); showStatus('Password changed successfully.', true); window.stuff8Toast?.('Password changed successfully.', { variant: 'success', title: 'Security updated' }); };
      (document.getElementById('avatar-input') as HTMLInputElement).onchange = async event => { const file = (event.target as HTMLInputElement).files?.[0]; if (!file) return; const form = new FormData(); form.append('file', file); const result = await fetch(`${AUTH.replace('/auth', '')}/users/${user().id}/avatar`, { method: 'POST', headers: { Authorization: `Bearer ${session().token}` }, body: form }); if (!result.ok) return showError('Profile photo could not be uploaded.'); const body = await result.json(); saveSessionUser({ avatarUrl: body.avatarUrl }); window.stuff8Toast?.('Profile photo uploaded successfully.', { variant: 'success', title: 'Profile saved' }); location.reload(); };
    }
    load().catch(() => { root.textContent = 'Profile not available yet. Try again.'; });
  </script>
</Layout>
