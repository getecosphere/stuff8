---
import Layout from '../../layouts/Layout.astro';
---

<Layout description="Verify your Stuff8 email.">
  <section class="mx-auto flex min-h-[calc(100vh-8rem)] w-full max-w-md items-center px-4 py-10 sm:py-16">
    <div class="w-full rounded-2xl border border-slate-200 bg-white p-6 text-center shadow-xs sm:p-8">
      <div id="verification-icon" class="mx-auto flex size-14 items-center justify-center rounded-full bg-slate-100 text-2xl text-slate-600" aria-hidden="true">…</div>
      <h1 id="verification-title" class="mt-5 font-display text-2xl font-extrabold tracking-tight text-navy-900">Verifying email</h1>
      <p id="verification-message" class="mt-2 text-sm leading-relaxed text-slate-600" aria-live="polite">Please wait a moment.</p>
      <a id="verification-action" href="/inventory/" class="mt-6 hidden inline-flex items-center justify-center rounded-full bg-navy-900 px-4 py-3 text-sm font-bold text-white transition-colors hover:bg-navy-800">Open Inventory</a>
    </div>
  </section>
  <script>
    const authApi = import.meta.env.PUBLIC_AUTH_URL || '/auth-api';
    const token = new URLSearchParams(location.search).get('token');
    const icon = document.getElementById('verification-icon')!;
    const title = document.getElementById('verification-title')!;
    const message = document.getElementById('verification-message')!;
    const action = document.getElementById('verification-action')!;
    const finish = (ok: boolean, text: string) => {
      icon.textContent = ok ? '✓' : '×';
      icon.className = `mx-auto flex size-14 items-center justify-center rounded-full text-2xl font-bold ${ok ? 'bg-emerald-100 text-emerald-700' : 'bg-rose-100 text-rose-700'}`;
      title.textContent = ok ? 'Email verified' : 'Verification failed';
      message.textContent = text;
      action.textContent = ok ? 'Open Inventory' : 'Back to Stuff8';
      action.classList.remove('hidden');
    };
    if (!token) {
      finish(false, 'The verification link is incomplete. Request a new verification email from Stuff8.');
    } else {
      // Avoid leaving the bearer token in browser history after reading it.
      history.replaceState(null, '', '/auth/verify-email/');
      fetch(`${authApi.replace(/\/$/, '')}/auth/verify-email?token=${encodeURIComponent(token)}`)
        .then(async response => {
          const raw = await response.text();
          const data = raw ? JSON.parse(raw) : {};
          if (!response.ok || !data.verified) throw new Error(data.message || 'The verification link could not be used.');
          try {
            const session = JSON.parse(localStorage.getItem('stuff8_session') || 'null');
            if (session?.user) { session.user.emailVerified = true; localStorage.setItem('stuff8_session', JSON.stringify(session)); }
          } catch { /* no local session to update */ }
          finish(true, data.message || 'Your email is verified. Marketplace and negotiations are now active.');
        })
        .catch(error => finish(false, error instanceof Error ? error.message : 'The verification link could not be used.'));
    }
  </script>
</Layout>
