---
import Layout from '../../layouts/Layout.astro';
---

<Layout description="Buat akun Stuff8 untuk mulai mencatat inventaris pribadimu.">
  <section class="mx-auto flex min-h-[calc(100vh-8rem)] w-full max-w-md items-center px-4 py-10 sm:py-16">
    <div class="w-full rounded-2xl border border-slate-200 bg-white p-6 shadow-xs sm:p-8">
      <div class="mb-6 space-y-2"><h1 class="text-2xl font-extrabold tracking-tight text-slate-900">Buat akun Stuff8</h1><p class="text-sm leading-relaxed text-slate-600">Mulai catat inventaris pribadimu dengan rapi.</p></div>
      <form id="signup-form" class="space-y-4">
        <p id="signup-error" class="hidden rounded-lg border border-rose-200 bg-rose-50 p-3 text-sm text-rose-700" role="alert"></p>
        <p id="signup-progress" class="hidden items-center gap-2 rounded-lg border border-brand-100 bg-brand-50 p-3 text-sm text-brand-800" role="status" aria-live="polite"><svg class="size-4 animate-spin" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle class="opacity-25" cx="12" cy="12" r="9" stroke="currentColor" stroke-width="3" /><path class="opacity-90" d="M21 12a9 9 0 0 0-9-9" stroke="currentColor" stroke-width="3" stroke-linecap="round" /></svg><span>Menyiapkan akunmu…</span></p>
        <input id="signup-name" required autocomplete="name" aria-label="Nama lengkap" placeholder="Nama lengkap" class="w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 outline-none focus:border-navy-900" />
        <input id="signup-email" type="email" required autocomplete="email" aria-label="Email" placeholder="Email" class="w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 outline-none focus:border-navy-900" />
        <div class="relative"><input id="signup-password" type="password" required autocomplete="new-password" aria-label="Kata sandi" placeholder="Kata sandi" class="w-full rounded-lg border border-slate-300 py-2.5 pl-3.5 pr-12 text-sm text-slate-900 outline-none focus:border-navy-900" /><button type="button" data-password-toggle="signup-password" aria-label="Tampilkan kata sandi" class="absolute inset-y-0 right-0 px-3 text-slate-500 hover:text-navy-900"><svg data-password-eye="hidden" class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.25 12s3.75-6.75 9.75-6.75S21.75 12 21.75 12 18 18.75 12 18.75 2.25 12 2.25 12Z" /><circle cx="12" cy="12" r="2.75" stroke-width="2" /></svg><svg data-password-eye="visible" class="hidden size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m3 3 18 18M10.584 10.587A2 2 0 0 0 13.414 13.4M9.88 5.3A10.9 10.9 0 0 1 12 5.1c6 0 9.75 6.9 9.75 6.9a18.5 18.4 0 0 1-3.04 3.88M6.23 6.23A18.4 18.4 0 0 0 2.25 12s3.75 6.9 9.75 6.9a10.9 10.9 0 0 0 3.18-.48" /></svg></button></div>
        <label class="flex cursor-pointer items-start gap-3 rounded-lg border border-slate-200 bg-slate-50 px-3.5 py-3 text-xs leading-relaxed text-slate-600 transition-colors hover:border-slate-300">
          <input id="signup-terms" type="checkbox" required class="mt-0.5 size-4 shrink-0 rounded border-slate-300 text-navy-900 focus:ring-navy-900" />
          <span>Saya setuju dengan <a href="/terms/" class="font-bold text-navy-900 underline underline-offset-2 hover:text-brand-700">Syarat dan Ketentuan Stuff8</a>, termasuk aturan penggunaan Marketplace.</span>
        </label>
        <button id="signup-submit" disabled class="flex w-full items-center justify-center gap-2 rounded-lg bg-navy-900 py-3 text-sm font-bold text-white transition-colors hover:bg-navy-800 disabled:cursor-not-allowed disabled:bg-slate-300 disabled:text-slate-500"><svg id="signup-spinner" class="hidden size-4 animate-spin" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle class="opacity-25" cx="12" cy="12" r="9" stroke="currentColor" stroke-width="3" /><path class="opacity-90" d="M21 12a9 9 0 0 0-9-9" stroke="currentColor" stroke-width="3" stroke-linecap="round" /></svg><span id="signup-submit-label">Buat akun</span></button>
      </form>
      <p class="mt-5 text-center text-sm text-slate-600">Sudah punya akun? <a id="signin-link" href="/auth/signin/" class="font-bold text-navy-900 underline underline-offset-4">Masuk</a></p>
    </div>
  </section>
  <script>
    const authApi = import.meta.env.PUBLIC_AUTH_URL || '/auth-api';
    const authEndpoint = `${authApi.replace(/\/$/, '')}/auth`;
    const returnTo = new URLSearchParams(location.search).get('return_to'); const safeReturnTo = returnTo?.startsWith('/') ? returnTo : '/inventory/';
    const terms = document.getElementById('signup-terms') as HTMLInputElement | null;
    const submitButton = document.getElementById('signup-submit') as HTMLButtonElement | null;
    const form = document.getElementById('signup-form') as HTMLFormElement | null;
    const progress = document.getElementById('signup-progress') as HTMLParagraphElement | null;
    const spinner = document.getElementById('signup-spinner');
    const submitLabel = document.getElementById('signup-submit-label');
    let submitting = false;
    const setSubmitting = (value: boolean) => {
      submitting = value;
      form?.querySelectorAll<HTMLInputElement | HTMLButtonElement>('input, button').forEach(control => { control.disabled = value || (control === terms ? false : control === submitButton ? !terms?.checked : false); });
      if (submitButton) submitButton.disabled = value || !terms?.checked;
      spinner?.classList.toggle('hidden', !value);
      progress?.classList.toggle('hidden', !value);
      progress?.classList.toggle('flex', value);
      if (submitLabel) submitLabel.textContent = value ? 'Membuat akun…' : 'Buat akun';
    };
    terms?.addEventListener('change', () => { if (!submitting && submitButton) submitButton.disabled = !terms.checked; });
    document.getElementById('signin-link')?.setAttribute('href', `/auth/signin/?return_to=${encodeURIComponent(safeReturnTo)}`);
    document.querySelectorAll<HTMLButtonElement>('[data-password-toggle]').forEach(button => { const input = document.getElementById(button.dataset.passwordToggle || '') as HTMLInputElement | null; button.addEventListener('click', () => { if (!input) return; const reveal = input.type === 'password'; input.type = reveal ? 'text' : 'password'; button.querySelector('[data-password-eye="hidden"]')?.classList.toggle('hidden', reveal); button.querySelector('[data-password-eye="visible"]')?.classList.toggle('hidden', !reveal); button.setAttribute('aria-label', reveal ? 'Sembunyikan kata sandi' : 'Tampilkan kata sandi'); }); });
    const internalUsernameFor = (email: string) => `stuff8-${Array.from(new TextEncoder().encode(email.trim().toLowerCase()), byte => byte.toString(16).padStart(2, '0')).join('')}`;
    form?.addEventListener('submit', async event => { event.preventDefault(); if (submitting) return; const error = document.getElementById('signup-error')!; error.classList.add('hidden'); if (!terms?.checked) { error.textContent = 'Centang persetujuan Syarat dan Ketentuan dulu, ya.'; error.classList.remove('hidden'); return; } const name = (document.getElementById('signup-name') as HTMLInputElement).value; const email = (document.getElementById('signup-email') as HTMLInputElement).value; const username = internalUsernameFor(email); const password = (document.getElementById('signup-password') as HTMLInputElement).value; setSubmitting(true); try { const response = await fetch(`${authEndpoint}/register`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ name, username, email, password }) }); const raw = await response.text(); let data: Record<string, unknown> = {}; try { data = raw ? JSON.parse(raw) : {}; } catch { throw new Error('Layanan Auth mengembalikan respons yang tidak valid. Coba lagi.'); } if (!response.ok || !data.token) throw new Error(String(data.message || data.error || `Pendaftaran belum berhasil (status ${response.status}).`)); localStorage.setItem('stuff8_session', JSON.stringify(data)); location.assign(safeReturnTo); } catch (cause) { error.textContent = cause instanceof Error ? cause.message : 'Pendaftaran belum berhasil. Coba lagi.'; error.classList.remove('hidden'); setSubmitting(false); } });
  </script>
</Layout>
