---
import Layout from '../../layouts/Layout.astro';
---

<Layout description="Masuk ke Stuff8 untuk mengelola inventaris pribadimu.">
  <section class="mx-auto flex min-h-[calc(100vh-8rem)] w-full max-w-md items-center px-4 py-10 sm:py-16">
    <div class="w-full rounded-2xl border border-slate-200 bg-white p-6 shadow-xs sm:p-8">
      <div class="mb-6 space-y-2">
        <h1 class="font-display text-2xl font-extrabold tracking-tight text-navy-900">Masuk ke Stuff8</h1>
        <p class="text-sm leading-relaxed text-slate-600">Lanjutkan mengatur inventaris dan negosiasimu.</p>
      </div>
      <form id="signin-form" class="space-y-4">
        <p id="signin-error" class="hidden rounded-lg border border-rose-200 bg-rose-50 p-3 text-sm text-rose-700" role="alert"></p>
        <input id="signin-email" type="email" required autocomplete="email" aria-label="Email" placeholder="Email" class="w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 outline-none focus:border-navy-900" />
        <div class="relative"><input id="signin-password" type="password" required autocomplete="current-password" aria-label="Kata sandi" placeholder="Kata sandi" class="w-full rounded-lg border border-slate-300 py-2.5 pl-3.5 pr-12 text-sm text-slate-900 outline-none focus:border-navy-900" /><button type="button" data-password-toggle="signin-password" aria-label="Tampilkan kata sandi" class="absolute inset-y-0 right-0 px-3 text-slate-500 hover:text-navy-900"><svg data-password-eye="hidden" class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.25 12s3.75-6.75 9.75-6.75S21.75 12 21.75 12 18 18.75 12 18.75 2.25 12 2.25 12Z" /><circle cx="12" cy="12" r="2.75" stroke-width="2" /></svg><svg data-password-eye="visible" class="hidden size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m3 3 18 18M10.584 10.587A2 2 0 0 0 13.414 13.4M9.88 5.3A10.9 10.9 0 0 1 12 5.1c6 0 9.75 6.9 9.75 6.9a18.5 18.5 0 0 1-3.04 3.88M6.23 6.23A18.4 18.4 0 0 0 2.25 12s3.75 6.9 9.75 6.9a10.9 10.9 0 0 0 3.18-.48" /></svg></button></div>
        <button class="w-full rounded-full bg-navy-900 py-3 text-sm font-bold text-white transition-colors hover:bg-navy-800">Masuk</button>
      </form>
      <p class="mt-5 text-center text-sm text-slate-600">Belum punya akun? <a id="signup-link" href="/auth/signup/" class="font-bold text-navy-900 underline underline-offset-4">Buat akun</a></p>
    </div>
  </section>
  <script>
    const authApi = import.meta.env.PUBLIC_AUTH_URL || '/auth-api';
    const authEndpoint = `${authApi.replace(/\/$/, '')}/auth`;
    const returnTo = new URLSearchParams(location.search).get('return_to');
    const safeReturnTo = returnTo?.startsWith('/') ? returnTo : '/inventory/';
    document.getElementById('signup-link')?.setAttribute('href', `/auth/signup/?return_to=${encodeURIComponent(safeReturnTo)}`);
    document.querySelectorAll<HTMLButtonElement>('[data-password-toggle]').forEach(button => {
      const input = document.getElementById(button.dataset.passwordToggle || '') as HTMLInputElement | null;
      button.addEventListener('click', () => { if (!input) return; const reveal = input.type === 'password'; input.type = reveal ? 'text' : 'password'; button.querySelector('[data-password-eye="hidden"]')?.classList.toggle('hidden', reveal); button.querySelector('[data-password-eye="visible"]')?.classList.toggle('hidden', !reveal); button.setAttribute('aria-label', reveal ? 'Sembunyikan kata sandi' : 'Tampilkan kata sandi'); });
    });
    document.getElementById('signin-form')?.addEventListener('submit', async event => {
      event.preventDefault(); const error = document.getElementById('signin-error')!; error.classList.add('hidden');
      const email = (document.getElementById('signin-email') as HTMLInputElement).value; const password = (document.getElementById('signin-password') as HTMLInputElement).value;
      try { const response = await fetch(`${authEndpoint}/login`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ username: email, password }) }); const raw = await response.text(); let data: Record<string, unknown> = {}; try { data = raw ? JSON.parse(raw) : {}; } catch { throw new Error('Layanan Auth mengembalikan respons yang tidak valid. Coba lagi.'); } if (!response.ok || !data.token) throw new Error(String(data.message || data.error || 'Email atau kata sandi salah.')); localStorage.setItem('stuff8_session', JSON.stringify(data)); location.assign(safeReturnTo); } catch (cause) { error.textContent = cause instanceof Error ? cause.message : 'Gagal masuk. Coba lagi.'; error.classList.remove('hidden'); }
    });
  </script>
</Layout>
