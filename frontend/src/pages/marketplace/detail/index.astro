---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
---

<Layout>
  <div class="mx-auto w-full max-w-5xl px-4 py-5 sm:px-6 lg:px-8">
    <Breadcrumb
      currentId="breadcrumb-current"
      crumbs={[
        { label: 'Beranda', href: '/' },
        { label: 'Pasar', href: '/marketplace/' },
        { label: 'Detail Barang' }
      ]}
    />
    <article id="product-detail" class="mt-4 rounded-2xl border border-navy-100 bg-white p-5 shadow-[0_1px_2px_rgba(15,30,25,0.04)]">Memuat barang…</article>
  </div>
  <script>
    const API = import.meta.env.PUBLIC_MARKETPLACE_URL || '/api/marketplace';
    const STORAGE = import.meta.env.PUBLIC_PHOTOS_URL || '/api';
    const root = document.getElementById('product-detail')!;
    const id = new URLSearchParams(location.search).get('id');
    const escapeHtml = (value: string) => value.replace(/[&<>"']/g, char => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' }[char] || char));
    const photoUrl = (key?: string) => key ? `${STORAGE}/storage/content/${key.split('/').map(encodeURIComponent).join('/')}` : '/images/no-item-image.webp';
    const money = (amount: number) => `Rp ${Number(amount || 0).toLocaleString('id-ID')}`;
    async function load() {
      if (!id) throw new Error('Barang tidak ditemukan.');
      const response = await fetch(`${API}/listings/${encodeURIComponent(id)}`);
      if (!response.ok) throw new Error('Barang tidak tersedia atau sudah ditarik dari marketplace.');
      const item = await response.json();
      const breadcrumbCurrent = document.getElementById('breadcrumb-current');
      if (breadcrumbCurrent) breadcrumbCurrent.textContent = item.title || 'Detail Barang';
      document.title = `${item.title || 'Detail Barang'} - Stuff8`;
      const photos = item.photos?.length ? item.photos : [undefined];
      const authenticated = !!sender()?.id;
      const owner = authenticated && sender()?.id === item.seller_id;
      const returnTo = `${location.pathname}${location.search}`;
      // Negotiation visibility is deliberately public: a prospective buyer can
      // see the current market signal before deciding whether to make an offer.
      const itemBids = await getItemBids(item.id);
      const activeBids = itemBids.filter((bid: any) => !['rejected', 'outbid'].includes(bid.status));
      const bidderCount = new Set(activeBids.map((bid: any) => bid.buyer_id)).size;
      const highestBid = activeBids[0];
      const highestBidAmount = Number(highestBid?.amount || item.asking_price || 0);
      const existingBid = authenticated && !owner ? await getMyBid(item.id, sender()?.id) : undefined;
      const inboxAction = (label: string) => `<a href="/chat/?item=${encodeURIComponent(item.id)}" class="flex w-full items-center justify-between rounded-full bg-brand-600 px-4 py-3 text-sm font-bold text-white shadow-xs hover:bg-brand-700"><span>${label}</span><span class="inline-flex size-7 items-center justify-center rounded-full border border-white/20 text-lg leading-none" aria-hidden="true">→</span><span class="sr-only">Buka di Inbox</span></a>`;
      const bidSummary = highestBid ? `<div class="grid grid-cols-2 gap-3 rounded-xl border border-brand-200 bg-brand-50 p-3 text-xs"><div><p class="text-brand-700">Penawaran tertinggi</p><p class="num mt-1 font-extrabold text-brand-800">${money(highestBid.amount)}</p></div><div><p class="text-brand-700">Penawar aktif</p><p class="num mt-1 font-extrabold text-brand-800">${bidderCount} orang</p></div></div>` : '';
      // Completing a sale happens from the chat page (the Terjual button
      // lives there); the marketplace item never sells itself directly.
      const negotiationAction = owner
        ? `${inboxAction(highestBid ? 'Lihat offer & chat produk ini' : 'Buka Inbox produk ini')}`
        : existingBid
          ? inboxAction(`Sedang nego ${money(existingBid.amount)}`)
          : authenticated
          ? `<button id="start-negotiation" class="w-full rounded-full bg-brand-600 px-4 py-3 text-sm font-bold text-white shadow-xs hover:bg-brand-700">Ajukan offer & nego</button><div id="offer-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/50 p-4 backdrop-blur-xs"><div class="w-full max-w-md space-y-4 rounded-2xl border border-navy-100 bg-white p-6 shadow-xl"><div class="flex items-start justify-between border-b border-navy-100 pb-3"><div><h2 class="font-display text-lg font-bold text-navy-900">Ajukan offer & nego</h2><p class="text-xs text-slate-500">Penawaranmu langsung membuka percakapan dengan pemilik.</p></div><button id="offer-close" type="button" class="text-xl font-bold text-slate-400 hover:text-slate-700" aria-label="Tutup">×</button></div><form id="offer-form" class="space-y-4"><div class="flex items-center justify-between rounded-xl border border-slate-200 bg-slate-50 p-3"><div><span class="block text-[10px] font-bold uppercase tracking-wider text-slate-500">Penawar</span><span class="block text-sm font-bold text-navy-900">${escapeHtml(sender()?.name || sender()?.username || 'Pengguna Stuff8')}</span></div><span class="rounded border border-emerald-200 bg-emerald-100 px-2 py-0.5 text-[10px] font-semibold text-emerald-800">Akun aktif</span></div><div class="space-y-0.5 rounded-xl border border-slate-200 bg-slate-50 p-3"><span class="block text-sm font-bold text-slate-900">${escapeHtml(item.title)}</span><span class="block text-xs font-semibold text-slate-600">Harga buka: ${money(item.asking_price)}</span>${highestBid ? `<span class="mt-1 block text-xs font-bold text-brand-700">Harga tertinggi: ${money(highestBid.amount)}</span>` : ''}</div><div class="space-y-2"><div class="flex items-start justify-between gap-2"><div><label class="block text-xs font-bold text-slate-800">Jumlah penawaran kamu</label><p class="text-[11px] font-medium text-slate-500">Atur dengan stepper atau persentase.</p></div><div class="flex flex-col items-end gap-1"><span id="offer-diff" class="whitespace-nowrap rounded-md border border-slate-300 bg-slate-100 px-2 py-0.5 text-[11px] font-extrabold text-slate-700">Harga pas (0%)</span><span id="offer-formatted" class="whitespace-nowrap rounded-md border border-emerald-200 bg-emerald-50 px-2.5 py-0.5 text-xs font-extrabold text-emerald-600">${money(highestBidAmount)}</span></div></div><div class="flex items-center gap-2"><button id="offer-step-down" type="button" class="rounded-lg border border-slate-300 bg-slate-100 px-3.5 py-2.5 text-xs font-bold text-slate-800 hover:bg-slate-200">− 100rb</button><div class="relative flex-1"><span class="absolute left-3 top-1/2 -translate-y-1/2 text-sm font-bold text-slate-500">Rp</span><input id="offer-amount" inputmode="numeric" required class="w-full rounded-lg border border-slate-300 bg-white py-2 pl-9 pr-3 text-center text-base font-bold text-slate-900 outline-none focus:border-navy-900" value="${highestBidAmount.toLocaleString('id-ID')}" /></div><button id="offer-step-up" type="button" class="rounded-lg border border-slate-300 bg-slate-100 px-3.5 py-2.5 text-xs font-bold text-slate-800 hover:bg-slate-200">+ 100rb</button></div><div class="grid grid-cols-4 gap-1.5 pt-1"><button id="offer-pct-down" type="button" class="rounded-lg border border-slate-200 bg-slate-100 py-2 text-xs font-bold text-slate-700 hover:bg-slate-200">−5%</button><button id="offer-reset" type="button" class="rounded-lg border border-slate-200 bg-slate-100 py-2 text-xs font-bold text-slate-700 hover:bg-slate-200">Harga pas</button><button id="offer-highest" type="button" class="rounded-lg border border-brand-200 bg-brand-50 py-2 text-xs font-bold text-brand-800 hover:bg-brand-100" ${highestBid ? '' : 'disabled'}>Harga tertinggi</button><button id="offer-pct-up" type="button" class="rounded-lg border border-slate-200 bg-slate-100 py-2 text-xs font-bold text-slate-700 hover:bg-slate-200">+5%</button></div></div><div class="flex justify-end gap-3 border-t border-slate-200 pt-3"><button id="offer-cancel" type="button" class="rounded-lg bg-slate-100 px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-200">Batal</button><button type="submit" class="rounded-full bg-brand-600 px-4 py-2 text-sm font-bold text-white shadow-xs hover:bg-brand-700">Kirim penawaran</button></div></form></div></div>`
          : `<a href="/auth/signup/?return_to=${encodeURIComponent(returnTo)}" class="block w-full rounded-full bg-brand-600 px-4 py-3 text-center text-sm font-bold text-white shadow-xs hover:bg-brand-700">Daftar atau masuk untuk membuat offer</a><p class="rounded-lg border border-amber-200 bg-amber-50 p-3 text-xs text-amber-900">Kamu perlu membuat akun atau masuk terlebih dahulu sebelum dapat mengajukan offer dan bernegosiasi.</p>`;
      root.innerHTML = `<div class="grid gap-6 md:grid-cols-2"><div class="space-y-3"><div class="aspect-square overflow-hidden rounded-xl bg-slate-100"><img id="product-photo" src="${photoUrl(photos[0])}" alt="${escapeHtml(item.title)}" class="size-full object-cover" /></div>${photos.length > 1 ? `<div class="flex gap-2 overflow-x-auto">${photos.map((photo: string, index: number) => `<button type="button" data-photo="${index}" class="size-14 shrink-0 overflow-hidden rounded-lg border border-navy-100"><img src="${photoUrl(photo)}" alt="Foto ${index + 1}" class="size-full object-cover" /></button>`).join('')}</div>` : ''}</div><div class="space-y-4"><p class="text-xs font-bold uppercase tracking-wider text-brand-700">${escapeHtml(item.category)} · ${escapeHtml(item.condition)}</p><h1 class="font-display text-2xl font-extrabold tracking-tight text-navy-900">${escapeHtml(item.title)}</h1><div class="flex items-baseline gap-2"><p class="num font-display text-3xl font-extrabold text-brand-700">${money(item.asking_price)}</p><span class="rounded-full bg-brand-50 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide text-brand-700">harga buka</span></div><p class="whitespace-pre-line text-sm leading-relaxed text-slate-600">${escapeHtml(item.description || 'Tanpa deskripsi')}</p><dl class="grid grid-cols-2 gap-3 border-y border-navy-100 py-4 text-xs"><div><dt class="text-slate-500">Pemilik</dt><dd class="mt-1 font-bold text-navy-900">${escapeHtml(item.seller_name || 'Pemilik Stuff8')}</dd></div><div><dt class="text-slate-500">Kondisi</dt><dd class="mt-1 font-bold text-navy-900">${escapeHtml(item.condition)}</dd></div></dl>${bidSummary}${negotiationAction}<p id="negotiation-note" class="hidden rounded-lg border border-amber-200 bg-amber-50 p-3 text-xs text-amber-900">Masuk terlebih dahulu untuk mengirim offer dan mulai negosiasi.</p></div></div>`;
      document.querySelectorAll<HTMLButtonElement>('[data-photo]').forEach(button => button.addEventListener('click', () => { (document.getElementById('product-photo') as HTMLImageElement).src = photoUrl(photos[Number(button.dataset.photo)]); }));
      document.getElementById('start-negotiation')?.addEventListener('click', () => document.getElementById('offer-modal')?.classList.replace('hidden', 'flex'));
      const offerForm = document.getElementById('offer-form') as HTMLFormElement | null;
      const offerInput = document.getElementById('offer-amount') as HTMLInputElement | null;
      const closeOffer = () => document.getElementById('offer-modal')?.classList.replace('flex', 'hidden');
      const offerValue = () => Number(offerInput?.value.replace(/\D/g, '') || 0);
      const setOfferValue = (amount: number) => { if (offerInput) offerInput.value = Math.max(0, amount).toLocaleString('id-ID'); updateOfferSummary(); };
      const updateOfferSummary = () => {
        const amount = offerValue();
        const difference = amount - Number(item.asking_price || 0);
        const percentage = item.asking_price ? Math.round((difference / item.asking_price) * 1000) / 10 : 0;
        const badge = document.getElementById('offer-diff');
        const formatted = document.getElementById('offer-formatted');
        if (formatted) formatted.textContent = money(amount);
        if (!badge) return;
        badge.textContent = difference === 0 ? 'Harga pas (0%)' : `${difference > 0 ? '+' : '−'}${money(Math.abs(difference))} (${percentage > 0 ? '+' : ''}${percentage}%)`;
        badge.className = difference > 0 ? 'whitespace-nowrap rounded-md border border-emerald-300 bg-emerald-100 px-2 py-0.5 text-[11px] font-extrabold text-emerald-800' : difference < 0 ? 'whitespace-nowrap rounded-md border border-rose-300 bg-rose-100 px-2 py-0.5 text-[11px] font-extrabold text-rose-800' : 'whitespace-nowrap rounded-md border border-slate-300 bg-slate-100 px-2 py-0.5 text-[11px] font-extrabold text-slate-700';
      };
      offerInput?.addEventListener('input', () => setOfferValue(offerValue()));
      document.getElementById('offer-step-down')?.addEventListener('click', () => setOfferValue(offerValue() - 100000));
      document.getElementById('offer-step-up')?.addEventListener('click', () => setOfferValue(offerValue() + 100000));
      document.getElementById('offer-pct-down')?.addEventListener('click', () => setOfferValue(offerValue() - Math.round(Number(item.asking_price || 0) * 0.05)));
      document.getElementById('offer-pct-up')?.addEventListener('click', () => setOfferValue(offerValue() + Math.round(Number(item.asking_price || 0) * 0.05)));
      document.getElementById('offer-reset')?.addEventListener('click', () => setOfferValue(Number(item.asking_price || 0)));
      document.getElementById('offer-highest')?.addEventListener('click', () => setOfferValue(highestBidAmount));
      document.getElementById('offer-close')?.addEventListener('click', closeOffer);
      document.getElementById('offer-cancel')?.addEventListener('click', closeOffer);
      if (offerForm) offerForm.onsubmit = async event => {
        event.preventDefault();
        const amount = offerValue();
        if (!amount) return;
        const note = document.getElementById('negotiation-note')!;
        try {
          await createBid(item, amount);
          closeOffer();
          const conversation = await startChat(item, amount);
          location.assign(`/chat/?conversation=${encodeURIComponent(conversation.conversation_id)}`);
        } catch (error: any) {
          note.textContent = error?.message || 'Penawaran belum dapat disimpan. Coba lagi.';
          note.classList.remove('hidden');
        }
      };
    }
    const CHAT = import.meta.env.PUBLIC_CHAT_URL || '/api/chat';
    const BIDDING = import.meta.env.PUBLIC_BIDDING_URL || '/api/bidding';
    let activeConversation: any;
    let websocket: WebSocket | undefined;
    const session = () => { try { return JSON.parse(localStorage.getItem('stuff8_session') || 'null'); } catch { return null; } };
    const sender = () => session()?.user;
    const chatHeaders = () => ({ 'Authorization': `Bearer ${session()?.token}` });
    async function createBid(item: any, amount: number) {
      const user = sender();
      const response = await fetch(`${BIDDING}/bids`, {
        method: 'POST',
        headers: { ...chatHeaders(), 'Content-Type': 'application/json' },
        body: JSON.stringify({
          item_id: item.id,
          buyer_id: user.id,
          buyer_name: user.name || user.username || 'Pengguna Stuff8',
          contact_info: user.email || user.username || user.id,
          amount,
          note: `Offer untuk ${item.title}`
        })
      });
      if (!response.ok) {
        const body = await response.json().catch(() => ({}));
        throw new Error(body.error || body.message || 'Penawaran belum dapat disimpan.');
      }
      return response.json();
    }
    async function getMyBid(itemId: string, buyerId?: string) {
      if (!buyerId) return undefined;
      const response = await fetch(`${BIDDING}/items/${encodeURIComponent(itemId)}/bids?buyer_id=${encodeURIComponent(buyerId)}`);
      if (!response.ok) return undefined;
      const bids = await response.json();
      return bids.find((bid: any) => ['pending', 'interviewing', 'winning'].includes(bid.status));
    }
    async function getItemBids(itemId: string) {
      const response = await fetch(`${BIDDING}/items/${encodeURIComponent(itemId)}/bids`);
      return response.ok ? response.json() : [];
    }
    const renderMessage = (message: any) => {
      const mine = message.sender_id === sender()?.id;
      const attachments = (message.attachments || []).map((file: any) => `<a class="block text-xs underline" target="_blank" href="${STORAGE}/storage/content/${file.key.split('/').map(encodeURIComponent).join('/')}">📎 ${escapeHtml(file.filename)}</a>`).join('');
      return `<div class="flex ${mine ? 'justify-end' : 'justify-start'}"><div class="max-w-[85%] rounded-2xl px-3 py-2 text-sm ${mine ? 'bg-brand-600 text-white' : 'bg-slate-100 text-slate-800'}">${message.offer_amount ? `<p class="mb-1 text-xs font-bold">Offer: ${money(message.offer_amount)}</p>` : ''}${message.body ? `<p>${escapeHtml(message.body)}</p>` : ''}${message.sticker_id ? `<p class="mt-1 text-xs font-bold">${escapeHtml(message.sticker_id.replaceAll('-', ' '))}</p>` : ''}${attachments}</div></div>`;
    };
    async function startChat(item: any, offerAmount?: number) {
      const user = sender();
      if (!user?.id) { document.getElementById('negotiation-note')?.classList.remove('hidden'); return; }
      const response = await fetch(`${CHAT}/conversations?participant_id=${encodeURIComponent(user.id)}`, { headers: chatHeaders() });
      if (!response.ok) throw new Error('Inbox belum dapat dimuat. Coba lagi.');
      const existing = await response.json();
      const productConversations = existing.filter((conversation: any) => conversation.context?.domain === 'marketplace' && conversation.context?.reference_id === item.id);
      activeConversation = productConversations.find((conversation: any) => conversation.participant_ids.includes(item.seller_id));
      if (user.id === item.seller_id && !activeConversation) { const note = document.getElementById('negotiation-note')!; note.textContent = 'Belum ada offer yang masuk untuk barang ini. Saat pembeli mengirim offer, chat akan muncul di sini.'; note.classList.remove('hidden'); return; }
      if (!activeConversation) {
        const created = await fetch(`${CHAT}/conversations`, { method: 'POST', headers: { ...chatHeaders(), 'Content-Type': 'application/json' }, body: JSON.stringify({ participant_ids: [user.id, item.seller_id], kind: 'negotiation', context: { domain: 'marketplace', reference_id: item.id, title: item.title } }) });
        if (!created.ok) throw new Error('Percakapan belum dapat dibuat.');
        activeConversation = await created.json();
      }
      if (offerAmount) await sendChat({ offer_amount: offerAmount, body: `Halo ${item.seller_name || 'pemilik'}, saya mengajukan offer ${money(offerAmount)} untuk ${item.title}.` });
      return activeConversation;
    }
    async function sendChat(payload: any) {
      if (!activeConversation || !sender()?.id) return;
      const response = await fetch(`${CHAT}/conversations/${activeConversation.conversation_id}/messages`, { method: 'POST', headers: { ...chatHeaders(), 'Content-Type': 'application/json' }, body: JSON.stringify({ sender_id: sender().id, ...payload }) });
      if (!response.ok) throw new Error('Pesan offer belum dapat disimpan.');
      return response.json();
    }
    load().catch(error => { root.innerHTML = `<p class="text-rose-700">${escapeHtml(error.message)}</p>`; });
  </script>
</Layout>
