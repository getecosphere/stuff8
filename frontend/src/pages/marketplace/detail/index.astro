---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
---

<Layout>
  <div class="w-full px-4 py-3 sm:px-6 lg:px-8 flex flex-col min-h-0" style="height:calc(100dvh - 4rem)">
    <Breadcrumb
      currentId="breadcrumb-current"
      crumbs={[
        { label: 'Home', href: '/' },
        { label: 'Marketplace', href: '/marketplace/' },
        { label: 'Item Details' }
      ]}
    />
    <article id="product-detail" class="flex-1 min-h-0 overflow-y-auto md:overflow-hidden rounded-2xl border border-navy-100 bg-white p-5 shadow-[0_1px_2px_rgba(15,30,25,0.04)]">
      <div class="grid gap-6 md:grid-cols-2">
        <div class="space-y-3">
          <div class="skeleton aspect-square w-full rounded-xl"></div>
          <div class="flex gap-2"><div class="skeleton size-14 rounded-lg"></div><div class="skeleton size-14 rounded-lg"></div><div class="skeleton size-14 rounded-lg"></div></div>
        </div>
        <div class="space-y-4">
          <div class="skeleton h-3 w-1/3"></div>
          <div class="skeleton h-8 w-3/4"></div>
          <div class="skeleton h-7 w-2/5"></div>
          <div class="skeleton h-3 w-full"></div>
          <div class="skeleton h-3 w-5/6"></div>
          <div class="grid grid-cols-2 gap-3 py-4"><div class="skeleton h-6 w-24"></div><div class="skeleton h-6 w-24"></div></div>
          <div class="skeleton h-11 w-full rounded-full"></div>
        </div>
      </div>
    </article>
  </div>
  <script>
    import { openLightbox } from '../../../lib/lightbox';
    import { marketplaceDetailPath } from '../../../lib/slug';
    import { initSlider } from '../../../lib/slider';
    import { applyMuteToAll, installVideoBehaviors, isVideoKey, videoMarkup, videoThumbMarkup } from '../../../lib/media';

    const API = import.meta.env.PUBLIC_MARKETPLACE_URL || '/api/marketplace';
    const PROFILE = import.meta.env.PUBLIC_PROFILE_URL || '/api';
    const STORAGE = import.meta.env.PUBLIC_STORAGE_URL || '/api';
    const root = document.getElementById('product-detail')!;
    const id = new URLSearchParams(location.search).get('id');
    const escapeHtml = (value: string) => value.replace(/[&<>"']/g, char => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' }[char] || char));
    const detailDesc = (text: string, fallback: string) => {
      const safe = escapeHtml((text || fallback).trim());
      return `<p class="whitespace-pre-line text-sm leading-relaxed text-slate-600">${safe}</p>`;
    };
    const photoUrl = (key?: string) => key ? `${STORAGE}/storage/content/${key.split('/').map(encodeURIComponent).join('/')}` : '/images/no-item-image.webp';
    const thumbPhotoUrl = (key?: string) => key && !isVideoKey(key)
      ? `${STORAGE}/storage/content/${key.replace(/\.[a-z0-9]+$/i, '-thumb.webp').split('/').map(encodeURIComponent).join('/')}`
      : photoUrl(key);
    const money = (amount: number) => `Rp ${Number(amount || 0).toLocaleString('id-ID')}`;
    const setMeta = (nameOrProperty: string, content: string, property = false) => {
      const selector = property ? `meta[property="${nameOrProperty}"]` : `meta[name="${nameOrProperty}"]`;
      let tag = document.head.querySelector<HTMLMetaElement>(selector);
      if (!tag) {
        tag = document.createElement('meta');
        tag.setAttribute(property ? 'property' : 'name', nameOrProperty);
        document.head.appendChild(tag);
      }
      tag.setAttribute('content', content);
    };
    const applySeo = (item: any, prettyPath: string) => {
      const prettyUrl = `${location.origin}${prettyPath}`;
      const imageUrl = item.photos?.[0] ? photoUrl(item.photos[0]) : '';
      const fallbackPhoto = (item.photos || []).find((key: string) => !isVideoKey(key));
      const ogImage = fallbackPhoto ? photoUrl(fallbackPhoto) : imageUrl || '/images/no-item-image.webp';
      const metaTitle = `${item.title || 'Item Details'} — ${money(item.asking_price)} · Stuff8`;
      const metaDescription = (item.description || `Check ${item.title || 'this item'} on the Stuff8 Marketplace.`).slice(0, 160);
      document.title = metaTitle;
      setMeta('description', metaDescription);
      setMeta('robots', 'index, follow');
      setMeta('og:title', metaTitle, true);
      setMeta('og:description', metaDescription, true);
      setMeta('og:type', 'product', true);
      setMeta('og:url', prettyUrl, true);
      setMeta('og:image', ogImage, true);
      setMeta('og:image:secure_url', ogImage, true);
      setMeta('og:price:amount', String(Number(item.asking_price) || 0), true);
      setMeta('og:price:currency', 'IDR', true);
      setMeta('twitter:title', metaTitle);
      setMeta('twitter:description', metaDescription);
      setMeta('twitter:image', ogImage);
      setMeta('title', metaTitle);
      setMeta('description', metaDescription);
      setMeta('image', ogImage);
      const canonical = document.head.querySelector<HTMLLinkElement>('link[rel="canonical"]');
      if (canonical) canonical.href = prettyUrl;
    };
    const shareListing = async (item: any, prettyPath: string) => {
      const shareUrl = `${location.origin}${prettyPath}`;
      const shareData = {
        title: `${item.title} — ${money(item.asking_price)} · Stuff8`,
        text: item.description ? item.description.slice(0, 120) : `${item.title} on the Stuff8 Marketplace`,
        url: shareUrl
      };
      if (navigator.share) {
        try { await navigator.share(shareData); return; } catch { /* user cancelled */ }
      }
      try {
        await navigator.clipboard.writeText(shareUrl);
        window.stuff8Toast?.('Item link copied. Share it with your friends!', { variant: 'success', title: 'Link copied' });
      } catch {
        window.prompt('Copy item link:', shareUrl);
      }
    };
    async function load() {
      if (!id) throw new Error('Item not found.');
      const response = await fetch(`${API}/listings/${encodeURIComponent(id)}`);
      if (!response.ok) throw new Error('Item unavailable or has been removed from the marketplace.');
      const item = await response.json();
      const prettyPath = marketplaceDetailPath(item);
      if (location.pathname !== prettyPath) history.replaceState(null, '', prettyPath);
      const breadcrumbCurrent = document.getElementById('breadcrumb-current');
      if (breadcrumbCurrent) breadcrumbCurrent.textContent = item.title || 'Item Details';
      applySeo(item, prettyPath);
      const photos = item.photos?.length ? item.photos : [undefined];
      // Seller's default Cash-on-Delivery meeting point (per-user, from the
      // profile domain). Public endpoint; buyers see where to meet the owner.
      let codLocation = '';
      try {
        const profileResponse = await fetch(`${PROFILE}/users/${encodeURIComponent(item.seller_id)}`);
        if (profileResponse.ok) {
          const sellerProfile = await profileResponse.json();
          codLocation = sellerProfile.codLocation || '';
        }
      } catch { /* profile unreachable — hide the COD card */ }
      const codCard = codLocation
        ? `<div class="mt-3 rounded-xl border border-emerald-200 bg-emerald-50 p-3"><div class="flex items-center gap-1.5 text-xs font-bold text-emerald-800"><svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"/></svg>Meet for Cash on Delivery</div><p class="mt-1 text-xs text-emerald-900">The owner meets buyers at this location for COD.</p><a href="${escapeHtml(codLocation)}" target="_blank" rel="noopener" class="mt-2 inline-flex w-full items-center justify-center gap-1.5 rounded-full bg-emerald-600 px-4 py-2 text-xs font-bold text-white hover:bg-emerald-700">Open meeting point in Google Maps</a></div>`
        : '';

      const authenticated = !!sender()?.id;
      const owner = authenticated && sender()?.id === item.seller_id;
      const returnTo = `${location.pathname}${location.search}`;
      // Negotiation visibility is deliberately public: a prospective buyer can
      // see the current market signal before deciding whether to make an offer.
      const itemBids = await getItemBids(item.id);
      const activeBids = itemBids.filter((bid: any) => !['rejected', 'outbid'].includes(bid.status));
      const bidderCount = new Set(activeBids.map((bid: any) => bid.buyer_id)).size;
      const highestBid = activeBids[0];
      const highestBidAmount = Number(highestBid?.amount || item.asking_price || 0);
      const existingBid = authenticated && !owner ? await getMyBid(item.id, sender()?.id) : undefined;
      const inboxAction = (label: string) => `<a href="/chat/?item=${encodeURIComponent(item.id)}" class="flex w-full items-center justify-between rounded-full bg-brand-600 px-4 py-3 text-sm font-bold text-white shadow-xs hover:bg-brand-700"><span>${label}</span><span class="inline-flex size-7 items-center justify-center rounded-full border border-white/20 text-lg leading-none" aria-hidden="true">→</span><span class="sr-only">Open in Inbox</span></a>`;
      const bidSummary = highestBid ? `<div class="grid grid-cols-2 gap-3 rounded-xl border border-brand-200 bg-brand-50 p-3 text-xs"><div><p class="text-brand-700">Highest offer</p><p class="num mt-1 font-extrabold text-brand-800">${money(highestBid.amount)}</p></div><div><p class="text-brand-700">Active bidders</p><p class="num mt-1 font-extrabold text-brand-800">${bidderCount} ${bidderCount === 1 ? 'bidder' : 'bidders'}</p></div></div>` : '';
      // Completing a sale happens from the chat page (the Terjual button
      // lives there); the marketplace item never sells itself directly.
      const negotiationAction = owner
        ? `${inboxAction(highestBid ? 'View offers & chat about this item' : 'Open this item\'s Inbox')}`
        : existingBid
          ? inboxAction(`Negotiating ${money(existingBid.amount)}`)
          : authenticated
          ? `<button id="start-negotiation" class="w-full rounded-full bg-brand-600 px-4 py-3 text-sm font-bold text-white shadow-xs hover:bg-brand-700">Make an offer & negotiate</button><div id="offer-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-navy-950/50 p-4 backdrop-blur-xs"><div class="w-full max-w-md space-y-4 rounded-2xl border border-navy-100 bg-white p-6 shadow-xl max-h-[calc(100dvh-2rem)] overflow-y-auto"><div class="flex items-start justify-between border-b border-navy-100 pb-3"><div><h2 class="font-display text-lg font-bold text-navy-900">Make an offer & negotiate</h2><p class="text-xs text-slate-500">Your offer opens a conversation with the owner right away.</p></div><button id="offer-close" type="button" class="text-xl font-bold text-slate-400 hover:text-slate-700" aria-label="Close">×</button></div><form id="offer-form" class="space-y-4"><div class="flex items-center justify-between rounded-xl border border-brand-100 bg-brand-50/60 p-3"><div><span class="block text-[10px] font-bold uppercase tracking-wider text-slate-500">Bidder</span><span class="block text-sm font-bold text-navy-900">${escapeHtml(sender()?.name || sender()?.username || 'Stuff8 user')}</span></div><span class="rounded border border-emerald-200 bg-emerald-100 px-2 py-0.5 text-[10px] font-semibold text-emerald-800">Active account</span></div><div class="space-y-0.5 rounded-xl border border-brand-100 bg-brand-50/60 p-3"><span class="block text-sm font-bold text-navy-900">${escapeHtml(item.title)}</span><span class="block text-xs font-semibold text-slate-600">Opening price: ${money(item.asking_price)}</span>${highestBid ? `<span class="mt-1 block text-xs font-bold text-brand-700">Highest price: ${money(highestBid.amount)}</span>` : ''}</div><div class="space-y-2"><div class="flex items-start justify-between gap-2"><div><label class="block text-xs font-bold text-slate-800">Your offer amount</label><p class="text-[11px] font-medium text-slate-500">Adjust with the steppers or percentage.</p></div><div class="flex flex-col items-end gap-1"><span id="offer-diff" class="whitespace-nowrap rounded-md border border-navy-200 bg-navy-100 px-2 py-0.5 text-[11px] font-extrabold text-navy-800">Exact price (0%)</span><span id="offer-formatted" class="whitespace-nowrap rounded-md border border-emerald-200 bg-emerald-50 px-2.5 py-0.5 text-xs font-extrabold text-emerald-600">${money(highestBidAmount)}</span></div></div><div class="flex items-center gap-2"><button id="offer-step-down" type="button" class="rounded-lg border border-navy-200 bg-navy-100 px-3.5 py-2.5 text-xs font-bold text-navy-800 hover:bg-navy-200">− 100K</button><div class="relative flex-1"><span class="absolute left-3 top-1/2 -translate-y-1/2 text-sm font-bold text-slate-500">Rp</span><input id="offer-amount" inputmode="numeric" required class="w-full rounded-lg border border-navy-200 bg-white py-2 pl-9 pr-3 text-center text-base font-bold text-navy-900 outline-none focus:border-brand-500" value="${highestBidAmount.toLocaleString('id-ID')}" /></div><button id="offer-step-up" type="button" class="rounded-lg border border-navy-200 bg-navy-100 px-3.5 py-2.5 text-xs font-bold text-navy-800 hover:bg-navy-200">+ 100K</button></div><div class="grid grid-cols-4 gap-1.5 pt-1"><button id="offer-pct-down" type="button" class="rounded-lg border border-navy-100 bg-navy-100 py-2 text-xs font-bold text-navy-800 hover:bg-navy-200">−5%</button><button id="offer-reset" type="button" class="rounded-lg border border-navy-100 bg-navy-100 py-2 text-xs font-bold text-navy-800 hover:bg-navy-200">Exact price</button><button id="offer-highest" type="button" class="rounded-lg border border-brand-200 bg-brand-50 py-2 text-xs font-bold text-brand-800 hover:bg-brand-100" ${highestBid ? '' : 'disabled'}>Highest price</button><button id="offer-pct-up" type="button" class="rounded-lg border border-navy-100 bg-navy-100 py-2 text-xs font-bold text-navy-800 hover:bg-navy-200">+5%</button></div></div><div class="flex justify-end gap-3 border-t border-slate-200 pt-3"><button id="offer-cancel" type="button" class="rounded-lg bg-navy-100 px-4 py-2 text-sm font-semibold text-navy-800 hover:bg-navy-200">Cancel</button><button type="submit" class="rounded-full bg-brand-600 px-4 py-2 text-sm font-bold text-white shadow-xs hover:bg-brand-700">Send offer</button></div></form></div></div>`
          : `<a href="/auth/signup/?return_to=${encodeURIComponent(returnTo)}" class="block w-full rounded-full bg-brand-600 px-4 py-3 text-center text-sm font-bold text-white shadow-xs hover:bg-brand-700">Sign up or sign in to make an offer</a><p class="rounded-lg border border-amber-200 bg-amber-50 p-3 text-xs text-amber-900">You need to <a href="/auth/signup/?return_to=${encodeURIComponent(returnTo)}" class="font-bold text-amber-900 underline hover:text-amber-950">create an account</a> or <a href="/auth/signin/?return_to=${encodeURIComponent(returnTo)}" class="font-bold text-amber-900 underline hover:text-amber-950">sign in</a> first before you can make an offer and negotiate.</p>`;
      root.innerHTML = `<div class="grid gap-6 md:grid-cols-2 h-full min-h-0"><div data-photo-carousel class="min-w-0 space-y-3"><div data-main-photo role="button" tabindex="0" class="group relative aspect-square w-full cursor-zoom-in overflow-hidden rounded-xl bg-slate-100"><div data-slide-track class="flex size-full" style="transition:transform .35s cubic-bezier(.4,0,.2,1)">${photos.map((photo: string) => isVideoKey(photo)
                ? videoMarkup({ src: photoUrl(photo), className: 'size-full shrink-0 object-cover', label: `${escapeHtml(item.title)} — video` })
                : `<img src="${photoUrl(photo)}" alt="${escapeHtml(item.title)}" class="size-full shrink-0 object-cover transition-transform duration-500 group-hover:scale-[1.03]" />`).join('')}</div><span class="absolute bottom-2.5 right-2.5 inline-flex items-center gap-1 rounded-full bg-navy-950/70 px-2.5 py-1 text-[10px] font-bold text-white backdrop-blur-sm transition-colors group-hover:bg-navy-950"><svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 21h7a2 2 0 0 0 2-2V9.414a1 1 0 0 0-.293-.707l-5.414-5.414A1 1 0 0 0 12.586 3H7a2 2 0 0 0-2 2v11m0 5 4.879-4.879m0 0a3 3 0 1 0 4.243-4.242 3 3 0 0 0-4.243 4.242Z"/></svg>Zoom in</span>${photos.length > 1 ? `<button type="button" data-slide-prev class="absolute left-2 top-1/2 z-10 -translate-y-1/2 rounded-full bg-white/90 p-2 text-slate-800 shadow-sm transition hover:bg-white" aria-label="Previous photo"><svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m15 18-6-6 6-6" /></svg></button><button type="button" data-slide-next class="absolute right-2 top-1/2 z-10 -translate-y-1/2 rounded-full bg-white/90 p-2 text-slate-800 shadow-sm transition hover:bg-white" aria-label="Next photo"><svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m9 18 6-6-6-6" /></svg></button><span class="absolute bottom-2.5 right-2.5 rounded-full bg-navy-950/70 px-2 py-0.5 text-[11px] font-semibold text-white" data-slide-count>1/${photos.length}</span>` : ''}</div>${photos.length > 1 ? `<div class="flex gap-2 overflow-x-auto">${photos.map((photo: string, index: number) => `<button type="button" data-slide-thumb="${index}" class="size-14 shrink-0 overflow-hidden rounded-lg border border-navy-100 transition hover:border-brand-400">${isVideoKey(photo) ? videoThumbMarkup(`Video ${index + 1}`) : `<img src="${thumbPhotoUrl(photo)}" alt="Photo ${index + 1}" class="size-full object-cover" onerror="this.onerror=null;this.src='${photoUrl(photo)}'" />`}</button>`).join('')}</div>` : ''}</div><div class="min-w-0 flex flex-col min-h-0"><div class="shrink-0 space-y-3"><p class="text-xs font-bold uppercase tracking-wider text-brand-700">${escapeHtml(item.category)} · ${escapeHtml(item.condition)}</p><h1 class="font-display text-2xl font-extrabold tracking-tight text-navy-900">${escapeHtml(item.title)}</h1><div class="flex items-baseline justify-between gap-2"><div class="flex items-baseline gap-2"><p class="num font-display text-3xl font-extrabold text-brand-700">${money(item.asking_price)}</p><span class="rounded-full bg-brand-50 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide text-brand-700">opening price</span></div><button type="button" id="share-listing" class="inline-flex shrink-0 items-center gap-1.5 rounded-full border border-navy-100 bg-white px-3 py-1.5 text-xs font-bold text-navy-900 transition-colors hover:bg-slate-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-500" aria-label="Share this item"><svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 1 1 0-2.684m0 2.684l6.632 3.316m-6.632-6 6.632-3.316m0 0a3 3 0 1 0 5.367-2.684 3 3 0 0 0-5.367 2.684Zm0 0a3 3 0 1 1-5.367 2.684 3 3 0 0 1 5.367-2.684Z" /></svg><span>Share</span></button></div></div><div class="flex-1 min-h-0 overflow-y-auto my-3">${detailDesc(item.description, 'No description')}</div><div class="shrink-0 space-y-3 border-t border-navy-100 pt-3"><dl class="grid grid-cols-2 gap-3 text-xs"><div><dt class="text-slate-500">Owner</dt><dd class="mt-1 font-bold text-navy-900">${escapeHtml(item.seller_name || 'Stuff8 owner')}</dd></div><div><dt class="text-slate-500">Condition</dt><dd class="mt-1 font-bold text-navy-900">${escapeHtml(item.condition)}</dd></div></dl>${codCard}${bidSummary}${negotiationAction}<p id="negotiation-note" class="hidden rounded-lg border border-amber-200 bg-amber-50 p-3 text-xs text-amber-900">Sign in first to send an offer and start negotiating.</p></div></div></div>`;
      const galleryPhotos = (photos[0] ? photos : [photos[0]]).map((photo: string) => ({ src: photoUrl(photo), alt: `${escapeHtml(item.title)} — photo` }));
      let currentPhoto = 0;
      initSlider(root.querySelector('[data-photo-carousel]')!, {
        onIndexChange: index => {
          currentPhoto = index;
          root.querySelectorAll<HTMLElement>('[data-slide-thumb]').forEach(thumb => {
            const active = Number(thumb.dataset.slideThumb) === index;
            thumb.classList.toggle('border-brand-400', active);
            thumb.classList.toggle('border-navy-100', !active);
          });
        }
      });
      document.querySelector<HTMLElement>('[data-main-photo]')?.addEventListener('click', () => openLightbox(galleryPhotos, currentPhoto));
      document.querySelector<HTMLElement>('[data-main-photo]')?.addEventListener('keydown', event => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          openLightbox(galleryPhotos, currentPhoto);
        }
      });
      installVideoBehaviors();
      applyMuteToAll();
      document.getElementById('share-listing')?.addEventListener('click', () => shareListing(item, prettyPath));
      document.getElementById('start-negotiation')?.addEventListener('click', () => document.getElementById('offer-modal')?.classList.replace('hidden', 'flex'));
      const offerForm = document.getElementById('offer-form') as HTMLFormElement | null;
      const offerInput = document.getElementById('offer-amount') as HTMLInputElement | null;
      const closeOffer = () => document.getElementById('offer-modal')?.classList.replace('flex', 'hidden');
      const offerValue = () => Number(offerInput?.value.replace(/\D/g, '') || 0);
      const setOfferValue = (amount: number) => { if (offerInput) offerInput.value = Math.max(0, amount).toLocaleString('id-ID'); updateOfferSummary(); };
      const updateOfferSummary = () => {
        const amount = offerValue();
        const difference = amount - Number(item.asking_price || 0);
        const percentage = item.asking_price ? Math.round((difference / item.asking_price) * 1000) / 10 : 0;
        const badge = document.getElementById('offer-diff');
        const formatted = document.getElementById('offer-formatted');
        if (formatted) formatted.textContent = money(amount);
        if (!badge) return;
        badge.textContent = difference === 0 ? 'Exact price (0%)' : `${difference > 0 ? '+' : '−'}${money(Math.abs(difference))} (${percentage > 0 ? '+' : ''}${percentage}%)`;
        badge.className = difference > 0 ? 'whitespace-nowrap rounded-md border border-emerald-300 bg-emerald-100 px-2 py-0.5 text-[11px] font-extrabold text-emerald-800' : difference < 0 ? 'whitespace-nowrap rounded-md border border-rose-300 bg-rose-100 px-2 py-0.5 text-[11px] font-extrabold text-rose-800' : 'whitespace-nowrap rounded-md border border-navy-200 bg-navy-100 px-2 py-0.5 text-[11px] font-extrabold text-navy-800';
      };
      offerInput?.addEventListener('input', () => setOfferValue(offerValue()));
      document.getElementById('offer-step-down')?.addEventListener('click', () => setOfferValue(offerValue() - 100000));
      document.getElementById('offer-step-up')?.addEventListener('click', () => setOfferValue(offerValue() + 100000));
      document.getElementById('offer-pct-down')?.addEventListener('click', () => setOfferValue(offerValue() - Math.round(Number(item.asking_price || 0) * 0.05)));
      document.getElementById('offer-pct-up')?.addEventListener('click', () => setOfferValue(offerValue() + Math.round(Number(item.asking_price || 0) * 0.05)));
      document.getElementById('offer-reset')?.addEventListener('click', () => setOfferValue(Number(item.asking_price || 0)));
      document.getElementById('offer-highest')?.addEventListener('click', () => setOfferValue(highestBidAmount));
      document.getElementById('offer-close')?.addEventListener('click', closeOffer);
      document.getElementById('offer-cancel')?.addEventListener('click', closeOffer);
      if (offerForm) offerForm.onsubmit = async event => {
        event.preventDefault();
        const amount = offerValue();
        if (!amount) return;
        const note = document.getElementById('negotiation-note')!;
        try {
          await createBid(item, amount);
          closeOffer();
          const conversation = await startChat(item, amount);
          location.assign(`/chat/?conversation=${encodeURIComponent(conversation.conversation_id)}`);
        } catch (error: any) {
          note.textContent = error?.message || 'Offer could not be saved. Try again.';
          note.classList.remove('hidden');
        }
      };
    }
    const CHAT = import.meta.env.PUBLIC_CHAT_URL || '/api/chat';
    const BIDDING = import.meta.env.PUBLIC_BIDDING_URL || '/api/bidding';
    let activeConversation: any;
    let websocket: WebSocket | undefined;
    const session = () => { try { return JSON.parse(localStorage.getItem('stuff8_session') || 'null'); } catch { return null; } };
    const sender = () => session()?.user;
    const chatHeaders = () => ({ 'Authorization': `Bearer ${session()?.token}` });
    async function createBid(item: any, amount: number) {
      const user = sender();
      const response = await fetch(`${BIDDING}/bids`, {
        method: 'POST',
        headers: { ...chatHeaders(), 'Content-Type': 'application/json' },
        body: JSON.stringify({
          item_id: item.id,
          buyer_id: user.id,
          buyer_name: user.name || user.username || 'Stuff8 user',
          contact_info: user.email || user.username || user.id,
          amount,
          note: `Offer for ${item.title}`
        })
      });
      if (!response.ok) {
        const body = await response.json().catch(() => ({}));
        throw new Error(body.error || body.message || 'Offer could not be saved.');
      }
      return response.json();
    }
    async function getMyBid(itemId: string, buyerId?: string) {
      if (!buyerId) return undefined;
      const response = await fetch(`${BIDDING}/items/${encodeURIComponent(itemId)}/bids?buyer_id=${encodeURIComponent(buyerId)}`);
      if (!response.ok) return undefined;
      const bids = await response.json();
      return bids.find((bid: any) => ['pending', 'interviewing', 'winning'].includes(bid.status));
    }
    async function getItemBids(itemId: string) {
      const response = await fetch(`${BIDDING}/items/${encodeURIComponent(itemId)}/bids`);
      return response.ok ? response.json() : [];
    }
    const renderMessage = (message: any) => {
      const mine = message.sender_id === sender()?.id;
      const attachments = (message.attachments || []).map((file: any) => `<a class="block text-xs underline" target="_blank" href="${STORAGE}/storage/content/${file.key.split('/').map(encodeURIComponent).join('/')}">📎 ${escapeHtml(file.filename)}</a>`).join('');
      return `<div class="flex ${mine ? 'justify-end' : 'justify-start'}"><div class="max-w-[85%] rounded-2xl px-3 py-2 text-sm ${mine ? 'bg-brand-600 text-white' : 'bg-slate-100 text-slate-800'}">${message.offer_amount ? `<p class="mb-1 text-xs font-bold">Offer: ${money(message.offer_amount)}</p>` : ''}${message.body ? `<p>${escapeHtml(message.body)}</p>` : ''}${message.sticker_id ? `<p class="mt-1 text-xs font-bold">${escapeHtml(message.sticker_id.replaceAll('-', ' '))}</p>` : ''}${attachments}</div></div>`;
    };
    async function startChat(item: any, offerAmount?: number) {
      const user = sender();
      if (!user?.id) { document.getElementById('negotiation-note')?.classList.remove('hidden'); return; }
      const response = await fetch(`${CHAT}/conversations?participant_id=${encodeURIComponent(user.id)}`, { headers: chatHeaders() });
      if (!response.ok) throw new Error('Inbox could not be loaded. Try again.');
      const existing = await response.json();
      const productConversations = existing.filter((conversation: any) => conversation.context?.domain === 'marketplace' && conversation.context?.reference_id === item.id);
      activeConversation = productConversations.find((conversation: any) => conversation.participant_ids.includes(item.seller_id));
      if (user.id === item.seller_id && !activeConversation) { const note = document.getElementById('negotiation-note')!; note.textContent = 'No offers for this item yet. When a buyer sends an offer, the chat will appear here.'; note.classList.remove('hidden'); return; }
      if (!activeConversation) {
        const created = await fetch(`${CHAT}/conversations`, { method: 'POST', headers: { ...chatHeaders(), 'Content-Type': 'application/json' }, body: JSON.stringify({ participant_ids: [user.id, item.seller_id], kind: 'negotiation', context: { domain: 'marketplace', reference_id: item.id, title: item.title } }) });
        if (!created.ok) throw new Error('Conversation could not be created.');
        activeConversation = await created.json();
      }
      if (offerAmount) await sendChat({ offer_amount: offerAmount, body: `Hi ${item.seller_name || 'owner'}, I'm placing an offer of ${money(offerAmount)} for ${item.title}.` });
      return activeConversation;
    }
    async function sendChat(payload: any) {
      if (!activeConversation || !sender()?.id) return;
      const response = await fetch(`${CHAT}/conversations/${activeConversation.conversation_id}/messages`, { method: 'POST', headers: { ...chatHeaders(), 'Content-Type': 'application/json' }, body: JSON.stringify({ sender_id: sender().id, ...payload }) });
      if (!response.ok) throw new Error('Offer message could not be saved.');
      return response.json();
    }
    load().catch(error => { root.innerHTML = `<p class="text-rose-700">${escapeHtml(error.message)}</p>`; });
  </script>
</Layout>
