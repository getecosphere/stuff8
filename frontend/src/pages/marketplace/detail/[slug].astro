---
import Layout from '../../../layouts/Layout.astro';
import { slugify, encodeItemToken, marketplaceDetailPath } from '../../../lib/slug';

// Server-rendered (build-time) product head for crawlers and link previews.
// Every public marketplace listing gets a static HTML page at its pretty slug
// with the real title, description, price, image, Open Graph and JSON-LD. The
// interactive detail page (marketplace/detail/index.astro) then takes over via
// an instant client-side redirect, so behaviour and fresh data are unchanged.
//
// The fetch is best-effort: if the marketplace API is unreachable during build
// (e.g. a cold-start deploy), we emit no pages instead of failing the deploy.

const SITE_URL = 'https://stuff8.com';
const PHOTOS_URL = (import.meta.env.PUBLIC_STORAGE_URL || 'https://storage.stuff8.com/api').replace(/\/+$/, '');

interface Listing {
  id: string;
  title?: string;
  description?: string;
  asking_price?: number;
  seller_name?: string;
  condition?: string;
  photos?: string[];
}

const isVideoKey = (key?: string) => typeof key === 'string' && /\.(mp4|webm|m4v|ogv|mov|3gp)([?#].*)?$/i.test(key);
const storageUrl = (key?: string) => key ? `${PHOTOS_URL}/storage/content/${key.split('/').map(encodeURIComponent).join('/')}` : '';
const thumbUrl = (key?: string) => {
  if (!key || isVideoKey(key)) return storageUrl(key);
  return storageUrl(key.replace(/\.[a-z0-9]+$/i, '-thumb.webp'));
};
const money = (amount: number) => `Rp ${Number(amount || 0).toLocaleString('id-ID')}`;
const cleanDescription = (value: string) => String(value || '').replace(/\s+/g, ' ').trim();
const itemCondition = (condition?: string) =>
  /baru|new/i.test(condition || '') ? 'https://schema.org/NewCondition' : 'https://schema.org/UsedCondition';

export async function getStaticPaths() {
  const api = (import.meta.env.PUBLIC_MARKETPLACE_URL || 'https://stuff8.com/api/marketplace').replace(/\/+$/, '');
  const listings: Listing[] = [];
  try {
    const pageSize = 100;
    let page = 1;
    let totalPages = 1;
    do {
      const response = await fetch(`${api}/listings?limit=${pageSize}&page=${page}`, { signal: AbortSignal.timeout(15000) });
      if (!response.ok) break;
      const data = await response.json();
      const items = Array.isArray(data) ? data : data?.listings || [];
      listings.push(...items);
      totalPages = Number(data?.total_pages) || 1;
      page += 1;
    } while (page <= totalPages && page <= 25);
  } catch {
    // API unreachable at build time — SSR fallback handles it at request time.
  }
  const seen = new Set<string>();
  return listings
    .filter((listing) => listing && listing.id && !seen.has(listing.id) && seen.add(listing.id))
    .map((listing) => ({
      params: { slug: `${slugify(listing.title || '')}-${encodeItemToken(listing.id) || listing.id}` },
      props: { listing }
    }));
}

let listing = (Astro.props as { listing?: Listing }).listing;
if (!listing) {
  const api = (import.meta.env.PUBLIC_MARKETPLACE_URL || 'https://stuff8.com/api/marketplace').replace(/\/+$/, '');
  const { slug } = Astro.params;
  const encodedId = slug.split('-').pop() || slug;
  try {
    const response = await fetch(`${api}/listings/${encodeURIComponent(encodedId)}`, { signal: AbortSignal.timeout(8000) });
    if (response.ok) listing = await response.json() as Listing;
  } catch {}
}
if (!listing) {
  return Astro.redirect('/marketplace/');
}
const title = listing.title || 'Item on Stuff8';
const description = (cleanDescription(listing.description) || `Check ${title} on the Stuff8 Marketplace.`).slice(0, 160);
const ogImage = (listing.photos || []).find((key) => !isVideoKey(key)) || (listing.photos || [])[0] || '';
const imageUrl = thumbUrl(ogImage) || new URL('/images/stuff8-social-preview.webp', SITE_URL).toString();
const price = Number(listing.asking_price) || 0;
const prettyPath = marketplaceDetailPath(listing);
const prettyUrl = `${SITE_URL}${prettyPath}`;
const metaTitle = `${title} — ${money(price)} · Stuff8`;

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: title,
    image: imageUrl ? [imageUrl] : [],
    description,
    brand: { '@type': 'Brand', name: listing.seller_name || 'Stuff8' },
    offers: {
      '@type': 'Offer',
      priceCurrency: 'IDR',
      price,
      availability: 'https://schema.org/InStock',
      itemCondition: itemCondition(listing.condition),
      url: prettyUrl
    }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
      { '@type': 'ListItem', position: 2, name: 'Marketplace', item: `${SITE_URL}/marketplace/` },
      { '@type': 'ListItem', position: 3, name: title }
    ]
  }
];
---

<Layout
  title={metaTitle}
  description={description}
  image={imageUrl}
  type="product"
  url={prettyUrl}
  structuredData={structuredData}
  ogPrice={price}
>
  <div class="mx-auto w-full max-w-5xl px-4 py-10">
    <div class="rounded-2xl border border-navy-100 bg-white p-6 text-center shadow-[0_1px_2px_rgba(15,30,25,0.04)]">
      <p class="font-display text-lg font-bold tracking-tight text-navy-900">{title}</p>
      <p class="mt-1 text-sm font-bold text-brand-700">{money(price)}</p>
      <p class="mt-3 text-xs text-slate-500">Preparing the details page…</p>
      <noscript>
        <a href={`/marketplace/detail/?id=${encodeURIComponent(listing.id)}`} class="mt-4 inline-flex items-center justify-center rounded-full bg-brand-600 px-5 py-2.5 text-sm font-bold text-white">Open item details</a>
      </noscript>
    </div>
  </div>
  <script is:inline set:html={`location.replace('/marketplace/detail/?id=' + encodeURIComponent(${JSON.stringify(listing.id)}));`} />
</Layout>
