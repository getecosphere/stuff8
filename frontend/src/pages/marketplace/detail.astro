---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Detail Barang — Marketplace Stuff8" marketplace={true}>
  <div class="mx-auto w-full max-w-5xl px-4 py-5 sm:px-6 lg:px-8">
    <a href="/marketplace/" class="text-xs font-bold text-navy-900 hover:underline">← Kembali ke Marketplace</a>
    <article id="product-detail" class="mt-4 rounded-2xl border border-slate-200 bg-white p-5 shadow-xs">Memuat barang…</article>
  </div>
  <script>
    const API = 'http://127.0.0.1:26374/api/marketplace';
    const STORAGE = import.meta.env.PUBLIC_API_URL || 'http://127.0.0.1:26372/api';
    const root = document.getElementById('product-detail')!;
    const id = new URLSearchParams(location.search).get('id');
    const escapeHtml = (value: string) => value.replace(/[&<>"']/g, char => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' }[char] || char));
    const photoUrl = (key?: string) => key ? `${STORAGE}/storage/content/${key.split('/').map(encodeURIComponent).join('/')}` : '/images/no-item-image.webp';
    const money = (amount: number) => `Rp ${Number(amount || 0).toLocaleString('id-ID')}`;
    async function load() {
      if (!id) throw new Error('Barang tidak ditemukan.');
      const response = await fetch(`${API}/listings/${encodeURIComponent(id)}`);
      if (!response.ok) throw new Error('Barang tidak tersedia atau sudah ditarik dari marketplace.');
      const item = await response.json();
      const photos = item.photos?.length ? item.photos : [undefined];
      root.innerHTML = `<div class="grid gap-6 md:grid-cols-2"><div class="space-y-3"><div class="aspect-square overflow-hidden rounded-xl bg-slate-100"><img id="product-photo" src="${photoUrl(photos[0])}" alt="${escapeHtml(item.title)}" class="size-full object-cover" /></div>${photos.length > 1 ? `<div class="flex gap-2 overflow-x-auto">${photos.map((photo: string, index: number) => `<button type="button" data-photo="${index}" class="size-14 shrink-0 overflow-hidden rounded-lg border border-slate-200"><img src="${photoUrl(photo)}" alt="Foto ${index + 1}" class="size-full object-cover" /></button>`).join('')}</div>` : ''}</div><div class="space-y-4"><p class="text-xs font-bold uppercase tracking-wider text-brand-700">${escapeHtml(item.category)} · ${escapeHtml(item.condition)}</p><h1 class="text-2xl font-extrabold tracking-tight text-navy-900">${escapeHtml(item.title)}</h1><p class="text-2xl font-extrabold text-navy-900">${money(item.asking_price)}</p><p class="whitespace-pre-line text-sm leading-relaxed text-slate-600">${escapeHtml(item.description || 'Tanpa deskripsi')}</p><dl class="grid grid-cols-2 gap-3 border-y border-slate-100 py-4 text-xs"><div><dt class="text-slate-500">Area</dt><dd class="mt-1 font-bold text-slate-800">${escapeHtml(item.general_location || 'Area lokal')}</dd></div><div><dt class="text-slate-500">Kondisi</dt><dd class="mt-1 font-bold text-slate-800">${escapeHtml(item.condition)}</dd></div></dl><button id="start-negotiation" class="w-full rounded-xl bg-navy-900 px-4 py-3 text-sm font-bold text-white shadow-xs hover:bg-navy-800">Ajukan penawaran & nego</button><p id="negotiation-note" class="hidden rounded-lg border border-amber-200 bg-amber-50 p-3 text-xs text-amber-900">Masuk terlebih dahulu untuk mengirim penawaran dan mulai negosiasi.</p></div></div>`;
      document.querySelectorAll<HTMLButtonElement>('[data-photo]').forEach(button => button.addEventListener('click', () => { (document.getElementById('product-photo') as HTMLImageElement).src = photoUrl(photos[Number(button.dataset.photo)]); }));
      document.getElementById('start-negotiation')?.addEventListener('click', () => document.getElementById('negotiation-note')?.classList.remove('hidden'));
    }
    load().catch(error => { root.innerHTML = `<p class="text-rose-700">${escapeHtml(error.message)}</p>`; });
  </script>
</Layout>
