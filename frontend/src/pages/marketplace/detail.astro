---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Detail Barang — Marketplace Stuff8" marketplace={true}>
  <div class="mx-auto w-full max-w-5xl px-4 py-5 sm:px-6 lg:px-8">
    <a href="/marketplace/" class="text-xs font-bold text-navy-900 hover:underline">← Kembali ke Marketplace</a>
    <article id="product-detail" class="mt-4 rounded-2xl border border-slate-200 bg-white p-5 shadow-xs">Memuat barang…</article>
  </div>
  <script>
    const API = 'http://127.0.0.1:26374/api/marketplace';
    const STORAGE = import.meta.env.PUBLIC_API_URL || 'http://127.0.0.1:26372/api';
    const root = document.getElementById('product-detail')!;
    const id = new URLSearchParams(location.search).get('id');
    const escapeHtml = (value: string) => value.replace(/[&<>"']/g, char => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' }[char] || char));
    const photoUrl = (key?: string) => key ? `${STORAGE}/storage/content/${key.split('/').map(encodeURIComponent).join('/')}` : '/images/no-item-image.webp';
    const money = (amount: number) => `Rp ${Number(amount || 0).toLocaleString('id-ID')}`;
    async function load() {
      if (!id) throw new Error('Barang tidak ditemukan.');
      const response = await fetch(`${API}/listings/${encodeURIComponent(id)}`);
      if (!response.ok) throw new Error('Barang tidak tersedia atau sudah ditarik dari marketplace.');
      const item = await response.json();
      const photos = item.photos?.length ? item.photos : [undefined];
      const authenticated = !!sender()?.id;
      const owner = authenticated && sender()?.id === item.seller_id;
      const returnTo = `${location.pathname}${location.search}`;
      const negotiationAction = owner
        ? `<button id="start-negotiation" class="w-full rounded-xl bg-navy-900 px-4 py-3 text-sm font-bold text-white shadow-xs hover:bg-navy-800">Lihat offer & chat produk ini</button>`
        : authenticated
          ? `<button id="start-negotiation" class="w-full rounded-xl bg-navy-900 px-4 py-3 text-sm font-bold text-white shadow-xs hover:bg-navy-800">Ajukan offer & nego</button><form id="offer-form" class="mt-3 hidden gap-2 rounded-xl border border-slate-200 bg-slate-50 p-3"><input id="offer-amount" inputmode="numeric" class="min-w-0 flex-1 rounded-lg border border-slate-200 px-3 py-2 text-sm" placeholder="Nominal offer (Rp)" /><button class="rounded-lg bg-navy-900 px-4 text-sm font-bold text-white">Kirim offer</button></form>`
          : `<a href="/?auth=signup&return_to=${encodeURIComponent(returnTo)}" class="block w-full rounded-xl bg-navy-900 px-4 py-3 text-center text-sm font-bold text-white shadow-xs hover:bg-navy-800">Daftar atau masuk untuk membuat offer</a><p class="rounded-lg border border-amber-200 bg-amber-50 p-3 text-xs text-amber-900">Kamu perlu membuat akun atau masuk terlebih dahulu sebelum dapat mengajukan offer dan bernegosiasi.</p>`;
      root.innerHTML = `<div class="grid gap-6 md:grid-cols-2"><div class="space-y-3"><div class="aspect-square overflow-hidden rounded-xl bg-slate-100"><img id="product-photo" src="${photoUrl(photos[0])}" alt="${escapeHtml(item.title)}" class="size-full object-cover" /></div>${photos.length > 1 ? `<div class="flex gap-2 overflow-x-auto">${photos.map((photo: string, index: number) => `<button type="button" data-photo="${index}" class="size-14 shrink-0 overflow-hidden rounded-lg border border-slate-200"><img src="${photoUrl(photo)}" alt="Foto ${index + 1}" class="size-full object-cover" /></button>`).join('')}</div>` : ''}</div><div class="space-y-4"><p class="text-xs font-bold uppercase tracking-wider text-brand-700">${escapeHtml(item.category)} · ${escapeHtml(item.condition)}</p><h1 class="text-2xl font-extrabold tracking-tight text-navy-900">${escapeHtml(item.title)}</h1><p class="text-2xl font-extrabold text-navy-900">${money(item.asking_price)}</p><p class="whitespace-pre-line text-sm leading-relaxed text-slate-600">${escapeHtml(item.description || 'Tanpa deskripsi')}</p><dl class="grid grid-cols-3 gap-3 border-y border-slate-100 py-4 text-xs"><div><dt class="text-slate-500">Pemilik</dt><dd class="mt-1 font-bold text-slate-800">${escapeHtml(item.seller_name || 'Pemilik Stuff8')}</dd></div><div><dt class="text-slate-500">Area</dt><dd class="mt-1 font-bold text-slate-800">${escapeHtml(item.general_location || 'Area lokal')}</dd></div><div><dt class="text-slate-500">Kondisi</dt><dd class="mt-1 font-bold text-slate-800">${escapeHtml(item.condition)}</dd></div></dl>${negotiationAction}<p id="negotiation-note" class="hidden rounded-lg border border-amber-200 bg-amber-50 p-3 text-xs text-amber-900">Masuk terlebih dahulu untuk mengirim offer dan mulai negosiasi.</p></div></div><section id="chat-panel" class="mt-6 hidden rounded-xl border border-slate-200 bg-slate-50 p-4"><div class="mb-3 flex items-center justify-between"><h2 class="text-sm font-bold text-navy-900">Negosiasi langsung</h2><span class="text-xs text-slate-500">Tersimpan otomatis</span></div><div id="chat-messages" class="max-h-80 space-y-2 overflow-y-auto rounded-lg bg-white p-3"></div><div id="chat-stickers" class="mt-2 flex gap-1 overflow-x-auto"></div><form id="chat-form" class="mt-3 flex gap-2"><input id="chat-body" class="min-w-0 flex-1 rounded-lg border border-slate-200 px-3 py-2 text-sm" placeholder="Tulis pesan" /><input id="chat-file" type="file" class="hidden" /><button id="chat-file-button" type="button" class="rounded-lg border border-slate-200 px-3 text-sm" aria-label="Lampirkan gambar atau dokumen">＋</button><button class="rounded-lg bg-navy-900 px-4 text-sm font-bold text-white">Kirim</button></form></section>`;
      document.querySelectorAll<HTMLButtonElement>('[data-photo]').forEach(button => button.addEventListener('click', () => { (document.getElementById('product-photo') as HTMLImageElement).src = photoUrl(photos[Number(button.dataset.photo)]); }));
      document.getElementById('start-negotiation')?.addEventListener('click', () => owner ? startChat(item) : document.getElementById('offer-form')?.classList.remove('hidden'));
      const offerForm = document.getElementById('offer-form') as HTMLFormElement | null;
      if (offerForm) offerForm.onsubmit = event => { event.preventDefault(); const amount = Number((document.getElementById('offer-amount') as HTMLInputElement).value.replace(/\D/g, '')); if (amount > 0) startChat(item, amount); };
    }
    const CHAT = `${import.meta.env.PUBLIC_CHAT_URL || 'http://127.0.0.1:26377/api'}/chat`;
    let activeConversation: any;
    let websocket: WebSocket | undefined;
    const session = () => { try { return JSON.parse(localStorage.getItem('stuff8_session') || 'null'); } catch { return null; } };
    const sender = () => session()?.user;
    const renderMessage = (message: any) => {
      const mine = message.sender_id === sender()?.id;
      const attachments = (message.attachments || []).map((file: any) => `<a class="block text-xs underline" target="_blank" href="${STORAGE}/storage/content/${file.key.split('/').map(encodeURIComponent).join('/')}">📎 ${escapeHtml(file.filename)}</a>`).join('');
      return `<div class="flex ${mine ? 'justify-end' : 'justify-start'}"><div class="max-w-[85%] rounded-xl px-3 py-2 text-sm ${mine ? 'bg-navy-900 text-white' : 'bg-slate-100 text-slate-800'}">${message.offer_amount ? `<p class="mb-1 text-xs font-bold">Offer: ${money(message.offer_amount)}</p>` : ''}${message.body ? `<p>${escapeHtml(message.body)}</p>` : ''}${message.sticker_id ? `<p class="mt-1 text-xs font-bold">${escapeHtml(message.sticker_id.replaceAll('-', ' '))}</p>` : ''}${attachments}</div></div>`;
    };
    async function startChat(item: any, offerAmount?: number) {
      const user = sender();
      if (!user?.id) { document.getElementById('negotiation-note')?.classList.remove('hidden'); return; }
      const response = await fetch(`${CHAT}/conversations?participant_id=${encodeURIComponent(user.id)}`);
      const existing = response.ok ? await response.json() : [];
      const productConversations = existing.filter((conversation: any) => conversation.context?.domain === 'marketplace' && conversation.context?.reference_id === item.id);
      activeConversation = productConversations.find((conversation: any) => conversation.participant_ids.includes(item.seller_id));
      if (user.id === item.seller_id && !activeConversation) { const note = document.getElementById('negotiation-note')!; note.textContent = 'Belum ada offer yang masuk untuk barang ini. Saat pembeli mengirim offer, chat akan muncul di sini.'; note.classList.remove('hidden'); return; }
      if (!activeConversation) {
        const created = await fetch(`${CHAT}/conversations`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ participant_ids: [user.id, item.seller_id], kind: 'negotiation', context: { domain: 'marketplace', reference_id: item.id, title: item.title } }) });
        if (!created.ok) throw new Error('Percakapan belum dapat dibuat.');
        activeConversation = await created.json();
      }
      document.getElementById('chat-panel')?.classList.remove('hidden');
      if (offerAmount) await sendChat({ offer_amount: offerAmount, body: `Halo ${item.seller_name || 'pemilik'}, saya mengajukan offer ${money(offerAmount)} untuk ${item.title}.` });
      const messagesResponse = await fetch(`${CHAT}/conversations/${activeConversation.conversation_id}/messages?participant_id=${encodeURIComponent(user.id)}`);
      const messages = messagesResponse.ok ? await messagesResponse.json() : [];
      const messagesRoot = document.getElementById('chat-messages')!;
      messagesRoot.innerHTML = messages.map(renderMessage).join('');
      const stickers = await fetch(`${CHAT}/stickers`).then(response => response.ok ? response.json() : { packs: [] });
      document.getElementById('chat-stickers')!.innerHTML = stickers.packs.flatMap((pack: any) => pack.stickers.slice(0, 8)).map((sticker: any) => `<button type="button" data-sticker="${escapeHtml(sticker.id)}" class="shrink-0 rounded-md border border-slate-200 bg-white px-2 py-1 text-xs">${escapeHtml(sticker.label)}</button>`).join('');
      document.querySelectorAll<HTMLButtonElement>('[data-sticker]').forEach(button => button.addEventListener('click', () => sendChat({ sticker_id: button.dataset.sticker })));
      (document.getElementById('chat-form') as HTMLFormElement).onsubmit = event => { event.preventDefault(); const input = document.getElementById('chat-body') as HTMLInputElement; if (input.value.trim()) { sendChat({ body: input.value }); input.value = ''; } };
      document.getElementById('chat-file-button')?.addEventListener('click', () => (document.getElementById('chat-file') as HTMLInputElement).click());
      (document.getElementById('chat-file') as HTMLInputElement).onchange = async event => { const file = (event.target as HTMLInputElement).files?.[0]; if (!file) return; const form = new FormData(); form.append('owner_id', user.id); form.append('file', file); const uploaded = await fetch(`${CHAT}/conversations/${activeConversation.conversation_id}/attachments`, { method: 'POST', body: form }); if (uploaded.ok) sendChat({ attachments: [await uploaded.json()] }); };
      websocket?.close(); websocket = new WebSocket(`${CHAT.replace(/^http/, 'ws')}/conversations/${activeConversation.conversation_id}/ws?user_id=${encodeURIComponent(user.id)}`);
      websocket.onmessage = event => { const message = JSON.parse(event.data); if (!document.getElementById(`message-${message.message_id}`)) { messagesRoot.insertAdjacentHTML('beforeend', `<div id="message-${message.message_id}">${renderMessage(message)}</div>`); messagesRoot.scrollTop = messagesRoot.scrollHeight; } };
    }
    async function sendChat(payload: any) { if (!activeConversation || !sender()?.id) return; await fetch(`${CHAT}/conversations/${activeConversation.conversation_id}/messages`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ sender_id: sender().id, ...payload }) }); }
    load().catch(error => { root.innerHTML = `<p class="text-rose-700">${escapeHtml(error.message)}</p>`; });
  </script>
</Layout>
