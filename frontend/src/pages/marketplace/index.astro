---
import Layout from '../../layouts/Layout.astro';
---

<Layout>
  <div class="mx-auto flex min-h-[calc(100dvh-10rem)] w-full max-w-7xl flex-col px-4 py-5 sm:px-6 lg:px-8">
    <section class="flex min-h-0 flex-1 flex-col gap-3" aria-label="Marketplace">
      <div class="flex flex-wrap items-end justify-between gap-x-3 gap-y-1">
        <h1 class="font-display text-2xl font-extrabold tracking-tight text-navy-900 sm:text-3xl">Pasar Stuff8</h1>
        <p id="marketplace-total" class="shrink-0 pb-1 text-xs font-semibold text-slate-500">Belum ada barang</p>
      </div>

      <div id="marketplace-ticker" class="ticker-mask hidden items-center rounded-full border border-navy-100 bg-white/70 py-2 pl-0 md:flex" aria-hidden="true"></div>

      <div id="marketplace-category-tabs" class="flex items-stretch gap-2 overflow-x-auto pb-1 no-scrollbar" role="tablist" aria-label="Kategori marketplace">
        <!-- Dynamic category showcase rendered here -->
      </div>

      <div class="flex items-center gap-2">
        <label class="relative min-w-0 flex-1">
          <span class="sr-only">Cari barang marketplace</span>
          <svg class="pointer-events-none absolute left-3 top-1/2 size-4 -translate-y-1/2 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" stroke-width="2"/><path stroke-linecap="round" stroke-width="2" d="m16 16 4 4"/></svg>
          <input id="marketplace-search" type="search" autocomplete="off" placeholder="Cari barang" class="min-h-10 w-full rounded-full border border-navy-100 bg-white py-2 pl-9 pr-3 text-sm text-navy-900 outline-none transition-colors placeholder:text-slate-400 focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20" />
        </label>
        <details id="marketplace-view-menu" class="relative shrink-0">
          <summary id="marketplace-view-trigger" aria-label="Pilih mode tampilan marketplace" class="flex size-10 cursor-pointer list-none items-center justify-center rounded-full border border-navy-100 bg-white text-slate-700 marker:hidden focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-500/20 [&::-webkit-details-marker]:hidden"></summary>
          <div class="absolute right-0 z-20 mt-2 flex w-36 justify-around rounded-full border border-navy-100 bg-white p-1.5 shadow-lg" role="group" aria-label="Mode tampilan marketplace">
            <button type="button" data-marketplace-view="list" aria-label="Tampilan daftar" title="Tampilan daftar" class="rounded-full p-2 text-slate-600 hover:bg-brand-50 hover:text-brand-700"><svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-width="2" d="M8 6h12M8 12h12M8 18h12M4 6h.01M4 12h.01M4 18h.01"/></svg></button>
            <button type="button" data-marketplace-view="thumbnail" aria-label="Tampilan thumbnail" title="Tampilan thumbnail" class="rounded-full p-2 text-slate-600 hover:bg-brand-50 hover:text-brand-700"><svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="8" height="7" rx="1" stroke-width="2"/><rect x="13" y="4" width="8" height="7" rx="1" stroke-width="2"/><rect x="3" y="13" width="8" height="7" rx="1" stroke-width="2"/><rect x="13" y="13" width="8" height="7" rx="1" stroke-width="2"/></svg></button>
            <button type="button" data-marketplace-view="card" aria-label="Tampilan kartu" title="Tampilan kartu" class="rounded-full p-2 text-slate-600 hover:bg-brand-50 hover:text-brand-700"><svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2" stroke-width="2"/><path stroke-linecap="round" stroke-width="2" d="M3 15h18M8 9h.01"/></svg></button>
          </div>
        </details>
      </div>

      <div id="marketplace-grid" class="grid grid-cols-1 gap-3 sm:gap-4 md:grid-cols-2 lg:grid-cols-3">
        <!-- Loading skeletons, replaced on first render -->
        <div class="overflow-hidden rounded-2xl border border-navy-100 bg-white"><div class="skeleton h-40 rounded-none"></div><div class="space-y-2 p-4"><div class="skeleton h-3 w-1/3"></div><div class="skeleton h-4 w-3/4"></div><div class="skeleton h-3 w-2/3"></div></div></div>
        <div class="hidden overflow-hidden rounded-2xl border border-navy-100 bg-white md:block"><div class="skeleton h-40 rounded-none"></div><div class="space-y-2 p-4"><div class="skeleton h-3 w-1/3"></div><div class="skeleton h-4 w-3/4"></div><div class="skeleton h-3 w-2/3"></div></div></div>
        <div class="hidden overflow-hidden rounded-2xl border border-navy-100 bg-white md:block"><div class="skeleton h-40 rounded-none"></div><div class="space-y-2 p-4"><div class="skeleton h-3 w-1/3"></div><div class="skeleton h-4 w-3/4"></div><div class="skeleton h-3 w-2/3"></div></div></div>
      </div>
      <nav id="marketplace-pagination" class="hidden items-center justify-between gap-3" aria-label="Navigasi halaman marketplace"></nav>
    </section>
  </div>

  <script>
    import { marketplaceDetailPath } from '../../lib/slug';
    import { applyMuteToAll, installVideoBehaviors, isVideoKey, videoMarkup, thumbImageSrc } from '../../lib/media';
    const API = import.meta.env.PUBLIC_MARKETPLACE_URL || '/api/marketplace';
    const BIDDING_API = import.meta.env.PUBLIC_BIDDING_URL || '/api/bidding';
    const STORAGE = import.meta.env.PUBLIC_PHOTOS_URL || '/api';
    let page = 1;
    let search = new URLSearchParams(location.search).get('q') || '';
    let category = new URLSearchParams(location.search).get('category') || '';
    const marketplaceViewPreferenceKey = () => {
      try {
        const session = JSON.parse(localStorage.getItem('stuff8_session') || 'null');
        return `stuff8_marketplace_view_${session?.user?.id || 'guest'}`;
      } catch {
        return 'stuff8_marketplace_view_guest';
      }
    };
    const savedMarketplaceView = localStorage.getItem(marketplaceViewPreferenceKey());
    let view = savedMarketplaceView === 'list' || savedMarketplaceView === 'thumbnail' || savedMarketplaceView === 'card'
      ? savedMarketplaceView
      : 'thumbnail';
    let meta: any = { listings: [], page: 1, limit: 12, total: 0, total_pages: 1 };
    let categories: Array<{ category: string; count: number }> = [];
    let bidSummaries = new Map<string, { bidder_count: number; highest_bid: number }>();
    let searchTimer: number | undefined;
    const grid = document.getElementById('marketplace-grid')!;
    const pagination = document.getElementById('marketplace-pagination')!;
    const searchInput = document.getElementById('marketplace-search') as HTMLInputElement;
    const viewTrigger = document.getElementById('marketplace-view-trigger')!;
    const viewMenu = document.getElementById('marketplace-view-menu') as HTMLDetailsElement;
    const categoryTabs = document.getElementById('marketplace-category-tabs')!;

    const escapeHtml = (value: string) => value.replace(/[&<>"']/g, char => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' }[char] || char));
    const expandableDesc = (text: string, fallback: string, maxLines: number, extraClasses = '') => {
      const safe = escapeHtml((text || fallback).trim());
      if (safe.length < 100) return `<span class="${extraClasses}">${safe}</span>`;
      return `<span class="desc-wrapper ${extraClasses}"><span class="desc-text line-clamp-${maxLines}">${safe}</span><button type="button" onclick="this.previousElementSibling.classList.contains('line-clamp-${maxLines}')?(this.previousElementSibling.classList.remove('line-clamp-${maxLines}'),this.textContent='Sembunyikan'):(this.previousElementSibling.classList.add('line-clamp-${maxLines}'),this.textContent='Selengkapnya')" class="desc-toggle ml-1 text-[11px] font-bold text-brand-600 hover:underline whitespace-nowrap">Selengkapnya</button></span>`;
    };
    const photoUrl = (key?: string) => key ? `${STORAGE}/storage/content/${key.split('/').map(encodeURIComponent).join('/')}` : '/images/no-item-image.webp';
    const money = (amount: number) => `Rp ${Number(amount || 0).toLocaleString('id-ID')}`;
    const bidSummary = (itemId: string) => {
      const summary = bidSummaries.get(itemId);
      if (!summary?.bidder_count) {
        return '<p class="text-[11px] font-medium text-slate-500">Belum ada penawaran · jadi penawar pertama</p>';
      }
      const bidderLabel = summary.bidder_count === 1 ? '1 penawar' : `${summary.bidder_count} penawar`;
      return `<div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-[11px]"><span class="font-semibold text-slate-500">${bidderLabel}</span><span class="num font-bold text-brand-700">Bid tertinggi ${money(summary.highest_bid)}</span></div>`;
    };
    const detailButton = (href: string) => `<a href="${href}" class="btn-press inline-flex min-h-9 w-full items-center justify-center rounded-full bg-brand-600 px-3 py-1.5 text-[11px] font-bold text-white hover:bg-brand-700">Lihat & tawar <span class="ml-1" aria-hidden="true">→</span></a>`;
    const emptyMarketplace = (title = 'Belum ada barang', message = 'Coba kata kunci lain atau kembali lagi nanti.') => `
      <div class="flex min-h-80 flex-1 flex-col items-center justify-center rounded-2xl border border-navy-100 bg-white px-6 py-10 text-center">
        <div class="mb-4 flex size-28 items-center justify-center rounded-3xl bg-brand-50 sm:size-32">
          <svg class="size-12 text-brand-300 sm:size-14" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15.75 10.5V6a3.75 3.75 0 1 0-7.5 0v4.5m11.356-1.993 1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 0 1-1.12-1.243l1.264-12A1.125 1.125 0 0 1 5.513 7.5h12.974c.576 0 1.059.435 1.119 1.007Z"/></svg>
        </div>
        <h2 class="font-display text-base font-bold text-navy-900">${escapeHtml(title)}</h2>
        <p class="mt-1 max-w-sm text-xs leading-5 text-slate-500">${escapeHtml(message)}</p>
      </div>`;

    const CATEGORY_META: Record<string, { label: string; icon: string }> = {
      '': { label: 'Semua', icon: '<svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="8" height="8" rx="1.5" stroke-width="2"/><rect x="13" y="3" width="8" height="8" rx="1.5" stroke-width="2"/><rect x="3" y="13" width="8" height="8" rx="1.5" stroke-width="2"/><rect x="13" y="13" width="8" height="8" rx="1.5" stroke-width="2"/></svg>' },
      'Electronics': { label: 'Elektronik', icon: '<svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="11" rx="2" stroke-width="2"/><path stroke-linecap="round" stroke-width="2" d="M8 21h8M12 15v6"/></svg>' },
      'Cameras': { label: 'Kamera', icon: '<svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.5 4h-5L7.5 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3.5L14.5 4z"/><circle cx="12" cy="13" r="3" stroke-width="2"/></svg>' },
      'Bicycles': { label: 'Sepeda', icon: '<svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><circle cx="5.5" cy="17.5" r="3.5" stroke-width="2"/><circle cx="18.5" cy="17.5" r="3.5" stroke-width="2"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.5 17.5 9 10h4l3 7.5M9 10h4l1.5-3H11"/></svg>' },
      'Books': { label: 'Buku', icon: '<svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20V4H6.5A2.5 2.5 0 0 0 4 6.5v13z"/><path stroke-linecap="round" stroke-width="2" d="M20 17v3"/></svg>' },
      'Musical Instruments': { label: 'Alat Musik', icon: '<svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3" stroke-width="2"/><circle cx="18" cy="16" r="3" stroke-width="2"/></svg>' },
      'Furniture': { label: 'Furnitur', icon: '<svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="9" width="18" height="6" rx="2" stroke-width="2"/><path stroke-linecap="round" stroke-width="2" d="M5 15v3.5M19 15v3.5M7.5 15v-3h9v3"/></svg>' }
    };
    const FALLBACK_ICON = '<svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.6 13.4 11 3.8H5a2 2 0 0 0-2 2v6l9.6 9.6a2 2 0 0 0 2.8 0l5.2-5.2a2 2 0 0 0 0-2.8z"/><circle cx="7.5" cy="7.5" r="1" stroke-width="2"/></svg>';
    const categoryMeta = (value: string) => CATEGORY_META[value] || { label: value, icon: FALLBACK_ICON };

    function renderCategoryTabs() {
      if (category && !categories.some(entry => entry.category === category)) category = '';
      const total = categories.reduce((sum, entry) => sum + entry.count, 0);
      const renderTab = (value: string, count: number) => {
        const active = category === value;
        const meta = categoryMeta(value);
        return `<button type="button" role="tab" aria-selected="${active}" data-marketplace-category="${escapeHtml(value)}" class="group flex min-w-[5.5rem] shrink-0 flex-col items-center gap-1.5 rounded-2xl border px-3 py-3 transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-500 ${active ? 'border-brand-600 bg-brand-600 text-white shadow-sm' : 'border-navy-100 bg-white text-slate-700 hover:border-brand-300 hover:bg-brand-50'}">
          <span class="flex size-10 items-center justify-center rounded-xl ${active ? 'bg-white/15 text-white' : 'bg-brand-50 text-brand-700 group-hover:bg-brand-100'}">${meta.icon}</span>
          <span class="max-w-full truncate text-xs font-bold">${escapeHtml(meta.label)}</span>
          <span class="num text-[10px] font-semibold ${active ? 'text-brand-100' : 'text-slate-400'}">${count} barang</span>
        </button>`;
      };
      categoryTabs.innerHTML = [
        renderTab('', total),
        ...categories.map(entry => renderTab(entry.category, entry.count))
      ].join('');
    }

    const marketplaceViewIcons: Record<string, string> = {
      list: '<svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-width="2" d="M8 6h12M8 12h12M8 18h12M4 6h.01M4 12h.01M4 18h.01"/></svg>',
      thumbnail: '<svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="8" height="7" rx="1" stroke-width="2"/><rect x="13" y="4" width="8" height="7" rx="1" stroke-width="2"/><rect x="3" y="13" width="8" height="7" rx="1" stroke-width="2"/><rect x="13" y="13" width="8" height="7" rx="1" stroke-width="2"/></svg>',
      card: '<svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2" stroke-width="2"/><path stroke-linecap="round" stroke-width="2" d="M3 15h18M8 9h.01"/></svg>'
    };
    const renderViewTrigger = () => { viewTrigger.innerHTML = marketplaceViewIcons[view] || marketplaceViewIcons.card; };

    const renderTicker = () => {
      const ticker = document.getElementById('marketplace-ticker');
      if (!ticker) return;
      const items = (meta.listings || []).slice(0, 6);
      if (!items.length) { ticker.innerHTML = ''; ticker.style.display = 'none'; return; }
      const row = items.map((item: any) => `<span><span class="font-semibold text-navy-800">${escapeHtml(item.title)}</span><span class="num font-extrabold text-brand-700">${money(item.asking_price)}</span></span>`).join('<span class="mx-4 text-navy-200" aria-hidden="true">·</span>');
      ticker.innerHTML = `<div class="ticker-track pl-6 pr-4 text-[11px] leading-none text-slate-500">${row}${row}</div>`;
      ticker.style.display = '';
    };

    function render() {
      const listings = meta.listings || [];
      (document.getElementById('marketplace-total')!).textContent = meta.total > 0 ? `${meta.total} barang` : 'Belum ada barang';
      renderCategoryTabs();
      renderTicker();
      const classes: Record<string, string> = { list: 'space-y-3', thumbnail: 'grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4', card: 'grid grid-cols-1 gap-3 sm:gap-4 md:grid-cols-2 lg:grid-cols-3' };
      grid.className = listings.length ? (classes[view] || classes.card) : 'flex flex-1';
      renderViewTrigger();

      grid.innerHTML = listings.length ? listings.map((item: any) => {
        const media = isVideoKey(item.photos?.[0])
          ? videoMarkup({ src: photoUrl(item.photos[0]), className: 'size-full object-cover', label: `${escapeHtml(item.title)} — video` })
          : thumbImageSrc(STORAGE, item.photos?.[0] || '', escapeHtml(item.title), 'size-full object-cover');
        const image = media;
        const href = marketplaceDetailPath(item);
        if (view === 'list') return `<article onclick="location.assign('${href}')" class="card-interactive flex gap-3 rounded-2xl border border-navy-100 bg-white p-3 shadow-[0_1px_2px_rgba(15,30,25,0.04)] hover:border-brand-300 hover:shadow-md"><div class="card-img-zoom size-20 shrink-0 overflow-hidden rounded-xl bg-slate-100">${image}</div><div class="min-w-0 flex-1"><p class="truncate text-[11px] font-bold uppercase tracking-wider text-brand-700">${escapeHtml(item.category)}</p><h2 class="truncate text-sm font-bold text-navy-900">${escapeHtml(item.title)}</h2><p class="mt-1 text-xs text-slate-500">${expandableDesc(item.description || '', 'Tanpa deskripsi', 1, 'text-xs text-slate-500 block')}</p><div class="mt-2 flex flex-wrap items-end justify-between gap-2"><div><p class="num text-base font-extrabold text-brand-700">${money(item.asking_price)}</p><div class="mt-1">${bidSummary(item.id)}</div></div><div class="w-28">${detailButton(href)}</div></div></div></article>`;
        if (view === 'thumbnail') return `<article onclick="location.assign('${href}')" class="card-interactive overflow-hidden rounded-2xl border border-navy-100 bg-white shadow-[0_1px_2px_rgba(15,30,25,0.04)] hover:border-brand-300 hover:shadow-md"><div class="card-img-zoom aspect-square bg-slate-100">${image}</div><div class="space-y-2 p-3"><p class="truncate text-[11px] font-bold text-brand-700">${escapeHtml(item.category)}</p><h2 class="mt-0.5 truncate text-sm font-bold text-navy-900">${escapeHtml(item.title)}</h2><p class="num text-sm font-extrabold text-brand-700">${money(item.asking_price)}</p><div class="pt-1">${detailButton(href)}</div></div></article>`;
        return `<article onclick="location.assign('${href}')" class="card-interactive overflow-hidden rounded-2xl border border-navy-100 bg-white shadow-[0_1px_2px_rgba(15,30,25,0.04)] hover:border-brand-300 hover:shadow-lg"><div class="card-img-zoom relative h-40 overflow-hidden bg-slate-100">${image}<span class="num absolute right-3 top-3 rounded-full bg-brand-600 px-3 py-1 text-sm font-extrabold text-white shadow-md">${money(item.asking_price)}</span><span class="absolute left-3 top-3 rounded-full bg-white/95 px-2.5 py-1 text-[10px] font-bold text-brand-700 shadow-xs">OPEN · ${escapeHtml(item.condition || 'Bisa ditawar')}</span></div><div class="space-y-2 p-4"><p class="text-[11px] font-bold uppercase tracking-wider text-brand-700">${escapeHtml(item.category)}</p><h2 class="text-base font-bold text-navy-900">${escapeHtml(item.title)}</h2><p class="text-xs text-slate-500">${expandableDesc(item.description || '', 'Tanpa deskripsi', 2, 'text-xs text-slate-500 block')}</p><div class="border-t border-navy-100 pt-2">${bidSummary(item.id)}</div><div class="pt-1">${detailButton(href)}</div></div></article>`;
      }).join('') : emptyMarketplace(
        search ? `Tidak ada hasil untuk "${search}"` : category ? 'Belum ada barang di kategori ini' : 'Belum ada barang dipajang',
        search
          ? 'Coba kata kunci lain seperti "kamera", "sepeda", atau "buku".'
          : category
            ? 'Lapak di kategori ini masih kosong. Cek kategori lain atau kembali lagi nanti.'
            : 'Jadilah yang pertama menawar barang favoritmu — lapak baru muncul tiap hari.'
      );
      const visible = meta.total_pages > 1;
      pagination.className = visible ? 'flex items-center justify-between gap-3' : 'hidden';
      pagination.innerHTML = visible ? `<button id="page-prev" ${meta.page <= 1 ? 'disabled' : ''} class="min-h-9 rounded-full border border-navy-100 px-3 text-xs font-bold text-slate-700 disabled:opacity-40 hover:bg-brand-50">Sebelumnya</button><span class="text-xs font-semibold text-slate-500">Halaman ${meta.page} dari ${meta.total_pages}</span><button id="page-next" ${meta.page >= meta.total_pages ? 'disabled' : ''} class="min-h-9 rounded-full border border-navy-100 px-3 text-xs font-bold text-slate-700 disabled:opacity-40 hover:bg-brand-50">Berikutnya</button>` : '';
      installVideoBehaviors();
      applyMuteToAll();
      document.getElementById('page-prev')?.addEventListener('click', () => changePage(meta.page - 1));
      document.getElementById('page-next')?.addEventListener('click', () => changePage(meta.page + 1));
    }
    async function load() {
      const params = new URLSearchParams({ page: String(page), limit: '12' });
      if (search) params.set('q', search);
      if (category) params.set('category', category);
      const [response, categoriesResponse] = await Promise.all([
        fetch(`${API}/listings?${params}`),
        fetch(`${API}/categories`)
      ]);
      if (!response.ok) throw new Error('Marketplace belum tersedia.');
      const payload = await response.json();
      meta = Array.isArray(payload) ? { listings: payload, page: 1, limit: 12, total: payload.length, total_pages: 1 } : payload;
      categories = categoriesResponse.ok ? await categoriesResponse.json() : [];
      const itemIds = (meta.listings || []).map((item: any) => item.id).filter(Boolean);
      if (itemIds.length) {
        const summariesResponse = await fetch(`${BIDDING_API}/listing-summaries?item_ids=${encodeURIComponent(itemIds.join(','))}`);
        const summaries = summariesResponse.ok ? await summariesResponse.json() : [];
        bidSummaries = new Map((Array.isArray(summaries) ? summaries : []).map((summary: any) => [summary.item_id, summary]));
      } else {
        bidSummaries = new Map();
      }
      page = meta.page;
      render();
    }
    function changePage(next: number) { if (next >= 1 && next <= meta.total_pages && next !== page) { page = next; load().catch(console.error); } }
    searchInput.addEventListener('input', () => { search = searchInput.value.trim(); page = 1; window.clearTimeout(searchTimer); searchTimer = window.setTimeout(() => load().catch(console.error), 250); });
    categoryTabs.addEventListener('click', event => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-marketplace-category]');
      if (!button) return;
      const nextCategory = button.dataset.marketplaceCategory || '';
      if (nextCategory === category) return;
      category = nextCategory;
      page = 1;
      load().catch(console.error);
    });
    document.querySelectorAll<HTMLButtonElement>('[data-marketplace-view]').forEach(button => button.addEventListener('click', () => { view = button.dataset.marketplaceView || 'card'; localStorage.setItem(marketplaceViewPreferenceKey(), view); viewMenu.removeAttribute('open'); render(); }));
    renderViewTrigger();
    searchInput.value = search;
    load().catch(() => {
      grid.className = 'flex flex-1';
      grid.innerHTML = emptyMarketplace('Marketplace belum tersedia', 'Coba muat kembali beberapa saat lagi.');
    });
  </script>
</Layout>
