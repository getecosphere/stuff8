---
import Layout from '../../layouts/Layout.astro';
---

<Layout>
  <div class="mx-auto flex min-h-[calc(100dvh-10rem)] w-full max-w-7xl flex-col px-4 py-5 sm:px-6 lg:px-8">
    <section class="flex min-h-0 flex-1 flex-col gap-3" aria-label="Marketplace">
      <div class="flex items-end justify-between gap-3">
        <h1 class="page-heading">Temukan barang pilihan</h1>
        <p id="marketplace-total" class="shrink-0 pb-0.5 text-xs font-semibold text-slate-500">Belum ada barang</p>
      </div>

      <div id="marketplace-category-tabs" class="flex gap-2 overflow-x-auto pb-1 no-scrollbar" role="tablist" aria-label="Kategori marketplace">
        <!-- Dynamic category tabs rendered here -->
      </div>

      <div class="flex items-center gap-2">
        <label class="relative min-w-0 flex-1">
          <span class="sr-only">Cari barang marketplace</span>
          <svg class="pointer-events-none absolute left-3 top-1/2 size-4 -translate-y-1/2 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" stroke-width="2"/><path stroke-linecap="round" stroke-width="2" d="m16 16 4 4"/></svg>
          <input id="marketplace-search" type="search" autocomplete="off" placeholder="Cari barang" class="min-h-10 w-full rounded-lg border border-slate-200 bg-white py-2 pl-9 pr-3 text-sm text-slate-900 outline-none transition-colors placeholder:text-slate-400 focus:border-navy-900 focus:ring-2 focus:ring-navy-900/10" />
        </label>
        <details id="marketplace-view-menu" class="relative shrink-0">
          <summary id="marketplace-view-trigger" aria-label="Pilih mode tampilan marketplace" class="flex size-10 cursor-pointer list-none items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-700 marker:hidden focus:outline-none focus-visible:ring-2 focus-visible:ring-navy-900/20 [&::-webkit-details-marker]:hidden"></summary>
          <div class="absolute right-0 z-20 mt-2 flex w-36 justify-around rounded-lg border border-slate-200 bg-white p-1.5 shadow-lg" role="group" aria-label="Mode tampilan marketplace">
            <button type="button" data-marketplace-view="list" aria-label="Tampilan daftar" title="Tampilan daftar" class="rounded-md p-2 text-slate-600 hover:bg-slate-100"><svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-width="2" d="M8 6h12M8 12h12M8 18h12M4 6h.01M4 12h.01M4 18h.01"/></svg></button>
            <button type="button" data-marketplace-view="thumbnail" aria-label="Tampilan thumbnail" title="Tampilan thumbnail" class="rounded-md p-2 text-slate-600 hover:bg-slate-100"><svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="8" height="7" rx="1" stroke-width="2"/><rect x="13" y="4" width="8" height="7" rx="1" stroke-width="2"/><rect x="3" y="13" width="8" height="7" rx="1" stroke-width="2"/><rect x="13" y="13" width="8" height="7" rx="1" stroke-width="2"/></svg></button>
            <button type="button" data-marketplace-view="card" aria-label="Tampilan kartu" title="Tampilan kartu" class="rounded-md p-2 text-slate-600 hover:bg-slate-100"><svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2" stroke-width="2"/><path stroke-linecap="round" stroke-width="2" d="M3 15h18M8 9h.01"/></svg></button>
          </div>
        </details>
      </div>

      <div id="marketplace-grid" class="grid grid-cols-1 gap-3 sm:gap-4 md:grid-cols-2 lg:grid-cols-3"></div>
      <nav id="marketplace-pagination" class="hidden items-center justify-between gap-3" aria-label="Navigasi halaman marketplace"></nav>
    </section>
  </div>

  <script>
    const API = import.meta.env.PUBLIC_MARKETPLACE_URL || '/api/marketplace';
    const STORAGE = import.meta.env.PUBLIC_PHOTOS_URL || '/api';
    let page = 1;
    let search = '';
    let category = '';
    let view = localStorage.getItem('stuff8_marketplace_view') || 'card';
    let meta: any = { listings: [], page: 1, limit: 12, total: 0, total_pages: 1 };
    let categories: Array<{ category: string; count: number }> = [];
    let searchTimer: number | undefined;
    const grid = document.getElementById('marketplace-grid')!;
    const pagination = document.getElementById('marketplace-pagination')!;
    const searchInput = document.getElementById('marketplace-search') as HTMLInputElement;
    const viewTrigger = document.getElementById('marketplace-view-trigger')!;
    const viewMenu = document.getElementById('marketplace-view-menu') as HTMLDetailsElement;
    const categoryTabs = document.getElementById('marketplace-category-tabs')!;

    const escapeHtml = (value: string) => value.replace(/[&<>"']/g, char => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' }[char] || char));
    const photoUrl = (key?: string) => key ? `${STORAGE}/storage/content/${key.split('/').map(encodeURIComponent).join('/')}` : '/images/no-item-image.webp';
    const money = (amount: number) => `Rp ${Number(amount || 0).toLocaleString('id-ID')}`;
    const emptyMarketplace = (title = 'Belum ada barang', message = 'Coba kata kunci lain atau kembali lagi nanti.') => `
      <div class="flex min-h-80 flex-1 flex-col items-center justify-center rounded-2xl border border-slate-200 bg-white px-6 py-10 text-center">
        <img src="/images/empty-marketplace.webp" alt="Lapak marketplace masih kosong" class="mb-4 size-36 object-contain sm:size-40" />
        <h2 class="text-base font-bold text-slate-900">${escapeHtml(title)}</h2>
        <p class="mt-1 max-w-sm text-xs leading-5 text-slate-500">${escapeHtml(message)}</p>
      </div>`;

    function renderCategoryTabs() {
      if (category && !categories.some(entry => entry.category === category)) category = '';
      const total = categories.reduce((sum, entry) => sum + entry.count, 0);
      const renderTab = (value: string, label: string, count: number) => {
        const active = category === value;
        const countLabel = count > 0 ? `<span class="ml-1 ${active ? 'text-slate-300' : 'text-slate-400'}">${count}</span>` : '';
        return `<button type="button" role="tab" aria-selected="${active}" data-marketplace-category="${escapeHtml(value)}" class="shrink-0 min-h-9 rounded-full border px-3 py-1.5 text-xs font-semibold transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-900 ${active ? 'border-navy-900 bg-navy-900 text-white' : 'border-slate-200 bg-white text-slate-700 hover:border-slate-300 hover:bg-slate-50'}">${escapeHtml(label)}${countLabel}</button>`;
      };
      categoryTabs.innerHTML = [
        renderTab('', 'Semua', total),
        ...categories.map(entry => renderTab(entry.category, entry.category, entry.count))
      ].join('');
    }

    function render() {
      const listings = meta.listings || [];
      (document.getElementById('marketplace-total')!).textContent = meta.total > 0 ? `${meta.total} barang` : 'Belum ada barang';
      renderCategoryTabs();
      const classes: Record<string, string> = { list: 'space-y-3', thumbnail: 'grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4', card: 'grid grid-cols-1 gap-3 sm:gap-4 md:grid-cols-2 lg:grid-cols-3' };
      grid.className = listings.length ? (classes[view] || classes.card) : 'flex flex-1';
      const icons: Record<string, string> = {
        list: '<svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-width="2" d="M8 6h12M8 12h12M8 18h12M4 6h.01M4 12h.01M4 18h.01"/></svg>',
        thumbnail: '<svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="8" height="7" rx="1" stroke-width="2"/><rect x="13" y="4" width="8" height="7" rx="1" stroke-width="2"/><rect x="3" y="13" width="8" height="7" rx="1" stroke-width="2"/><rect x="13" y="13" width="8" height="7" rx="1" stroke-width="2"/></svg>',
        card: '<svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2" stroke-width="2"/><path stroke-linecap="round" stroke-width="2" d="M3 15h18M8 9h.01"/></svg>'
      };
      viewTrigger.innerHTML = icons[view] || icons.card;

      grid.innerHTML = listings.length ? listings.map((item: any) => {
        const image = `<img src="${photoUrl(item.photos?.[0])}" alt="${escapeHtml(item.title)}" class="size-full object-cover" />`;
        const href = `/marketplace/detail?id=${encodeURIComponent(item.id)}`;
        if (view === 'list') return `<a href="${href}" class="flex gap-3 rounded-xl border border-slate-200 bg-white p-3 shadow-xs transition hover:border-slate-300"><div class="size-20 shrink-0 overflow-hidden rounded-lg bg-slate-100">${image}</div><div class="min-w-0 flex-1"><p class="truncate text-xs font-semibold uppercase tracking-wider text-brand-700">${escapeHtml(item.category)}</p><h2 class="truncate text-sm font-bold text-slate-900">${escapeHtml(item.title)}</h2><p class="mt-1 line-clamp-1 text-xs text-slate-500">${escapeHtml(item.description || 'Tanpa deskripsi')}</p><p class="mt-2 text-xs font-bold text-navy-900">${money(item.asking_price)}</p></div></a>`;
        if (view === 'thumbnail') return `<a href="${href}" class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-xs transition hover:border-slate-300"><div class="aspect-square bg-slate-100">${image}</div><div class="p-3"><p class="truncate text-xs font-semibold text-brand-700">${escapeHtml(item.category)}</p><h2 class="mt-0.5 truncate text-sm font-bold text-slate-900">${escapeHtml(item.title)}</h2><p class="mt-1 text-xs font-semibold text-slate-600">${money(item.asking_price)}</p></div></a>`;
        return `<a href="${href}" class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-xs transition hover:border-slate-300 hover:shadow-md"><div class="relative h-40 overflow-hidden bg-slate-100">${image}<span class="absolute right-3 top-3 rounded-md bg-navy-900 px-2.5 py-1 text-xs font-bold text-white">${money(item.asking_price)}</span></div><div class="space-y-2 p-4"><p class="text-xs font-semibold uppercase tracking-wider text-brand-700">${escapeHtml(item.category)} · ${escapeHtml(item.condition)}</p><h2 class="text-base font-bold text-slate-900">${escapeHtml(item.title)}</h2><p class="line-clamp-2 text-xs text-slate-600">${escapeHtml(item.description || 'Tanpa deskripsi')}</p><p class="border-t border-slate-100 pt-2 text-xs text-slate-500">${escapeHtml(item.general_location || 'Area lokal')}</p></div></a>`;
      }).join('') : emptyMarketplace();
      const visible = meta.total_pages > 1;
      pagination.className = visible ? 'flex items-center justify-between gap-3' : 'hidden';
      pagination.innerHTML = visible ? `<button id="page-prev" ${meta.page <= 1 ? 'disabled' : ''} class="min-h-9 rounded-lg border border-slate-200 px-3 text-xs font-bold text-slate-700 disabled:opacity-40">Sebelumnya</button><span class="text-xs font-semibold text-slate-500">Halaman ${meta.page} dari ${meta.total_pages}</span><button id="page-next" ${meta.page >= meta.total_pages ? 'disabled' : ''} class="min-h-9 rounded-lg border border-slate-200 px-3 text-xs font-bold text-slate-700 disabled:opacity-40">Berikutnya</button>` : '';
      document.getElementById('page-prev')?.addEventListener('click', () => changePage(meta.page - 1));
      document.getElementById('page-next')?.addEventListener('click', () => changePage(meta.page + 1));
    }
    async function load() {
      const params = new URLSearchParams({ page: String(page), limit: '12' });
      if (search) params.set('q', search);
      if (category) params.set('category', category);
      const [response, categoriesResponse] = await Promise.all([
        fetch(`${API}/listings?${params}`),
        fetch(`${API}/categories`)
      ]);
      if (!response.ok) throw new Error('Marketplace belum tersedia.');
      const payload = await response.json();
      meta = Array.isArray(payload) ? { listings: payload, page: 1, limit: 12, total: payload.length, total_pages: 1 } : payload;
      categories = categoriesResponse.ok ? await categoriesResponse.json() : [];
      page = meta.page;
      render();
    }
    function changePage(next: number) { if (next >= 1 && next <= meta.total_pages && next !== page) { page = next; load().catch(console.error); } }
    searchInput.addEventListener('input', () => { search = searchInput.value.trim(); page = 1; window.clearTimeout(searchTimer); searchTimer = window.setTimeout(() => load().catch(console.error), 250); });
    categoryTabs.addEventListener('click', event => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-marketplace-category]');
      if (!button) return;
      const nextCategory = button.dataset.marketplaceCategory || '';
      if (nextCategory === category) return;
      category = nextCategory;
      page = 1;
      load().catch(console.error);
    });
    document.querySelectorAll<HTMLButtonElement>('[data-marketplace-view]').forEach(button => button.addEventListener('click', () => { view = button.dataset.marketplaceView || 'card'; localStorage.setItem('stuff8_marketplace_view', view); viewMenu.removeAttribute('open'); render(); }));
    load().catch(() => {
      grid.className = 'flex flex-1';
      grid.innerHTML = emptyMarketplace('Marketplace belum tersedia', 'Coba muat kembali beberapa saat lagi.');
    });
  </script>
</Layout>
