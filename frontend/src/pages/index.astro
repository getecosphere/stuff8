    function getBidsForItem(itemId: string): any[] {
      const isDemoItem = itemId.startsWith('demo-') || ['camera', 'bike', 'macbook', 'guitar'].includes(itemId.replace('demo-', ''));
      const backendItemBids = isDemoItem ? [] : bids.filter(b => b.item_id === itemId);
      const sessionItemBids = (demoBids[itemId] || []).map((db, idx) => ({
        id: `demo_bid_${itemId}_${idx}`,
        item_id: itemId,
        buyer_id: `buyer_${idx}`,
        buyer_name: db.buyer_name,
        contact_info: '0812-9876-5432 (WA)',
        amount: db.amount,
        status: 'Accepted'
      }));

      const combined: any[] = [];
      [...sessionItemBids, ...backendItemBids].forEach(b => {
        if (!combined.some(c => c.id === b.id || (c.buyer_name === b.buyer_name && c.amount === b.amount))) {
          combined.push(b);
        }
      });

      return combined.sort((a, b) => (b.amount || 0) - (a.amount || 0));
    }

    let ownershipHistoryStore: Record<string, Array<{
      id: string;
      item_id: string;
      from_owner_id: string;
      from_owner_name: string;
      to_owner_id: string;
      to_owner_name: string;
      price: number;
      transferred_at: string;
      notes: string;
    }>> = {};

    function getOwnershipHistory(itemId: string): any[] {
      if (ownershipHistoryStore[itemId] && ownershipHistoryStore[itemId].length > 0) {
        return ownershipHistoryStore[itemId];
      }
      const key = itemId.replace('demo-', '');
      const item = items.find(i => i.id === itemId) || marketplaceListings.find(m => m.item_id === itemId) || demoItems[key];
      const sellerName = item?.owner_name || 'Penjual Asal (Owner Pertama)';

      const initialRecords: any[] = [{
        id: 'prov_init_' + itemId,
        item_id: itemId,
        from_owner_id: 'original_creator',
        from_owner_name: sellerName,
        to_owner_id: 'seller_id',
        to_owner_name: sellerName,
        price: item?.asking_price || item?.value || 0,
        transferred_at: new Date(Date.now() - 86400000 * 2).toISOString(),
        notes: 'Terdaftar pertama kali di Katalog Inventory & Marketplace'
      }];

      if (item?.is_sold || item?.isSold) {
        initialRecords.push({
          id: 'prov_sold_' + itemId,
          item_id: itemId,
          from_owner_id: 'seller_id',
          from_owner_name: sellerName,
          to_owner_id: item?.buyer_id || 'buyer_1',
          to_owner_name: item?.buyer_name || 'Ahmad Fauzi',
          price: item?.final_price || item?.asking_price || 0,
          transferred_at: item?.sold_at || new Date().toISOString(),
          notes: 'Terjual via Bidding COD & Disetujui Penjual'
        });
      }

      ownershipHistoryStore[itemId] = initialRecords;
      return initialRecords;
    }

    (window as any).openOwnershipHistoryModal = async (itemId: string) => {
      const modal = document.getElementById('modal-ownership-history');
      const titleEl = document.getElementById('ownership-item-title');
      const timelineEl = document.getElementById('ownership-history-timeline');

      if (!modal || !timelineEl) return;

      const key = itemId.replace('demo-', '');
      const item = items.find(i => i.id === itemId) || marketplaceListings.find(m => m.item_id === itemId) || demoItems[key];
      const itemTitle = item ? item.title : `Barang #${itemId}`;
      if (titleEl) titleEl.textContent = itemTitle;

      let records: any[] = [];
      try {
        const res = await fetch(`${MARKETPLACE_API}/listings/${itemId}/ownership-history`);
        if (res.ok) {
          records = await res.json();
        }
      } catch (e) {}

      if (!records || records.length === 0) {
        records = getOwnershipHistory(itemId);
      }

      timelineEl.innerHTML = records.map((rec, idx) => {
        const isLatest = idx === records.length - 1;
        const isSoldRecord = (rec.notes || '').toLowerCase().includes('terjual') || (rec.notes || '').toLowerCase().includes('sold');
        const isInitialRecord = (rec.notes || '').toLowerCase().includes('terdaftar pertama') || (rec.notes || '').toLowerCase().includes('katalog inventory');
        const dateStr = rec.transferred_at ? (new Date(rec.transferred_at).toLocaleString('id-ID', { dateStyle: 'medium', timeStyle: 'short' })) : 'Baru saja';

        return `
          <div class="relative pl-8 pb-4 border-l-2 ${isLatest ? 'border-emerald-500' : 'border-slate-200'} last:pb-0">
            <div class="absolute -left-[10px] top-0 w-5 h-5 rounded-full ${isSoldRecord ? 'bg-emerald-500 ring-4 ring-emerald-100' : 'bg-slate-400'} flex items-center justify-center text-[10px] text-white font-bold">
              ${isSoldRecord ? '✓' : idx + 1}
            </div>
            <div class="p-3.5 rounded-xl ${isSoldRecord ? 'bg-emerald-50/70 border border-emerald-200' : 'bg-slate-50 border border-slate-200'} space-y-2 shadow-2xs">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <span class="text-lg">${isSoldRecord ? '🏷️' : '📍'}</span>
                  <strong class="text-sm ${isSoldRecord ? 'text-emerald-900' : 'text-slate-900'}">${rec.to_owner_name}</strong>
                </div>
                <span class="text-[11px] text-slate-500 font-mono">${dateStr}</span>
              </div>
              <div class="text-xs ${isSoldRecord ? 'text-emerald-700' : 'text-slate-600'} font-semibold">
                Rp ${(rec.price || 0).toLocaleString('id-ID')}
              </div>
              <div class="text-[11px] text-slate-500 pt-1 border-t border-slate-200/60 italic">
                ${rec.notes}
              </div>
            </div>
          </div>
        `;
      }).join('');

      modal.classList.remove('hidden');
    };

