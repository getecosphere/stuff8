      tabAuthSignin?.classList.remove('bg-emerald-500', 'text-slate-950', 'font-bold');
      formAuthSignup?.classList.remove('hidden');
      formAuthSignin?.classList.add('hidden');
    });

    document.getElementById('btn-logout')?.addEventListener('click', () => {
      localStorage.removeItem('stuff8_session');
      localStorage.removeItem('stuff8_wizard_completed');
      currentSession = null;
      updateAuthUIState();
      window.scrollTo({ top: 0, behavior: 'smooth' });
      loadData();
    });

    // Real Sign In Handler (calls Auth Domain Microservice)
    formAuthSignin?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (authSigninError) authSigninError.classList.add('hidden');

      const username = (document.getElementById('signin-username') as HTMLInputElement).value;
      const password = (document.getElementById('signin-password') as HTMLInputElement).value;

      try {
        const res = await fetch(`${AUTH_API}/login`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ username, password })
        });

        const data = await res.json();
        if (res.ok && data.token) {
          currentSession = data;
          localStorage.setItem('stuff8_session', JSON.stringify(data));
          updateAuthUIState();
          closeWizard();
          await loadData();
        } else {
          if (authSigninError) {
            authSigninError.textContent = data.message || data.error || 'Authentication failed. Invalid username or password.';
            authSigninError.classList.remove('hidden');
          }
        }
      } catch (err) {
        if (authSigninError) {
          authSigninError.textContent = 'Failed to connect to Auth Domain service at ' + AUTH_API;
          authSigninError.classList.remove('hidden');
        }
      }
    });

    // Real Sign Up / Registration Handler (calls Auth Domain Microservice)
    formAuthSignup?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (authSignupError) authSignupError.classList.add('hidden');

      const name = (document.getElementById('signup-name') as HTMLInputElement).value;
      const username = (document.getElementById('signup-username') as HTMLInputElement).value;
      const email = (document.getElementById('signup-email') as HTMLInputElement).value;
      const password = (document.getElementById('signup-password') as HTMLInputElement).value;

      try {
        const queryParams = new URLSearchParams({ username, email, password, name });
        const res = await fetch(`${AUTH_API}/register?${queryParams.toString()}`, {
          method: 'POST'
        });

        const data = await res.json();
        if (res.ok && data.token) {
          currentSession = data;
          localStorage.setItem('stuff8_session', JSON.stringify(data));
          updateAuthUIState();
          setWizardStep(2);
        } else {
          if (authSignupError) {
            authSignupError.textContent = data.message || data.error || 'Registration failed. Check password requirements or existing username/email.';
            authSignupError.classList.remove('hidden');
          }
        }
      } catch (err) {
        if (authSignupError) {
          authSignupError.textContent = 'Failed to connect to Auth Domain service at ' + AUTH_API;
          authSignupError.classList.remove('hidden');
        }
      }
    });

    // Wizard Form Step 3 Submit (First Item)
    document.getElementById('wizard-form-first-item')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!currentSession || !currentSession.user) {
        setWizardStep(1);
        return;
      }

      const title = (document.getElementById('w-item-title') as HTMLInputElement).value;
      const category = (document.getElementById('w-item-category') as HTMLSelectElement).value;
      const condition = (document.getElementById('w-item-condition') as HTMLSelectElement).value;
      const description = (document.getElementById('w-item-description') as HTMLTextAreaElement).value;
      const estVal = parseFloat((document.getElementById('w-item-est-value') as HTMLInputElement).value) || 0;
      const location = (document.getElementById('w-item-location') as HTMLInputElement).value;
      const isSellable = (document.getElementById('w-item-sellable') as HTMLInputElement).checked;

      try {
        const res = await fetch(`${INVENTORY_API}/items`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            owner_id: currentSession.user.id,
            title,
            category,
            condition,
            description,
            photos: ['https://images.unsplash.com/photo-1516035069371-29a1b244cc32?w=500&q=80'],
            storage_location: location,
            estimated_value: estVal,
            asking_price: isSellable ? estVal : null,
            sellable: isSellable,
            status: isSellable ? 'sellable' : 'collection'
          })
        });

        if (res.ok) {
          const newItem = await res.json();
          if (isSellable) {
            await fetch(`${MARKETPLACE_API}/sync-item`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                item_id: newItem.id,
                seller_id: currentSession.user.id,
                title: newItem.title,
                description: newItem.description,
                category: newItem.category,
                condition: newItem.condition,
                photos: newItem.photos || [],
                asking_price: estVal,
                general_location: location || 'Local Area',
                sellable: true
              })
            });
          }
        }
      } catch (err) {
        console.error('Wizard first item error:', err);
      }

      localStorage.setItem('stuff8_wizard_completed', 'true');
      closeWizard();
      await loadData();
    });

