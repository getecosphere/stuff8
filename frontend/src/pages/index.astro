  <!-- Modal: Real-time Deals Chat -->
  <div id="modal-chat" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-3 sm:p-4 hidden">
    <div class="bg-white border border-slate-200 rounded-2xl max-w-xl w-full h-[620px] max-h-[92vh] flex flex-col shadow-2xl overflow-hidden relative">
      
      <!-- Chat Header -->
      <div class="p-4 bg-slate-900 text-white flex items-center justify-between border-b border-slate-800 shrink-0">
        <div class="flex items-center gap-3">
          <div class="relative">
            <div id="chat-bidder-avatar" class="w-10 h-10 rounded-full bg-navy-700 text-white font-bold text-base flex items-center justify-center border border-white/20">
              B
            </div>
            <span class="absolute bottom-0 right-0 w-3 h-3 rounded-full bg-emerald-400 border-2 border-slate-900" title="Online"></span>
          </div>
          <div>
            <div class="flex items-center gap-2">
              <h3 id="chat-bidder-name" class="font-bold text-white text-sm sm:text-base">Budi Santoso</h3>
