    // Attach Global Functions
    (window as any).openWizard = openWizard;

    (window as any).toggleSellable = async (id: string) => {
      const item = items.find(i => i.id === id);
      if (!item) return;

      const newSellable = !item.sellable;
      const askingPrice = newSellable ? (item.asking_price || item.estimated_value || 100000) : null;

      try {
        await fetch(`${INVENTORY_API}/items/${id}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            sellable: newSellable,
            asking_price: askingPrice,
            status: newSellable ? 'sellable' : 'collection'
          })
        });

        await fetch(`${MARKETPLACE_API}/sync-item`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            item_id: item.id,
            seller_id: item.owner_id || (currentSession && currentSession.user ? currentSession.user.id : 'user_guest'),
            title: item.title,
            description: item.description,
            category: item.category,
            condition: item.condition,
            photos: item.photos || [],
            asking_price: askingPrice || 0,
            general_location: item.storage_location || 'Area Lokal',
            sellable: newSellable
          })
        });

        await loadData();
      } catch (err) {
        console.error('Failed to toggle sellable state:', err);
      }
    };

    const getBidAmountValue = (): number => {
      const input = document.getElementById('bid-amount') as HTMLInputElement;
      if (!input || !input.value) return 0;
      return parseInt(input.value.replace(/\D/g, ''), 10) || 0;
    };

    const setBidAmountValue = (val: number) => {
      const input = document.getElementById('bid-amount') as HTMLInputElement;
      if (!input) return;
      input.value = val > 0 ? val.toLocaleString('id-ID') : '0';
    };

    const updateBidFormattedDisplay = () => {
      const input = document.getElementById('bid-amount') as HTMLInputElement;
      const fmtEl = document.getElementById('bid-amount-formatted');
      const diffBadgeEl = document.getElementById('bid-diff-badge');

      if (!input || !fmtEl) return;

      const val = getBidAmountValue();
      fmtEl.textContent = `Rp ${val.toLocaleString('id-ID')}`;

      if (diffBadgeEl) {
        const diffPrice = val - currentBidBasePrice;
        if (currentBidBasePrice > 0) {
          const diffPct = (diffPrice / currentBidBasePrice) * 100;
          const roundedPct = Math.round(diffPct * 10) / 10;

          if (diffPrice > 0) {
            const pctStr = roundedPct > 0 ? `+${roundedPct}%` : `${roundedPct}%`;
            diffBadgeEl.textContent = `+Rp ${diffPrice.toLocaleString('id-ID')} (${pctStr})`;
            diffBadgeEl.className = "text-[11px] font-extrabold px-2 py-0.5 rounded-md bg-emerald-100 text-emerald-800 border border-emerald-300 transition-all select-none whitespace-nowrap";
          } else if (diffPrice < 0) {
            const absDiff = Math.abs(diffPrice);
            const pctStr = `${roundedPct}%`;
            diffBadgeEl.textContent = `-Rp ${absDiff.toLocaleString('id-ID')} (${pctStr})`;
            diffBadgeEl.className = "text-[11px] font-extrabold px-2 py-0.5 rounded-md bg-rose-100 text-rose-800 border border-rose-300 transition-all select-none whitespace-nowrap";
          } else {
            diffBadgeEl.textContent = "Harga Pas (0%)";
            diffBadgeEl.className = "text-[11px] font-extrabold px-2 py-0.5 rounded-md bg-slate-100 text-slate-700 border border-slate-300 transition-all select-none whitespace-nowrap";
          }
        } else {
          diffBadgeEl.textContent = "Harga Pas";
          diffBadgeEl.className = "text-[11px] font-extrabold px-2 py-0.5 rounded-md bg-slate-100 text-slate-700 border border-slate-300 transition-all select-none whitespace-nowrap";
        }
      }
    };

    document.getElementById('bid-amount')?.addEventListener('input', (e) => {
      const input = e.target as HTMLInputElement;
      const digits = input.value.replace(/\D/g, '');
      if (digits) {
        const num = parseInt(digits, 10);
        input.value = num.toLocaleString('id-ID');
      } else {
        input.value = '';
      }
      updateBidFormattedDisplay();
    });

    (window as any).openBidModal = (id: string, title: string, price: number) => {
      (document.getElementById('bid-item-id') as HTMLInputElement).value = id;
      document.getElementById('bid-item-title')!.textContent = title;
      
      currentBidBasePrice = price || 0;

      const existingBids = getBidsForItem(id);
      if (existingBids.length > 0) {
        currentHighestBid = Math.max(...existingBids.map(b => b.amount || 0));
      } else {
        currentHighestBid = currentBidBasePrice;
      }

      document.getElementById('bid-asking-price')!.textContent = `Harga Buka: Rp ${price.toLocaleString('id-ID')}` +
        (currentHighestBid > currentBidBasePrice ? ` • Tertinggi: Rp ${currentHighestBid.toLocaleString('id-ID')}` : '');

      // Find existing bidders for this item to ensure 1 offer per user
      const existingBidders = new Set<string>(
        existingBids.map(b => b.buyer_name).filter(Boolean)
      );

      const availableNames = INDONESIAN_NAMES.filter(name => !existingBidders.has(name));
      const chosenName = availableNames.length > 0
        ? availableNames[Math.floor(Math.random() * availableNames.length)]
        : `Penawaran #${existingBidders.size + 1}`;

      document.getElementById('bid-sim-name')!.textContent = chosenName;

      // Default amount is highest bid so far (or base asking price if no bids exist yet)
      setBidAmountValue(currentHighestBid);
      updateBidFormattedDisplay();

      modalBid?.classList.remove('hidden');
    };

    // Steppers and Percentage listeners for Bid Form
    document.getElementById('btn-bid-step-down')?.addEventListener('click', () => {
      const currentVal = getBidAmountValue();
      setBidAmountValue(Math.max(0, currentVal - 100000));
      updateBidFormattedDisplay();
    });

    document.getElementById('btn-bid-step-up')?.addEventListener('click', () => {
      const currentVal = getBidAmountValue();
      setBidAmountValue(currentVal + 100000);
      updateBidFormattedDisplay();
    });

    // 5% Percentage Stepping handlers (Incremental)
    document.getElementById('btn-bid-pct-down')?.addEventListener('click', () => {
      const currentVal = getBidAmountValue() || currentBidBasePrice || 0;
      const step = currentBidBasePrice > 0 ? Math.round(currentBidBasePrice * 0.05) : 100000;
      setBidAmountValue(Math.max(0, currentVal - step));
      updateBidFormattedDisplay();
    });

    document.getElementById('btn-bid-pct-up')?.addEventListener('click', () => {
      const currentVal = getBidAmountValue() || currentBidBasePrice || 0;
      const step = currentBidBasePrice > 0 ? Math.round(currentBidBasePrice * 0.05) : 100000;
      setBidAmountValue(currentVal + step);
      updateBidFormattedDisplay();
    });

    document.getElementById('btn-bid-pct-reset')?.addEventListener('click', () => {
      setBidAmountValue(currentBidBasePrice);
      updateBidFormattedDisplay();
    });

    document.getElementById('btn-bid-highest')?.addEventListener('click', () => {
      setBidAmountValue(currentHighestBid);
      updateBidFormattedDisplay();
    });

    // Real-time Chat & Approved Bids State
    let activeChatBidId: string | null = null;
    let chatPollInterval: any = null;
    let activeVisitorProductTab: string = 'all';
    let activeVisitorChatBidId: string | null = null;
    const localChatMessages: Record<string, Array<{ id: string; sender_id: string; sender_name: string; message: string; created_at: string }>> = {};

    // Chat functions (must be defined before global onclick handlers)
    async function fetchChatMessages(bidId: string) {
      // Handle both inline visitor chat container AND modal chat container
      const modalContainer = document.getElementById('chat-messages-container');
      const inlineContainer = document.getElementById('visitor-inline-messages-container');
      const container = inlineContainer || modalContainer;
      
      if (!container) return;

      let msgList: any[] = [];
      try {
        const res = await fetch(`${BIDDING_API}/bids/${bidId}/messages`);
        if (res.ok) {
          msgList = await res.json();
        }
      } catch (e) {
        // Fallback to local
      }

      if (!msgList || msgList.length === 0) {
        msgList = localChatMessages[bidId] || [];
      } else {
        localChatMessages[bidId] = msgList;
      }

      const currentUserId = currentSession?.user?.id || 'seller_id';

      container.innerHTML = msgList.map(msg => {
        const isMe = msg.sender_id === currentUserId || msg.sender_name?.includes('Penjual') || msg.sender_name === currentSession?.user?.name;
        const timeStr = msg.created_at ? (new Date(msg.created_at).toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' })) : 'Baru saja';

        return `
          <div class="flex flex-col ${isMe ? 'items-end' : 'items-start'} space-y-1">
            <span class="text-[10px] text-slate-400 font-semibold px-1">${isMe ? 'Anda (Penjual)' : msg.sender_name} • ${timeStr}</span>
            <div class="max-w-[82%] px-4 py-2.5 rounded-2xl text-xs leading-relaxed ${
              isMe 
                ? 'bg-navy-900 text-white rounded-tr-none shadow-xs' 
                : 'bg-white text-slate-800 border border-slate-200/90 rounded-tl-none shadow-2xs'
            }">
              ${msg.message}
            </div>
          </div>
        `;
      }).join('');

      container.scrollTop = container.scrollHeight;
    }

    async function sendChatMessage(text: string) {
      if (!activeChatBidId || !text.trim()) return;

      const bidId = activeChatBidId;
      const inputEl = document.getElementById('chat-input-message') as HTMLInputElement;
      if (inputEl) inputEl.value = '';

      const senderId = currentSession?.user?.id || 'seller_id';
      const senderName = currentSession?.user?.name || currentSession?.user?.username || 'Penjual';

      const newMsg = {
        id: 'msg_' + Date.now(),
        bid_id: bidId,
        sender_id: senderId,
        sender_name: senderName,
        message: text,
        created_at: new Date().toISOString()
      };

      if (!localChatMessages[bidId]) localChatMessages[bidId] = [];
      localChatMessages[bidId].push(newMsg);

      // Try sending to backend API
      try {
        await fetch(`${BIDDING_API}/bids/${bidId}/messages`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            sender_id: senderId,
            sender_name: senderName,
            message: text
          })
        });
      } catch (err) {
        console.warn('Backend chat sync fallback to local');
      }

      await fetchChatMessages(bidId);

      // Trigger automatic realistic reply from chosen bidder after 1.2s
      const targetBid = bids.find(b => b.id === bidId);
      const buyerName = targetBid ? targetBid.buyer_name : 'Bidder Pilihan';
      
      setTimeout(async () => {
        if (activeChatBidId === bidId) {
          const replies = [
            `Siap kak! Lokasi COD di mana yang enak? Saya ikut arahan penjual.`,
            `Oke sip, barangnya lengkap dan sesuai deskripsi kan kak? Jam 4 sore ini saya longgar.`,
            `Terima kasih sudah menyetujui tawaran saya kak! Nanti bayarnya langsung cash / QRIS ya.`,
            `Bisa share lokasi pastinya kak? Nanti saya meluncur ke lokasi.`
          ];
          const autoReplyText = replies[Math.floor(Math.random() * replies.length)];
          const replyMsg = {
            id: 'msg_reply_' + Date.now(),
            bid_id: bidId,
            sender_id: targetBid?.buyer_id || 'bidder_id',
            sender_name: buyerName,
            message: autoReplyText,
            created_at: new Date().toISOString()
          };

          localChatMessages[bidId].push(replyMsg);
          try {
            await fetch(`${BIDDING_API}/bids/${bidId}/messages`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                sender_id: targetBid?.buyer_id || 'bidder_id',
                sender_name: buyerName,
                message: autoReplyText
              })
            });
          } catch (e) {}

          if (activeChatBidId === bidId) {
            await fetchChatMessages(bidId);
          }
        }
      }, 1200);
    }

    // Define global functions EARLY to ensure onclick handlers work when HTML is rendered
    (window as any).selectVisitorBidder = (bidId: string) => {
      activeVisitorChatBidId = bidId;
      activeChatBidId = bidId;
      renderApprovedBidsWidget();
    };

    (window as any).sendInlineVisitorMessage = (text: string) => {
      if (!activeVisitorChatBidId) return;
      activeChatBidId = activeVisitorChatBidId;
      sendChatMessage(text);
      const inputEl = document.getElementById('visitor-inline-chat-input') as HTMLInputElement;
      if (inputEl) inputEl.value = '';
    };

    (window as any).switchVisitorProductTab = (itemId: string) => {
      activeVisitorProductTab = itemId;
      renderApprovedBidsWidget();
    };

    // Approved Bids Widget Renderer (For both Dashboard & Visitor Section with Product Tabs)
    function renderApprovedBidsWidget() {
      const container = document.getElementById('approved-bids-container');
      const visitorContainer = document.getElementById('visitor-approved-bids-container');
      const tabsContainer = document.getElementById('visitor-chat-product-tabs');
      const badge = document.getElementById('approved-bids-count-badge');

      const acceptedBids = bids.filter(b => {
        const s = typeof b.status === 'string' ? b.status : Object.keys(b.status || {})[0] || '';
        return s === 'Accepted' || s === 'accepted';
      });

      if (badge) badge.textContent = `${acceptedBids.length} Obrolan Aktif`;

      if (container) {
        if (acceptedBids.length === 0) {
          container.innerHTML = `
            <div class="col-span-full p-6 rounded-xl bg-slate-50 border border-slate-200 text-center space-y-2">
              <p class="text-slate-800 text-xs font-semibold">Belum Ada Penawaran Disetujui</p>
              <p class="text-slate-600 text-[11px] max-w-md mx-auto leading-relaxed">
                Ketika kamu menyetujui penawaran harga dari pembeli di tab "Penawaran & Nego", widget chat realtime akan aktif di sini untuk melakukan pendekatan dan menyepakati transaksi COD.
              </p>
            </div>
          `;
        } else {
          container.innerHTML = acceptedBids.map(bid => renderSingleApprovedBidCard(bid)).join('');
        }
      }

      // Collect active marketplace listings to ensure deals/bids section only shows for active marketplace items
      const activeDemoListings = Object.values(demoItems).filter(item => item.isSellable).map(item => item.id);
      const activeListingItemIds = new Set([
        ...activeDemoListings,
        ...marketplaceListings.map(m => m.item_id || m.id)
      ]);

      // Collect all active bids (strictly synchronized with marketplace item bids)
      const allVisitorDeals: any[] = [];
      activeListingItemIds.forEach(itemId => {
        const itemBids = getBidsForItem(itemId);
        itemBids.forEach(b => {
          allVisitorDeals.push(b);
          if (!bids.some(gb => gb.id === b.id)) bids.push(b);
        });
      });

      // Dynamically hide/show the simulation section based on whether active deals/bids exist
      const demoApprovedSection = document.getElementById('demo-approved-bids-section');
      if (demoApprovedSection) {
        if (allVisitorDeals.length === 0) {
          demoApprovedSection.classList.add('hidden');
        } else {
          demoApprovedSection.classList.remove('hidden');
        }
      }

      // Render Product Tabs for Visitor Section
      if (tabsContainer) {
        if (allVisitorDeals.length === 0) {
          tabsContainer.innerHTML = '';
        } else {
          const itemMap: Record<string, number> = {};
          allVisitorDeals.forEach(d => {
            itemMap[d.item_id] = (itemMap[d.item_id] || 0) + 1;
          });

          const itemIds = Object.keys(itemMap);

          tabsContainer.innerHTML = `
            <button onclick="switchVisitorProductTab('all')" class="px-2.5 sm:px-3.5 py-1.5 rounded-lg border transition-all text-[11px] sm:text-xs font-bold shrink-0 whitespace-nowrap ${
              activeVisitorProductTab === 'all' 
                ? 'bg-navy-900 text-white border-navy-900 shadow-xs' 
                : 'bg-slate-100 text-slate-700 border-slate-200 hover:bg-slate-200'
            }">
              Semua (${allVisitorDeals.length})
            </button>
            ${itemIds.map(itemId => {
              const key = itemId.replace('demo-', '');
              const itemObj = items.find(i => i.id === itemId) || marketplaceListings.find(m => m.item_id === itemId) || demoItems[key];
              const title = itemObj ? itemObj.title : `Produk #${itemId.substring(0, 6)}`;
              // Shorter truncate for mobile
              const shortTitle = title.length > 18 ? title.substring(0, 16) + '...' : title;
              const count = itemMap[itemId];

              return `
                <button onclick="switchVisitorProductTab('${itemId}')" class="px-2.5 sm:px-3.5 py-1.5 rounded-lg border transition-all text-[11px] sm:text-xs font-semibold shrink-0 whitespace-nowrap ${
                  activeVisitorProductTab === itemId 
                    ? 'bg-navy-900 text-white border-navy-900 font-bold shadow-xs' 
                    : 'bg-slate-100 text-slate-700 border-slate-200 hover:bg-slate-200'
                }">
                  ${shortTitle} (${count})
                </button>
              `;
            }).join('')}
          `;
        }
      }

      // Render Visitor Section Deals Master-Detail Layout (Vertical List -> Inline Chat)
      if (visitorContainer) {
        if (allVisitorDeals.length === 0) {
          visitorContainer.className = "grid grid-cols-1 gap-4";
          visitorContainer.innerHTML = `
            <div class="col-span-full p-8 rounded-xl bg-slate-50 border border-slate-200 text-center space-y-3">
              <div class="w-12 h-12 rounded-full bg-white text-slate-600 font-bold text-xl flex items-center justify-center mx-auto border border-slate-200 shadow-2xs">
                💬
              </div>
              <div class="space-y-1 max-w-md mx-auto">
                <h4 class="text-slate-900 font-bold text-sm">Belum Ada Penawaran pada Barang Marketplace</h4>
                <p class="text-slate-600 text-xs leading-relaxed">
                  Alur simulasi ini menggunakan data riil. Silakan klik tombol <strong class="text-emerald-700 font-bold">"Ajukan Penawaran Harga"</strong> pada salah satu barang di marketplace di atas untuk mengirim penawaran dan menguji alur negosiasi & chat realtime per produk!
                </p>
              </div>
            </div>
          `;
        } else {
          const filteredDeals = activeVisitorProductTab === 'all' 
            ? allVisitorDeals 
            : allVisitorDeals.filter(d => d.item_id === activeVisitorProductTab);

          renderVisitorDealsMasterDetail(filteredDeals);
        }
      }
    }

