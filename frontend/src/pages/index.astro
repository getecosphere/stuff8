            authSignupError.textContent = data.message || data.error || 'Registration failed. Check the password requirements or whether the username/email is already registered.';
            authSignupError.classList.remove('hidden');
          }
        }
      } catch (err) {
        if (authSignupError) {
          authSignupError.textContent = 'Failed to connect to the Auth service at ' + AUTH_API;
