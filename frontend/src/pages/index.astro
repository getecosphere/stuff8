    formAuthSignin?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (authSigninError) authSigninError.classList.add('hidden');

      const username = (document.getElementById('signin-username') as HTMLInputElement).value;
      const password = (document.getElementById('signin-password') as HTMLInputElement).value;

      try {
        const res = await fetch(`${AUTH_API}/login`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ username, password })
        });

        const data = await res.json();
        if (res.ok && data.token) {
          currentSession = data;
          data.expires_at = Date.now() + (Number(data.expires_in) || 2592000) * 1000;
          localStorage.setItem('stuff8_session', JSON.stringify(data));
          updateAuthUIState();
          closeWizard();
          const returnTo = new URLSearchParams(location.search).get('return_to');
          if (returnTo?.startsWith('/marketplace/')) { location.assign(returnTo); return; }
          await loadData();
        } else {
          if (authSigninError) {
            authSigninError.textContent = data.message || data.error || 'Sign-in failed. Wrong username or password, please check again.';
            authSigninError.classList.remove('hidden');
          }
        }
      } catch (err) {
        if (authSigninError) {
          authSigninError.textContent = 'Failed to connect to the Auth service at ' + AUTH_API;
          authSigninError.classList.remove('hidden');
        }
      }
