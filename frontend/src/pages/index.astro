    // =================================================================
    // INTERACTIVE ASSET VALUE CALCULATOR
    // =================================================================
    function updateCalculator() {
      const rElec = parseInt((document.getElementById('calc-range-electronics') as HTMLInputElement)?.value || '0');
      const rSport = parseInt((document.getElementById('calc-range-sports') as HTMLInputElement)?.value || '0');
      const rMusic = parseInt((document.getElementById('calc-range-music') as HTMLInputElement)?.value || '0');
      const rOther = parseInt((document.getElementById('calc-range-other') as HTMLInputElement)?.value || '0');

      const valElec = rElec * 7500000;
      const valSport = rSport * 5250000;
      const valMusic = rMusic * 6000000;
      const valOther = rOther * 1200000;

      const total = valElec + valSport + valMusic + valOther;

      const elElec = document.getElementById('calc-val-electronics');
      const elSport = document.getElementById('calc-val-sports');
      const elMusic = document.getElementById('calc-val-music');
      const elOther = document.getElementById('calc-val-other');
      const totalDisplay = document.getElementById('calc-total-display');

      if (elElec) elElec.textContent = `${rElec} barang (Rp ${valElec.toLocaleString('id-ID')})`;
      if (elSport) elSport.textContent = `${rSport} barang (Rp ${valSport.toLocaleString('id-ID')})`;
      if (elMusic) elMusic.textContent = `${rMusic} barang (Rp ${valMusic.toLocaleString('id-ID')})`;
      if (elOther) elOther.textContent = `${rOther} barang (Rp ${valOther.toLocaleString('id-ID')})`;
      if (totalDisplay) totalDisplay.textContent = `Rp ${total.toLocaleString('id-ID')}`;
    }

    ['electronics', 'sports', 'music', 'other'].forEach(key => {
