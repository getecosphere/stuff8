                <div>
                  <span class="text-xs font-semibold text-teal-400 uppercase tracking-wider">${item.category} • ${item.condition}</span>
                  <h3 class="font-bold text-slate-100 text-lg leading-snug">${item.title}</h3>
                  <p class="text-slate-400 text-xs line-clamp-2 mt-1">${item.description}</p>
                </div>

                <button onclick="openBidModal('${item.item_id || item.id}', '${item.title}', ${item.asking_price || 0})" class="w-full py-2.5 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-400 hover:from-emerald-400 hover:to-teal-300 text-slate-950 font-bold text-xs shadow-md transition-all">
                  Place Offer / Bid
                </button>
              </div>
            </div>
          `).join('');
        }
      }

      // Render Bids Queue
      if (listBids) {
        if (bids.length === 0) {
          listBids.innerHTML = `
            <div class="p-12 rounded-2xl bg-slate-900/50 border border-slate-800 text-center space-y-4">
              <div class="w-12 h-12 rounded-2xl bg-amber-500/10 text-amber-400 flex items-center justify-center text-xl mx-auto font-bold">🤝</div>
              <div class="space-y-1">
                <h3 class="text-slate-200 font-bold text-base">No Active Offers or Bids</h3>
                <p class="text-slate-400 text-xs max-w-sm mx-auto leading-relaxed">When buyers submit cash offers on marketplace listings, they will appear here for your decision.</p>
              </div>
            </div>
          `;
        } else {
          listBids.innerHTML = bids.map(bid => {
            const item = items.find(i => i.id === bid.item_id) || marketplaceListings.find(m => m.item_id === bid.item_id);
            const statusStr = typeof bid.status === 'string' ? bid.status : Object.keys(bid.status || {})[0] || 'Pending';
            return `
              <div class="p-5 rounded-2xl bg-slate-900 border border-slate-800 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
                <div class="space-y-1">
                  <span class="text-xs font-bold uppercase tracking-wider text-emerald-400">${item ? item.title : 'Item #' + bid.item_id.substring(0, 8)}</span>
                  <h4 class="font-bold text-slate-100 text-base">Offer: $${bid.amount} <span class="text-xs font-normal text-slate-400">by ${bid.buyer_name}</span></h4>
                  <p class="text-slate-400 text-xs">${bid.note || 'No note provided'}</p>
                  <span class="inline-block text-xs text-slate-400">Contact: <code class="text-slate-200 bg-slate-950 px-1.5 py-0.5 rounded">${bid.contact_info}</code></span>
                </div>

                <div class="flex items-center gap-3">
                  <span class="px-3 py-1 rounded-full text-xs font-bold ${statusStr === 'Accepted' || statusStr === 'accepted' ? 'bg-emerald-500/20 text-emerald-400 border border-emerald-500/30' : 'bg-amber-500/20 text-amber-400 border border-amber-500/30'}">
                    ${statusStr}
                  </span>
                  ${statusStr === 'Pending' || statusStr === 'pending' ? `
                    <button onclick="acceptBid('${bid.id}')" class="px-4 py-1.5 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold text-xs shadow-sm">Accept Offer</button>
                  ` : ''}
                </div>
              </div>
            `;
          }).join('');
        }
      }
    }

    // Attach Global Functions
    (window as any).openWizard = openWizard;

    (window as any).toggleSellable = async (id: string) => {
      const item = items.find(i => i.id === id);
      if (!item) return;

      const newSellable = !item.sellable;
      const askingPrice = newSellable ? (item.asking_price || item.estimated_value || 100) : null;

      try {
        await fetch(`${INVENTORY_API}/items/${id}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            sellable: newSellable,
            asking_price: askingPrice,
            status: newSellable ? 'sellable' : 'collection'
          })
        });

        await fetch(`${MARKETPLACE_API}/sync-item`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            item_id: item.id,
            seller_id: item.owner_id || (currentSession && currentSession.user ? currentSession.user.id : 'user_guest'),
            title: item.title,
            description: item.description,
            category: item.category,
            condition: item.condition,
            photos: item.photos || [],
            asking_price: askingPrice || 0,
            general_location: item.storage_location || 'Local Area',
            sellable: newSellable
          })
        });

        await loadData();
      } catch (err) {
        console.error('Failed to toggle sellable state:', err);
      }
    };

    (window as any).openBidModal = (id: string, title: string, price: number) => {
      (document.getElementById('bid-item-id') as HTMLInputElement).value = id;
      document.getElementById('bid-item-title')!.textContent = title;
      document.getElementById('bid-asking-price')!.textContent = `Asking Price: $${price}`;
      if (currentSession && currentSession.user) {
        (document.getElementById('bid-buyer-name') as HTMLInputElement).value = currentSession.user.name || currentSession.user.username;
        (document.getElementById('bid-contact-info') as HTMLInputElement).value = currentSession.user.email;
      }
      modalBid?.classList.remove('hidden');
    };

    (window as any).acceptBid = async (bidId: string) => {
      try {
        const res = await fetch(`${BIDDING_API}/bids/${bidId}/accept`, {
          method: 'POST'
        });
        if (res.ok) {
          const data = await res.json();
          alert(`Bid of $${data.bid.amount} accepted! Contact buyer at: ${data.bid.contact_info} for Cash on Delivery.`);
          await loadData();
        }
      } catch (err) {
        console.error('Failed to accept bid:', err);
      }
    };

    // Direct Add Item Form
    document.getElementById('form-item')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!currentSession || !currentSession.user) {
        openWizard();
        return;
      }

      const title = (document.getElementById('input-title') as HTMLInputElement).value;
      const category = (document.getElementById('input-category') as HTMLSelectElement).value;
      const condition = (document.getElementById('input-condition') as HTMLSelectElement).value;
      const description = (document.getElementById('input-description') as HTMLTextAreaElement).value;
      const estVal = parseFloat((document.getElementById('input-estimated-value') as HTMLInputElement).value) || 0;
      const location = (document.getElementById('input-storage-location') as HTMLInputElement).value;
      const isSellable = (document.getElementById('input-sellable') as HTMLInputElement).checked;
      const askingPrice = parseFloat((document.getElementById('input-asking-price') as HTMLInputElement).value) || estVal;

      try {
        const res = await fetch(`${INVENTORY_API}/items`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            owner_id: currentSession.user.id,
            title,
            category,
            condition,
            description,
            photos: ['https://images.unsplash.com/photo-1526170375885-4d8ecf77b99f?w=500&q=80'],
            storage_location: location,
            estimated_value: estVal,
            asking_price: isSellable ? askingPrice : null,
            sellable: isSellable,
            status: isSellable ? 'sellable' : 'collection'
          })
        });

        if (res.ok) {
          const newItem = await res.json();

          if (isSellable) {
            await fetch(`${MARKETPLACE_API}/sync-item`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                item_id: newItem.id,
                seller_id: currentSession.user.id,
                title: newItem.title,
                description: newItem.description,
                category: newItem.category,
                condition: newItem.condition,
                photos: newItem.photos || [],
                asking_price: askingPrice,
                general_location: location || 'Local Area',
                sellable: true
              })
            });
          }

          modalItem?.classList.add('hidden');
          (document.getElementById('form-item') as HTMLFormElement).reset();
          askingPriceContainer?.classList.add('hidden');
          await loadData();
        }
      } catch (err) {
        console.error('Failed to create inventory item:', err);
      }
    });

    // Handle Submit Bid Form
    document.getElementById('form-bid')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const itemId = (document.getElementById('bid-item-id') as HTMLInputElement).value;
      const buyerName = (document.getElementById('bid-buyer-name') as HTMLInputElement).value;
      const contactInfo = (document.getElementById('bid-contact-info') as HTMLInputElement).value;
      const amount = parseFloat((document.getElementById('bid-amount') as HTMLInputElement).value) || 0;
      const note = (document.getElementById('bid-note') as HTMLTextAreaElement).value;

      const buyerId = currentSession && currentSession.user ? currentSession.user.id : 'buyer_' + Date.now();

      try {
        const res = await fetch(`${BIDDING_API}/bids`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            item_id: itemId,
            buyer_id: buyerId,
            buyer_name: buyerName,
            contact_info: contactInfo,
            amount,
            note
          })
        });

        if (res.ok) {
          modalBid?.classList.add('hidden');
          (document.getElementById('form-bid') as HTMLFormElement).reset();
          await loadData();
          if (currentSession && currentSession.user) {
            switchTab('bids');
          }
        }
      } catch (err) {
        console.error('Failed to submit bid:', err);
      }
    });

    // Initial Startup Flow
    initUserSession();
    renderDemoSandbox();
    updateCalculator();
    loadData();
  </script>
</Layout>
