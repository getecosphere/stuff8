      <div class="flex items-center justify-between border-b border-navy-100 pb-3">
        <div class="flex items-center gap-2">
          <span class="text-xl">📜</span>
          <div>
            <h3 class="font-extrabold text-navy-900 text-base">Ownership History</h3>
