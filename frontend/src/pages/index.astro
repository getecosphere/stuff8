        return;
      }

      const title = (document.getElementById('w-item-title') as HTMLInputElement).value;
      const category = (document.getElementById('w-item-category') as HTMLSelectElement).value;
      const condition = (document.getElementById('w-item-condition') as HTMLSelectElement).value;
      const description = (document.getElementById('w-item-description') as HTMLTextAreaElement).value;
      const estVal = parseFloat((document.getElementById('w-item-est-value') as HTMLInputElement).value) || 0;
      const location = (document.getElementById('w-item-location') as HTMLInputElement).value;
      const isSellable = (document.getElementById('w-item-sellable') as HTMLInputElement).checked;

      try {
        const res = await fetch(`${INVENTORY_API}/items`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            owner_id: currentSession.user.id,
            title,
            category,
            condition,
            description,
            photos: ['/fujifilm-camera.jpg'],
            storage_location: location,
            estimated_value: estVal,
            asking_price: isSellable ? estVal : null,
            sellable: isSellable,
            status: isSellable ? 'sellable' : 'collection'
          })
        });

        if (res.ok) {
          const newItem = await res.json();
          if (isSellable) {
            await fetch(`${MARKETPLACE_API}/sync-item`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                item_id: newItem.id,
                seller_id: currentSession.user.id,
                title: newItem.title,
                description: newItem.description,
                category: newItem.category,
                condition: newItem.condition,
                photos: newItem.photos || [],
                asking_price: estVal,
                general_location: location || 'Area Lokal',
                sellable: true
              })
            });
          }
        }
      } catch (err) {
        console.error('Wizard first item error:', err);
