  <script>
    import { inventoryDetailIdFromPath, marketplaceDetailIdFromPath, marketplaceDetailPath } from '../lib/slug';
    import { can, fetchAccessRights } from '../lib/authorization';
    import { applyMuteToAll, installVideoBehaviors, isVideoKey, videoMarkup, thumbImageSrc } from '../lib/media';

    const deepLinkId = inventoryDetailIdFromPath(location.pathname);
    if (deepLinkId) {
      location.replace(`/inventory/detail/?id=${encodeURIComponent(deepLinkId)}`);
    } else if (/^\/inventory\/detail\/.+/.test(location.pathname)) {
      location.replace('/inventory/');
    }
    const marketplaceDeepLinkId = marketplaceDetailIdFromPath(location.pathname);
    if (marketplaceDeepLinkId) {
      location.replace(`/marketplace/detail/?id=${encodeURIComponent(marketplaceDeepLinkId)}`);
    } else if (/^\/marketplace\/detail\/.+/.test(location.pathname)) {
      location.replace('/marketplace/');
    }
    const AUTH_API = `${import.meta.env.PUBLIC_AUTH_URL || '/auth-api'}/auth`;
    const PHOTOS_API = import.meta.env.PUBLIC_STORAGE_URL || '/api';
    const PROFILE_API = import.meta.env.PUBLIC_PROFILE_URL || '/api';
    const INVENTORY_API = import.meta.env.PUBLIC_INVENTORY_URL || '/api/inventory';
    const MARKETPLACE_API = import.meta.env.PUBLIC_MARKETPLACE_URL || '/api/marketplace';
    const BIDDING_API = import.meta.env.PUBLIC_BIDDING_URL || '/api/bidding';

    let items: any[] = [];
    let marketplaceListings: any[] = [];
    // Kept separately from the current listing page. This is the server's active
    // listing count, so it stays correct even when the marketplace is paginated.
    let marketplaceListingTotal = 0;
    let bids: any[] = [];
    let currentSession: { token?: string; user?: any } | null = null;
    let selectedInventoryCategory = 'all';
    let inventorySearch = '';
    let inventoryPage = 1;
    let allInventoryItems: any[] = [];
    let isLoadingInventory = false;
    let inventoryView: 'list' | 'thumbnail' | 'card' = 'thumbnail';
    let inventoryMeta = { total: 0, total_value: 0, page: 1, limit: 12, total_pages: 1, category_counts: [] as Array<{ category: string; count: number }> };
    let customInventoryCategories: string[] = [];
    let categoryPreferenceOwnerId: string | null = null;
    let inventoryViewPreferenceOwnerId: string | null = null;

    const DEFAULT_INVENTORY_CATEGORIES = ['Electronics', 'Cameras', 'Bicycles', 'Books', 'Musical Instruments', 'Furniture'];

    // DOM Views
    const signedOutLanding = document.getElementById('signed-out-landing');
    const signedInDashboard = document.getElementById('signed-in-dashboard');

    // DOM Elements
    const gridInventory = document.getElementById('inventory-grid');
    const gridMarketplace = document.getElementById('marketplace-grid');
    const listBids = document.getElementById('bids-list');
    const categoryTabs = document.getElementById('inventory-category-tabs');
    const categorySection = document.getElementById('inventory-category-section');
    const inventorySearchInput = document.getElementById('inventory-search') as HTMLInputElement | null;
    const inventoryViewMenu = document.getElementById('inventory-view-menu') as HTMLDetailsElement | null;
    const inventoryViewTrigger = document.getElementById('inventory-view-trigger');
    const inventoryPagination = document.getElementById('inventory-pagination');

    const modalBid = document.getElementById('modal-bid');
    const modalWizard = document.getElementById('modal-wizard');

    function escapeHtml(value: string) {
      return value.replace(/[&<>'"]/g, char => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#039;', '"': '&quot;'
      }[char] || char));
    }

    function expandableDesc(text: string, fallback: string, maxLines: number, extraClasses = ''): string {
      const safe = escapeHtml((text || fallback).trim());
      if (safe.length < 100) return `<span class="${extraClasses}">${safe}</span>`;
      return `<span class="desc-wrapper ${extraClasses}"><span class="desc-text line-clamp-${maxLines}">${safe}</span><button type="button" onclick="this.previousElementSibling.classList.contains('line-clamp-${maxLines}')?(this.previousElementSibling.classList.remove('line-clamp-${maxLines}'),this.textContent='Hide'):(this.previousElementSibling.classList.add('line-clamp-${maxLines}'),this.textContent='Show more')" class="desc-toggle ml-1 text-[11px] font-bold text-clay-600 hover:underline whitespace-nowrap">Show more</button></span>`;
    }

    function showNotice(message: string) {
      window.stuff8Toast?.(message, { variant: 'info', title: 'Notice' });
    }

    // Reveal-on-scroll for landing sections (respects reduced motion).
    const revealTargets = Array.from(document.querySelectorAll('[data-reveal]'));
    if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const revealObserver = new IntersectionObserver((entries, observer) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-revealed');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1 });
      revealTargets.forEach(el => revealObserver.observe(el));
    } else {
      revealTargets.forEach(el => el.classList.add('is-revealed'));
    }

    // Animate a number into a money-center stat (counts up once).
    const countUpFrames = new Map<HTMLElement, number>();
    function animateNumber(el: HTMLElement, target: number, format: (n: number) => string, duration = 700) {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        el.textContent = format(target);
        return;
      }
      const previous = countUpFrames.get(el);
      if (previous) window.cancelAnimationFrame(previous);
      const start = performance.now();
      const tick = (now: number) => {
        const progress = Math.min(1, (now - start) / duration);
        const eased = 1 - Math.pow(1 - progress, 3);
        el.textContent = format(Math.round(target * eased));
        if (progress < 1) countUpFrames.set(el, requestAnimationFrame(tick));
        else countUpFrames.delete(el);
      };
      countUpFrames.set(el, requestAnimationFrame(tick));
    }

    function categoryLabel(category: string) {
      const labels: Record<string, string> = {
        Electronics: 'Electronics', Cameras: 'Cameras', Bicycles: 'Bicycles',
        Books: 'Books', 'Musical Instruments': 'Musical Instruments', Furniture: 'Furniture'
      };
      return labels[category] || category;
    }

    function categoryPreferenceKey() {
      return `stuff8_inventory_categories_${currentSession?.user?.id || 'guest'}`;
    }

    function inventoryViewPreferenceKey() {
      return `stuff8_inventory_view_${currentSession?.user?.id || 'guest'}`;
    }

    function loadInventoryViewPreference() {
      const ownerId = currentSession?.user?.id || null;
      if (ownerId === inventoryViewPreferenceOwnerId) return;

      inventoryViewPreferenceOwnerId = ownerId;
      const savedView = localStorage.getItem(inventoryViewPreferenceKey());
      inventoryView = savedView === 'list' || savedView === 'thumbnail' || savedView === 'card' ? savedView : 'thumbnail';
    }

    function loadCategoryPreferences() {
      const ownerId = currentSession?.user?.id || null;
      if (ownerId === categoryPreferenceOwnerId) return;

      categoryPreferenceOwnerId = ownerId;
      selectedInventoryCategory = 'all';
      try {
        const saved = JSON.parse(localStorage.getItem(categoryPreferenceKey()) || '[]');
        customInventoryCategories = Array.isArray(saved)
          ? saved.filter(category => typeof category === 'string' && category.trim())
          : [];
      } catch {
        customInventoryCategories = [];
      }
    }

    function getSelectableInventoryCategories() {
      return Array.from(new Set([
        ...DEFAULT_INVENTORY_CATEGORIES,
        ...customInventoryCategories,
        ...inventoryMeta.category_counts.map(item => item.category)
      ])).sort((a, b) => categoryLabel(a).localeCompare(categoryLabel(b), 'id'));
    }

    function getVisibleInventoryCategories() {
      return inventoryMeta.category_counts.map(item => item.category);
    }

    function syncCategorySelects() {
      const categories = getSelectableInventoryCategories();
      const wizardCategorySelect = document.getElementById('w-item-category') as HTMLSelectElement | null;
      if (wizardCategorySelect) {
        const currentValue = wizardCategorySelect.value;
        wizardCategorySelect.innerHTML = categories.map(category =>
          `<option value="${escapeHtml(category)}">${escapeHtml(categoryLabel(category))}</option>`
        ).join('');
        wizardCategorySelect.value = selectedInventoryCategory !== 'all' && categories.includes(selectedInventoryCategory)
          ? selectedInventoryCategory
          : (categories.includes(currentValue) ? currentValue : categories[0]);
      }
    }

    function renderCategoryTabs() {
      if (!categoryTabs) return;
      const categories = getVisibleInventoryCategories();
      if (selectedInventoryCategory !== 'all' && !categories.includes(selectedInventoryCategory)) {
        selectedInventoryCategory = 'all';
      }

      const renderTab = (category: string, label: string, count: number) => {
        const active = selectedInventoryCategory === category;
        const countLabel = count > 0 ? `<span class="ml-1 ${active ? 'text-slate-300' : 'text-slate-400'}">${count}</span>` : '';
        return `<button type="button" role="tab" aria-selected="${active}" data-category="${escapeHtml(category)}" class="shrink-0 min-h-9 rounded-full border px-3 py-1.5 text-xs font-semibold transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-clay-500 ${active ? 'border-clay-600 bg-clay-600 text-white' : 'border-navy-100 bg-white text-slate-700 hover:border-clay-300 hover:bg-clay-50'}">${escapeHtml(label)}${countLabel}</button>`;
      };

      categoryTabs.innerHTML = [
        renderTab('all', 'All', inventoryMeta.total),
        ...categories.map(category => renderTab(category, categoryLabel(category), inventoryMeta.category_counts.find(entry => entry.category === category)?.count || 0))
      ].join('');
      syncCategorySelects();
    }

    // Onboarding Wizard Elements
    const wizardStepIndicator = document.getElementById('wizard-step-indicator');
    const step1 = document.getElementById('wizard-step-1');
    const step2 = document.getElementById('wizard-step-2');
    const step3 = document.getElementById('wizard-step-3');

    const tabAuthSignin = document.getElementById('tab-auth-signin');
    const tabAuthSignup = document.getElementById('tab-auth-signup');
    const formAuthSignin = document.getElementById('form-auth-signin');
    const formAuthSignup = document.getElementById('form-auth-signup');
    const authSigninError = document.getElementById('auth-signin-error');
    const authSignupError = document.getElementById('auth-signup-error');

    document.querySelectorAll<HTMLButtonElement>('[data-password-toggle]').forEach((button) => {
      const input = document.getElementById(button.dataset.passwordToggle || '') as HTMLInputElement | null;
      if (!input) return;

      button.addEventListener('click', () => {
        const reveal = input.type === 'password';
        input.type = reveal ? 'text' : 'password';
        button.querySelector<SVGElement>('[data-password-eye="hidden"]')?.classList.toggle('hidden', reveal);
        button.querySelector<SVGElement>('[data-password-eye="visible"]')?.classList.toggle('hidden', !reveal);
        button.setAttribute('aria-label', reveal ? 'Hide password' : 'Show password');
        button.setAttribute('aria-pressed', String(reveal));
      });
    });

    // Initialize User Session
    function initUserSession() {
      const savedSession = localStorage.getItem('stuff8_session');
      if (savedSession) {
        try {
          currentSession = JSON.parse(savedSession);
        } catch (e) {
          currentSession = null;
        }
      }
      const isInventoryRoute = location.pathname === '/inventory' || location.pathname === '/inventory/';
      const isRootRoute = location.pathname === '/';
      if (currentSession?.user && isRootRoute) {
        location.replace('/inventory/');
        return true;
      }
      if (!currentSession?.user && isInventoryRoute) {
        location.replace('/auth/signin/?return_to=/inventory/');
        return true;
      }
      updateAuthUIState();
      refreshSidebarProfile();
      return false;
    }

    async function refreshSidebarProfile() {
      if (!currentSession?.token || !currentSession.user?.id) return;
      try {
        const response = await fetch(`${PROFILE_API}/users/${encodeURIComponent(currentSession.user.id)}`, {
          headers: { Authorization: `Bearer ${currentSession.token}` },
        });
        if (!response.ok) return;
        const profile = await response.json();
        const avatarUrl = profile.avatarUrl || currentSession.user.avatarUrl;
        const name = profile.name || currentSession.user.name;
        currentSession.user = {
          ...currentSession.user,
          ...(avatarUrl ? { avatarUrl } : {}),
          ...(name ? { name } : {}),
        };
        localStorage.setItem('stuff8_session', JSON.stringify(currentSession));
        updateAuthUIState();
      } catch {
        // The sidebar keeps the initials from the authenticated session.
      }
    }

    function updateAuthUIState() {
      const sidebarSummary = document.getElementById('sidebar-user-summary');
      const sidebarLogin = document.getElementById('btn-sidebar-login');
      const sidebarAddItem = document.getElementById('btn-sidebar-add-item');
      const sidebarProfile = document.getElementById('btn-sidebar-profile');
      const sidebarChat = document.getElementById('btn-sidebar-chat');
      const sidebarLogout = document.getElementById('btn-logout');
      const avatarWrap = document.getElementById('sidebar-user-avatar-wrap');
      const nameEl = document.getElementById('sidebar-user-name');

      const isAuthenticated = !!(currentSession && currentSession.user);

      if (isAuthenticated) {
        sidebarSummary?.classList.remove('hidden');
        sidebarSummary?.classList.add('flex');
        sidebarLogin?.classList.add('hidden');
        sidebarAddItem?.classList.remove('hidden');
        sidebarAddItem?.classList.add('flex');
        sidebarProfile?.classList.remove('hidden');
        sidebarProfile?.classList.add('flex');
        sidebarChat?.classList.remove('hidden');
        sidebarChat?.classList.add('flex');
        sidebarLogout?.classList.remove('hidden');
        if (avatarWrap) {
          avatarWrap.replaceChildren();
          if (currentSession!.user.avatarUrl) {
            const image = document.createElement('img');
            image.src = currentSession!.user.avatarUrl;
            image.alt = '';
            image.className = 'size-full object-cover';
            image.loading = 'lazy';
            image.decoding = 'async';
            image.addEventListener('error', () => {
              delete currentSession!.user.avatarUrl;
              localStorage.setItem('stuff8_session', JSON.stringify(currentSession));
              updateAuthUIState();
            }, { once: true });
            avatarWrap.append(image);
          } else {
            const initial = document.createElement('span');
            initial.id = 'sidebar-user-avatar';
            initial.textContent = (currentSession!.user.name || currentSession!.user.username || 'U').charAt(0).toUpperCase();
            avatarWrap.append(initial);
          }
        }
        if (nameEl) nameEl.textContent = currentSession!.user.name || currentSession!.user.username;

        signedOutLanding?.classList.add('hidden');
        signedInDashboard?.classList.remove('hidden');
      } else {
        sidebarSummary?.classList.add('hidden');
        sidebarSummary?.classList.remove('flex');
        sidebarLogin?.classList.remove('hidden');
        sidebarProfile?.classList.add('hidden');
        sidebarChat?.classList.add('hidden');
        sidebarLogin?.classList.add('flex');
        sidebarAddItem?.classList.add('hidden');
        sidebarAddItem?.classList.remove('flex');
        sidebarLogout?.classList.add('hidden');

        signedOutLanding?.classList.remove('hidden');
        signedInDashboard?.classList.add('hidden');
      }
    }

    // Hero Section Event Handlers
    document.getElementById('btn-hero-start')?.addEventListener('click', () => openAuth());
    document.getElementById('btn-cta-bottom')?.addEventListener('click', () => openAuth());
    document.getElementById('btn-hero-browse-mkt')?.addEventListener('click', () => {
      document.getElementById('public-marketplace-visitor-grid')?.scrollIntoView({ behavior: 'smooth' });
    });

    function storagePhotoUrl(photoKey?: string) {
      if (!photoKey) return '/images/no-item-image.webp';
      if (/^(https?:)?\//.test(photoKey)) return photoKey;
      return `${PHOTOS_API}/storage/content/${photoKey.split('/').map(encodeURIComponent).join('/')}`;
    }

    const productPhotoIndexes = new Map<string, number>();

    function renderProductPhotoCarousel(item: any, carouselKey: string, imageClass: string) {
      const photos = Array.isArray(item.photos) ? item.photos.filter(Boolean) : [];
      if (photos.length === 0) {
        return `<img src="${storagePhotoUrl()}" alt="No item image available" loading="lazy" decoding="async" class="${imageClass} object-contain p-5" />`;
      }

      const currentIndex = ((productPhotoIndexes.get(carouselKey) || 0) + photos.length) % photos.length;
      productPhotoIndexes.set(carouselKey, currentIndex);
      const photo = photos[currentIndex];
      const previousAction = escapeHtml(`event.stopPropagation(); window.changeProductPhoto(${JSON.stringify(carouselKey)}, -1, ${photos.length})`);
      const nextAction = escapeHtml(`event.stopPropagation(); window.changeProductPhoto(${JSON.stringify(carouselKey)}, 1, ${photos.length})`);

      return `
