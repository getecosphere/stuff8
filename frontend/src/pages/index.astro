      if (elElec) elElec.textContent = `${rElec} barang (Rp ${valElec.toLocaleString('id-ID')})`;
      if (elSport) elSport.textContent = `${rSport} barang (Rp ${valSport.toLocaleString('id-ID')})`;
      if (elMusic) elMusic.textContent = `${rMusic} barang (Rp ${valMusic.toLocaleString('id-ID')})`;
      if (elOther) elOther.textContent = `${rOther} barang (Rp ${valOther.toLocaleString('id-ID')})`;
      if (totalDisplay) totalDisplay.textContent = `Rp ${total.toLocaleString('id-ID')}`;
    }

