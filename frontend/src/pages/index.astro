            </div>
            <p id="chat-item-subtitle" class="text-slate-400 text-xs truncate max-w-xs sm:max-w-sm">Kamera Fujifilm X100V • Rp 21.000.000</p>
          </div>
        </div>
        <button id="btn-close-chat-modal" class="text-slate-400 hover:text-white text-2xl font-bold p-1">×</button>
      </div>

      <!-- Live Deal Banner -->
      <div class="px-4 py-2 bg-emerald-50 border-b border-emerald-100 flex items-center justify-between text-xs text-emerald-900 shrink-0">
        <span class="font-semibold flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          Status: <span id="chat-bid-status-badge" class="font-bold text-emerald-800 bg-emerald-100 px-2 py-0.5 rounded border border-emerald-300">Dalam Diskusi (Interview)</span>
          <strong id="chat-agreed-amount" class="text-emerald-700 font-mono ml-1">Rp 21.000.000</strong>
        </span>
        <button type="button" id="btn-chat-mark-sold" onclick="openConfirmSoldModalFromChat()" class="px-3.5 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs shadow-xs transition-all flex items-center gap-1">
          <span>🏷️ Tandai SOLD</span>
