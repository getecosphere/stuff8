    function renderInventoryPagination() {
      if (!inventoryPagination) return;
      const totalPages = inventoryMeta.total_pages;
      if (totalPages <= 1) {
        inventoryPagination.className = 'hidden';
        inventoryPagination.innerHTML = '';
        return;
      }
      inventoryPagination.className = 'flex items-center justify-center gap-1 pt-2';
      const pages: string[] = [];
      pages.push(`<button type="button" class="page-btn rounded-lg border border-navy-100 bg-white px-3 py-1.5 text-xs font-semibold text-slate-600 hover:bg-brand-50 hover:text-brand-700 disabled:opacity-40 disabled:cursor-not-allowed" ${inventoryPage <= 1 ? 'disabled' : ''} data-page="${inventoryPage - 1}" aria-label="Previous page">&laquo; Previous</button>`);
      const maxVisible = 5;
      let start = Math.max(1, inventoryPage - Math.floor(maxVisible / 2));
      let end = Math.min(totalPages, start + maxVisible - 1);
      if (end - start < maxVisible - 1) start = Math.max(1, end - maxVisible + 1);
      if (start > 1) pages.push(`<span class="px-1 text-xs text-slate-400">...</span>`);
      for (let p = start; p <= end; p++) {
        pages.push(`<button type="button" class="page-btn rounded-lg border px-3 py-1.5 text-xs font-semibold transition-colors ${p === inventoryPage ? 'border-brand-600 bg-brand-600 text-white' : 'border-navy-100 bg-white text-slate-600 hover:bg-brand-50 hover:text-brand-700'}" data-page="${p}">${p}</button>`);
      }
      if (end < totalPages) pages.push(`<span class="px-1 text-xs text-slate-400">...</span>`);
      pages.push(`<button type="button" class="page-btn rounded-lg border border-navy-100 bg-white px-3 py-1.5 text-xs font-semibold text-slate-600 hover:bg-brand-50 hover:text-brand-700 disabled:opacity-40 disabled:cursor-not-allowed" ${inventoryPage >= totalPages ? 'disabled' : ''} data-page="${inventoryPage + 1}" aria-label="Next page">Next &raquo;</button>`);
      inventoryPagination.innerHTML = pages.join('');
      inventoryPagination.querySelectorAll<HTMLButtonElement>('.page-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const p = parseInt(btn.dataset.page || '1');
          if (p === inventoryPage || p < 1 || p > totalPages || isLoadingInventory) return;
          goToInventoryPage(p);
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      });
    }

