                  </div>` : ''}
                </div>

                <button onclick="toggleSellable('${item.id}')" class="w-full py-2 rounded-lg border ${item.sellable ? 'border-slate-300 text-slate-700 bg-slate-50 hover:bg-slate-100' : 'border-navy-900/30 text-navy-900 bg-brand-50 hover:bg-brand-100'} text-xs font-bold transition-all">
                  ${item.sellable ? 'Sembunyikan dari Marketplace' : 'Aktifkan Status Dijual'}
                </button>
              </div>
            </div>
          `).join('');
        }
      }

      // Render Marketplace Cards
      if (gridMarketplace) {
        if (marketplaceListings.length === 0) {
          gridMarketplace.innerHTML = `
            <div class="col-span-full p-12 rounded-2xl bg-white border border-slate-200 text-center space-y-4 shadow-xs">
              <div class="space-y-1">
                <h3 class="text-slate-900 font-bold text-base">Belum Ada Barang Dipajang</h3>
                <p class="text-slate-600 text-xs max-w-sm mx-auto leading-relaxed">Aktifkan status dijual pada barang di inventaris pribadimu untuk menayangkannya di sini.</p>
              </div>
            </div>
          `;
        } else {
          gridMarketplace.innerHTML = marketplaceListings.map(item => `
            <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden hover:border-slate-300 hover:shadow-md transition-all flex flex-col justify-between shadow-xs">
              <div class="h-48 bg-slate-100 relative overflow-hidden">
                <img src="${(item.photos && item.photos[0]) || 'https://images.unsplash.com/photo-1526170375885-4d8ecf77b99f?w=500&q=80'}" alt="${item.title}" class="w-full h-full object-cover" />
                <span class="absolute top-3 right-3 px-2.5 py-1 rounded-md text-xs font-bold bg-navy-900 text-white shadow-xs">
                  Rp ${parseInt(item.asking_price || 0).toLocaleString('id-ID')}
                </span>
              </div>
              <div class="p-5 space-y-3 flex-1 flex flex-col justify-between">
                <div>
                  <span class="text-xs font-semibold text-brand-700 uppercase tracking-wider">${item.category} • ${item.condition}</span>
                  <h3 class="font-bold text-slate-900 text-base leading-snug">${item.title}</h3>
                  <p class="text-slate-600 text-xs line-clamp-2 mt-1">${item.description}</p>
                </div>

                <button onclick="openBidModal('${item.item_id || item.id}', '${item.title}', ${item.asking_price || 0})" class="w-full py-2.5 rounded-lg bg-navy-900 hover:bg-navy-800 text-white font-bold text-xs shadow-xs transition-all">
                  Ajukan Penawaran Harga
                </button>
              </div>
            </div>
          `).join('');
        }
      }

      // Render Bids Queue
      if (listBids) {
        if (bids.length === 0) {
          listBids.innerHTML = `
            <div class="p-12 rounded-2xl bg-white border border-slate-200 text-center space-y-4 shadow-xs">
              <div class="space-y-1">
                <h3 class="text-slate-900 font-bold text-base">Belum Ada Penawaran Masuk</h3>
                <p class="text-slate-600 text-xs max-w-sm mx-auto leading-relaxed">Saat calon pembeli ngirim penawaran tunai pada barangmu, daftarnya bakal muncul di sini.</p>
              </div>
            </div>
          `;
        } else {
          listBids.innerHTML = bids.map(bid => {
            const item = items.find(i => i.id === bid.item_id) || marketplaceListings.find(m => m.item_id === bid.item_id);
            const statusStr = typeof bid.status === 'string' ? bid.status : Object.keys(bid.status || {})[0] || 'Pending';
            const statusDisplay = statusStr === 'Accepted' || statusStr === 'accepted' ? 'Diterima' : 'Menunggu Respons';
            return `
              <div class="p-5 rounded-2xl bg-white border border-slate-200 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 shadow-xs">
                <div class="space-y-1">
                  <span class="text-xs font-bold uppercase tracking-wider text-brand-700">${item ? item.title : 'Barang #' + bid.item_id.substring(0, 8)}</span>
                  <h4 class="font-bold text-slate-900 text-base">Penawaran: Rp ${(bid.amount || 0).toLocaleString('id-ID')} <span class="text-xs font-normal text-slate-500">oleh ${bid.buyer_name}</span></h4>
                  <p class="text-slate-600 text-xs">${bid.note || 'Tidak ada pesan'}</p>
                  <span class="inline-block text-xs text-slate-500">Kontak: <code class="text-slate-800 bg-slate-100 px-1.5 py-0.5 rounded border border-slate-200">${bid.contact_info}</code></span>
                </div>

                <div class="flex items-center gap-3">
                  <span class="px-3 py-1 rounded-full text-xs font-bold ${statusStr === 'Accepted' || statusStr === 'accepted' ? 'bg-emerald-50 text-emerald-800 border border-emerald-200' : 'bg-amber-50 text-amber-800 border border-amber-200'}">
                    ${statusDisplay}
                  </span>
                  ${statusStr === 'Pending' || statusStr === 'pending' ? `
                    <button onclick="acceptBid('${bid.id}')" class="px-4 py-1.5 rounded-lg bg-navy-900 hover:bg-navy-800 text-white font-bold text-xs shadow-xs">Terima Penawaran</button>
                  ` : ''}
                </div>
              </div>
            `;
          }).join('');
        }
      }
    }

    // Attach Global Functions
    (window as any).openWizard = openWizard;

    (window as any).toggleSellable = async (id: string) => {
      const item = items.find(i => i.id === id);
      if (!item) return;

      const newSellable = !item.sellable;
      const askingPrice = newSellable ? (item.asking_price || item.estimated_value || 100000) : null;

      try {
        await fetch(`${INVENTORY_API}/items/${id}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            sellable: newSellable,
            asking_price: askingPrice,
            status: newSellable ? 'sellable' : 'collection'
          })
        });

        await fetch(`${MARKETPLACE_API}/sync-item`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            item_id: item.id,
            seller_id: item.owner_id || (currentSession && currentSession.user ? currentSession.user.id : 'user_guest'),
            title: item.title,
            description: item.description,
            category: item.category,
            condition: item.condition,
            photos: item.photos || [],
            asking_price: askingPrice || 0,
            general_location: item.storage_location || 'Area Lokal',
            sellable: newSellable
          })
        });

        await loadData();
      } catch (err) {
        console.error('Failed to toggle sellable state:', err);
      }
    };

    const updateBidFormattedDisplay = () => {
      const input = document.getElementById('bid-amount') as HTMLInputElement;
      const fmtEl = document.getElementById('bid-amount-formatted');
      if (input && fmtEl) {
        const val = parseInt(input.value) || 0;
        fmtEl.textContent = `Rp ${val.toLocaleString('id-ID')}`;
      }
    };

    document.getElementById('bid-amount')?.addEventListener('input', updateBidFormattedDisplay);

    (window as any).openBidModal = (id: string, title: string, price: number) => {
      (document.getElementById('bid-item-id') as HTMLInputElement).value = id;
      document.getElementById('bid-item-title')!.textContent = title;
      document.getElementById('bid-asking-price')!.textContent = `Harga Buka: Rp ${price.toLocaleString('id-ID')}`;
      
      currentBidBasePrice = price || 0;

      // Randomly pick an Indonesian name for the bidder
      const randomName = INDONESIAN_NAMES[Math.floor(Math.random() * INDONESIAN_NAMES.length)];
      document.getElementById('bid-sim-name')!.textContent = randomName;

      // Default amount is base asking price
      (document.getElementById('bid-amount') as HTMLInputElement).value = currentBidBasePrice.toString();
      updateBidFormattedDisplay();

      modalBid?.classList.remove('hidden');
    };

    // Steppers and Percentage listeners for Bid Form
    document.getElementById('btn-bid-step-down')?.addEventListener('click', () => {
      const input = document.getElementById('bid-amount') as HTMLInputElement;
      const currentVal = parseInt(input.value) || 0;
      input.value = Math.max(0, currentVal - 100000).toString();
      updateBidFormattedDisplay();
    });

    document.getElementById('btn-bid-step-up')?.addEventListener('click', () => {
      const input = document.getElementById('bid-amount') as HTMLInputElement;
      const currentVal = parseInt(input.value) || 0;
      input.value = (currentVal + 100000).toString();
      updateBidFormattedDisplay();
    });

    document.querySelectorAll('.btn-bid-pct').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const pct = parseInt((e.currentTarget as HTMLElement).getAttribute('data-pct') || '0');
        const calculated = Math.round((currentBidBasePrice * (1 + pct / 100)) / 50000) * 50000;
        (document.getElementById('bid-amount') as HTMLInputElement).value = calculated.toString();
        updateBidFormattedDisplay();
      });
    });

    (window as any).acceptBid = async (bidId: string) => {
      try {
        const res = await fetch(`${BIDDING_API}/bids/${bidId}/accept`, {
          method: 'POST'
        });
        if (res.ok) {
          const data = await res.json();
          alert(`Penawaran sebesar Rp ${data.bid.amount.toLocaleString('id-ID')} diterima! Hubungi pembeli di: ${data.bid.contact_info} untuk transaksi / COD.`);
          await loadData();
        }
      } catch (err) {
        console.error('Failed to accept bid:', err);
      }
    };

    // Handle Submit Bid Form
    document.getElementById('form-bid')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const itemId = (document.getElementById('bid-item-id') as HTMLInputElement).value;
      const buyerName = document.getElementById('bid-sim-name')?.textContent || 'User Simulasi';
      const amount = parseInt((document.getElementById('bid-amount') as HTMLInputElement).value) || 0;

      if (!demoBids[itemId]) {
        demoBids[itemId] = [];
      }

      demoBids[itemId].push({
        buyer_name: buyerName,
        amount: amount,
        created_at: Date.now()
      });

      modalBid?.classList.add('hidden');
      renderVisitorMarketplaceGrid();
    });

    // Initial Startup Flow
    initUserSession();
    renderDemoSandbox();
    updateCalculator();
    loadData();
  </script>
</Layout>
