---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div class="mx-auto max-w-7xl px-4 py-5 sm:px-6 lg:px-8">
    
    <!-- ================================================================= -->
    <!-- 1. LANDING PAGE HALAMAN UTAMA                                    -->
    <!-- ================================================================= -->
    <div id="signed-out-landing" class="hidden space-y-12 py-4 transition-all duration-300">
      
      <!-- HERO SECTION -->
      <section class="relative overflow-hidden rounded-3xl border border-navy-100 bg-gradient-to-br from-paper-50 via-paper-100 to-clay-50 p-8 text-center shadow-[0_1px_2px_rgba(15,30,25,0.04)] sm:p-12 md:p-14">
        <div class="pointer-events-none absolute -left-20 -top-24 size-72 rounded-full bg-clay-200/30 blur-3xl" aria-hidden="true"></div>
        <div class="pointer-events-none absolute -bottom-24 -right-16 size-72 rounded-full bg-navy-200/30 blur-3xl" aria-hidden="true"></div>

        <div class="relative z-10 mx-auto max-w-3xl space-y-5">
          <h1 data-reveal style="--reveal-delay: 80ms" class="font-display text-3xl font-extrabold leading-tight tracking-tight text-navy-900 sm:text-5xl">
            Track every item you own.<br class="hidden sm:inline" />
            <span class="text-clay-600">
              Sell whenever you want.
            </span>
          </h1>
          <p data-reveal style="--reveal-delay: 160ms" class="mx-auto max-w-2xl text-sm leading-relaxed text-slate-600 sm:text-base">
            We all have valuable items we don't realize we own — they just pile up unused for years. That's why on <strong class="font-bold text-navy-900">Stuff8</strong>, you simply log your items first, so you know the total value of your assets. Then when you feel like selling something, just flag it and people can start bidding on it!
          </p>

          <!-- Action CTAs -->
          <div data-reveal style="--reveal-delay: 240ms" class="flex flex-wrap items-center justify-center gap-3 pt-2">
            <button id="btn-hero-start" class="inline-flex items-center gap-2 rounded-full bg-navy-900 px-6 py-3 text-sm font-bold text-white shadow-sm transition-all hover:bg-navy-800 hover:shadow-md active:scale-[0.99]">
              <span>Start Tracking Items</span>
              <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
            </button>

            <a href="#interactive-demo" class="inline-flex items-center gap-2 rounded-full border border-navy-100 bg-white px-6 py-3 text-sm font-bold text-navy-900 shadow-sm transition-all hover:bg-paper-100">
              <span>Try the Interactive Demo</span>
            </a>

            <button id="btn-hero-browse-mkt" class="inline-flex items-center gap-2 rounded-full bg-brand-600 px-6 py-3 text-sm font-bold text-white shadow-sm transition-all hover:bg-brand-700 hover:shadow-md active:scale-[0.99]">
              <span>View Marketplace</span>
            </button>
          </div>

          <!-- Two-sided flow: private item -> 1 click -> listed on the Marketplace -->
          <div data-reveal style="--reveal-delay: 320ms" class="mx-auto max-w-3xl pt-8" aria-label="How Stuff8 works: keep items private, then list them in the marketplace">
            <div class="grid grid-cols-[1fr_auto_1fr] items-center gap-2 sm:gap-4">
              <div class="card overflow-hidden text-left">
                <div class="relative aspect-[4/3] overflow-hidden bg-navy-100">
                  <img src="/fujifilm-camera.jpg" alt="Fujifilm camera logged in a private inventory" class="size-full object-cover" loading="lazy" />
                  <span class="absolute left-2 top-2 rounded-md bg-white/95 px-2 py-0.5 text-[10px] font-bold text-navy-900 shadow-xs">Private Collection</span>
                </div>
                <div class="space-y-1.5 p-3 text-left sm:p-4">
                  <p class="text-[10px] font-bold uppercase tracking-wider text-clay-600">Inventory · location recorded</p>
                  <p class="truncate text-sm font-bold text-navy-900">Fujifilm X100V Camera</p>
                  <p class="num text-base font-extrabold text-clay-700">Rp 21.750.000</p>
                </div>
              </div>

              <div class="flex flex-col items-center gap-1.5 px-1 text-navy-900" aria-hidden="true">
                <span class="flex size-9 items-center justify-center rounded-full border border-navy-100 bg-white shadow-xs">
                  <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                </span>
                <span class="whitespace-nowrap rounded-full border border-navy-100 bg-paper-100 px-2 py-0.5 text-[10px] font-bold text-navy-900">1 click</span>
              </div>

              <div class="card overflow-hidden text-left ring-2 ring-brand-500/25">
                <div class="relative aspect-[4/3] overflow-hidden bg-navy-100">
                  <img src="/fujifilm-camera.jpg" alt="Fujifilm camera listed in the marketplace" class="size-full object-cover" loading="lazy" />
                  <span class="num absolute right-2 top-2 rounded-full bg-brand-600 px-2.5 py-1 text-[11px] font-extrabold text-white shadow-xs">Rp 21.750.000</span>
                  <span class="absolute left-2 top-2 rounded-md bg-white/95 px-2 py-0.5 text-[10px] font-bold text-brand-700 shadow-xs">OPEN · Open to offers</span>
                </div>
                <div class="space-y-1.5 p-3 text-left sm:p-4">
                  <p class="text-[10px] font-bold uppercase tracking-wider text-brand-600">Stuff8 Marketplace</p>
                  <p class="truncate text-sm font-bold text-navy-900">Fujifilm X100V Camera</p>
                  <span class="inline-flex items-center gap-1 rounded-full bg-brand-600 px-2.5 py-1 text-[10px] font-bold text-white">View &amp; make an offer →</span>
                </div>
              </div>
            </div>
            <p class="mt-4 text-center text-xs text-slate-500">Keep it first, sell it whenever you want — all from one place.</p>
          </div>

          <!-- Quick Stats Banner -->
          <div data-reveal style="--reveal-delay: 400ms" class="grid grid-cols-2 gap-3 pt-6 text-left md:grid-cols-4">
            <div class="card p-4">
              <div class="text-xs font-semibold text-slate-500">Privacy Protected</div>
              <div class="mt-1 text-lg font-extrabold text-navy-900">100% Private</div>
              <p class="mt-0.5 text-[11px] text-slate-500">Only you know about your items</p>
            </div>
            <div class="card p-4">
              <div class="text-xs font-semibold text-slate-500">List Items</div>
              <div class="mt-1 text-lg font-extrabold text-clay-700">1-Click Listing</div>
              <p class="mt-0.5 text-[11px] text-slate-500">Goes straight to the marketplace</p>
            </div>
            <div class="card p-4">
              <div class="text-xs font-semibold text-slate-500">Easy Negotiation</div>
              <div class="mt-1 text-lg font-extrabold text-brand-700">Open to Offers</div>
              <p class="mt-0.5 text-[11px] text-slate-500">Review cash offers from buyers</p>
            </div>
            <div class="card p-4">
              <div class="text-xs font-semibold text-slate-500">No Fees</div>
              <div class="mt-1 text-lg font-extrabold text-navy-900">No Commission</div>
              <p class="mt-0.5 text-[11px] text-slate-500">100% of the sale stays with you</p>
            </div>
          </div>
        </div>
      </section>

      <!-- UNLOCKED ASSET VALUE CALCULATOR -->
      <section data-reveal class="card space-y-8 p-8 sm:p-12">
        <div class="mx-auto max-w-2xl text-center space-y-2">
          <h2 class="font-display text-2xl font-extrabold tracking-tight text-navy-900 sm:text-3xl">
            Imagine the Value of Everything You Own!
          </h2>
          <p class="text-xs text-slate-600 sm:text-sm">
            Move the sliders below to estimate the assets that have been sitting in your garage or closet.
          </p>
        </div>

        <div class="mx-auto grid max-w-3xl grid-cols-1 gap-6 md:grid-cols-2">
          <div class="space-y-4 rounded-2xl border border-navy-100 bg-paper-100 p-5">
            <div class="flex justify-between text-xs font-semibold">
              <span class="text-navy-900">Electronics &amp; Gadgets</span>
              <span id="calc-val-electronics" class="num text-clay-700">2 items (Rp 15.000.000)</span>
            </div>
            <input type="range" id="calc-range-electronics" min="0" max="10" value="2" class="slider w-full cursor-pointer" />

            <div class="flex justify-between pt-2 text-xs font-semibold">
              <span class="text-navy-900">Sports &amp; Outdoor Gear</span>
              <span id="calc-val-sports" class="num text-clay-700">1 item (Rp 5.250.000)</span>
            </div>
            <input type="range" id="calc-range-sports" min="0" max="10" value="1" class="slider w-full cursor-pointer" />
          </div>

          <div class="space-y-4 rounded-2xl border border-navy-100 bg-paper-100 p-5">
            <div class="flex justify-between text-xs font-semibold">
              <span class="text-navy-900">Music &amp; Audio Gear</span>
              <span id="calc-val-music" class="num text-clay-700">1 item (Rp 6.000.000)</span>
            </div>
            <input type="range" id="calc-range-music" min="0" max="10" value="1" class="slider w-full cursor-pointer" />

            <div class="flex justify-between pt-2 text-xs font-semibold">
              <span class="text-navy-900">Collectibles &amp; Furniture</span>
              <span id="calc-val-other" class="num text-clay-700">3 items (Rp 3.600.000)</span>
            </div>
            <input type="range" id="calc-range-other" min="0" max="15" value="3" class="slider w-full cursor-pointer" />
          </div>
        </div>

        <!-- Calculator Result Card -->
        <div class="mx-auto max-w-md space-y-3 rounded-2xl bg-navy-900 p-6 text-center text-white shadow-lg">
          <span class="text-xs font-bold uppercase tracking-wider text-navy-200">Total Estimated Value of Your Stored Items</span>
          <div id="calc-total-display" class="num font-display text-3xl font-extrabold text-white sm:text-4xl">
            Rp 29.850.000
          </div>
          <p class="text-xs text-navy-200">
            Start logging your items now to know your stored assets and be ready to sell anytime.
          </p>
          <button id="btn-calc-cta" class="w-full rounded-full bg-brand-600 py-3 text-xs font-bold text-white shadow-xs transition-all hover:bg-brand-500">
            Start Tracking My Items
          </button>
        </div>
      </section>

      <!-- THREE CORE PILLARS OF STUFF8 -->
      <section data-reveal class="space-y-8">
        <div class="mx-auto max-w-xl space-y-2 text-center">
          <h2 class="font-display text-2xl font-extrabold tracking-tight text-navy-900 sm:text-3xl">How Stuff8 Works</h2>
          <p class="text-xs text-slate-600 sm:text-sm">Focus on organizing your personal inventory first, then sell at your own pace later.</p>
        </div>

        <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
          <div class="card space-y-3 p-6 transition-all hover:border-clay-300 hover:shadow-md">
            <div class="flex items-center gap-3">
              <div class="flex size-8 shrink-0 items-center justify-center rounded-lg bg-clay-600 text-sm font-bold text-white">1</div>
              <h3 class="font-display text-base font-bold text-navy-900">Private Storage Gallery</h3>
            </div>
            <p class="text-xs leading-relaxed text-slate-600">
              Log the purchase price, condition, estimated value, and where it's stored. Your catalog is 100% private and secure.
            </p>
          </div>

          <div class="card space-y-3 p-6 transition-all hover:border-brand-300 hover:shadow-md">
            <div class="flex items-center gap-3">
              <div class="flex size-8 shrink-0 items-center justify-center rounded-lg bg-navy-900 text-sm font-bold text-white">2</div>
              <h3 class="font-display text-base font-bold text-navy-900">One click .. to the Marketplace!</h3>
            </div>
            <p class="text-xs leading-relaxed text-slate-600">
              No need to retype descriptions. Just flip the "For Sale" toggle and your item goes live on the marketplace.
            </p>
          </div>

          <div class="card space-y-3 p-6 transition-all hover:border-brand-300 hover:shadow-md">
            <div class="flex items-center gap-3">
              <div class="flex size-8 shrink-0 items-center justify-center rounded-lg bg-brand-600 text-sm font-bold text-white">3</div>
              <h3 class="font-display text-base font-bold text-navy-900">Direct Offers</h3>
            </div>
            <p class="text-xs leading-relaxed text-slate-600">
              Buyers can send price offers directly. Just review the offers on your dashboard and pick your favorite.
            </p>
          </div>
        </div>
      </section>

      <!-- INTERACTIVE DEMO SANDBOX -->
      <section id="interactive-demo" data-reveal class="space-y-6 scroll-mt-24">
        <div class="space-y-2 text-center">
          <h2 class="font-display text-2xl font-extrabold tracking-tight text-navy-900 sm:text-3xl">
            See How Stuff8 Works
          </h2>
          <p class="mx-auto max-w-xl text-xs text-slate-600 sm:text-sm">
            Pick a sample item below, flip the sell toggle, and watch how smoothly it moves from your private gallery to the public marketplace.
          </p>
        </div>

        <!-- Sample Item Selector Tabs -->
        <div class="flex flex-wrap justify-center gap-2 text-xs font-semibold">
          <button id="demo-tab-camera" class="demo-item-btn active rounded-full bg-navy-900 px-4 py-2 font-bold text-white shadow-xs transition-all">
            Fujifilm Camera (Rp 21.7M)
          </button>
          <button id="demo-tab-bike" class="demo-item-btn rounded-full border border-navy-100 bg-white px-4 py-2 text-slate-600 transition-all hover:bg-paper-100 hover:text-navy-900">
            Road Bike (Rp 10.2M)
          </button>
          <button id="demo-tab-macbook" class="demo-item-btn rounded-full border border-navy-100 bg-white px-4 py-2 text-slate-600 transition-all hover:bg-paper-100 hover:text-navy-900">
            MacBook Pro M2 (Rp 27M)
          </button>
          <button id="demo-tab-guitar" class="demo-item-btn rounded-full border border-navy-100 bg-white px-4 py-2 text-slate-600 transition-all hover:bg-paper-100 hover:text-navy-900">
            Acoustic Guitar (Rp 6.3M)
          </button>
        </div>

        <!-- Interactive Sandbox Card -->
        <div class="card relative mx-auto grid max-w-4xl grid-cols-1 gap-8 overflow-hidden p-6 sm:p-8 md:grid-cols-12">
          <!-- Image Column -->
          <div class="relative h-64 overflow-hidden rounded-xl border border-navy-100 bg-navy-100 md:col-span-5 md:h-full">
            <img id="demo-card-img" src="/fujifilm-camera.jpg" alt="Sample item" loading="lazy" decoding="async" class="size-full object-cover transition-transform duration-500 group-hover:scale-102" />
            <span id="demo-card-badge" class="absolute right-3 top-3 rounded-md bg-navy-900/90 px-3 py-1 text-xs font-bold text-white shadow-xs backdrop-blur-xs transition-all">
              Private Collection
            </span>
          </div>

          <!-- Details & Controls Column -->
          <div class="flex flex-col justify-between space-y-6 md:col-span-7">
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <span id="demo-card-category" class="text-xs font-bold uppercase tracking-wider text-clay-600">Camera &amp; Photography</span>
                <span id="demo-card-location" class="rounded-md border border-navy-100 bg-paper-100 px-2.5 py-1 text-xs text-slate-500">Location: Closet Shelf B</span>
              </div>
              <h3 id="demo-card-title" class="font-display text-xl font-bold text-navy-900 sm:text-2xl">Fujifilm X100V Compact Camera</h3>
              <p id="demo-card-desc" class="text-xs leading-relaxed text-slate-600 sm:text-sm">
                Flawless condition, fixed 23mm F2 lens, shutter count under 2,500. Comes with original box and leather strap.
              </p>
            </div>

            <!-- Value & Toggle Box -->
            <div class="space-y-4 rounded-2xl border border-navy-100 bg-paper-100 p-4">
              <div class="flex items-center justify-between">
                <div>
                  <span class="text-xs font-medium text-slate-500">Estimated Item Value:</span>
                  <div id="demo-card-val" class="num text-xl font-extrabold text-clay-700">Rp 21.750.000</div>
                </div>
                <div class="text-right">
                  <span class="text-xs font-medium text-slate-500">Condition:</span>
                  <div id="demo-card-condition" class="text-sm font-semibold text-navy-900">Like New</div>
                </div>
              </div>

              <!-- Interactive Toggle Switch -->
              <div class="flex items-center justify-between gap-4 border-t border-navy-100 pt-3">
                <div>
                  <span class="block text-xs font-bold text-navy-900">Status on the Public Marketplace</span>
                  <span id="demo-toggle-label" class="block text-[11px] text-slate-500">Status: Private Only</span>
                </div>
                <button id="btn-demo-toggle-sellable" class="inline-flex items-center gap-2 rounded-full bg-navy-900 px-4 py-2 text-xs font-bold text-white shadow-xs transition-all hover:bg-navy-800">
                  <span>Activate For Sale</span>
                </button>
              </div>
            </div>



          </div>
        </div>
      </section>

      <!-- PUBLIC MARKETPLACE PREVIEW FOR VISITORS -->
      <section data-reveal class="space-y-6 pt-4">
        <div class="border-b border-navy-100 pb-4">
          <div>
            <h2 class="font-display text-xl font-extrabold tracking-tight text-navy-900 sm:text-2xl">Community Items For Sale</h2>
            <p class="text-xs text-slate-600">Items currently listed by other users</p>
          </div>
        </div>

        <div id="public-marketplace-visitor-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <!-- Dynamic public marketplace listings rendered here -->
        </div>
      </section>

      <!-- INTERACTIVE DEMO: SIMULASI ALUR CHAT REALTIME SETELAH PENAWARAN DISETUJUI -->
      <section id="demo-approved-bids-section" class="space-y-6 border-t border-navy-100 pt-6 scroll-mt-24 hidden">
        <div class="card space-y-6 p-6 sm:p-8">
          <div class="border-b border-navy-100 pb-4">
            <h2 class="font-display text-xl font-extrabold tracking-tight text-navy-900 sm:text-2xl">Flow Demo: Negotiation &amp; Real-Time Chat with a Chosen Bidder</h2>
            <p class="mt-1 text-xs text-slate-600 sm:text-sm">
              This chat flow appears after an offer is placed on a marketplace item. Pick a product tab below to see real-time chat for each product!
            </p>
          </div>

          <!-- Product Tabs Bar (Appears when items have bids) -->
          <div id="visitor-chat-product-tabs" class="no-scrollbar flex items-center gap-2 overflow-x-auto pb-1 text-xs font-semibold text-slate-600">
            <!-- Dynamic product tabs rendered here -->
          </div>

          <div id="visitor-approved-bids-container" class="grid grid-cols-1 gap-4 md:grid-cols-2">
            <!-- Dynamic interactive cards rendered here -->
          </div>
        </div>
      </section>

      <!-- CLOSING CTA -->
      <section data-reveal class="rounded-3xl border border-navy-100 bg-paper-100 px-6 py-10 text-center sm:px-10">
        <p class="mx-auto inline-flex items-center gap-2 text-[11px] font-bold uppercase tracking-widest text-clay-600">
          <span class="size-1.5 rounded-full bg-clay-500" aria-hidden="true"></span>
          Start today
        </p>
        <h2 class="mx-auto mt-3 max-w-2xl font-display text-2xl font-extrabold tracking-tight text-navy-900 sm:text-3xl">
          Your stuff is worth more than you think.
        </h2>
        <p class="mx-auto mt-2 max-w-md text-sm leading-relaxed text-slate-600">
          Log it now, know its total value, and sell whenever you need — all from one warm, private place.
        </p>
        <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
          <button id="btn-cta-bottom" class="inline-flex items-center gap-2 rounded-full bg-navy-900 px-6 py-3 text-sm font-bold text-white shadow-sm transition-all hover:bg-navy-800 hover:shadow-md active:scale-[0.99]">
            <span>Start Tracking Items</span>
            <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
          </button>
          <a href="/marketplace/" class="inline-flex items-center gap-2 rounded-full bg-brand-600 px-6 py-3 text-sm font-bold text-white shadow-sm transition-all hover:bg-brand-700 hover:shadow-md active:scale-[0.99]">
            <span>View Marketplace</span>
          </a>
        </div>
      </section>

    </div>


    <!-- ================================================================= -->
    <!-- 2. DASHBOARD PENGGUNA TERDAPAT KETIKA LOGIN                       -->
    <!-- ================================================================= -->
    <div id="signed-in-dashboard" class="hidden min-h-[calc(100dvh-10rem)] flex flex-col gap-4 transition-all duration-300">
      
      <!-- Widget: Penawaran Disetujui & Chat Real-Time dengan Bidder Pilihan -->
      <div id="approved-bids-widget" class="hidden space-y-4 rounded-2xl border border-navy-100 bg-white p-6 shadow-[0_1px_2px_rgba(15,30,25,0.04)]">
        <div class="border-b border-navy-100 pb-3">
          <h3 class="font-display text-lg font-bold tracking-tight text-navy-900">Negotiation &amp; Real-Time Chat with a Chosen Bidder</h3>
        </div>

        <div id="approved-bids-container" class="grid grid-cols-1 gap-4 md:grid-cols-2">
          <!-- Dynamic cards for approved bids will render here -->
        </div>
      </div>

      <!-- Inventory-first category picker -->
      <section id="inventory-category-section" class="space-y-3" aria-label="Inventory summary and filters">
        <div class="flex items-end justify-between gap-3">
          <div class="min-w-0">
            <h1 id="inventory-total-value" class="font-display truncate text-2xl font-extrabold tracking-tight text-navy-900 sm:text-3xl">No inventory value yet</h1>
            <p class="mt-1 text-xs text-slate-500">Your collection · know what you own, where, and what it's worth.</p>
          </div>
          <p id="inventory-total-count" class="shrink-0 pb-0.5 text-xs font-semibold text-slate-500">No items yet</p>
        </div>
        <div id="inventory-category-tabs" class="flex gap-2 overflow-x-auto pb-1 no-scrollbar" role="tablist" aria-label="Inventory categories">
          <!-- Dynamic category tabs rendered here -->
        </div>
        <div class="flex items-center gap-2">
          <label class="relative min-w-0 flex-1">
            <span class="sr-only">Search inventory items</span>
            <svg class="pointer-events-none absolute left-3 top-1/2 size-4 -translate-y-1/2 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" stroke-width="2"/><path stroke-linecap="round" stroke-width="2" d="m16 16 4 4"/></svg>
            <input id="inventory-search" type="search" autocomplete="off" placeholder="Search items" class="min-h-10 w-full rounded-full border border-navy-100 bg-white py-2 pl-9 pr-3 text-sm text-navy-900 outline-none transition-colors placeholder:text-slate-400 focus:border-clay-500 focus:ring-2 focus:ring-clay-500/20" />
          </label>
          <details id="inventory-view-menu" class="relative shrink-0">
            <summary id="inventory-view-trigger" aria-label="Choose inventory view mode" class="flex size-10 cursor-pointer list-none items-center justify-center rounded-full border border-navy-100 bg-white text-slate-700 marker:hidden focus:outline-none focus-visible:ring-2 focus-visible:ring-clay-500/20 [&::-webkit-details-marker]:hidden">
