    // =================================================================
    // DATA LOADING & RENDERING
    // =================================================================
    async function loadData() {
      try {
        const ownerId = currentSession && currentSession.user ? currentSession.user.id : null;
        
        const [resItems, resMarketplace, resBids] = await Promise.all([
          ownerId ? fetch(`${INVENTORY_API}/items?owner_id=${ownerId}`).then(r => r.ok ? r.json() : []) : Promise.resolve([]),
          fetch(`${MARKETPLACE_API}/listings`).then(r => r.ok ? r.json() : []),
          fetch(`${BIDDING_API}/bids`).then(r => r.ok ? r.json() : [])
        ]);

        items = resItems;
        marketplaceListings = resMarketplace;
        bids = resBids;

        render();
      } catch (err) {
        console.error('Error fetching domain service data:', err);
      }
    }

