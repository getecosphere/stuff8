  <!-- Modal: Riwayat Kepemilikan (Provenance Log) -->
  <div id="modal-ownership-history" class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs z-50 flex items-center justify-center p-4 hidden">
    <div class="bg-white border border-slate-200 rounded-2xl max-w-lg w-full p-6 space-y-5 shadow-2xl relative">
      <div class="flex items-center justify-between border-b border-slate-100 pb-3">
        <div class="flex items-center gap-2">
          <span class="text-xl">📜</span>
          <div>
            <h3 class="font-extrabold text-slate-900 text-base">Riwayat Kepemilikan</h3>
            <p id="ownership-item-title" class="text-xs text-slate-500 font-semibold">Nama Barang</p>
          </div>
        </div>
        <button onclick="document.getElementById('modal-ownership-history').classList.add('hidden')" class="text-slate-400 hover:text-slate-700 text-xl font-bold p-1">×</button>
      </div>

      <div id="ownership-history-timeline" class="space-y-4 max-h-[60vh] overflow-y-auto pr-1">
        <!-- Dynamic timeline entries -->
      </div>

      <div class="pt-3 border-t border-slate-100 flex justify-end">
        <button type="button" onclick="document.getElementById('modal-ownership-history').classList.add('hidden')" class="px-4 py-2 rounded-xl bg-navy-900 text-white text-xs font-bold">
          Tutup
        </button>
      </div>
    </div>
  </div>

  <script>
    const AUTH_API = import.meta.env.PUBLIC_AUTH_URL ? `${import.meta.env.PUBLIC_AUTH_URL}/auth` : 'http://127.0.0.1:26376/api/auth';
    const INVENTORY_API = 'http://127.0.0.1:26373/api/inventory';
    const MARKETPLACE_API = 'http://127.0.0.1:26374/api/marketplace';
    const BIDDING_API = 'http://127.0.0.1:26375/api/bidding';

    let items: any[] = [];
    let marketplaceListings: any[] = [];
    let bids: any[] = [];
    let currentSession: { token?: string; user?: any } | null = null;
    let selectedInventoryCategory = 'all';
    let customInventoryCategories: string[] = [];
    let categoryPreferenceOwnerId: string | null = null;

    const DEFAULT_INVENTORY_CATEGORIES = ['Electronics', 'Cameras', 'Bicycles', 'Books', 'Musical Instruments', 'Furniture'];

    // DOM Views
    const signedOutLanding = document.getElementById('signed-out-landing');
    const signedInDashboard = document.getElementById('signed-in-dashboard');

    // DOM Elements
    const gridInventory = document.getElementById('inventory-grid');
    const gridMarketplace = document.getElementById('marketplace-grid');
    const listBids = document.getElementById('bids-list');
    const categoryTabs = document.getElementById('inventory-category-tabs');
    const categorySection = document.getElementById('inventory-category-section');

    const modalItem = document.getElementById('modal-item');
    const modalCategory = document.getElementById('modal-category');
    const modalBid = document.getElementById('modal-bid');
    const modalWizard = document.getElementById('modal-wizard');
    const categoryNameInput = document.getElementById('input-category-name') as HTMLInputElement | null;
    const categoryFormError = document.getElementById('category-form-error');

    const inputSellable = document.getElementById('input-sellable') as HTMLInputElement;
    const askingPriceContainer = document.getElementById('asking-price-container');

    function escapeHtml(value: string) {
      return value.replace(/[&<>'"]/g, char => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#039;', '"': '&quot;'
      }[char] || char));
    }

    function categoryLabel(category: string) {
      const labels: Record<string, string> = {
        Electronics: 'Elektronik', Cameras: 'Kamera', Bicycles: 'Sepeda',
        Books: 'Buku', 'Musical Instruments': 'Alat Musik', Furniture: 'Furnitur'
      };
      return labels[category] || category;
    }

    function categoryPreferenceKey() {
      return `stuff8_inventory_categories_${currentSession?.user?.id || 'guest'}`;
    }

    function loadCategoryPreferences() {
      const ownerId = currentSession?.user?.id || null;
      if (ownerId === categoryPreferenceOwnerId) return;

      categoryPreferenceOwnerId = ownerId;
      selectedInventoryCategory = 'all';
      try {
        const saved = JSON.parse(localStorage.getItem(categoryPreferenceKey()) || '[]');
        customInventoryCategories = Array.isArray(saved)
          ? saved.filter(category => typeof category === 'string' && category.trim())
          : [];
      } catch {
        customInventoryCategories = [];
      }
    }

    function getSelectableInventoryCategories() {
      return Array.from(new Set([
        ...DEFAULT_INVENTORY_CATEGORIES,
        ...customInventoryCategories,
        ...items.map(item => item.category).filter(Boolean)
      ]));
    }

    function getVisibleInventoryCategories() {
      return Array.from(new Set(items.map(item => item.category).filter(Boolean)));
    }

    function syncCategorySelects() {
      const categories = getSelectableInventoryCategories();
      ['input-category', 'w-item-category'].forEach(id => {
        const select = document.getElementById(id) as HTMLSelectElement | null;
        if (!select) return;

        const currentValue = select.value;
        select.innerHTML = categories.map(category =>
          `<option value="${escapeHtml(category)}">${escapeHtml(categoryLabel(category))}</option>`
        ).join('');
        select.value = selectedInventoryCategory !== 'all' && categories.includes(selectedInventoryCategory)
          ? selectedInventoryCategory
          : (categories.includes(currentValue) ? currentValue : categories[0]);
      });
    }

    function renderCategoryTabs() {
      if (!categoryTabs) return;
      const categories = getVisibleInventoryCategories();
      if (selectedInventoryCategory !== 'all' && !categories.includes(selectedInventoryCategory)) {
        selectedInventoryCategory = 'all';
      }

      const renderTab = (category: string, label: string, count: number) => {
        const active = selectedInventoryCategory === category;
        return `<button type="button" role="tab" aria-selected="${active}" data-category="${escapeHtml(category)}" class="shrink-0 min-h-9 rounded-full border px-3 py-1.5 text-xs font-semibold transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-900 ${active ? 'border-navy-900 bg-navy-900 text-white' : 'border-slate-200 bg-white text-slate-700 hover:border-slate-300 hover:bg-slate-50'}">${escapeHtml(label)} <span class="ml-1 ${active ? 'text-slate-300' : 'text-slate-400'}">${count}</span></button>`;
      };

      categoryTabs.innerHTML = [
        renderTab('all', 'Semua', items.length),
        ...categories.map(category => renderTab(category, categoryLabel(category), items.filter(item => item.category === category).length))
      ].join('');
      syncCategorySelects();
    }

    function closeCategoryModal() {
      modalCategory?.classList.add('hidden');
      modalCategory?.classList.remove('flex');
    }

    function showCategoryError(message: string) {
      if (!categoryFormError) return;
      categoryFormError.textContent = message;
      categoryFormError.classList.remove('hidden');
    }

    function openCategoryModal() {
      if (!modalCategory || !categoryNameInput) return;
      categoryFormError?.classList.add('hidden');
      categoryNameInput.value = '';
      modalCategory.classList.remove('hidden');
      modalCategory.classList.add('flex');
      requestAnimationFrame(() => categoryNameInput.focus());
    }

    // Onboarding Wizard Elements
    const wizardStepIndicator = document.getElementById('wizard-step-indicator');
    const step1 = document.getElementById('wizard-step-1');
    const step2 = document.getElementById('wizard-step-2');
    const step3 = document.getElementById('wizard-step-3');

    const tabAuthSignin = document.getElementById('tab-auth-signin');
    const tabAuthSignup = document.getElementById('tab-auth-signup');
    const formAuthSignin = document.getElementById('form-auth-signin');
    const formAuthSignup = document.getElementById('form-auth-signup');
    const authSigninError = document.getElementById('auth-signin-error');
    const authSignupError = document.getElementById('auth-signup-error');

    document.querySelectorAll<HTMLButtonElement>('[data-password-toggle]').forEach((button) => {
      const input = document.getElementById(button.dataset.passwordToggle || '') as HTMLInputElement | null;
      if (!input) return;

      button.addEventListener('click', () => {
        const reveal = input.type === 'password';
        input.type = reveal ? 'text' : 'password';
        button.querySelector<SVGElement>('[data-password-eye="hidden"]')?.classList.toggle('hidden', reveal);
        button.querySelector<SVGElement>('[data-password-eye="visible"]')?.classList.toggle('hidden', !reveal);
        button.setAttribute('aria-label', reveal ? 'Sembunyikan kata sandi' : 'Tampilkan kata sandi');
        button.setAttribute('aria-pressed', String(reveal));
      });
    });

    // Initialize User Session
    function initUserSession() {
      const savedSession = localStorage.getItem('stuff8_session');
      if (savedSession) {
        try {
          currentSession = JSON.parse(savedSession);
        } catch (e) {
          currentSession = null;
        }
      }
      updateAuthUIState();
    }

    function updateAuthUIState() {
      const pillEl = document.getElementById('user-profile-pill');
      const loginBtnHeader = document.getElementById('btn-header-login');
      const initialEl = document.getElementById('user-avatar-initial');
      const nameEl = document.getElementById('user-display-name');

      const isAuthenticated = !!(currentSession && currentSession.user);

      if (isAuthenticated) {
        pillEl?.classList.remove('hidden');
        loginBtnHeader?.classList.add('hidden');
        if (initialEl) initialEl.textContent = (currentSession!.user.name || currentSession!.user.username || 'U').charAt(0).toUpperCase();
        if (nameEl) nameEl.textContent = currentSession!.user.name || currentSession!.user.username;

        signedOutLanding?.classList.add('hidden');
        signedInDashboard?.classList.remove('hidden');
      } else {
        pillEl?.classList.add('hidden');
        loginBtnHeader?.classList.remove('hidden');

        signedOutLanding?.classList.remove('hidden');
        signedInDashboard?.classList.add('hidden');
      }
    }

    // Hero Section Event Handlers
    document.getElementById('btn-hero-start')?.addEventListener('click', () => openWizard());
    document.getElementById('btn-hero-browse-mkt')?.addEventListener('click', () => {
      document.getElementById('public-marketplace-visitor-grid')?.scrollIntoView({ behavior: 'smooth' });
    });

    // Modal Triggers
    document.getElementById('btn-add-item')?.addEventListener('click', () => {
      if (!currentSession || !currentSession.user) {
        openWizard();
      } else {
        syncCategorySelects();
        modalItem?.classList.remove('hidden');
      }
    });
    categoryTabs?.addEventListener('click', event => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-category]');
      if (!button) return;
      selectedInventoryCategory = button.dataset.category || 'all';
      render();
    });
    document.getElementById('btn-add-category')?.addEventListener('click', openCategoryModal);
    document.getElementById('btn-close-category-modal')?.addEventListener('click', closeCategoryModal);
    document.getElementById('btn-cancel-category-modal')?.addEventListener('click', closeCategoryModal);
    document.getElementById('form-category')?.addEventListener('submit', event => {
      event.preventDefault();
      const category = categoryNameInput?.value.trim() || '';
      if (!category) {
        showCategoryError('Masukkan nama kategori terlebih dahulu.');
        categoryNameInput?.focus();
        return;
      }
      if (getSelectableInventoryCategories().some(existing => existing.toLocaleLowerCase() === category.toLocaleLowerCase())) {
        showCategoryError('Kategori ini sudah tersedia.');
        categoryNameInput?.focus();
        return;
      }

      customInventoryCategories.push(category);
      localStorage.setItem(categoryPreferenceKey(), JSON.stringify(customInventoryCategories));
      syncCategorySelects();
      const itemCategorySelect = document.getElementById('input-category') as HTMLSelectElement | null;
      if (itemCategorySelect) itemCategorySelect.value = category;
      closeCategoryModal();
    });
    document.getElementById('btn-close-modal')?.addEventListener('click', () => modalItem?.classList.add('hidden'));
    document.getElementById('btn-cancel-modal')?.addEventListener('click', () => modalItem?.classList.add('hidden'));

    document.getElementById('btn-close-bid-modal')?.addEventListener('click', () => modalBid?.classList.add('hidden'));
    document.getElementById('btn-cancel-bid-modal')?.addEventListener('click', () => modalBid?.classList.add('hidden'));

    inputSellable?.addEventListener('change', () => {
      askingPriceContainer?.classList.toggle('hidden', !inputSellable.checked);
    });

    // Wizard Controls
    function setWizardStep(step: 1 | 2 | 3) {
      if (wizardStepIndicator) wizardStepIndicator.textContent = `Langkah ${step} dari 3`;
      step1?.classList.toggle('hidden', step !== 1);
      step2?.classList.toggle('hidden', step !== 2);
      step3?.classList.toggle('hidden', step !== 3);
    }

    function openWizard() {
      setWizardStep(currentSession && currentSession.user ? 2 : 1);
      modalWizard?.classList.remove('hidden');
    }

    function closeWizard() {
      modalWizard?.classList.add('hidden');
    }

    document.getElementById('btn-onboarding-wizard')?.addEventListener('click', openWizard);
    document.getElementById('btn-header-login')?.addEventListener('click', openWizard);
    document.getElementById('btn-close-wizard')?.addEventListener('click', closeWizard);

    document.getElementById('btn-wizard-back-1')?.addEventListener('click', () => setWizardStep(1));
    document.getElementById('btn-wizard-next-2')?.addEventListener('click', () => setWizardStep(3));
    document.getElementById('btn-wizard-back-2')?.addEventListener('click', () => setWizardStep(2));

    // Auth Mode Toggles
    tabAuthSignin?.addEventListener('click', () => {
      tabAuthSignin.className = 'flex-1 py-2 rounded-md bg-white text-navy-900 font-bold shadow-xs transition-all';
      tabAuthSignup!.className = 'flex-1 py-2 rounded-md hover:text-slate-900 transition-all font-semibold';
      formAuthSignin?.classList.remove('hidden');
      formAuthSignup?.classList.add('hidden');
    });

    tabAuthSignup?.addEventListener('click', () => {
      tabAuthSignup.className = 'flex-1 py-2 rounded-md bg-white text-navy-900 font-bold shadow-xs transition-all';
      tabAuthSignin!.className = 'flex-1 py-2 rounded-md hover:text-slate-900 transition-all font-semibold';
      formAuthSignup?.classList.remove('hidden');
      formAuthSignin?.classList.add('hidden');
    });

    document.getElementById('btn-logout')?.addEventListener('click', () => {
      localStorage.removeItem('stuff8_session');
      localStorage.removeItem('stuff8_wizard_completed');
      currentSession = null;
      updateAuthUIState();
      window.scrollTo({ top: 0, behavior: 'smooth' });
      loadData();
    });

    // Real Sign In Handler (calls Auth Domain Microservice)
    formAuthSignin?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (authSigninError) authSigninError.classList.add('hidden');

      const username = (document.getElementById('signin-username') as HTMLInputElement).value;
      const password = (document.getElementById('signin-password') as HTMLInputElement).value;

      try {
        const res = await fetch(`${AUTH_API}/login`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ username, password })
        });

        const data = await res.json();
        if (res.ok && data.token) {
          currentSession = data;
          localStorage.setItem('stuff8_session', JSON.stringify(data));
          updateAuthUIState();
          closeWizard();
          await loadData();
        } else {
          if (authSigninError) {
            authSigninError.textContent = data.message || data.error || 'Gagal masuk. Username atau kata sandi salah, coba cek lagi ya.';
            authSigninError.classList.remove('hidden');
          }
        }
      } catch (err) {
        if (authSigninError) {
          authSigninError.textContent = 'Gagal terhubung ke layanan Auth di ' + AUTH_API;
          authSigninError.classList.remove('hidden');
        }
      }
    });

    // Real Sign Up / Registration Handler (calls Auth Domain Microservice)
    formAuthSignup?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (authSignupError) authSignupError.classList.add('hidden');

      const name = (document.getElementById('signup-name') as HTMLInputElement).value;
      const username = (document.getElementById('signup-username') as HTMLInputElement).value;
      const email = (document.getElementById('signup-email') as HTMLInputElement).value;
      const password = (document.getElementById('signup-password') as HTMLInputElement).value;

      try {
        const queryParams = new URLSearchParams({ username, email, password, name });
        const res = await fetch(`${AUTH_API}/register?${queryParams.toString()}`, {
          method: 'POST'
        });

        const data = await res.json();
        if (res.ok && data.token) {
          currentSession = data;
          localStorage.setItem('stuff8_session', JSON.stringify(data));
          updateAuthUIState();
          setWizardStep(2);
        } else {
          if (authSignupError) {
