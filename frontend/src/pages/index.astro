  <script>
    const AUTH_API = import.meta.env.PUBLIC_AUTH_URL ? `${import.meta.env.PUBLIC_AUTH_URL}/auth` : 'http://127.0.0.1:26376/api/auth';
    const INVENTORY_API = 'http://127.0.0.1:26373/api/inventory';
    const MARKETPLACE_API = 'http://127.0.0.1:26374/api/marketplace';
    const BIDDING_API = 'http://127.0.0.1:26375/api/bidding';

    let items: any[] = [];
    let marketplaceListings: any[] = [];
    let bids: any[] = [];
    let currentSession: { token?: string; user?: any } | null = null;

    // DOM Views
    const signedOutLanding = document.getElementById('signed-out-landing');
    const signedInDashboard = document.getElementById('signed-in-dashboard');

    // DOM Elements
    const gridInventory = document.getElementById('inventory-grid');
    const gridMarketplace = document.getElementById('marketplace-grid');
    const listBids = document.getElementById('bids-list');

    const modalItem = document.getElementById('modal-item');
    const modalBid = document.getElementById('modal-bid');
    const modalWizard = document.getElementById('modal-wizard');

    const inputSellable = document.getElementById('input-sellable') as HTMLInputElement;
    const askingPriceContainer = document.getElementById('asking-price-container');

    // Navigation Tabs
    const tabInventory = document.getElementById('tab-btn-inventory');
    const tabMarketplace = document.getElementById('tab-btn-marketplace');
    const tabBids = document.getElementById('tab-btn-bids');

    const secInventory = document.getElementById('inventory-section');
    const secMarketplace = document.getElementById('marketplace-section');
    const secBids = document.getElementById('bids-section');

    const headingTitle = document.getElementById('page-heading-title');
    const headingSub = document.getElementById('page-heading-sub');

    // Onboarding Wizard Elements
    const wizardStepIndicator = document.getElementById('wizard-step-indicator');
    const step1 = document.getElementById('wizard-step-1');
    const step2 = document.getElementById('wizard-step-2');
    const step3 = document.getElementById('wizard-step-3');

    const tabAuthSignin = document.getElementById('tab-auth-signin');
    const tabAuthSignup = document.getElementById('tab-auth-signup');
    const formAuthSignin = document.getElementById('form-auth-signin');
    const formAuthSignup = document.getElementById('form-auth-signup');
    const authSigninError = document.getElementById('auth-signin-error');
    const authSignupError = document.getElementById('auth-signup-error');

    // Initialize User Session
    function initUserSession() {
      const savedSession = localStorage.getItem('stuff8_session');
      if (savedSession) {
        try {
          currentSession = JSON.parse(savedSession);
        } catch (e) {
          currentSession = null;
        }
      }
      updateAuthUIState();
    }

    function updateAuthUIState() {
      const pillEl = document.getElementById('user-profile-pill');
      const loginBtnHeader = document.getElementById('btn-header-login');
      const initialEl = document.getElementById('user-avatar-initial');
      const nameEl = document.getElementById('user-display-name');

      const isAuthenticated = !!(currentSession && currentSession.user);

      if (isAuthenticated) {
        pillEl?.classList.remove('hidden');
        loginBtnHeader?.classList.add('hidden');
        if (initialEl) initialEl.textContent = (currentSession!.user.name || currentSession!.user.username || 'U').charAt(0).toUpperCase();
        if (nameEl) nameEl.textContent = currentSession!.user.name || currentSession!.user.username;

        signedOutLanding?.classList.add('hidden');
        signedInDashboard?.classList.remove('hidden');
      } else {
        pillEl?.classList.add('hidden');
        loginBtnHeader?.classList.remove('hidden');

        signedOutLanding?.classList.remove('hidden');
        signedInDashboard?.classList.add('hidden');
      }
    }

    function switchTab(tab: 'inventory' | 'marketplace' | 'bids') {
      secInventory?.classList.toggle('hidden', tab !== 'inventory');
      secMarketplace?.classList.toggle('hidden', tab !== 'marketplace');
      secBids?.classList.toggle('hidden', tab !== 'bids');

      tabInventory?.classList.toggle('text-emerald-400', tab === 'inventory');
      tabInventory?.classList.toggle('border-emerald-400', tab === 'inventory');
      tabMarketplace?.classList.toggle('text-emerald-400', tab === 'marketplace');
      tabMarketplace?.classList.toggle('border-emerald-400', tab === 'marketplace');
      tabBids?.classList.toggle('text-emerald-400', tab === 'bids');
      tabBids?.classList.toggle('border-emerald-400', tab === 'bids');

      if (headingTitle && headingSub) {
        if (tab === 'inventory') {
          headingTitle.textContent = 'My Belongings & Assets';
          headingSub.textContent = 'Private digital catalog of your physical belongings. Toggle items to sellable to project them to the public marketplace.';
        } else if (tab === 'marketplace') {
          headingTitle.textContent = 'Public Marketplace Projection';
          headingSub.textContent = 'Browse items published by owners. Submit direct price bids to sellers.';
        } else {
          headingTitle.textContent = 'Active Bids & Offers Queue';
          headingSub.textContent = 'Review incoming cash offers on your items or check status of your submitted bids.';
        }
      }
    }

    tabInventory?.addEventListener('click', () => switchTab('inventory'));
    tabMarketplace?.addEventListener('click', () => switchTab('marketplace'));
    tabBids?.addEventListener('click', () => switchTab('bids'));

    // Hero Section Event Handlers
    document.getElementById('btn-hero-start')?.addEventListener('click', () => openWizard());
    document.getElementById('btn-hero-browse-mkt')?.addEventListener('click', () => {
      if (currentSession && currentSession.user) {
        switchTab('marketplace');
      } else {
        document.getElementById('public-marketplace-visitor-grid')?.scrollIntoView({ behavior: 'smooth' });
      }
    });

    // Modal Triggers
    document.getElementById('btn-add-item')?.addEventListener('click', () => {
      if (!currentSession || !currentSession.user) {
        openWizard();
      } else {
        modalItem?.classList.remove('hidden');
      }
    });
    document.getElementById('btn-close-modal')?.addEventListener('click', () => modalItem?.classList.add('hidden'));
