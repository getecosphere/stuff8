    // Render Function
    function render() {
      const invCount = document.getElementById('inventory-count');
      const mktCount = document.getElementById('marketplace-count');
      const bidCount = document.getElementById('bids-count');

      const statTotalItems = document.getElementById('stat-total-items');
      const statTotalValue = document.getElementById('stat-total-value');
      const statSellableCount = document.getElementById('stat-sellable-count');
      const statBidsCount = document.getElementById('stat-bids-count');

      if (invCount) invCount.textContent = items.length.toString();
      if (mktCount) mktCount.textContent = marketplaceListings.length.toString();
      if (bidCount) bidCount.textContent = bids.length.toString();

      if (statTotalItems) statTotalItems.textContent = items.length.toString();
      const totalVal = items.reduce((acc, curr) => acc + (curr.estimated_value || 0), 0);
      if (statTotalValue) statTotalValue.textContent = `Rp ${totalVal.toLocaleString('id-ID')}`;
      if (statSellableCount) statSellableCount.textContent = marketplaceListings.length.toString();
