      const valElec = rElec * 7500000;
      const valSport = rSport * 5250000;
      const valMusic = rMusic * 6000000;
      const valOther = rOther * 1200000;

      const total = valElec + valSport + valMusic + valOther;

      const elElec = document.getElementById('calc-val-electronics');
      const elSport = document.getElementById('calc-val-sports');
      const elMusic = document.getElementById('calc-val-music');
      const elOther = document.getElementById('calc-val-other');
