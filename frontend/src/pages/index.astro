                <div class="pt-3 border-t border-navy-100 text-xs space-y-1.5">
                  <div class="flex justify-between text-slate-500">
                    <span>Lokasi Simpan:</span> <span class="font-medium text-navy-800">${item.storage_location || '-'}</span>
