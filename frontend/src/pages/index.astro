---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Stuff8 — Personal Inventory & Asset Management">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
    
    <!-- Clean Dashboard Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-slate-800/80 pb-6">
      <div>
        <div class="flex items-center gap-2 mb-1">
          <span class="px-2.5 py-0.5 rounded-md text-[11px] font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 uppercase tracking-wider">
            Personal Inventory System
          </span>
        </div>
        <h1 id="page-heading-title" class="text-2xl sm:text-3xl font-extrabold tracking-tight text-slate-100">
          My Belongings & Assets
        </h1>
        <p id="page-heading-sub" class="text-slate-400 text-xs sm:text-sm mt-1">
          Private digital catalog of your physical belongings. Toggle items to sellable to project them to the public marketplace.
        </p>
      </div>

      <div class="flex items-center gap-3">
        <button id="btn-add-item" class="px-4 py-2.5 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold text-xs shadow-md shadow-emerald-500/15 transition-all flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"></path></svg>
          Add Inventory Item
        </button>
      </div>
    </div>

    <!-- Stat Summary Tiles -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <div class="p-4 rounded-xl bg-slate-900 border border-slate-800 space-y-1">
        <span class="text-slate-400 text-xs font-medium">Total Belongings</span>
        <div id="stat-total-items" class="text-2xl font-extrabold text-slate-100">0</div>
      </div>
      <div class="p-4 rounded-xl bg-slate-900 border border-slate-800 space-y-1">
        <span class="text-slate-400 text-xs font-medium">Est. Asset Value</span>
        <div id="stat-total-value" class="text-2xl font-extrabold text-emerald-400">$0</div>
      </div>
      <div class="p-4 rounded-xl bg-slate-900 border border-slate-800 space-y-1">
        <span class="text-slate-400 text-xs font-medium">Sellable Listings</span>
        <div id="stat-sellable-count" class="text-2xl font-extrabold text-teal-300">0</div>
      </div>
      <div class="p-4 rounded-xl bg-slate-900 border border-slate-800 space-y-1">
        <span class="text-slate-400 text-xs font-medium">Active Offers & Bids</span>
        <div id="stat-bids-count" class="text-2xl font-extrabold text-amber-400">0</div>
      </div>
    </div>

    <!-- Navigation Tab Switcher -->
    <div class="flex items-center justify-between border-b border-slate-800">
      <div class="flex gap-6 text-xs sm:text-sm font-semibold text-slate-400">
        <button id="tab-btn-inventory" class="py-3 text-emerald-400 border-b-2 border-emerald-400 flex items-center gap-2">
          <span>📦 Private Inventory</span>
          <span id="inventory-count" class="px-2 py-0.5 text-xs rounded-full bg-emerald-950 text-emerald-300 border border-emerald-800/40">0</span>
        </button>
        <button id="tab-btn-marketplace" class="py-3 hover:text-slate-200 border-b-2 border-transparent flex items-center gap-2">
          <span>🏷️ Public Marketplace</span>
          <span id="marketplace-count" class="px-2 py-0.5 text-xs rounded-full bg-slate-800 text-slate-300">0</span>
        </button>
        <button id="tab-btn-bids" class="py-3 hover:text-slate-200 border-b-2 border-transparent flex items-center gap-2">
          <span>🤝 Offers & Bids</span>
          <span id="bids-count" class="px-2 py-0.5 text-xs rounded-full bg-slate-800 text-slate-300">0</span>
        </button>
      </div>
    </div>

    <!-- Section 1: Private Inventory View -->
    <section id="inventory-section" class="space-y-6">
      <div id="inventory-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Dynamic Inventory Items Rendered Here -->
      </div>
    </section>

    <!-- Section 2: Public Marketplace View -->
    <section id="marketplace-section" class="space-y-6 hidden">
      <div id="marketplace-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Dynamic Marketplace Items Rendered Here -->
      </div>
    </section>

    <!-- Section 3: Offers & Bidding Queue -->
    <section id="bids-section" class="space-y-6 hidden">
      <div id="bids-list" class="space-y-4">
        <!-- Dynamic Bids Rendered Here -->
      </div>
    </section>

  </div>

  <!-- ONBOARDING WIZARD MODAL -->
  <div id="modal-wizard" class="fixed inset-0 bg-slate-950/85 backdrop-blur-md z-50 flex items-center justify-center p-4 hidden">
    <div class="bg-slate-900 border border-slate-800 rounded-2xl max-w-lg w-full p-6 space-y-6 shadow-2xl relative overflow-hidden">
      <!-- Header -->
      <div class="flex items-center justify-between text-xs font-semibold text-slate-400 border-b border-slate-800 pb-3">
        <div class="flex items-center gap-2">
          <span class="w-6 h-6 rounded-md bg-emerald-500 text-slate-950 flex items-center justify-center font-black text-xs">S8</span>
          <span class="text-slate-200">Stuff8 Onboarding Wizard</span>
        </div>
        <div class="flex items-center gap-1.5 text-slate-400">
          <span id="wizard-step-indicator" class="text-emerald-400 font-mono text-[11px]">Step 1 of 3</span>
          <button id="btn-close-wizard" class="ml-3 text-slate-500 hover:text-slate-200 text-base font-bold">×</button>
        </div>
      </div>

      <!-- WIZARD STEP 1: Account Authentication (Sign In / Sign Up) -->
      <div id="wizard-step-1" class="space-y-5">
        <div class="space-y-1">
          <h2 class="text-xl font-bold text-slate-100">Welcome to Stuff8</h2>
          <p class="text-slate-400 text-xs">Authenticate via the Auth domain microservice to start managing your belongings.</p>
        </div>

        <!-- Auth Toggle Switcher -->
        <div class="flex rounded-xl bg-slate-950 p-1 border border-slate-800 text-xs font-semibold text-slate-400">
          <button id="tab-auth-signin" type="button" class="flex-1 py-2 rounded-lg bg-emerald-500 text-slate-950 font-bold transition-all">Sign In</button>
          <button id="tab-auth-signup" type="button" class="flex-1 py-2 rounded-lg hover:text-slate-200 transition-all">Create Account</button>
        </div>

        <!-- SIGN IN FORM -->
        <form id="form-auth-signin" class="space-y-4">
          <div id="auth-signin-error" class="p-3 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-400 text-xs hidden"></div>

          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1">Username</label>
            <input type="text" id="signin-username" required placeholder="Enter your username" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-800 text-slate-100 text-sm focus:border-emerald-500 focus:outline-none" />
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1">Password</label>
            <input type="password" id="signin-password" required placeholder="••••••••" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-800 text-slate-100 text-sm focus:border-emerald-500 focus:outline-none" />
          </div>

          <button type="submit" class="w-full py-2.5 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold text-xs shadow-md shadow-emerald-500/20 transition-all flex items-center justify-center gap-2">
            <span>Sign In to Account</span>
            <span>→</span>
          </button>
        </form>

        <!-- SIGN UP FORM -->
        <form id="form-auth-signup" class="space-y-3.5 hidden">
          <div id="auth-signup-error" class="p-3 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-400 text-xs hidden"></div>

          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1">Full Name</label>
            <input type="text" id="signup-name" required placeholder="e.g. Alex Rivera" class="w-full px-3.5 py-2 rounded-xl bg-slate-950 border border-slate-800 text-slate-100 text-sm focus:border-emerald-500 focus:outline-none" />
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-semibold text-slate-300 mb-1">Username</label>
              <input type="text" id="signup-username" required placeholder="alexrivera" class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-slate-100 text-sm focus:border-emerald-500 focus:outline-none" />
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-300 mb-1">Email</label>
              <input type="email" id="signup-email" required placeholder="alex@domain.com" class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-slate-100 text-sm focus:border-emerald-500 focus:outline-none" />
            </div>
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1">Password (min 8 chars, uppercase, lowercase, number/symbol)</label>
            <input type="password" id="signup-password" required placeholder="Password123!" class="w-full px-3.5 py-2 rounded-xl bg-slate-950 border border-slate-800 text-slate-100 text-sm focus:border-emerald-500 focus:outline-none" />
          </div>

          <button type="submit" class="w-full py-2.5 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold text-xs shadow-md shadow-emerald-500/20 transition-all flex items-center justify-center gap-2">
            <span>Create Account & Continue</span>
            <span>→</span>
          </button>
        </form>
      </div>

      <!-- WIZARD STEP 2: Feature Walkthrough -->
      <div id="wizard-step-2" class="space-y-5 hidden">
        <div class="space-y-1">
          <h2 class="text-xl font-bold text-slate-100">How Stuff8 Works</h2>
          <p class="text-slate-400 text-xs">Inventory first, marketplace second. Learn how your belongings are managed.</p>
        </div>

        <div class="space-y-3">
          <div class="p-3.5 rounded-xl bg-slate-950 border border-slate-800 flex items-start gap-3">
            <div class="w-8 h-8 rounded-lg bg-emerald-500/10 text-emerald-400 flex items-center justify-center text-base shrink-0 font-bold">📦</div>
            <div>
              <h4 class="text-sm font-bold text-slate-200">1. Private Personal Inventory</h4>
              <p class="text-slate-400 text-xs mt-0.5">Catalog everything you own privately. Track storage locations, purchase cost, condition, and estimated value.</p>
            </div>
          </div>

          <div class="p-3.5 rounded-xl bg-slate-950 border border-slate-800 flex items-start gap-3">
            <div class="w-8 h-8 rounded-lg bg-teal-500/10 text-teal-400 flex items-center justify-center text-base shrink-0 font-bold">⚡</div>
            <div>
              <h4 class="text-sm font-bold text-slate-200">2. One-Click Marketplace Projection</h4>
              <p class="text-slate-400 text-xs mt-0.5">When you're ready to sell an item, toggle <code class="text-emerald-400 bg-slate-900 px-1 rounded font-mono text-[10px]">sellable = true</code> to list it on the public marketplace immediately.</p>
            </div>
          </div>

          <div class="p-3.5 rounded-xl bg-slate-950 border border-slate-800 flex items-start gap-3">
            <div class="w-8 h-8 rounded-lg bg-amber-500/10 text-amber-400 flex items-center justify-center text-base shrink-0 font-bold">🤝</div>
            <div>
              <h4 class="text-sm font-bold text-slate-200">3. Direct Bids & Cash Offers</h4>
              <p class="text-slate-400 text-xs mt-0.5">Interested buyers submit cash offers directly. Accept bids for simple offline payment (COD) transactions.</p>
            </div>
          </div>
        </div>

        <div class="flex justify-between items-center pt-2">
          <button type="button" id="btn-wizard-back-1" class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-semibold">← Back</button>
          <button type="button" id="btn-wizard-next-2" class="px-5 py-2 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 text-xs font-bold shadow-md shadow-emerald-500/20">Next: Add First Item →</button>
        </div>
      </div>

      <!-- WIZARD STEP 3: Add First Inventory Item -->
      <div id="wizard-step-3" class="space-y-5 hidden">
        <div class="space-y-1">
          <h2 class="text-xl font-bold text-slate-100">Add Your First Belonging</h2>
          <p class="text-slate-400 text-xs">Let's populate your private inventory with your first item!</p>
        </div>

        <form id="wizard-form-first-item" class="space-y-3.5">
          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1">Item Title</label>
            <input type="text" id="w-item-title" required placeholder="e.g. Sony Alpha A7 III Camera Body" class="w-full px-3 py-2 rounded-lg bg-slate-950 border border-slate-800 text-slate-100 text-sm focus:border-emerald-500 focus:outline-none" />
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-semibold text-slate-300 mb-1">Category</label>
              <select id="w-item-category" class="w-full px-3 py-2 rounded-lg bg-slate-950 border border-slate-800 text-slate-100 text-sm focus:border-emerald-500 focus:outline-none">
                <option value="Cameras">Cameras</option>
                <option value="Electronics">Electronics</option>
                <option value="Bicycles">Bicycles</option>
                <option value="Books">Books</option>
                <option value="Musical Instruments">Musical Instruments</option>
                <option value="Furniture">Furniture</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-300 mb-1">Condition</label>
              <select id="w-item-condition" class="w-full px-3 py-2 rounded-lg bg-slate-950 border border-slate-800 text-slate-100 text-sm focus:border-emerald-500 focus:outline-none">
                <option value="Like New">Like New</option>
                <option value="Good">Good</option>
                <option value="Fair">Fair</option>
                <option value="Used">Used</option>
              </select>
            </div>
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1">Description</label>
            <textarea id="w-item-description" rows="2" placeholder="Item description and details..." class="w-full px-3 py-2 rounded-lg bg-slate-950 border border-slate-800 text-slate-100 text-sm focus:border-emerald-500 focus:outline-none"></textarea>
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-semibold text-slate-300 mb-1">Estimated Value ($)</label>
              <input type="number" id="w-item-est-value" placeholder="1200" class="w-full px-3 py-2 rounded-lg bg-slate-950 border border-slate-800 text-slate-100 text-sm focus:border-emerald-500 focus:outline-none" />
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-300 mb-1">Storage Location</label>
              <input type="text" id="w-item-location" placeholder="Closet Box 3" class="w-full px-3 py-2 rounded-lg bg-slate-950 border border-slate-800 text-slate-100 text-sm focus:border-emerald-500 focus:outline-none" />
            </div>
          </div>

          <div class="p-3 rounded-xl bg-slate-950 border border-slate-800 flex items-center justify-between">
            <div>
              <span class="block text-xs font-semibold text-slate-200">List on Public Marketplace?</span>
              <span class="block text-[10px] text-slate-400">Sets sellable = true</span>
            </div>
            <input type="checkbox" id="w-item-sellable" class="w-4 h-4 accent-emerald-500 rounded cursor-pointer" />
          </div>

          <div class="flex justify-between items-center pt-2">
            <button type="button" id="btn-wizard-back-2" class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-semibold">← Back</button>
            <button type="submit" class="px-5 py-2 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 text-xs font-bold shadow-md shadow-emerald-500/20">Complete Setup & Save 🎉</button>
          </div>
        </form>
      </div>

    </div>
  </div>

  <!-- Modal: Add Inventory Item (Direct) -->
  <div id="modal-item" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 max-w-lg w-full space-y-4 shadow-2xl relative">
      <div class="flex items-center justify-between border-b border-slate-800 pb-3">
        <h3 class="text-lg font-bold text-slate-100">Add Item to Inventory</h3>
        <button id="btn-close-modal" class="text-slate-400 hover:text-slate-200 text-xl font-bold">×</button>
      </div>

      <form id="form-item" class="space-y-4">
        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1">Item Title</label>
          <input type="text" id="input-title" required placeholder="e.g. Sony A7 III Camera Body" class="w-full px-3 py-2 rounded-lg bg-slate-950 border border-slate-800 text-slate-100 text-sm focus:border-emerald-500 focus:outline-none" />
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1">Category</label>
            <select id="input-category" class="w-full px-3 py-2 rounded-lg bg-slate-950 border border-slate-800 text-slate-100 text-sm focus:border-emerald-500 focus:outline-none">
              <option value="Electronics">Electronics</option>
              <option value="Cameras">Cameras</option>
              <option value="Bicycles">Bicycles</option>
              <option value="Books">Books</option>
              <option value="Musical Instruments">Musical Instruments</option>
              <option value="Furniture">Furniture</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1">Condition</label>
            <select id="input-condition" class="w-full px-3 py-2 rounded-lg bg-slate-950 border border-slate-800 text-slate-100 text-sm focus:border-emerald-500 focus:outline-none">
              <option value="Like New">Like New</option>
              <option value="Good">Good</option>
              <option value="Fair">Fair</option>
              <option value="Used">Used</option>
            </select>
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1">Description</label>
          <textarea id="input-description" rows="2" placeholder="Item description and details..." class="w-full px-3 py-2 rounded-lg bg-slate-950 border border-slate-800 text-slate-100 text-sm focus:border-emerald-500 focus:outline-none"></textarea>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1">Estimated Value ($)</label>
            <input type="number" id="input-estimated-value" placeholder="1200" class="w-full px-3 py-2 rounded-lg bg-slate-950 border border-slate-800 text-slate-100 text-sm focus:border-emerald-500 focus:outline-none" />
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1">Storage Location (Private)</label>
            <input type="text" id="input-storage-location" placeholder="Closet Box 3" class="w-full px-3 py-2 rounded-lg bg-slate-950 border border-slate-800 text-slate-100 text-sm focus:border-emerald-500 focus:outline-none" />
          </div>
        </div>

        <div class="p-3 rounded-xl bg-slate-950/60 border border-slate-800 flex items-center justify-between">
          <div>
            <span class="block text-sm font-semibold text-slate-200">Available For Sale?</span>
            <span class="block text-xs text-slate-400">Exposes item on public marketplace</span>
          </div>
          <input type="checkbox" id="input-sellable" class="w-5 h-5 accent-emerald-500 rounded cursor-pointer" />
        </div>

        <div id="asking-price-container" class="hidden">
          <label class="block text-xs font-semibold text-emerald-400 mb-1">Asking Price ($)</label>
          <input type="number" id="input-asking-price" placeholder="950" class="w-full px-3 py-2 rounded-lg bg-slate-950 border border-emerald-500/50 text-slate-100 text-sm focus:border-emerald-500 focus:outline-none" />
        </div>

        <div class="flex justify-end gap-3 pt-3 border-t border-slate-800">
          <button type="button" id="btn-cancel-modal" class="px-4 py-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 text-sm font-semibold">Cancel</button>
          <button type="submit" class="px-4 py-2 rounded-lg bg-emerald-500 hover:bg-emerald-400 text-slate-950 text-sm font-bold shadow-md shadow-emerald-500/20">Save Inventory Item</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal: Place Bid -->
  <div id="modal-bid" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 max-w-md w-full space-y-4 shadow-2xl relative">
      <div class="flex items-center justify-between border-b border-slate-800 pb-3">
        <h3 class="text-lg font-bold text-slate-100">Submit Offer / Bid</h3>
        <button id="btn-close-bid-modal" class="text-slate-400 hover:text-slate-200 text-xl font-bold">×</button>
      </div>

      <form id="form-bid" class="space-y-4">
        <input type="hidden" id="bid-item-id" />
        <div>
          <span id="bid-item-title" class="block font-bold text-emerald-400 text-base mb-1">Item Title</span>
          <span id="bid-asking-price" class="block text-slate-400 text-xs">Asking Price: $0</span>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1">Your Name</label>
          <input type="text" id="bid-buyer-name" required placeholder="John Doe" class="w-full px-3 py-2 rounded-lg bg-slate-950 border border-slate-800 text-slate-100 text-sm focus:border-emerald-500 focus:outline-none" />
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1">Contact Info (Phone / WhatsApp / Email)</label>
          <input type="text" id="bid-contact-info" required placeholder="+1 555-0199 or email@domain.com" class="w-full px-3 py-2 rounded-lg bg-slate-950 border border-slate-800 text-slate-100 text-sm focus:border-emerald-500 focus:outline-none" />
        </div>

        <div>
          <label class="block text-xs font-semibold text-emerald-400 mb-1">Your Offer Amount ($)</label>
          <input type="number" id="bid-amount" required placeholder="850" class="w-full px-3 py-2 rounded-lg bg-slate-950 border border-emerald-500/50 text-slate-100 text-sm focus:border-emerald-500 focus:outline-none" />
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1">Message / Note to Seller (Optional)</label>
          <textarea id="bid-note" rows="2" placeholder="Can pick up in cash tomorrow morning..." class="w-full px-3 py-2 rounded-lg bg-slate-950 border border-slate-800 text-slate-100 text-sm focus:border-emerald-500 focus:outline-none"></textarea>
        </div>

        <div class="flex justify-end gap-3 pt-3 border-t border-slate-800">
          <button type="button" id="btn-cancel-bid-modal" class="px-4 py-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 text-sm font-semibold">Cancel</button>
          <button type="submit" class="px-4 py-2 rounded-lg bg-emerald-500 hover:bg-emerald-400 text-slate-950 text-sm font-bold shadow-md shadow-emerald-500/20">Submit Bid</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    const AUTH_API = import.meta.env.PUBLIC_AUTH_URL ? `${import.meta.env.PUBLIC_AUTH_URL}/auth` : 'http://127.0.0.1:26376/api/auth';
    const INVENTORY_API = 'http://127.0.0.1:26373/api/inventory';
    const MARKETPLACE_API = 'http://127.0.0.1:26374/api/marketplace';
    const BIDDING_API = 'http://127.0.0.1:26375/api/bidding';

    let items: any[] = [];
    let marketplaceListings: any[] = [];
    let bids: any[] = [];
    let currentSession: { token?: string; user?: any } | null = null;

    // DOM Elements
    const gridInventory = document.getElementById('inventory-grid');
    const gridMarketplace = document.getElementById('marketplace-grid');
    const listBids = document.getElementById('bids-list');

    const modalItem = document.getElementById('modal-item');
    const modalBid = document.getElementById('modal-bid');
    const modalWizard = document.getElementById('modal-wizard');

    const inputSellable = document.getElementById('input-sellable') as HTMLInputElement;
    const askingPriceContainer = document.getElementById('asking-price-container');

    // Navigation Tabs
    const tabInventory = document.getElementById('tab-btn-inventory');
    const tabMarketplace = document.getElementById('tab-btn-marketplace');
    const tabBids = document.getElementById('tab-btn-bids');

    const secInventory = document.getElementById('inventory-section');
    const secMarketplace = document.getElementById('marketplace-section');
    const secBids = document.getElementById('bids-section');

    const headingTitle = document.getElementById('page-heading-title');
    const headingSub = document.getElementById('page-heading-sub');

    // Onboarding Wizard Elements
    const wizardStepIndicator = document.getElementById('wizard-step-indicator');
    const step1 = document.getElementById('wizard-step-1');
    const step2 = document.getElementById('wizard-step-2');
    const step3 = document.getElementById('wizard-step-3');

    const tabAuthSignin = document.getElementById('tab-auth-signin');
    const tabAuthSignup = document.getElementById('tab-auth-signup');
    const formAuthSignin = document.getElementById('form-auth-signin');
    const formAuthSignup = document.getElementById('form-auth-signup');
    const authSigninError = document.getElementById('auth-signin-error');
    const authSignupError = document.getElementById('auth-signup-error');

    // Initialize User Session
    function initUserSession() {
      const savedSession = localStorage.getItem('stuff8_session');
      if (savedSession) {
        try {
          currentSession = JSON.parse(savedSession);
        } catch (e) {
          currentSession = null;
        }
      }
      updateUserBadge();
    }

    function updateUserBadge() {
      const pillEl = document.getElementById('user-profile-pill');
      const loginBtnHeader = document.getElementById('btn-header-login');
      const initialEl = document.getElementById('user-avatar-initial');
      const nameEl = document.getElementById('user-display-name');

      if (currentSession && currentSession.user) {
        pillEl?.classList.remove('hidden');
        loginBtnHeader?.classList.add('hidden');
        if (initialEl) initialEl.textContent = (currentSession.user.name || currentSession.user.username || 'U').charAt(0).toUpperCase();
        if (nameEl) nameEl.textContent = currentSession.user.name || currentSession.user.username;
      } else {
        pillEl?.classList.add('hidden');
        loginBtnHeader?.classList.remove('hidden');
      }
    }

    function switchTab(tab: 'inventory' | 'marketplace' | 'bids') {
      secInventory?.classList.toggle('hidden', tab !== 'inventory');
      secMarketplace?.classList.toggle('hidden', tab !== 'marketplace');
      secBids?.classList.toggle('hidden', tab !== 'bids');

      tabInventory?.classList.toggle('text-emerald-400', tab === 'inventory');
      tabInventory?.classList.toggle('border-emerald-400', tab === 'inventory');
      tabMarketplace?.classList.toggle('text-emerald-400', tab === 'marketplace');
      tabMarketplace?.classList.toggle('border-emerald-400', tab === 'marketplace');
      tabBids?.classList.toggle('text-emerald-400', tab === 'bids');
      tabBids?.classList.toggle('border-emerald-400', tab === 'bids');

      if (headingTitle && headingSub) {
        if (tab === 'inventory') {
          headingTitle.textContent = 'My Belongings & Assets';
          headingSub.textContent = 'Private digital catalog of your physical belongings. Toggle items to sellable to project them to the public marketplace.';
        } else if (tab === 'marketplace') {
          headingTitle.textContent = 'Public Marketplace Projection';
          headingSub.textContent = 'Browse items published by owners. Submit direct price bids to sellers.';
        } else {
          headingTitle.textContent = 'Active Bids & Offers Queue';
          headingSub.textContent = 'Review incoming cash offers on your items or check status of your submitted bids.';
        }
      }
    }

    tabInventory?.addEventListener('click', () => switchTab('inventory'));
    tabMarketplace?.addEventListener('click', () => switchTab('marketplace'));
    tabBids?.addEventListener('click', () => switchTab('bids'));

    // Modal Triggers
    document.getElementById('btn-add-item')?.addEventListener('click', () => {
      if (!currentSession || !currentSession.user) {
        openWizard();
      } else {
        modalItem?.classList.remove('hidden');
      }
    });
    document.getElementById('btn-close-modal')?.addEventListener('click', () => modalItem?.classList.add('hidden'));
    document.getElementById('btn-cancel-modal')?.addEventListener('click', () => modalItem?.classList.add('hidden'));

    document.getElementById('btn-close-bid-modal')?.addEventListener('click', () => modalBid?.classList.add('hidden'));
    document.getElementById('btn-cancel-bid-modal')?.addEventListener('click', () => modalBid?.classList.add('hidden'));

    inputSellable?.addEventListener('change', () => {
      askingPriceContainer?.classList.toggle('hidden', !inputSellable.checked);
    });

    // Wizard Controls
    function setWizardStep(step: 1 | 2 | 3) {
      if (wizardStepIndicator) wizardStepIndicator.textContent = `Step ${step} of 3`;
      step1?.classList.toggle('hidden', step !== 1);
      step2?.classList.toggle('hidden', step !== 2);
      step3?.classList.toggle('hidden', step !== 3);
    }

    function openWizard() {
      setWizardStep(currentSession && currentSession.user ? 2 : 1);
      modalWizard?.classList.remove('hidden');
    }

    function closeWizard() {
      modalWizard?.classList.add('hidden');
    }

    document.getElementById('btn-onboarding-wizard')?.addEventListener('click', openWizard);
    document.getElementById('btn-header-login')?.addEventListener('click', openWizard);
    document.getElementById('btn-close-wizard')?.addEventListener('click', closeWizard);

    document.getElementById('btn-wizard-back-1')?.addEventListener('click', () => setWizardStep(1));
    document.getElementById('btn-wizard-next-2')?.addEventListener('click', () => setWizardStep(3));
    document.getElementById('btn-wizard-back-2')?.addEventListener('click', () => setWizardStep(2));

    // Auth Mode Toggles
    tabAuthSignin?.addEventListener('click', () => {
      tabAuthSignin.classList.add('bg-emerald-500', 'text-slate-950', 'font-bold');
      tabAuthSignup?.classList.remove('bg-emerald-500', 'text-slate-950', 'font-bold');
      formAuthSignin?.classList.remove('hidden');
      formAuthSignup?.classList.add('hidden');
    });

    tabAuthSignup?.addEventListener('click', () => {
      tabAuthSignup.classList.add('bg-emerald-500', 'text-slate-950', 'font-bold');
      tabAuthSignin?.classList.remove('bg-emerald-500', 'text-slate-950', 'font-bold');
      formAuthSignup?.classList.remove('hidden');
      formAuthSignin?.classList.add('hidden');
    });

    document.getElementById('btn-logout')?.addEventListener('click', () => {
      localStorage.removeItem('stuff8_session');
      localStorage.removeItem('stuff8_wizard_completed');
      currentSession = null;
      updateUserBadge();
      openWizard();
      loadData();
    });

    // Real Sign In Handler (calls Auth Domain Microservice)
    formAuthSignin?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (authSigninError) authSigninError.classList.add('hidden');

      const username = (document.getElementById('signin-username') as HTMLInputElement).value;
      const password = (document.getElementById('signin-password') as HTMLInputElement).value;

      try {
        const res = await fetch(`${AUTH_API}/login`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ username, password })
        });

        const data = await res.json();
        if (res.ok && data.token) {
          currentSession = data;
          localStorage.setItem('stuff8_session', JSON.stringify(data));
          updateUserBadge();
          setWizardStep(2);
        } else {
          if (authSigninError) {
            authSigninError.textContent = data.message || data.error || 'Authentication failed. Invalid username or password.';
            authSigninError.classList.remove('hidden');
          }
        }
      } catch (err) {
        if (authSigninError) {
          authSigninError.textContent = 'Failed to connect to Auth Domain service at ' + AUTH_API;
          authSigninError.classList.remove('hidden');
        }
      }
    });

    // Real Sign Up / Registration Handler (calls Auth Domain Microservice)
    formAuthSignup?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (authSignupError) authSignupError.classList.add('hidden');

      const name = (document.getElementById('signup-name') as HTMLInputElement).value;
      const username = (document.getElementById('signup-username') as HTMLInputElement).value;
      const email = (document.getElementById('signup-email') as HTMLInputElement).value;
      const password = (document.getElementById('signup-password') as HTMLInputElement).value;

      try {
        const queryParams = new URLSearchParams({ username, email, password, name });
        const res = await fetch(`${AUTH_API}/register?${queryParams.toString()}`, {
          method: 'POST'
        });

        const data = await res.json();
        if (res.ok && data.token) {
          currentSession = data;
          localStorage.setItem('stuff8_session', JSON.stringify(data));
          updateUserBadge();
          setWizardStep(2);
        } else {
          if (authSignupError) {
            authSignupError.textContent = data.message || data.error || 'Registration failed. Check password requirements or existing username/email.';
            authSignupError.classList.remove('hidden');
          }
        }
      } catch (err) {
        if (authSignupError) {
          authSignupError.textContent = 'Failed to connect to Auth Domain service at ' + AUTH_API;
          authSignupError.classList.remove('hidden');
        }
      }
    });

    // Wizard Form Step 3 Submit (First Item)
    document.getElementById('wizard-form-first-item')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!currentSession || !currentSession.user) {
        setWizardStep(1);
        return;
      }

      const title = (document.getElementById('w-item-title') as HTMLInputElement).value;
      const category = (document.getElementById('w-item-category') as HTMLSelectElement).value;
      const condition = (document.getElementById('w-item-condition') as HTMLSelectElement).value;
      const description = (document.getElementById('w-item-description') as HTMLTextAreaElement).value;
      const estVal = parseFloat((document.getElementById('w-item-est-value') as HTMLInputElement).value) || 0;
      const location = (document.getElementById('w-item-location') as HTMLInputElement).value;
      const isSellable = (document.getElementById('w-item-sellable') as HTMLInputElement).checked;

      try {
        const res = await fetch(`${INVENTORY_API}/items`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            owner_id: currentSession.user.id,
            title,
            category,
            condition,
            description,
            photos: ['https://images.unsplash.com/photo-1516035069371-29a1b244cc32?w=500&q=80'],
            storage_location: location,
            estimated_value: estVal,
            asking_price: isSellable ? estVal : null,
            sellable: isSellable,
            status: isSellable ? 'sellable' : 'collection'
          })
        });

        if (res.ok) {
          const newItem = await res.json();
          if (isSellable) {
            await fetch(`${MARKETPLACE_API}/sync-item`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                item_id: newItem.id,
                seller_id: currentSession.user.id,
                title: newItem.title,
                description: newItem.description,
                category: newItem.category,
                condition: newItem.condition,
                photos: newItem.photos || [],
                asking_price: estVal,
                general_location: location || 'Local Area',
                sellable: true
              })
            });
          }
        }
      } catch (err) {
        console.error('Wizard first item error:', err);
      }

      localStorage.setItem('stuff8_wizard_completed', 'true');
      closeWizard();
      await loadData();
    });

    async function loadData() {
      try {
        const ownerId = currentSession && currentSession.user ? currentSession.user.id : null;
        
        const [resItems, resMarketplace, resBids] = await Promise.all([
          ownerId ? fetch(`${INVENTORY_API}/items?owner_id=${ownerId}`).then(r => r.ok ? r.json() : []) : Promise.resolve([]),
          fetch(`${MARKETPLACE_API}/listings`).then(r => r.ok ? r.json() : []),
          fetch(`${BIDDING_API}/bids`).then(r => r.ok ? r.json() : [])
        ]);

        items = resItems;
        marketplaceListings = resMarketplace;
        bids = resBids;

        render();
      } catch (err) {
        console.error('Error fetching domain service data:', err);
      }
    }

    // Render Function
    function render() {
      const invCount = document.getElementById('inventory-count');
      const mktCount = document.getElementById('marketplace-count');
      const bidCount = document.getElementById('bids-count');

      const statTotalItems = document.getElementById('stat-total-items');
      const statTotalValue = document.getElementById('stat-total-value');
      const statSellableCount = document.getElementById('stat-sellable-count');
      const statBidsCount = document.getElementById('stat-bids-count');

      if (invCount) invCount.textContent = items.length.toString();
      if (mktCount) mktCount.textContent = marketplaceListings.length.toString();
      if (bidCount) bidCount.textContent = bids.length.toString();

      if (statTotalItems) statTotalItems.textContent = items.length.toString();
      const totalVal = items.reduce((acc, curr) => acc + (curr.estimated_value || 0), 0);
      if (statTotalValue) statTotalValue.textContent = `$${totalVal.toLocaleString()}`;
      if (statSellableCount) statSellableCount.textContent = marketplaceListings.length.toString();
      if (statBidsCount) statBidsCount.textContent = bids.length.toString();

      // Render Inventory Cards
      if (gridInventory) {
        if (items.length === 0) {
          gridInventory.innerHTML = `
            <div class="col-span-full p-12 rounded-2xl bg-slate-900/50 border border-slate-800 text-center space-y-4">
              <div class="w-12 h-12 rounded-2xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center text-xl mx-auto font-bold">📦</div>
              <div class="space-y-1">
                <h3 class="text-slate-200 font-bold text-base">Your Private Inventory is Empty</h3>
                <p class="text-slate-400 text-xs max-w-sm mx-auto leading-relaxed">Start cataloging your physical belongings to keep track of assets and sell items with one click.</p>
              </div>
              <button onclick="document.getElementById('modal-item').classList.remove('hidden')" class="px-4 py-2 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold text-xs shadow-md shadow-emerald-500/15 transition-all">
                + Add Your First Belonging
              </button>
            </div>
          `;
        } else {
          gridInventory.innerHTML = items.map(item => `
            <div class="bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden hover:border-emerald-500/40 transition-all flex flex-col justify-between">
              <div class="h-48 bg-slate-950 relative overflow-hidden flex items-center justify-center">
                <img src="${(item.photos && item.photos[0]) || 'https://images.unsplash.com/photo-1526170375885-4d8ecf77b99f?w=500&q=80'}" alt="${item.title}" class="w-full h-full object-cover" />
                <span class="absolute top-3 right-3 px-2.5 py-1 rounded-full text-xs font-bold ${item.sellable ? 'bg-emerald-500 text-slate-950 shadow-md' : 'bg-slate-800 text-slate-300'}">
                  ${item.sellable ? 'Available For Sale' : 'Private Collection'}
                </span>
              </div>
              <div class="p-5 space-y-3 flex-1 flex flex-col justify-between">
                <div>
                  <span class="text-xs font-semibold text-emerald-400 uppercase tracking-wider">${item.category}</span>
                  <h3 class="font-bold text-slate-100 text-lg leading-snug">${item.title}</h3>
                  <p class="text-slate-400 text-xs line-clamp-2 mt-1">${item.description}</p>
                </div>

                <div class="pt-3 border-t border-slate-800 text-xs space-y-1">
                  <div class="flex justify-between text-slate-400">
                    <span>Storage Location:</span> <span class="font-medium text-slate-200">${item.storage_location || 'N/A'}</span>
                  </div>
                  <div class="flex justify-between text-slate-400">
                    <span>Est. Asset Value:</span> <span class="font-medium text-slate-200">$${item.estimated_value || '0'}</span>
                  </div>
                  ${item.sellable ? `<div class="flex justify-between text-emerald-400 font-bold text-sm">
                    <span>Asking Price:</span> <span>$${item.asking_price || '0'}</span>
                  </div>` : ''}
                </div>

                <button onclick="toggleSellable('${item.id}')" class="w-full py-2.5 rounded-xl border ${item.sellable ? 'border-amber-500/40 text-amber-400 hover:bg-amber-950/40' : 'border-emerald-500/40 text-emerald-400 hover:bg-emerald-950/40'} text-xs font-bold transition-all">
                  ${item.sellable ? 'Withdraw from Marketplace' : '⚡ Enable "Sellable"'}
                </button>
              </div>
            </div>
          `).join('');
        }
      }

      // Render Marketplace Cards
      if (gridMarketplace) {
        if (marketplaceListings.length === 0) {
          gridMarketplace.innerHTML = `
            <div class="col-span-full p-12 rounded-2xl bg-slate-900/50 border border-slate-800 text-center space-y-4">
              <div class="w-12 h-12 rounded-2xl bg-teal-500/10 text-teal-400 flex items-center justify-center text-xl mx-auto font-bold">🏷️</div>
              <div class="space-y-1">
                <h3 class="text-slate-200 font-bold text-base">No Marketplace Listings Yet</h3>
                <p class="text-slate-400 text-xs max-w-sm mx-auto leading-relaxed">Toggle "Sellable = true" on items in your private inventory to project them here for public bidding.</p>
              </div>
            </div>
          `;
        } else {
          gridMarketplace.innerHTML = marketplaceListings.map(item => `
            <div class="bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden hover:border-teal-500/40 transition-all flex flex-col justify-between">
              <div class="h-48 bg-slate-950 relative overflow-hidden">
                <img src="${(item.photos && item.photos[0]) || 'https://images.unsplash.com/photo-1526170375885-4d8ecf77b99f?w=500&q=80'}" alt="${item.title}" class="w-full h-full object-cover" />
                <span class="absolute top-3 right-3 px-2.5 py-1 rounded-full text-xs font-extrabold bg-emerald-400 text-slate-950 shadow-md">
                  $${item.asking_price}
                </span>
              </div>
              <div class="p-5 space-y-3 flex-1 flex flex-col justify-between">
                <div>
                  <span class="text-xs font-semibold text-teal-400 uppercase tracking-wider">${item.category} • ${item.condition}</span>
                  <h3 class="font-bold text-slate-100 text-lg leading-snug">${item.title}</h3>
                  <p class="text-slate-400 text-xs line-clamp-2 mt-1">${item.description}</p>
                </div>

                <button onclick="openBidModal('${item.item_id || item.id}', '${item.title}', ${item.asking_price || 0})" class="w-full py-2.5 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-400 hover:from-emerald-400 hover:to-teal-300 text-slate-950 font-bold text-xs shadow-md transition-all">
                  Place Offer / Bid
                </button>
              </div>
            </div>
          `).join('');
        }
      }

      // Render Bids Queue
      if (listBids) {
        if (bids.length === 0) {
          listBids.innerHTML = `
            <div class="p-12 rounded-2xl bg-slate-900/50 border border-slate-800 text-center space-y-4">
              <div class="w-12 h-12 rounded-2xl bg-amber-500/10 text-amber-400 flex items-center justify-center text-xl mx-auto font-bold">🤝</div>
              <div class="space-y-1">
                <h3 class="text-slate-200 font-bold text-base">No Active Offers or Bids</h3>
                <p class="text-slate-400 text-xs max-w-sm mx-auto leading-relaxed">When buyers submit cash offers on marketplace listings, they will appear here for your decision.</p>
              </div>
            </div>
          `;
        } else {
          listBids.innerHTML = bids.map(bid => {
            const item = items.find(i => i.id === bid.item_id) || marketplaceListings.find(m => m.item_id === bid.item_id);
            const statusStr = typeof bid.status === 'string' ? bid.status : Object.keys(bid.status || {})[0] || 'Pending';
            return `
              <div class="p-5 rounded-2xl bg-slate-900 border border-slate-800 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
                <div class="space-y-1">
                  <span class="text-xs font-bold uppercase tracking-wider text-emerald-400">${item ? item.title : 'Item #' + bid.item_id.substring(0, 8)}</span>
                  <h4 class="font-bold text-slate-100 text-base">Offer: $${bid.amount} <span class="text-xs font-normal text-slate-400">by ${bid.buyer_name}</span></h4>
                  <p class="text-slate-400 text-xs">${bid.note || 'No note provided'}</p>
                  <span class="inline-block text-xs text-slate-400">Contact: <code class="text-slate-200 bg-slate-950 px-1.5 py-0.5 rounded">${bid.contact_info}</code></span>
                </div>

                <div class="flex items-center gap-3">
                  <span class="px-3 py-1 rounded-full text-xs font-bold ${statusStr === 'Accepted' || statusStr === 'accepted' ? 'bg-emerald-500/20 text-emerald-400 border border-emerald-500/30' : 'bg-amber-500/20 text-amber-400 border border-amber-500/30'}">
                    ${statusStr}
                  </span>
                  ${statusStr === 'Pending' || statusStr === 'pending' ? `
                    <button onclick="acceptBid('${bid.id}')" class="px-4 py-1.5 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold text-xs shadow-sm">Accept Offer</button>
                  ` : ''}
                </div>
              </div>
            `;
          }).join('');
        }
      }
    }

    // Attach Global Functions
    (window as any).toggleSellable = async (id: string) => {
      const item = items.find(i => i.id === id);
      if (!item) return;

      const newSellable = !item.sellable;
      const askingPrice = newSellable ? (item.asking_price || item.estimated_value || 100) : null;

      try {
        await fetch(`${INVENTORY_API}/items/${id}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            sellable: newSellable,
            asking_price: askingPrice,
            status: newSellable ? 'sellable' : 'collection'
          })
        });

        await fetch(`${MARKETPLACE_API}/sync-item`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            item_id: item.id,
            seller_id: item.owner_id || (currentSession && currentSession.user ? currentSession.user.id : 'user_guest'),
            title: item.title,
            description: item.description,
            category: item.category,
            condition: item.condition,
            photos: item.photos || [],
            asking_price: askingPrice || 0,
            general_location: item.storage_location || 'Local Area',
            sellable: newSellable
          })
        });

        await loadData();
      } catch (err) {
        console.error('Failed to toggle sellable state:', err);
      }
    };

    (window as any).openBidModal = (id: string, title: string, price: number) => {
      (document.getElementById('bid-item-id') as HTMLInputElement).value = id;
      document.getElementById('bid-item-title')!.textContent = title;
      document.getElementById('bid-asking-price')!.textContent = `Asking Price: $${price}`;
      if (currentSession && currentSession.user) {
        (document.getElementById('bid-buyer-name') as HTMLInputElement).value = currentSession.user.name || currentSession.user.username;
        (document.getElementById('bid-contact-info') as HTMLInputElement).value = currentSession.user.email;
      }
      modalBid?.classList.remove('hidden');
    };

    (window as any).acceptBid = async (bidId: string) => {
      try {
        const res = await fetch(`${BIDDING_API}/bids/${bidId}/accept`, {
          method: 'POST'
        });
        if (res.ok) {
          const data = await res.json();
          alert(`Bid of $${data.bid.amount} accepted! Contact buyer at: ${data.bid.contact_info} for Cash on Delivery.`);
          await loadData();
        }
      } catch (err) {
        console.error('Failed to accept bid:', err);
      }
    };

    // Direct Add Item Form
    document.getElementById('form-item')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!currentSession || !currentSession.user) {
        openWizard();
        return;
      }

      const title = (document.getElementById('input-title') as HTMLInputElement).value;
      const category = (document.getElementById('input-category') as HTMLSelectElement).value;
      const condition = (document.getElementById('input-condition') as HTMLSelectElement).value;
      const description = (document.getElementById('input-description') as HTMLTextAreaElement).value;
      const estVal = parseFloat((document.getElementById('input-estimated-value') as HTMLInputElement).value) || 0;
      const location = (document.getElementById('input-storage-location') as HTMLInputElement).value;
      const isSellable = (document.getElementById('input-sellable') as HTMLInputElement).checked;
      const askingPrice = parseFloat((document.getElementById('input-asking-price') as HTMLInputElement).value) || estVal;

      try {
        const res = await fetch(`${INVENTORY_API}/items`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            owner_id: currentSession.user.id,
            title,
            category,
            condition,
            description,
            photos: ['https://images.unsplash.com/photo-1526170375885-4d8ecf77b99f?w=500&q=80'],
            storage_location: location,
            estimated_value: estVal,
            asking_price: isSellable ? askingPrice : null,
            sellable: isSellable,
            status: isSellable ? 'sellable' : 'collection'
          })
        });

        if (res.ok) {
          const newItem = await res.json();

          if (isSellable) {
            await fetch(`${MARKETPLACE_API}/sync-item`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                item_id: newItem.id,
                seller_id: currentSession.user.id,
                title: newItem.title,
                description: newItem.description,
                category: newItem.category,
                condition: newItem.condition,
                photos: newItem.photos || [],
                asking_price: askingPrice,
                general_location: location || 'Local Area',
                sellable: true
              })
            });
          }

          modalItem?.classList.add('hidden');
          (document.getElementById('form-item') as HTMLFormElement).reset();
          askingPriceContainer?.classList.add('hidden');
          await loadData();
        }
      } catch (err) {
        console.error('Failed to create inventory item:', err);
      }
    });

    // Handle Submit Bid Form
    document.getElementById('form-bid')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const itemId = (document.getElementById('bid-item-id') as HTMLInputElement).value;
      const buyerName = (document.getElementById('bid-buyer-name') as HTMLInputElement).value;
      const contactInfo = (document.getElementById('bid-contact-info') as HTMLInputElement).value;
      const amount = parseFloat((document.getElementById('bid-amount') as HTMLInputElement).value) || 0;
      const note = (document.getElementById('bid-note') as HTMLTextAreaElement).value;

      const buyerId = currentSession && currentSession.user ? currentSession.user.id : 'buyer_' + Date.now();

      try {
        const res = await fetch(`${BIDDING_API}/bids`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            item_id: itemId,
            buyer_id: buyerId,
            buyer_name: buyerName,
            contact_info: contactInfo,
            amount,
            note
          })
        });

        if (res.ok) {
          modalBid?.classList.add('hidden');
          (document.getElementById('form-bid') as HTMLFormElement).reset();
          await loadData();
          switchTab('bids');
        }
      } catch (err) {
        console.error('Failed to submit bid:', err);
      }
    });

    // Initial Startup Flow
    initUserSession();
    if (!currentSession || !localStorage.getItem('stuff8_wizard_completed')) {
      openWizard();
    }
    loadData();
  </script>
</Layout>
