    // Approved Bids Widget Renderer (For both Dashboard & Visitor Section with Product Tabs)
    function renderApprovedBidsWidget() {
      const container = document.getElementById('approved-bids-container');
      const visitorContainer = document.getElementById('visitor-approved-bids-container');
      const tabsContainer = document.getElementById('visitor-chat-product-tabs');
      const badge = document.getElementById('approved-bids-count-badge');

      const acceptedBids = bids.filter(b => {
        const s = typeof b.status === 'string' ? b.status : Object.keys(b.status || {})[0] || '';
        return s === 'Accepted' || s === 'accepted';
      });

      if (badge) badge.textContent = `${acceptedBids.length} Active Chats`;

      if (container) {
        if (acceptedBids.length === 0) {
          container.innerHTML = `
            <div class="col-span-full p-6 rounded-xl bg-paper-100 border border-navy-100 text-center space-y-2">
              <p class="text-navy-900 text-xs font-semibold">No Approved Offers Yet</p>
              <p class="text-slate-600 text-[11px] max-w-md mx-auto leading-relaxed">
                When you approve a buyer's price offer in the "Offers & Negotiation" tab, a real-time chat widget activates here for reaching out and agreeing on a COD transaction.
              </p>
            </div>
          `;
        } else {
          container.innerHTML = acceptedBids.map(bid => renderSingleApprovedBidCard(bid)).join('');
        }
      }

      // Collect active marketplace listings to ensure deals/bids section only shows for active marketplace items
      const activeDemoListings = Object.values(demoItems).filter(item => item.isSellable).map(item => item.id);
      const activeListingItemIds = new Set([
        ...activeDemoListings,
        ...marketplaceListings.map(m => m.item_id || m.id)
      ]);

      // Collect all active bids (strictly synchronized with marketplace item bids)
      const allVisitorDeals: any[] = [];
      activeListingItemIds.forEach(itemId => {
        const itemBids = getBidsForItem(itemId);
        itemBids.forEach(b => {
          allVisitorDeals.push(b);
          if (!bids.some(gb => gb.id === b.id)) bids.push(b);
        });
      });

      // Dynamically hide/show the simulation section based on whether active deals/bids exist
      const demoApprovedSection = document.getElementById('demo-approved-bids-section');
      if (demoApprovedSection) {
        if (allVisitorDeals.length === 0) {
          demoApprovedSection.classList.add('hidden');
        } else {
          demoApprovedSection.classList.remove('hidden');
        }
      }

      // Render Product Tabs for Visitor Section
      if (tabsContainer) {
        if (allVisitorDeals.length === 0) {
          tabsContainer.innerHTML = '';
