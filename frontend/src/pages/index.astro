    let currentConfirmSoldBidId: string | null = null;

    (window as any).openConfirmSoldModalFromChat = (bidIdOverride?: string) => {
      const bidId = typeof bidIdOverride === 'string' ? bidIdOverride : (activeChatBidId || activeVisitorChatBidId);
      if (!bidId) return;

      const bid = bids.find(b => b.id === bidId);
      if (!bid) return;

      currentConfirmSoldBidId = bidId;

      const key = (bid.item_id || '').replace('demo-', '');
      const item = items.find(i => i.id === bid.item_id) || marketplaceListings.find(m => m.item_id === bid.item_id) || demoItems[key];
      const itemTitle = item ? item.title : `Item #${bid.item_id.substring(0, 8)}`;

      const buyerNameEl = document.getElementById('confirm-sold-buyer-name');
      const titleEl = document.getElementById('confirm-sold-item-title');
      const amountEl = document.getElementById('confirm-sold-amount');

      if (buyerNameEl) buyerNameEl.textContent = bid.buyer_name;
      if (titleEl) titleEl.textContent = itemTitle;
      if (amountEl) amountEl.textContent = `Rp ${(bid.amount || 0).toLocaleString('id-ID')}`;

      document.getElementById('modal-confirm-sold')?.classList.remove('hidden');
    };

    (window as any).executeMarkSold = async () => {
      const bidId = currentConfirmSoldBidId;
      if (!bidId) return;

      const bid = bids.find(b => b.id === bidId);
      if (!bid) return;

      const itemId = bid.item_id;
      const key = itemId.replace('demo-', '');
      const item = items.find(i => i.id === itemId) || marketplaceListings.find(m => m.item_id === itemId) || demoItems[key];
      const sellerName = item?.owner_name || 'Seller (Original Owner)';
      const buyerName = bid.buyer_name;
      const finalPrice = bid.amount || 0;
      const buyerId = bid.buyer_id || 'buyer_' + Date.now();

      // Mark target bid as Sold, all other bids for same item as Outbid
      bids.forEach(b => {
        if (b.item_id === itemId) {
          if (b.id === bidId) {
            b.status = 'Sold';
          } else {
            b.status = 'Outbid';
          }
        }
      });

      // Update local item as sold
      if (demoItems[key]) {
        demoItems[key].is_sold = true;
        demoItems[key].isSold = true;
        demoItems[key].buyer_name = buyerName;
        demoItems[key].final_price = finalPrice;
      }
      if (item) {
        item.is_sold = true;
        item.isSold = true;
        item.buyer_id = buyerId;
        item.buyer_name = buyerName;
        item.final_price = finalPrice;
        item.owner_id = buyerId;
        item.purchase_price = finalPrice;
        item.sellable = false;
        item.status = 'Collection';
      }
      const mktItem = marketplaceListings.find(m => m.item_id === itemId || m.id === itemId);
      if (mktItem) {
        mktItem.is_sold = true;
        mktItem.buyer_id = buyerId;
        mktItem.buyer_name = buyerName;
        mktItem.final_price = finalPrice;
      }

      // Record Provenance entry
      if (!ownershipHistoryStore[itemId]) {
        // Determine initial asking price from various sources
        let initialPrice = 0;
        if (demoItems[key]) {
          initialPrice = demoItems[key].value || 0;
        } else if (item) {
          initialPrice = item.purchase_price || item.asking_price || item.estimated_value || item.value || 0;
        }
        
        // Add initial ownership record first
        ownershipHistoryStore[itemId] = [{
          id: 'prov_init_' + itemId,
          item_id: itemId,
          from_owner_id: 'original_creator',
          from_owner_name: sellerName,
          to_owner_id: 'seller_id',
          to_owner_name: sellerName,
          price: initialPrice,
          transferred_at: new Date(Date.now() - 86400000 * 2).toISOString(), // 2 days ago
        notes: 'First registered in the Inventory & Marketplace Catalog'
        }];
      }
      
      // Add sold transaction record
      ownershipHistoryStore[itemId].push({
        id: 'prov_sold_' + Date.now(),
        item_id: itemId,
        from_owner_id: 'seller_id',
        from_owner_name: sellerName,
        to_owner_id: buyerId,
        to_owner_name: buyerName,
        price: finalPrice,
        transferred_at: new Date().toISOString(),
        notes: 'Sold via bid offer & COD transaction'
      });

      // Backend API calls
      try {
        await fetch(`${BIDDING_API}/bids/${bidId}/sold`, { method: 'POST', headers: (() => { const s = JSON.parse(localStorage.getItem('stuff8_session') || 'null'); return s?.token ? { 'Authorization': `Bearer ${s.token}` } : {}; })() });
      } catch (e) {}

      try {
        await fetch(`${MARKETPLACE_API}/listings/${itemId}/mark-sold`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            buyer_id: buyerId,
            buyer_name: buyerName,
            seller_name: sellerName,
            final_price: finalPrice
          })
        });
      } catch (e) {}

      try {
        await fetch(`${INVENTORY_API}/items/${itemId}/transfer-owner`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', ...(() => { const s = JSON.parse(localStorage.getItem('stuff8_session') || 'null'); return s?.token ? { 'Authorization': `Bearer ${s.token}` } : {}; })() },
          body: JSON.stringify({
            new_owner_id: buyerId,
            purchase_price: finalPrice,
            sellable: false,
            status: 'collection'
          })
        });
      } catch (e) {}

      document.getElementById('modal-confirm-sold')?.classList.add('hidden');
      document.getElementById('modal-chat')?.classList.add('hidden');
      activeChatBidId = null;

      await loadData();
    };

    (window as any).openChatModal = async (bidId: string) => {
      activeChatBidId = bidId;
      const modal = document.getElementById('modal-chat');
      const bid = bids.find(b => b.id === bidId);

      if (!bid) return;

      const item = items.find(i => i.id === bid.item_id) || marketplaceListings.find(m => m.item_id === bid.item_id);
      const itemTitle = item ? item.title : `Item #${bid.item_id.substring(0, 8)}`;

      const nameEl = document.getElementById('chat-bidder-name');
      const avatarEl = document.getElementById('chat-bidder-avatar');
      const subtitleEl = document.getElementById('chat-item-subtitle');
      const agreedEl = document.getElementById('chat-agreed-amount');
      const statusBadgeEl = document.getElementById('chat-bid-status-badge');
      const buyerBadgeEl = document.getElementById('chat-buyer-badge');

      // Check if THIS specific bid is the winning/sold bid
      const isBidSold = bid.status === 'Sold';
      // Check if item is sold (to anyone)
      const isItemSold = item?.is_sold || item?.isSold || bids.some(b => b.item_id === bid.item_id && b.status === 'Sold');

      if (nameEl) nameEl.textContent = bid.buyer_name;
      if (avatarEl) avatarEl.textContent = (bid.buyer_name || 'B').charAt(0).toUpperCase();
      if (subtitleEl) subtitleEl.textContent = `${itemTitle} • Rp ${(bid.amount || 0).toLocaleString('id-ID')}`;
      if (agreedEl) agreedEl.textContent = `Rp ${(bid.amount || 0).toLocaleString('id-ID')}`;
      
      // Update buyer badge based on whether THIS bid won
      if (buyerBadgeEl) {
        if (isBidSold) {
          buyerBadgeEl.textContent = '👤 New Owner';
          buyerBadgeEl.className = 'px-2 py-0.5 rounded text-[10px] font-bold bg-amber-500/20 text-amber-300 border border-amber-500/30';
        } else {
          buyerBadgeEl.textContent = 'Chosen Bidder';
          buyerBadgeEl.className = 'px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30';
        }
      }
      
      // Update status badge based on whether item is sold
      if (statusBadgeEl) {
        if (isItemSold) {
          statusBadgeEl.textContent = 'SOLD';
          statusBadgeEl.className = 'font-bold text-rose-800 bg-rose-100 px-2 py-0.5 rounded border border-rose-300';
        } else {
          statusBadgeEl.textContent = 'In Discussion (Interview)';
          statusBadgeEl.className = 'font-bold text-emerald-800 bg-emerald-100 px-2 py-0.5 rounded border border-emerald-300';
        }
      }

      // Update Tandai SOLD button based on whether item is sold
      const markSoldBtn = document.getElementById('btn-chat-mark-sold');
      if (markSoldBtn) {
        if (isItemSold) {
          markSoldBtn.innerHTML = '<span>✓ Already Sold</span>';
          markSoldBtn.className = 'px-3.5 py-1.5 rounded-lg bg-slate-400 text-white font-bold text-xs shadow-xs cursor-not-allowed flex items-center gap-1';
          markSoldBtn.setAttribute('disabled', 'true');
          markSoldBtn.onclick = null;
        } else {
          markSoldBtn.innerHTML = '<span>🏷️ Mark SOLD</span>';
          markSoldBtn.className = 'px-3.5 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs shadow-xs transition-all flex items-center gap-1';
          markSoldBtn.removeAttribute('disabled');
        }
      }

      // Initialize default message if empty
      if (!localChatMessages[bidId] || localChatMessages[bidId].length === 0) {
        localChatMessages[bidId] = [{
          id: 'welcome_msg',
          sender_id: bid.buyer_id || 'bidder',
          sender_name: bid.buyer_name,
          message: `Hi Seller! You've approved my offer of Rp ${(bid.amount || 0).toLocaleString('id-ID')}. Thank you so much! Ready to schedule a meetup / COD.`,
          created_at: new Date().toISOString()
        }];
      }

      modal?.classList.remove('hidden');
      await fetchChatMessages(bidId);

      if (chatPollInterval) clearInterval(chatPollInterval);
      chatPollInterval = setInterval(() => {
        if (activeChatBidId) fetchChatMessages(activeChatBidId);
      }, 1500);
    };

    function closeChatModal() {
      activeChatBidId = null;
      if (chatPollInterval) clearInterval(chatPollInterval);
      document.getElementById('modal-chat')?.classList.add('hidden');
    }

    document.getElementById('btn-close-chat-modal')?.addEventListener('click', closeChatModal);

    document.getElementById('form-chat-send')?.addEventListener('submit', (e) => {
      e.preventDefault();
      const inputEl = document.getElementById('chat-input-message') as HTMLInputElement;
      if (inputEl && inputEl.value) {
        sendChatMessage(inputEl.value);
      }
    });

    document.querySelectorAll('.chat-quick-chip').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const text = (e.currentTarget as HTMLElement).textContent || '';
        if (text) sendChatMessage(text);
      });
    });

    (window as any).acceptBid = async (bidId: string) => {
      try {
        const res = await fetch(`${BIDDING_API}/bids/${bidId}/accept`, {
          method: 'POST',
          headers: (() => { const s = JSON.parse(localStorage.getItem('stuff8_session') || 'null'); return s?.token ? { 'Authorization': `Bearer ${s.token}` } : {}; })()
        });
        if (res.ok) {
          const data = await res.json();
          await loadData();
          (window as any).openChatModal(bidId);
        } else {
          const targetBid = bids.find(b => b.id === bidId);
          if (targetBid) {
            targetBid.status = 'Accepted';
            render();
            (window as any).openChatModal(bidId);
          }
        }
      } catch (err) {
        const targetBid = bids.find(b => b.id === bidId);
        if (targetBid) {
          targetBid.status = 'Accepted';
          render();
          (window as any).openChatModal(bidId);
        }
      }
    };

    // Handle Submit Bid Form
    document.getElementById('form-bid')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const itemId = (document.getElementById('bid-item-id') as HTMLInputElement).value;
      const buyerName = document.getElementById('bid-sim-name')?.textContent || 'Simulated User';
      const amount = getBidAmountValue();

      if (!demoBids[itemId]) {
        demoBids[itemId] = [];
      }

      // Ensure single offer per user
      const alreadySubmitted = demoBids[itemId].some(b => b.buyer_name === buyerName);
      if (alreadySubmitted) {
        showNotice(`The user "${buyerName}" has already placed an offer on this item.`);
        return;
      }

      demoBids[itemId].push({
        buyer_name: buyerName,
        amount: amount,
        created_at: Date.now()
      });

      modalBid?.classList.add('hidden');
      activeVisitorProductTab = itemId;
      render();

      setTimeout(() => {
        document.getElementById('demo-approved-bids-section')?.scrollIntoView({ behavior: 'smooth' });
      }, 100);
    });

    // Initial Startup Flow
    const isRedirectingForRoute = initUserSession();
    if (!isRedirectingForRoute) {
      const authIntent = new URLSearchParams(location.search).get('auth');
      if (!currentSession?.user && authIntent) location.replace(`/auth/${authIntent === 'signin' ? 'signin' : 'signup'}/`);
      if (currentSession?.user && new URLSearchParams(location.search).get('add-item') === '1') location.assign('/inventory/form/');
      renderDemoSandbox();
      updateCalculator();
      goToInventoryPage(1).then(() => {
        afterLoad();
      });
    }
  </script>
</Layout>
