    (window as any).changeProductPhoto = (carouselKey: string, direction: number, total: number) => {
      if (total < 2) return;
      const current = productPhotoIndexes.get(carouselKey) || 0;
      const next = (current + direction + total) % total;
      productPhotoIndexes.set(carouselKey, next);
      const track = document.querySelector<HTMLElement>(`[data-slide-track="${carouselKey}"]`);
      if (track) track.style.transform = `translateX(-${next * 100}%)`;
      const counter = document.querySelector(`[data-slide-count="${carouselKey}"]`);
      if (counter) counter.textContent = `${next + 1}/${total}`;
    };
    (window as any).toggleSellable = async (id: string) => {
      const item = items.find(i => i.id === id);
      if (!item || !currentSession?.user || item.owner_id !== currentSession.user.id) return;

      const newSellable = !item.sellable;
      const askingPrice = newSellable ? (item.asking_price || item.estimated_value || 100000) : null;

      if (newSellable) {
        const freshPermissions = await fetchAccessRights(AUTH_API, currentSession?.token || '');
        const authorizedUser = { ...currentSession?.user, permissions: freshPermissions.length ? freshPermissions : (currentSession?.user?.permissions ?? []) };
        if (!can(authorizedUser, 'marketplace:publish')) {
          window.stuff8Toast?.('Verify your email first to sell items in the Marketplace.', { variant: 'error', title: 'Cannot sell yet' });
          return;
        }
      }

      try {
        await fetch(`${INVENTORY_API}/items/${id}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${currentSession.token}` },
          body: JSON.stringify({
            owner_id: currentSession.user.id,
            sellable: newSellable,
            asking_price: askingPrice,
            status: newSellable ? 'sellable' : 'collection'
          })
        });

        await fetch(`${MARKETPLACE_API}/sync-item`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            item_id: item.id,
            seller_id: item.owner_id || (currentSession && currentSession.user ? currentSession.user.id : 'user_guest'),
            seller_name: currentSession?.user?.name || currentSession?.user?.username || 'Stuff8 owner',
            title: item.title,
            description: item.description,
            category: item.category,
            condition: item.condition,
            photos: item.photos || [],
            asking_price: askingPrice || 0,
            general_location: item.storage_location || 'Local Area',
            sellable: newSellable
          })
        });

        await loadData();
        window.stuff8Toast?.(newSellable ? 'Your item is now live and open to offers on the Marketplace.' : 'Listing removed from the Marketplace, back to a private collection.', { variant: 'success', title: newSellable ? 'Listed on the Marketplace' : 'Removed from the Marketplace' });
      } catch (err) {
        console.error('Failed to toggle sellable state:', err);
      }
    };

    const getBidAmountValue = (): number => {
      const input = document.getElementById('bid-amount') as HTMLInputElement;
      if (!input || !input.value) return 0;
      return parseInt(input.value.replace(/\D/g, ''), 10) || 0;
    };

    const setBidAmountValue = (val: number) => {
      const input = document.getElementById('bid-amount') as HTMLInputElement;
      if (!input) return;
      input.value = val > 0 ? val.toLocaleString('id-ID') : '0';
    };

    const updateBidFormattedDisplay = () => {
      const input = document.getElementById('bid-amount') as HTMLInputElement;
      const fmtEl = document.getElementById('bid-amount-formatted');
      const diffBadgeEl = document.getElementById('bid-diff-badge');

      if (!input || !fmtEl) return;

      const val = getBidAmountValue();
      fmtEl.textContent = `Rp ${val.toLocaleString('id-ID')}`;

      if (diffBadgeEl) {
        const diffPrice = val - currentBidBasePrice;
        if (currentBidBasePrice > 0) {
          const diffPct = (diffPrice / currentBidBasePrice) * 100;
          const roundedPct = Math.round(diffPct * 10) / 10;

          if (diffPrice > 0) {
            const pctStr = roundedPct > 0 ? `+${roundedPct}%` : `${roundedPct}%`;
            diffBadgeEl.textContent = `+Rp ${diffPrice.toLocaleString('id-ID')} (${pctStr})`;
            diffBadgeEl.className = "text-[11px] font-extrabold px-2 py-0.5 rounded-md bg-emerald-100 text-emerald-800 border border-emerald-300 transition-all select-none whitespace-nowrap";
          } else if (diffPrice < 0) {
            const absDiff = Math.abs(diffPrice);
            const pctStr = `${roundedPct}%`;
            diffBadgeEl.textContent = `-Rp ${absDiff.toLocaleString('id-ID')} (${pctStr})`;
            diffBadgeEl.className = "text-[11px] font-extrabold px-2 py-0.5 rounded-md bg-rose-100 text-rose-800 border border-rose-300 transition-all select-none whitespace-nowrap";
          } else {
            diffBadgeEl.textContent = "Exact Price (0%)";
            diffBadgeEl.className = "text-[11px] font-extrabold px-2 py-0.5 rounded-md bg-navy-100 text-slate-700 border border-navy-200 transition-all select-none whitespace-nowrap";
          }
        } else {
          diffBadgeEl.textContent = "Exact Price";
          diffBadgeEl.className = "text-[11px] font-extrabold px-2 py-0.5 rounded-md bg-navy-100 text-slate-700 border border-navy-200 transition-all select-none whitespace-nowrap";
        }
      }
    };

    document.getElementById('bid-amount')?.addEventListener('input', (e) => {
      const input = e.target as HTMLInputElement;
      const digits = input.value.replace(/\D/g, '');
      if (digits) {
        const num = parseInt(digits, 10);
        input.value = num.toLocaleString('id-ID');
      } else {
        input.value = '';
      }
      updateBidFormattedDisplay();
    });

    (window as any).openBidModal = (id: string, title: string, price: number) => {
      (document.getElementById('bid-item-id') as HTMLInputElement).value = id;
      document.getElementById('bid-item-title')!.textContent = title;
      
      currentBidBasePrice = price || 0;

      const existingBids = getBidsForItem(id);
      if (existingBids.length > 0) {
        currentHighestBid = Math.max(...existingBids.map(b => b.amount || 0));
      } else {
        currentHighestBid = currentBidBasePrice;
      }

      document.getElementById('bid-asking-price')!.textContent = `Opening Price: Rp ${price.toLocaleString('id-ID')}` +
        (currentHighestBid > currentBidBasePrice ? ` • Highest: Rp ${currentHighestBid.toLocaleString('id-ID')}` : '');

      // Find existing bidders for this item to ensure 1 offer per user
      const existingBidders = new Set<string>(
        existingBids.map(b => b.buyer_name).filter(Boolean)
      );

      const availableNames = INDONESIAN_NAMES.filter(name => !existingBidders.has(name));
      const chosenName = availableNames.length > 0
        ? availableNames[Math.floor(Math.random() * availableNames.length)]
        : `Offer #${existingBidders.size + 1}`;

      document.getElementById('bid-sim-name')!.textContent = chosenName;

      // Default amount is highest bid so far (or base asking price if no bids exist yet)
      setBidAmountValue(currentHighestBid);
      updateBidFormattedDisplay();

      modalBid?.classList.remove('hidden');
    };

    // Steppers and Percentage listeners for Bid Form
    document.getElementById('btn-bid-step-down')?.addEventListener('click', () => {
      const currentVal = getBidAmountValue();
      setBidAmountValue(Math.max(0, currentVal - 100000));
      updateBidFormattedDisplay();
    });

    document.getElementById('btn-bid-step-up')?.addEventListener('click', () => {
      const currentVal = getBidAmountValue();
      setBidAmountValue(currentVal + 100000);
      updateBidFormattedDisplay();
    });

    // 5% Percentage Stepping handlers (Incremental)
    document.getElementById('btn-bid-pct-down')?.addEventListener('click', () => {
      const currentVal = getBidAmountValue() || currentBidBasePrice || 0;
      const step = currentBidBasePrice > 0 ? Math.round(currentBidBasePrice * 0.05) : 100000;
      setBidAmountValue(Math.max(0, currentVal - step));
      updateBidFormattedDisplay();
    });

    document.getElementById('btn-bid-pct-up')?.addEventListener('click', () => {
      const currentVal = getBidAmountValue() || currentBidBasePrice || 0;
      const step = currentBidBasePrice > 0 ? Math.round(currentBidBasePrice * 0.05) : 100000;
      setBidAmountValue(currentVal + step);
      updateBidFormattedDisplay();
    });

    document.getElementById('btn-bid-pct-reset')?.addEventListener('click', () => {
      setBidAmountValue(currentBidBasePrice);
      updateBidFormattedDisplay();
    });

    document.getElementById('btn-bid-highest')?.addEventListener('click', () => {
      setBidAmountValue(currentHighestBid);
      updateBidFormattedDisplay();
    });

    // Real-time Chat & Approved Bids State
    let activeChatBidId: string | null = null;
    let chatPollInterval: any = null;
    let activeVisitorProductTab: string = 'all';
    let activeVisitorChatBidId: string | null = null;
    const localChatMessages: Record<string, Array<{ id: string; sender_id: string; sender_name: string; message: string; created_at: string }>> = {};

    // Chat functions (must be defined before global onclick handlers)
    async function fetchChatMessages(bidId: string) {
      // Handle both inline visitor chat container AND modal chat container
      const modalContainer = document.getElementById('chat-messages-container');
      const inlineContainer = document.getElementById('visitor-inline-messages-container');
      const container = inlineContainer || modalContainer;
      
      if (!container) return;

      let msgList: any[] = [];
      try {
        const res = await fetch(`${BIDDING_API}/bids/${bidId}/messages`);
        if (res.ok) {
          msgList = await res.json();
        }
      } catch (e) {
        // Fallback to local
      }

      if (!msgList || msgList.length === 0) {
        msgList = localChatMessages[bidId] || [];
      } else {
        localChatMessages[bidId] = msgList;
      }

      const currentUserId = currentSession?.user?.id || 'seller_id';

      container.innerHTML = msgList.map(msg => {
        const isMe = msg.sender_id === currentUserId || msg.sender_name?.includes('Seller') || msg.sender_name === currentSession?.user?.name;
        const timeStr = msg.created_at ? (new Date(msg.created_at).toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' })) : 'Just now';

        return `
          <div class="flex flex-col ${isMe ? 'items-end' : 'items-start'} space-y-1">
            <span class="text-[10px] text-slate-400 font-semibold px-1">${isMe ? 'You (Seller)' : msg.sender_name} • ${timeStr}</span>
            <div class="max-w-[82%] px-4 py-2.5 rounded-2xl text-xs leading-relaxed ${
              isMe 
                ? 'bg-navy-900 text-white rounded-tr-none shadow-xs' 
                : 'bg-white text-navy-900 border border-navy-100/90 rounded-tl-none shadow-2xs'
            }">
              ${msg.message}
            </div>
          </div>
        `;
      }).join('');

      container.scrollTop = container.scrollHeight;
    }

    async function sendChatMessage(text: string) {
      if (!activeChatBidId || !text.trim()) return;

      const bidId = activeChatBidId;
      const inputEl = document.getElementById('chat-input-message') as HTMLInputElement;
      if (inputEl) inputEl.value = '';

      const senderId = currentSession?.user?.id || 'seller_id';
      const senderName = currentSession?.user?.name || currentSession?.user?.username || 'Seller';

      const newMsg = {
        id: 'msg_' + Date.now(),
        bid_id: bidId,
        sender_id: senderId,
        sender_name: senderName,
        message: text,
        created_at: new Date().toISOString()
      };

      if (!localChatMessages[bidId]) localChatMessages[bidId] = [];
      localChatMessages[bidId].push(newMsg);

      // Try sending to backend API
      try {
        await fetch(`${BIDDING_API}/bids/${bidId}/messages`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            sender_id: senderId,
            sender_name: senderName,
            message: text
          })
        });
      } catch (err) {
        console.warn('Backend chat sync fallback to local');
      }

      await fetchChatMessages(bidId);

      // Trigger automatic realistic reply from chosen bidder after 1.2s
      const targetBid = bids.find(b => b.id === bidId);
      const buyerName = targetBid ? targetBid.buyer_name : 'Chosen Bidder';
      
      setTimeout(async () => {
        if (activeChatBidId === bidId) {
          const replies = [
            `Ready! Where's a good spot for COD? I'll follow your lead.`,
            `Great, the item is complete and matches the description, right? I'm free at 4 PM today.`,
            `Thanks for accepting my offer! I'll pay in cash or via QRIS.`,
            `Could you share the exact location? I'll head over.`
          ];
          const autoReplyText = replies[Math.floor(Math.random() * replies.length)];
          const replyMsg = {
            id: 'msg_reply_' + Date.now(),
            bid_id: bidId,
            sender_id: targetBid?.buyer_id || 'bidder_id',
            sender_name: buyerName,
            message: autoReplyText,
            created_at: new Date().toISOString()
          };

          localChatMessages[bidId].push(replyMsg);
          try {
            await fetch(`${BIDDING_API}/bids/${bidId}/messages`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                sender_id: targetBid?.buyer_id || 'bidder_id',
                sender_name: buyerName,
                message: autoReplyText
              })
            });
          } catch (e) {}

          if (activeChatBidId === bidId) {
            await fetchChatMessages(bidId);
          }
        }
      }, 1200);
    }

    // Define global functions EARLY to ensure onclick handlers work when HTML is rendered
