        id: item.id,
        item_id: item.id,
        title: item.title,
        category: item.category,
        condition: item.condition,
        description: item.desc,
        asking_price: item.value,
        photos: [item.img]
      }));

      const allListings = [...activeDemoListings, ...marketplaceListings];

      if (allListings.length === 0) {
