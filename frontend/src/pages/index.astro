                  <div class="flex justify-between items-baseline text-slate-500">
                    <span>Nilai Jual:</span> <span class="num text-base font-extrabold text-clay-700">Rp ${(item.estimated_value || 0).toLocaleString('id-ID')}</span>
                  </div>
                  ${item.sellable ? `<div class="flex justify-between items-baseline text-navy-900 font-bold">
                    <span>Harga Buka:</span> <span class="num text-base">Rp ${(item.asking_price || 0).toLocaleString('id-ID')}</span>
