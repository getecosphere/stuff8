    // =================================================================
    // DATA LOADING & RENDERING
    // =================================================================
    async function loadData(page: number) {
      try {
        loadCategoryPreferences();
        loadInventoryViewPreference();
        const ownerId = currentSession && currentSession.user ? currentSession.user.id : null;
        const inventoryParams = new URLSearchParams({
          page: page.toString(),
          limit: inventoryMeta.limit.toString()
        });
        if (ownerId) inventoryParams.set('owner_id', ownerId);
        if (selectedInventoryCategory !== 'all') inventoryParams.set('category', selectedInventoryCategory);
        if (inventorySearch) inventoryParams.set('search', inventorySearch);
        
        const resItems = ownerId
          ? await fetch(`${INVENTORY_API}/items?${inventoryParams}`, { headers: { 'Authorization': `Bearer ${currentSession.token}` } }).then(r => r.ok ? r.json() : null)
          : null;

        if (Array.isArray(resItems)) {
          items = resItems;
          const categoryMap = new Map<string, number>();
          items.forEach(item => categoryMap.set(item.category, (categoryMap.get(item.category) || 0) + 1));
          inventoryMeta = {
            total: items.length,
            total_value: items.reduce((total, item) => total + (item.estimated_value || 0), 0),
            page: 1,
            limit: inventoryMeta.limit,
            total_pages: 1,
            category_counts: Array.from(categoryMap, ([category, count]) => ({ category, count }))
          };
        } else {
          items = resItems?.items || [];
          inventoryMeta = resItems ? {
            total: resItems.total,
            total_value: resItems.total_value,
            page: resItems.page,
            limit: resItems.limit,
            total_pages: resItems.total_pages,
            category_counts: resItems.category_counts || []
          } : { total: 0, total_value: 0, page: 1, limit: inventoryMeta.limit, total_pages: 1, category_counts: [] };
        }
        inventoryPage = inventoryMeta.page;
        allInventoryItems = items;
      } catch (error) {
        console.error('Failed to load data:', error);
        items = []; allInventoryItems = [];
      }
    }

    async function loadMarketplaceAndBids() {
      try {
        const [resMarketplace, resBids] = await Promise.all([
          fetch(`${MARKETPLACE_API}/listings`).then(r => r.ok ? r.json() : []),
          fetch(`${BIDDING_API}/bids`).then(r => r.ok ? r.json() : [])
        ]);
        marketplaceListings = Array.isArray(resMarketplace) ? resMarketplace : (resMarketplace?.listings || []);
        marketplaceListingTotal = Array.isArray(resMarketplace)
          ? marketplaceListings.length
          : Number.isFinite(resMarketplace?.total) ? resMarketplace.total : marketplaceListings.length;
        bids = resBids;
      } catch (error) {
        console.error('Failed to load marketplace data:', error);
      }
    }

    async function goToInventoryPage(pageNum: number) {
      if (isLoadingInventory) return;
      isLoadingInventory = true;
      await loadData(pageNum);
      if (pageNum === 1) await loadMarketplaceAndBids();
      render();
      isLoadingInventory = false;
    }

    function afterLoad() {
        const editParam = new URLSearchParams(location.search).get('edit');
        if (editParam && currentSession?.user) {
          const editable = items.find((entry: any) => entry.id === editParam && entry.owner_id === currentSession.user.id);
          if (editable) {
            location.assign(`/inventory/form/?id=${encodeURIComponent(editParam)}`);
            return;
          }
          showNotice('This item cannot be edited: it is not yours or it has already changed hands.');
          history.replaceState(null, '', '/inventory/');
        }

        if (currentSession?.user?.id) {
          const resyncKey = `stuff8_marketplace_resynced_${currentSession.user.id}`;
          if (!sessionStorage.getItem(resyncKey)) {
            sessionStorage.setItem(resyncKey, '1');
            const listingMap = new Map<string, any>(marketplaceListings.map((l: any) => [l.id, l]));
            const stale = items.filter((item: any) => {
              if (!item.sellable || !item.photos?.length) return false;
              const listing = listingMap.get(item.id);
              if (!listing) return false;
              return !listing.photos?.length || listing.photos[0] !== item.photos[0];
            });
            if (stale.length > 0) {
