---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Stuff8 — Personal Inventory First, Marketplace Second">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-12">
    
    <!-- ================================================================= -->
    <!-- 1. SIGNED-OUT INTRODUCTORY LANDING PAGE (Interactive Showcase)   -->
    <!-- ================================================================= -->
    <div id="signed-out-landing" class="space-y-16 py-4 transition-all duration-300">
      
      <!-- HERO SECTION -->
      <section class="relative overflow-hidden rounded-3xl bg-slate-900/80 border border-slate-800 p-8 sm:p-12 md:p-16 text-center space-y-8 shadow-2xl backdrop-blur-xl">
        <!-- Glow accents -->
        <div class="absolute -top-24 -left-24 w-96 h-96 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-24 -right-24 w-96 h-96 bg-teal-500/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 shadow-sm animate-pulse">
          <span>✨ Re-imagining Personal Asset Management</span>
        </div>

        <div class="max-w-3xl mx-auto space-y-4">
          <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-slate-100 leading-tight">
            Catalog What You Own.<br class="hidden sm:inline" />
            <span class="bg-gradient-to-r from-emerald-400 via-teal-300 to-cyan-400 bg-clip-text text-transparent">
              Monetize What You Don't.
            </span>
          </h1>
          <p class="text-slate-300 text-sm sm:text-lg max-w-2xl mx-auto leading-relaxed">
            <strong class="text-slate-100">Stuff8</strong> is a private digital asset vault. Organize physical belongings with zero hassle, then turn unused items into public marketplace listings with a single click.
          </p>
        </div>

        <!-- Action CTAs -->
        <div class="flex flex-wrap items-center justify-center gap-4 pt-2">
          <button id="btn-hero-start" class="px-6 py-3.5 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-extrabold text-sm shadow-xl shadow-emerald-500/20 hover:scale-[1.02] active:scale-[0.98] transition-all flex items-center gap-2">
            <span>🚀 Start Cataloging (Free Account)</span>
            <span>→</span>
          </button>

          <a href="#interactive-demo" class="px-6 py-3.5 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-200 font-bold text-sm hover:scale-[1.02] active:scale-[0.98] transition-all flex items-center gap-2">
            <span>🎮 Try Interactive Demo</span>
          </a>

          <button id="btn-hero-browse-mkt" class="px-6 py-3.5 rounded-xl bg-slate-950 hover:bg-slate-900 border border-slate-800 text-teal-400 font-bold text-sm transition-all flex items-center gap-2">
            <span>🏷️ Browse Public Listings</span>
          </button>
        </div>

        <!-- Quick Stats Banner -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 pt-8 border-t border-slate-800/80 max-w-4xl mx-auto text-left">
          <div class="p-4 rounded-2xl bg-slate-950/60 border border-slate-800/80">
            <div class="text-slate-400 text-xs font-semibold">Privacy First</div>
            <div class="text-xl font-extrabold text-slate-100 mt-1">100% Private</div>
            <p class="text-[11px] text-slate-400 mt-0.5">Hidden vault until listed</p>
          </div>
          <div class="p-4 rounded-2xl bg-slate-950/60 border border-slate-800/80">
            <div class="text-slate-400 text-xs font-semibold">Publish Speed</div>
            <div class="text-xl font-extrabold text-emerald-400 mt-1">1-Click Projection</div>
            <p class="text-[11px] text-slate-400 mt-0.5">Instant marketplace feed</p>
          </div>
          <div class="p-4 rounded-2xl bg-slate-950/60 border border-slate-800/80">
            <div class="text-slate-400 text-xs font-semibold">Peer Negotiations</div>
            <div class="text-xl font-extrabold text-teal-300 mt-1">Direct Cash Bids</div>
            <p class="text-[11px] text-slate-400 mt-0.5">Accept buyer offers</p>
          </div>
          <div class="p-4 rounded-2xl bg-slate-950/60 border border-slate-800/80">
            <div class="text-slate-400 text-xs font-semibold">Platform Fee</div>
            <div class="text-xl font-extrabold text-amber-400 mt-1">$0 Commissions</div>
            <p class="text-[11px] text-slate-400 mt-0.5">Keep 100% sale value</p>
          </div>
        </div>
      </section>

      <!-- INTERACTIVE DEMO SANDBOX -->
      <section id="interactive-demo" class="space-y-8 scroll-mt-24">
        <div class="text-center space-y-2">
          <span class="text-xs font-bold text-emerald-400 uppercase tracking-widest bg-emerald-500/10 px-3 py-1 rounded-full border border-emerald-500/20">
            Interactive Playground
          </span>
          <h2 class="text-2xl sm:text-4xl font-extrabold text-slate-100">
            Experience How Stuff8 Works in Real-Time
          </h2>
          <p class="text-slate-400 text-xs sm:text-sm max-w-xl mx-auto">
            Select a sample belonging below, toggle its <code class="text-emerald-400 bg-slate-900 px-1 rounded font-mono">sellable</code> status, and watch how it transforms from a private inventory item into a public marketplace listing.
          </p>
        </div>

        <!-- Sample Item Selector Tabs -->
        <div class="flex flex-wrap justify-center gap-2 text-xs font-semibold">
          <button id="demo-tab-camera" class="demo-item-btn active px-4 py-2 rounded-xl bg-emerald-500 text-slate-950 font-bold shadow-md transition-all">
            📷 Fujifilm Camera ($1,450)
          </button>
          <button id="demo-tab-bike" class="demo-item-btn px-4 py-2 rounded-xl bg-slate-900 border border-slate-800 text-slate-300 hover:text-slate-100 transition-all">
            🚴 Vintage Road Bike ($680)
          </button>
          <button id="demo-tab-macbook" class="demo-item-btn px-4 py-2 rounded-xl bg-slate-900 border border-slate-800 text-slate-300 hover:text-slate-100 transition-all">
            💻 MacBook Pro M2 ($1,800)
          </button>
          <button id="demo-tab-guitar" class="demo-item-btn px-4 py-2 rounded-xl bg-slate-900 border border-slate-800 text-slate-300 hover:text-slate-100 transition-all">
            🎸 Acoustic Guitar ($420)
          </button>
        </div>

        <!-- Interactive Sandbox Card -->
        <div class="max-w-4xl mx-auto bg-slate-900 border border-slate-800 rounded-3xl p-6 sm:p-8 grid grid-cols-1 md:grid-cols-12 gap-8 shadow-2xl relative overflow-hidden">
          
          <!-- Image Column -->
          <div class="md:col-span-5 relative group rounded-2xl overflow-hidden bg-slate-950 h-64 md:h-full border border-slate-800/80">
            <img id="demo-card-img" src="https://images.unsplash.com/photo-1516035069371-29a1b244cc32?w=600&q=80" alt="Demo Belonging" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
            <span id="demo-card-badge" class="absolute top-4 right-4 px-3 py-1 rounded-full text-xs font-bold bg-slate-800 text-slate-300 shadow-lg backdrop-blur-md transition-all">
              🔒 Private Inventory
            </span>
          </div>

          <!-- Details & Controls Column -->
          <div class="md:col-span-7 space-y-6 flex flex-col justify-between">
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <span id="demo-card-category" class="text-xs font-bold uppercase tracking-wider text-emerald-400">Cameras & Photography</span>
                <span id="demo-card-location" class="text-xs text-slate-400 bg-slate-950 px-2.5 py-1 rounded-lg border border-slate-800">Storage: Closet Shelf B</span>
              </div>
              <h3 id="demo-card-title" class="text-xl sm:text-2xl font-extrabold text-slate-100">Fujifilm X100V Compact Camera</h3>
              <p id="demo-card-desc" class="text-slate-400 text-xs sm:text-sm leading-relaxed">
                Mint condition, 23mm F2 fixed lens, shutter count under 2,500. Includes original box and leather strap.
              </p>
            </div>

            <!-- Value & Toggle Box -->
            <div class="p-4 rounded-2xl bg-slate-950 border border-slate-800/80 space-y-4">
              <div class="flex items-center justify-between">
                <div>
                  <span class="text-slate-400 text-xs font-medium">Estimated Asset Value:</span>
                  <div id="demo-card-val" class="text-xl font-extrabold text-emerald-400">$1,450</div>
                </div>
                <div class="text-right">
                  <span class="text-slate-400 text-xs font-medium">Condition:</span>
                  <div id="demo-card-condition" class="text-sm font-bold text-slate-200">Like New</div>
                </div>
              </div>

              <!-- Interactive Toggle Switch -->
              <div class="pt-3 border-t border-slate-800/80 flex items-center justify-between gap-4">
                <div>
                  <span class="block text-xs font-bold text-slate-200">Public Marketplace Status</span>
                  <span id="demo-toggle-label" class="block text-[11px] text-slate-400">Current: Private Vault only</span>
                </div>
                <button id="btn-demo-toggle-sellable" class="px-4 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold text-xs border border-slate-700 transition-all flex items-center gap-2">
                  <span>⚡ Enable "Sellable"</span>
                </button>
              </div>
            </div>

            <!-- Interactive Bid Simulator Sandbox -->
            <div id="demo-bidding-sandbox" class="p-4 rounded-2xl bg-teal-950/20 border border-teal-500/20 space-y-3 hidden transition-all">
              <div class="flex items-center justify-between text-xs font-bold text-teal-300">
                <span>🤝 Live Marketplace Bidding Demo</span>
                <span>Asking Price: <span id="demo-asking-price">$1,450</span></span>
              </div>
              <div class="flex gap-2">
                <input type="number" id="demo-bid-input" placeholder="Enter bid (e.g. 1350)" value="1350" class="flex-1 px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-slate-100 text-xs focus:border-teal-400 focus:outline-none" />
                <button id="btn-demo-submit-bid" class="px-4 py-2 rounded-xl bg-teal-400 hover:bg-teal-300 text-slate-950 font-bold text-xs transition-all">
                  Submit Test Offer
                </button>
              </div>
              <div id="demo-bid-feedback" class="text-[11px] text-teal-400 hidden font-medium"></div>
            </div>

          </div>
        </div>
      </section>

      <!-- UNLOCKED ASSET VALUE CALCULATOR -->
      <section class="rounded-3xl bg-slate-900 border border-slate-800 p-8 sm:p-12 space-y-8 shadow-xl">
        <div class="max-w-2xl mx-auto text-center space-y-2">
          <span class="text-xs font-bold text-cyan-400 uppercase tracking-widest bg-cyan-500/10 px-3 py-1 rounded-full border border-cyan-500/20">
            Asset Liquidity Estimator
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-100">
            How Much Cash Is Hidden In Your Storage?
          </h2>
          <p class="text-slate-400 text-xs sm:text-sm">
            Adjust the sliders below to estimate the total stored asset value sitting unused in your home.
          </p>
        </div>

        <div class="max-w-3xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="space-y-4 p-5 rounded-2xl bg-slate-950 border border-slate-800">
            <div class="flex justify-between text-xs font-semibold">
              <span class="text-slate-300">📷 Electronics & Gadgets</span>
              <span id="calc-val-electronics" class="text-emerald-400 font-mono">2 items ($1,000)</span>
            </div>
            <input type="range" id="calc-range-electronics" min="0" max="10" value="2" class="w-full accent-emerald-500 bg-slate-900 cursor-pointer" />

            <div class="flex justify-between text-xs font-semibold pt-2">
              <span class="text-slate-300">🚴 Sports, Bicycles & Outdoor</span>
              <span id="calc-val-sports" class="text-emerald-400 font-mono">1 item ($350)</span>
            </div>
            <input type="range" id="calc-range-sports" min="0" max="10" value="1" class="w-full accent-emerald-500 bg-slate-900 cursor-pointer" />
          </div>

          <div class="space-y-4 p-5 rounded-2xl bg-slate-950 border border-slate-800">
            <div class="flex justify-between text-xs font-semibold">
              <span class="text-slate-300">🎸 Musical Gear & Instruments</span>
              <span id="calc-val-music" class="text-emerald-400 font-mono">1 item ($400)</span>
            </div>
            <input type="range" id="calc-range-music" min="0" max="10" value="1" class="w-full accent-emerald-500 bg-slate-900 cursor-pointer" />

            <div class="flex justify-between text-xs font-semibold pt-2">
              <span class="text-slate-300">📚 Collectibles, Books & Furniture</span>
              <span id="calc-val-other" class="text-emerald-400 font-mono">3 items ($240)</span>
            </div>
            <input type="range" id="calc-range-other" min="0" max="15" value="3" class="w-full accent-emerald-500 bg-slate-900 cursor-pointer" />
          </div>
        </div>

        <!-- Calculator Result Card -->
        <div class="max-w-md mx-auto p-6 rounded-2xl bg-gradient-to-br from-slate-950 to-slate-900 border border-emerald-500/30 text-center space-y-3 shadow-2xl">
          <span class="text-slate-400 text-xs font-semibold uppercase tracking-wider">Estimated Total Asset Value</span>
          <div id="calc-total-display" class="text-3xl sm:text-4xl font-black text-emerald-400 font-mono">
            $1,990.00
          </div>
          <p class="text-slate-400 text-xs">
            Start cataloging your belongings today to track asset value and unlock cash whenever you choose.
          </p>
          <button id="btn-calc-cta" class="w-full py-3 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-extrabold text-xs shadow-lg shadow-emerald-500/20 transition-all">
            Catalog My Belongings Now →
          </button>
        </div>
      </section>

      <!-- THREE CORE PILLARS OF STUFF8 -->
      <section class="space-y-8">
        <div class="text-center space-y-2 max-w-xl mx-auto">
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-100">Why Stuff8 is Built Differently</h2>
          <p class="text-slate-400 text-xs sm:text-sm">Designed around personal ownership first, public trading second.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="p-6 rounded-2xl bg-slate-900 border border-slate-800 space-y-3 hover:border-emerald-500/30 transition-all">
            <div class="w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center font-bold text-xl">🔒</div>
            <h3 class="font-bold text-slate-100 text-lg">1. Private Asset Vault</h3>
            <p class="text-slate-400 text-xs leading-relaxed">
              Track purchase prices, warranties, estimated asset value, and storage locations (e.g. "Garage Box 2"). Your catalog remains 100% private to you.
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-slate-900 border border-slate-800 space-y-3 hover:border-teal-500/30 transition-all">
            <div class="w-10 h-10 rounded-xl bg-teal-500/10 text-teal-400 flex items-center justify-center font-bold text-xl">⚡</div>
            <h3 class="font-bold text-slate-100 text-lg">2. 1-Click Marketplace Projection</h3>
            <p class="text-slate-400 text-xs leading-relaxed">
              No long forms or tedious republishing. Simply flip <code class="text-emerald-400 bg-slate-950 px-1 rounded font-mono">sellable = true</code> to list any item immediately on the public marketplace.
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-slate-900 border border-slate-800 space-y-3 hover:border-amber-500/30 transition-all">
            <div class="w-10 h-10 rounded-xl bg-amber-500/10 text-amber-400 flex items-center justify-center font-bold text-xl">🤝</div>
            <h3 class="font-bold text-slate-100 text-lg">3. Peer Cash Bidding</h3>
            <p class="text-slate-400 text-xs leading-relaxed">
              Buyers submit direct offers to your items. Review offers in your dashboard and accept for fast Cash on Delivery (COD) or local pickup transactions.
            </p>
          </div>
        </div>
      </section>

      <!-- PUBLIC MARKETPLACE PREVIEW FOR VISITORS -->
      <section class="space-y-6 pt-4">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-slate-800 pb-4">
          <div>
            <h2 class="text-xl sm:text-2xl font-extrabold text-slate-100">Browse Public Marketplace Listings</h2>
            <p class="text-slate-400 text-xs">Items published by community owners right now</p>
          </div>
          <button id="btn-public-mkt-refresh" class="px-3.5 py-1.5 rounded-xl bg-slate-900 hover:bg-slate-800 border border-slate-800 text-slate-300 text-xs font-semibold transition-all">
            🔄 Refresh Feed
          </button>
        </div>

        <div id="public-marketplace-visitor-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <!-- Dynamic public marketplace listings rendered here -->
        </div>
      </section>

    </div>


    <!-- ================================================================= -->
    <!-- 2. SIGNED-IN DASHBOARD VIEW (Private Belongings & Assets)        -->
    <!-- ================================================================= -->
    <div id="signed-in-dashboard" class="space-y-8 hidden transition-all duration-300">
      
      <!-- Clean Dashboard Header -->
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-slate-800/80 pb-6">
        <div>
          <div class="flex items-center gap-2 mb-1">
            <span class="px-2.5 py-0.5 rounded-md text-[11px] font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 uppercase tracking-wider">
              Personal Inventory System
            </span>
          </div>
          <h1 id="page-heading-title" class="text-2xl sm:text-3xl font-extrabold tracking-tight text-slate-100">
            My Belongings & Assets
          </h1>
          <p id="page-heading-sub" class="text-slate-400 text-xs sm:text-sm mt-1">
            Private digital catalog of your physical belongings. Toggle items to sellable to project them to the public marketplace.
          </p>
        </div>

        <div class="flex items-center gap-3">
          <button id="btn-add-item" class="px-4 py-2.5 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold text-xs shadow-md shadow-emerald-500/15 transition-all flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"></path></svg>
            Add Inventory Item
          </button>
        </div>
      </div>

      <!-- Stat Summary Tiles -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="p-4 rounded-xl bg-slate-900 border border-slate-800 space-y-1">
          <span class="text-slate-400 text-xs font-medium">Total Belongings</span>
          <div id="stat-total-items" class="text-2xl font-extrabold text-slate-100">0</div>
        </div>
        <div class="p-4 rounded-xl bg-slate-900 border border-slate-800 space-y-1">
          <span class="text-slate-400 text-xs font-medium">Est. Asset Value</span>
          <div id="stat-total-value" class="text-2xl font-extrabold text-emerald-400">$0</div>
        </div>
        <div class="p-4 rounded-xl bg-slate-900 border border-slate-800 space-y-1">
          <span class="text-slate-400 text-xs font-medium">Sellable Listings</span>
          <div id="stat-sellable-count" class="text-2xl font-extrabold text-teal-300">0</div>
        </div>
        <div class="p-4 rounded-xl bg-slate-900 border border-slate-800 space-y-1">
          <span class="text-slate-400 text-xs font-medium">Active Offers & Bids</span>
          <div id="stat-bids-count" class="text-2xl font-extrabold text-amber-400">0</div>
        </div>
      </div>

      <!-- Navigation Tab Switcher -->
      <div class="flex items-center justify-between border-b border-slate-800">
        <div class="flex gap-6 text-xs sm:text-sm font-semibold text-slate-400">
          <button id="tab-btn-inventory" class="py-3 text-emerald-400 border-b-2 border-emerald-400 flex items-center gap-2">
            <span>📦 Private Inventory</span>
            <span id="inventory-count" class="px-2 py-0.5 text-xs rounded-full bg-emerald-950 text-emerald-300 border border-emerald-800/40">0</span>
          </button>
          <button id="tab-btn-marketplace" class="py-3 hover:text-slate-200 border-b-2 border-transparent flex items-center gap-2">
            <span>🏷️ Public Marketplace</span>
            <span id="marketplace-count" class="px-2 py-0.5 text-xs rounded-full bg-slate-800 text-slate-300">0</span>
          </button>
          <button id="tab-btn-bids" class="py-3 hover:text-slate-200 border-b-2 border-transparent flex items-center gap-2">
            <span>🤝 Offers & Bids</span>
            <span id="bids-count" class="px-2 py-0.5 text-xs rounded-full bg-slate-800 text-slate-300">0</span>
          </button>
        </div>
      </div>

      <!-- Section 1: Private Inventory View -->
      <section id="inventory-section" class="space-y-6">
        <div id="inventory-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <!-- Dynamic Inventory Items Rendered Here -->
        </div>
      </section>

      <!-- Section 2: Public Marketplace View -->
      <section id="marketplace-section" class="space-y-6 hidden">
        <div id="marketplace-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <!-- Dynamic Marketplace Items Rendered Here -->
        </div>
      </section>

      <!-- Section 3: Offers & Bidding Queue -->
      <section id="bids-section" class="space-y-6 hidden">
        <div id="bids-list" class="space-y-4">
          <!-- Dynamic Bids Rendered Here -->
        </div>
      </section>

    </div>

  </div>

  <!-- ================================================================= -->
  <!-- MODALS                                                            -->
  <!-- ================================================================= -->

  <!-- ONBOARDING WIZARD MODAL -->
  <div id="modal-wizard" class="fixed inset-0 bg-slate-950/85 backdrop-blur-md z-50 flex items-center justify-center p-4 hidden">
    <div class="bg-slate-900 border border-slate-800 rounded-2xl max-w-lg w-full p-6 space-y-6 shadow-2xl relative overflow-hidden">
      <!-- Header -->
      <div class="flex items-center justify-between text-xs font-semibold text-slate-400 border-b border-slate-800 pb-3">
        <div class="flex items-center gap-2">
          <span class="w-6 h-6 rounded-md bg-emerald-500 text-slate-950 flex items-center justify-center font-black text-xs">S8</span>
          <span class="text-slate-200">Stuff8 Onboarding Wizard</span>
        </div>
        <div class="flex items-center gap-1.5 text-slate-400">
          <span id="wizard-step-indicator" class="text-emerald-400 font-mono text-[11px]">Step 1 of 3</span>
          <button id="btn-close-wizard" class="ml-3 text-slate-500 hover:text-slate-200 text-base font-bold">×</button>
        </div>
      </div>

      <!-- WIZARD STEP 1: Account Authentication (Sign In / Sign Up) -->
      <div id="wizard-step-1" class="space-y-5">
        <div class="space-y-1">
          <h2 class="text-xl font-bold text-slate-100">Welcome to Stuff8</h2>
