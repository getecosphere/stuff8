    function storagePhotoUrl(photoKey?: string) {
      if (!photoKey) return '/images/no-item-image.webp';
      if (/^(https?:)?\//.test(photoKey)) return photoKey;
      return `${PHOTOS_API}/storage/content/${photoKey.split('/').map(encodeURIComponent).join('/')}`;
    }

    const productPhotoIndexes = new Map<string, number>();

    function renderProductPhotoCarousel(item: any, carouselKey: string, imageClass: string) {
      const photos = Array.isArray(item.photos) ? item.photos.filter(Boolean) : [];
      if (photos.length === 0) {
        return `<img src="${storagePhotoUrl()}" alt="Gambar barang belum tersedia" class="${imageClass} object-contain p-5" />`;
      }

      const currentIndex = ((productPhotoIndexes.get(carouselKey) || 0) + photos.length) % photos.length;
      productPhotoIndexes.set(carouselKey, currentIndex);
      const photo = photos[currentIndex];
      const previousAction = escapeHtml(`event.stopPropagation(); window.changeProductPhoto(${JSON.stringify(carouselKey)}, -1, ${photos.length})`);
      const nextAction = escapeHtml(`event.stopPropagation(); window.changeProductPhoto(${JSON.stringify(carouselKey)}, 1, ${photos.length})`);

      return `
        <img src="${storagePhotoUrl(photo)}" alt="${escapeHtml(item.title || `Foto barang ${currentIndex + 1}`)}" class="${imageClass} object-cover" />
        ${photos.length > 1 ? `
          <button type="button" onclick="${previousAction}" class="absolute left-2 top-1/2 z-10 -translate-y-1/2 rounded-full bg-white/90 p-1.5 text-navy-900 shadow-sm transition hover:bg-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-900" aria-label="Foto sebelumnya">
            <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m15 18-6-6 6-6" /></svg>
          </button>
          <button type="button" onclick="${nextAction}" class="absolute right-2 top-1/2 z-10 -translate-y-1/2 rounded-full bg-white/90 p-1.5 text-navy-900 shadow-sm transition hover:bg-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-900" aria-label="Foto berikutnya">
            <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m9 18 6-6-6-6" /></svg>
          </button>
          <span class="absolute bottom-2 right-2 rounded-full bg-navy-950/70 px-2 py-0.5 text-[11px] font-semibold text-white">${currentIndex + 1}/${photos.length}</span>
        ` : ''}
      `;
    }

