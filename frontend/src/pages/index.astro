---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Stuff8 — Catat Barang & Pasar Jual Beli">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-8">
    
    <!-- ================================================================= -->
    <!-- 1. LANDING PAGE HALAMAN UTAMA                                    -->
    <!-- ================================================================= -->
    <div id="signed-out-landing" class="space-y-12 py-4 transition-all duration-300">
      
      <!-- HERO SECTION -->
      <section class="relative rounded-2xl bg-white border border-slate-200 p-8 sm:p-12 md:p-14 text-center space-y-6 shadow-xs">
        
        <div class="max-w-3xl mx-auto space-y-4">
          <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-slate-900 leading-tight">
            Catat Semua Barangmu.<br class="hidden sm:inline" />
            <span class="text-navy-900">
              Jual Kapan Saja Kamu Mau.
            </span>
          </h1>
          <p class="text-slate-600 text-sm sm:text-base max-w-2xl mx-auto leading-relaxed">
            Sering banget kita punya barang berharga tapi nggak sadar, ujung-ujungnya cuma numpuk dan bertahun-tahun nggak kepakai. Makanya di <strong class="text-slate-900">Stuff8</strong>, catat-catat aja dulu barangmu—biar kamu tau berapa total nilai asetmu. Nanti kalau ada barang yang rasa-rasanya mau dijual, tinggal tandai aja biar langsung bisa ditawar orang!
          </p>
        </div>

        <!-- Action CTAs -->
        <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
          <button id="btn-hero-start" class="px-5 py-3 rounded-lg bg-navy-900 hover:bg-navy-800 text-white font-bold text-sm shadow-xs hover:scale-[1.01] active:scale-[0.99] transition-all flex items-center gap-2">
            <span>Mulai Catat Barang</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
          </button>

          <a href="#interactive-demo" class="px-5 py-3 rounded-lg bg-white hover:bg-slate-50 border border-slate-300 text-slate-700 font-semibold text-sm transition-all flex items-center gap-2">
            <span>Coba Demo Interaktif</span>
          </a>

          <button id="btn-hero-browse-mkt" class="px-5 py-3 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-800 font-semibold text-sm transition-all">
            <span>Lihat Marketplace</span>
          </button>
        </div>

        <!-- Quick Stats Banner -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 pt-8 border-t border-slate-100 max-w-4xl mx-auto text-left">
          <div class="p-4 rounded-xl bg-slate-50 border border-slate-200/80">
            <div class="text-slate-500 text-xs font-semibold">Privasi Terjaga</div>
            <div class="text-lg font-bold text-slate-900 mt-1">100% Privat</div>
            <p class="text-[11px] text-slate-500 mt-0.5">Barangmu cuma kamu yang tau</p>
          </div>
          <div class="p-4 rounded-xl bg-slate-50 border border-slate-200/80">
            <div class="text-slate-500 text-xs font-semibold">Pajang Barang</div>
            <div class="text-lg font-bold text-navy-900 mt-1">1-Klik Tayang</div>
            <p class="text-[11px] text-slate-500 mt-0.5">Langsung masuk marketplace</p>
          </div>
          <div class="p-4 rounded-xl bg-slate-50 border border-slate-200/80">
            <div class="text-slate-500 text-xs font-semibold">Nego Santai</div>
            <div class="text-lg font-bold text-brand-700 mt-1">Bisa Ditawar</div>
            <p class="text-[11px] text-slate-500 mt-0.5">Cek penawaran tunai dari pembeli</p>
          </div>
          <div class="p-4 rounded-xl bg-slate-50 border border-slate-200/80">
            <div class="text-slate-500 text-xs font-semibold">Bebas Biaya</div>
            <div class="text-lg font-bold text-slate-900 mt-1">Tanpa Komisi</div>
            <p class="text-[11px] text-slate-500 mt-0.5">100% hasil jual buat kamu</p>
          </div>
        </div>
      </section>

      <!-- UNLOCKED ASSET VALUE CALCULATOR -->
      <section class="rounded-2xl bg-white border border-slate-200 p-8 sm:p-12 space-y-8 shadow-xs">
        <div class="max-w-2xl mx-auto text-center space-y-2">
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900">
            Bayangkan Nilai Tumpukan Barangmu Saat Ini!
          </h2>
          <p class="text-slate-600 text-xs sm:text-sm">
            Geser slider di bawah buat meraba berapa perkiraan aset barang yang selama ini cuma ngetem di gudang/lemari.
          </p>
        </div>

        <div class="max-w-3xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="space-y-4 p-5 rounded-xl bg-slate-50 border border-slate-200">
            <div class="flex justify-between text-xs font-semibold">
              <span class="text-slate-700">Elektronik & Gadget</span>
              <span id="calc-val-electronics" class="text-navy-900 font-mono">2 barang (Rp 15.000.000)</span>
            </div>
            <input type="range" id="calc-range-electronics" min="0" max="10" value="2" class="w-full accent-navy-900 bg-slate-200 cursor-pointer" />

            <div class="flex justify-between text-xs font-semibold pt-2">
              <span class="text-slate-700">Peralatan Olahraga & Outdoor</span>
              <span id="calc-val-sports" class="text-navy-900 font-mono">1 barang (Rp 5.250.000)</span>
            </div>
            <input type="range" id="calc-range-sports" min="0" max="10" value="1" class="w-full accent-navy-900 bg-slate-200 cursor-pointer" />
          </div>

          <div class="space-y-4 p-5 rounded-xl bg-slate-50 border border-slate-200">
            <div class="flex justify-between text-xs font-semibold">
              <span class="text-slate-700">Alat Musik & Audio</span>
              <span id="calc-val-music" class="text-navy-900 font-mono">1 barang (Rp 6.000.000)</span>
            </div>
            <input type="range" id="calc-range-music" min="0" max="10" value="1" class="w-full accent-navy-900 bg-slate-200 cursor-pointer" />

            <div class="flex justify-between text-xs font-semibold pt-2">
              <span class="text-slate-700">Koleksi & Furnitur</span>
              <span id="calc-val-other" class="text-navy-900 font-mono">3 barang (Rp 3.600.000)</span>
            </div>
            <input type="range" id="calc-range-other" min="0" max="15" value="3" class="w-full accent-navy-900 bg-slate-200 cursor-pointer" />
          </div>
        </div>

        <!-- Calculator Result Card -->
        <div class="max-w-md mx-auto p-6 rounded-xl bg-slate-900 text-white border border-slate-800 text-center space-y-3 shadow-md">
          <span class="text-slate-400 text-xs font-semibold uppercase tracking-wider">Total Perkiraan Nilai Simpanan</span>
          <div id="calc-total-display" class="text-3xl sm:text-4xl font-extrabold text-white font-mono">
            Rp 29.850.000
          </div>
          <p class="text-slate-300 text-xs">
            Mulai catat barang-barangmu sekarang biar tau aset simpananmu dan siap dijual kapan aja.
          </p>
          <button id="btn-calc-cta" class="w-full py-3 rounded-lg bg-brand-600 hover:bg-brand-500 text-white font-bold text-xs shadow-xs transition-all">
            Mulai Catat Barangku
          </button>
        </div>
      </section>

      <!-- THREE CORE PILLARS OF STUFF8 -->
      <section class="space-y-8">
        <div class="text-center space-y-2 max-w-xl mx-auto">
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900">Cara Kerja Stuff8</h2>
          <p class="text-slate-600 text-xs sm:text-sm">Fokus rapiin inventaris pribadi dulu, baru jual santai kemudian.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="p-6 rounded-xl bg-white border border-slate-200 space-y-3 hover:border-brand-500/40 hover:shadow-xs transition-all">
            <div class="w-8 h-8 rounded-lg bg-slate-100 text-navy-900 flex items-center justify-center font-bold text-sm">1</div>
            <h3 class="font-bold text-slate-900 text-base">Galeri Simpanan Privat</h3>
            <p class="text-slate-600 text-xs leading-relaxed">
              Catat harga beli, kondisi, perkiraan nilai, sampai posisi simpan barang. Katalogmu 100% rahasia dan aman.
            </p>
          </div>

          <div class="p-6 rounded-xl bg-white border border-slate-200 space-y-3 hover:border-brand-500/40 hover:shadow-xs transition-all">
            <div class="w-8 h-8 rounded-lg bg-slate-100 text-navy-900 flex items-center justify-center font-bold text-sm">2</div>
            <h3 class="font-bold text-slate-900 text-base">Sekali klik .. ke Marketplace!</h3>
            <p class="text-slate-600 text-xs leading-relaxed">
              Nggak perlu ribet ketik ulang deskripsi. Cukup aktifkan status "Dijual", barang langsung tayang di marketplace.
            </p>
          </div>

          <div class="p-6 rounded-xl bg-white border border-slate-200 space-y-3 hover:border-brand-500/40 hover:shadow-xs transition-all">
            <div class="w-8 h-8 rounded-lg bg-slate-100 text-navy-900 flex items-center justify-center font-bold text-sm">3</div>
            <h3 class="font-bold text-slate-900 text-base">Penawaran Langsung</h3>
            <p class="text-slate-600 text-xs leading-relaxed">
              Pembeli bisa langsung ngirim penawaran harga. Kamu tinggal cek penawaran di dashboard dan tentukan pilihan.
            </p>
          </div>
        </div>
      </section>

      <!-- INTERACTIVE DEMO SANDBOX -->
      <section id="interactive-demo" class="space-y-6 scroll-mt-24">
        <div class="text-center space-y-2">
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900">
            Cobain Gimana Cara Kerja Stuff8
          </h2>
          <p class="text-slate-600 text-xs sm:text-sm max-w-xl mx-auto">
            Pilih contoh barang di bawah, geser tombol jualnya, dan lihat gimana mulusnya barang berpindah dari galeri pribadi ke marketplace publik.
          </p>
        </div>

        <!-- Sample Item Selector Tabs -->
        <div class="flex flex-wrap justify-center gap-2 text-xs font-semibold">
          <button id="demo-tab-camera" class="demo-item-btn active px-4 py-2 rounded-lg bg-navy-900 text-white font-semibold shadow-xs transition-all">
            Kamera Fujifilm (Rp 21,7 Jt)
          </button>
          <button id="demo-tab-bike" class="demo-item-btn px-4 py-2 rounded-lg bg-white border border-slate-200 text-slate-600 hover:text-slate-900 hover:bg-slate-50 transition-all">
            Sepeda Balap (Rp 10,2 Jt)
          </button>
          <button id="demo-tab-macbook" class="demo-item-btn px-4 py-2 rounded-lg bg-white border border-slate-200 text-slate-600 hover:text-slate-900 hover:bg-slate-50 transition-all">
            MacBook Pro M2 (Rp 27 Jt)
          </button>
          <button id="demo-tab-guitar" class="demo-item-btn px-4 py-2 rounded-lg bg-white border border-slate-200 text-slate-600 hover:text-slate-900 hover:bg-slate-50 transition-all">
            Gitar Akustik (Rp 6,3 Jt)
          </button>
        </div>

        <!-- Interactive Sandbox Card -->
        <div class="max-w-4xl mx-auto bg-white border border-slate-200 rounded-2xl p-6 sm:p-8 grid grid-cols-1 md:grid-cols-12 gap-8 shadow-xs relative overflow-hidden">
          
          <!-- Image Column -->
          <div class="md:col-span-5 relative group rounded-xl overflow-hidden bg-slate-100 h-64 md:h-full border border-slate-200">
            <img id="demo-card-img" src="/fujifilm-camera.jpg" alt="Contoh Barang" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-102" />
            <span id="demo-card-badge" class="absolute top-3 right-3 px-3 py-1 rounded-md text-xs font-semibold bg-slate-900/80 text-white shadow-xs backdrop-blur-xs transition-all">
              Simpanan Privat
            </span>
          </div>

          <!-- Details & Controls Column -->
          <div class="md:col-span-7 space-y-6 flex flex-col justify-between">
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <span id="demo-card-category" class="text-xs font-semibold uppercase tracking-wider text-brand-700">Kamera & Fotografi</span>
                <span id="demo-card-location" class="text-xs text-slate-500 bg-slate-100 px-2.5 py-1 rounded-md border border-slate-200">Lokasi: Lemari Rak B</span>
              </div>
              <h3 id="demo-card-title" class="text-xl sm:text-2xl font-bold text-slate-900">Kamera Compact Fujifilm X100V</h3>
              <p id="demo-card-desc" class="text-slate-600 text-xs sm:text-sm leading-relaxed">
                Kondisi mulus banget, lensa fix 23mm F2, shutter count di bawah 2.500. Lengkap dus ori dan strap kulit.
              </p>
            </div>

            <!-- Value & Toggle Box -->
            <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 space-y-4">
              <div class="flex items-center justify-between">
                <div>
                  <span class="text-slate-500 text-xs font-medium">Perkiraan Nilai Barang:</span>
                  <div id="demo-card-val" class="text-xl font-bold text-navy-900">Rp 21.750.000</div>
                </div>
                <div class="text-right">
                  <span class="text-slate-500 text-xs font-medium">Kondisi:</span>
                  <div id="demo-card-condition" class="text-sm font-semibold text-slate-800">Mulus Beli Baru</div>
                </div>
              </div>

              <!-- Interactive Toggle Switch -->
              <div class="pt-3 border-t border-slate-200 flex items-center justify-between gap-4">
                <div>
                  <span class="block text-xs font-bold text-slate-800">Status di Marketplace Publik</span>
                  <span id="demo-toggle-label" class="block text-[11px] text-slate-500">Status: Cuma Disimpan Privat</span>
                </div>
                <button id="btn-demo-toggle-sellable" class="px-4 py-2 rounded-lg bg-navy-900 hover:bg-navy-800 text-white font-semibold text-xs transition-all flex items-center gap-2">
                  <span>Aktifkan Status Dijual</span>
                </button>
              </div>
            </div>



          </div>
        </div>
      </section>

      <!-- PUBLIC MARKETPLACE PREVIEW FOR VISITORS -->
      <section class="space-y-6 pt-4">
        <div class="border-b border-slate-200 pb-4">
          <div>
            <h2 class="text-xl sm:text-2xl font-extrabold text-slate-900">Barang Dijual Komunitas</h2>
            <p class="text-slate-600 text-xs">Daftar barang yang lagi dipajang oleh pengguna lain</p>
          </div>
        </div>

        <div id="public-marketplace-visitor-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <!-- Dynamic public marketplace listings rendered here -->
        </div>
      </section>

      <!-- INTERACTIVE DEMO: SIMULASI ALUR CHAT REALTIME SETELAH PENAWARAN DISETUJUI -->
      <section id="demo-approved-bids-section" class="space-y-6 pt-6 border-t border-slate-200 scroll-mt-24 hidden">
        <div class="p-6 sm:p-8 rounded-2xl bg-white border border-slate-200 space-y-6 shadow-xs">
          <div class="border-b border-slate-200 pb-4">
            <h2 class="text-xl sm:text-2xl font-extrabold text-slate-900 tracking-tight">Simulasi Alur: Negosiasi & Chat Real-Time dengan Bidder Pilihan</h2>
            <p class="text-slate-600 text-xs sm:text-sm mt-1">
              Alur obrolan ini muncul setelah ada penawaran pada barang di marketplace. Pilih tab produk di bawah untuk melihat obrolan realtime tiap produk!
            </p>
          </div>

          <!-- Product Tabs Bar (Appears when items have bids) -->
          <div id="visitor-chat-product-tabs" class="flex items-center gap-2 overflow-x-auto pb-1 text-xs font-semibold text-slate-600 no-scrollbar">
            <!-- Dynamic product tabs rendered here -->
          </div>

          <div id="visitor-approved-bids-container" class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <!-- Dynamic interactive cards rendered here -->
          </div>
        </div>
      </section>

    </div>


    <!-- ================================================================= -->
    <!-- 2. DASHBOARD PENGGUNA TERDAPAT KETIKA LOGIN                       -->
    <!-- ================================================================= -->
    <div id="signed-in-dashboard" class="space-y-4 hidden transition-all duration-300">
      
      <!-- Kept in the DOM for existing data updates; inventory management takes priority on mobile. -->
      <div class="hidden grid-cols-2 md:grid-cols-4 gap-4">
        <div class="p-4 rounded-xl bg-white border border-slate-200 space-y-1 shadow-xs">
          <span class="text-slate-500 text-xs font-medium">Total Barang</span>
          <div id="stat-total-items" class="text-2xl font-bold text-slate-900">0</div>
        </div>
        <div class="p-4 rounded-xl bg-white border border-slate-200 space-y-1 shadow-xs">
          <span class="text-slate-500 text-xs font-medium">Est. Total Nilai</span>
          <div id="stat-total-value" class="text-2xl font-bold text-navy-900">Rp 0</div>
        </div>
        <div class="p-4 rounded-xl bg-white border border-slate-200 space-y-1 shadow-xs">
          <span class="text-slate-500 text-xs font-medium">Barang Dipajang</span>
          <div id="stat-sellable-count" class="text-2xl font-bold text-brand-700">0</div>
        </div>
        <div class="p-4 rounded-xl bg-white border border-slate-200 space-y-1 shadow-xs">
          <span class="text-slate-500 text-xs font-medium">Penawaran Masuk</span>
          <div id="stat-bids-count" class="text-2xl font-bold text-slate-900">0</div>
        </div>
      </div>

      <!-- Widget: Penawaran Disetujui & Chat Real-Time dengan Bidder Pilihan -->
      <div id="approved-bids-widget" class="hidden p-6 rounded-2xl bg-white border border-slate-200 space-y-4 shadow-xs">
        <div class="border-b border-slate-200 pb-3">
          <h3 class="text-lg font-bold text-slate-900 tracking-tight">Negosiasi & Chat Real-Time dengan Bidder Pilihan</h3>
        </div>

        <div id="approved-bids-container" class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <!-- Dynamic cards for approved bids will render here -->
        </div>
      </div>

      <!-- Inventory-first category picker -->
      <section id="inventory-category-section" class="space-y-2" aria-labelledby="inventory-category-title">
        <div class="flex items-center justify-between gap-3">
          <h1 id="inventory-category-title" class="text-sm font-bold text-slate-900">Kategori</h1>
          <div class="flex items-center gap-2">
            <button id="btn-add-item" type="button" class="min-h-9 shrink-0 rounded-lg bg-navy-900 px-3 text-xs font-bold text-white transition-colors hover:bg-navy-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-900">
              + Barang
            </button>
          </div>
        </div>
        <div id="inventory-category-tabs" class="flex gap-2 overflow-x-auto pb-1 no-scrollbar" role="tablist" aria-label="Kategori inventaris">
          <!-- Dynamic category tabs rendered here -->
        </div>
      </section>

      <!-- Section 1: Private Inventory View -->
      <section id="inventory-section" class="space-y-3">
        <div id="inventory-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-4">
          <!-- Dynamic Inventory Items Rendered Here -->
        </div>
      </section>

    </div>

  </div>

  <!-- ================================================================= -->
  <!-- MODALS                                                            -->
  <!-- ================================================================= -->

  <!-- ONBOARDING WIZARD MODAL -->
  <div id="modal-wizard" class="fixed inset-0 bg-slate-900/50 backdrop-blur-xs z-50 flex items-center justify-center p-4 hidden">
    <div class="bg-white border border-slate-200 rounded-2xl max-w-lg w-full p-6 space-y-6 shadow-xl relative overflow-hidden">
      <!-- Header -->
      <div class="flex items-center justify-between text-xs font-semibold text-slate-500 border-b border-slate-200 pb-3">
        <div class="flex items-center gap-2">
          <img src="/logo.png" alt="Stuff8" class="h-6 w-auto object-contain" />
          <span class="text-slate-800 font-semibold">Panduan Pengguna Stuff8</span>
        </div>
        <div class="flex items-center gap-1.5 text-slate-500">
          <span id="wizard-step-indicator" class="text-navy-900 font-mono text-[11px]">Langkah 1 dari 3</span>
          <button id="btn-close-wizard" class="ml-3 text-slate-400 hover:text-slate-700 text-base font-bold">×</button>
        </div>
      </div>

      <!-- WIZARD STEP 1: Account Authentication (Sign In / Sign Up) -->
      <div id="wizard-step-1" class="space-y-5">
        <div class="space-y-1">
          <h2 class="text-xl font-bold text-slate-900">Selamat Datang di Stuff8!</h2>
          <p class="text-slate-600 text-xs">Masuk atau buat akun baru yuk buat mulai ngerapiin barang-barangmu.</p>
        </div>

        <!-- Auth Toggle Switcher -->
        <div class="flex rounded-lg bg-slate-100 p-1 border border-slate-200 text-xs font-semibold text-slate-600">
          <button id="tab-auth-signin" type="button" class="flex-1 py-2 rounded-md bg-white text-navy-900 font-bold shadow-xs transition-all">Masuk</button>
          <button id="tab-auth-signup" type="button" class="flex-1 py-2 rounded-md hover:text-slate-900 transition-all">Buat Akun Baru</button>
        </div>

        <!-- SIGN IN FORM -->
        <form id="form-auth-signin" class="space-y-4">
          <div id="auth-signin-error" class="p-3 rounded-lg bg-rose-50 border border-rose-200 text-rose-700 text-xs hidden"></div>

          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Username</label>
            <input type="text" id="signin-username" required placeholder="Masukkan username kamu" class="w-full px-3.5 py-2.5 rounded-lg bg-white border border-slate-300 text-slate-900 text-sm focus:border-navy-900 focus:outline-none" />
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Kata Sandi</label>
            <div class="relative">
              <input type="password" id="signin-password" required placeholder="••••••••" class="w-full px-3.5 py-2.5 pr-20 rounded-lg bg-white border border-slate-300 text-slate-900 text-sm focus:border-navy-900 focus:outline-none" />
              <button type="button" data-password-toggle="signin-password" aria-label="Tampilkan kata sandi" aria-pressed="false" class="absolute inset-y-0 right-0 px-3 text-xs font-semibold text-slate-500 hover:text-navy-900 focus:outline-none focus-visible:text-navy-900">
                <svg data-password-eye="hidden" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.25 12s3.75-6.75 9.75-6.75S21.75 12 21.75 12 18 18.75 12 18.75 2.25 12 2.25 12Z" /><circle cx="12" cy="12" r="2.75" stroke-width="2" /></svg>
