---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';

const editing = Boolean(Astro.url.searchParams.get('id'));
const pageTitle = editing ? 'Ubah Barang Inventaris' : 'Tambah Barang ke Inventaris';
const maxPhotoMB = Number(import.meta.env.PUBLIC_MAX_PHOTO_MB) || 10;
const maxVideoMB = Number(import.meta.env.PUBLIC_MAX_VIDEO_MB) || 200;
---

<Layout description={pageTitle}>
  <div class="mx-auto w-full max-w-3xl px-4 py-5 sm:px-6 lg:px-8">
    <Breadcrumb
      currentId="breadcrumb-current"
      crumbs={[
        { label: 'Beranda', href: '/' },
        { label: 'Inventaris', href: '/inventory/' },
        { label: pageTitle }
      ]}
    />

    <div class="mt-4 rounded-2xl border border-navy-100 bg-white p-5 shadow-[0_1px_2px_rgba(15,30,25,0.04)] sm:p-7">
      <div class="border-b border-navy-100 pb-4">
        <h1 id="form-page-title" class="text-xl font-extrabold tracking-tight text-slate-900 sm:text-2xl">Tambah Barang ke Inventaris</h1>
        <p class="mt-1 text-sm text-slate-500">Lengkapi data barang kamu. Barang yang dijual akan tampil di Marketplace.</p>
      </div>

      <p id="page-notice" class="mt-4 hidden rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-xs font-medium text-slate-700" role="alert"></p>

      <form id="form-item" class="mt-5 space-y-4">
        <div id="item-details-step" class="space-y-4">
          <div>
            <input type="text" id="input-title" required aria-label="Nama barang" placeholder="Nama Barang (contoh: Kamera Sony A7 III Body Only)" class="w-full px-3 py-2.5 rounded-lg bg-white border border-slate-300 text-slate-900 text-sm focus:border-navy-900 focus:outline-none" />
          </div>

          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div>
              <input id="input-category" type="text" required list="inventory-category-options" autocomplete="off" aria-label="Kategori" placeholder="Cari atau pilih kategori" class="w-full px-3 py-2.5 rounded-lg bg-white border border-slate-300 text-slate-900 text-sm focus:border-navy-900 focus:outline-none" />
              <datalist id="inventory-category-options"></datalist>
            </div>
            <div>
              <select id="input-condition" required aria-label="Kondisi" class="w-full px-3 py-2.5 rounded-lg bg-white border border-slate-300 text-slate-900 text-sm focus:border-navy-900 focus:outline-none">
                <option value="" disabled selected>Kondisi</option>
                <option value="Like New">Mulus Beli Baru</option>
                <option value="Good">Bagus</option>
                <option value="Fair">Cukup</option>
                <option value="Used">Pernah Pakai</option>
              </select>
            </div>
          </div>

          <div>
            <textarea id="input-description" rows="3" aria-label="Deskripsi barang" placeholder="Deskripsi Barang: kelengkapan, garansi, atau catatan fisik..." class="w-full px-3 py-2.5 rounded-lg bg-white border border-slate-300 text-slate-900 text-sm focus:border-navy-900 focus:outline-none"></textarea>
          </div>

          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div>
              <input type="text" id="input-purchase-price" required inputmode="numeric" aria-label="Harga beli dalam rupiah" placeholder="Harga Beli (Rp)" class="w-full px-3 py-2.5 rounded-lg bg-white border border-slate-300 text-slate-900 text-sm focus:border-navy-900 focus:outline-none" />
            </div>
            <div>
              <input type="text" id="input-estimated-value" inputmode="numeric" aria-label="Nilai jual dalam rupiah" placeholder="Nilai Jual (Rp)" class="w-full px-3 py-2.5 rounded-lg bg-white border border-slate-300 text-slate-900 text-sm focus:border-navy-900 focus:outline-none" />
            </div>
            <div class="sm:col-span-2">
              <input type="text" id="input-storage-location" aria-label="Lokasi simpan privat" placeholder="Lokasi Simpan (Privat)" class="w-full px-3 py-2.5 rounded-lg bg-white border border-slate-300 text-slate-900 text-sm focus:border-navy-900 focus:outline-none" />
            </div>
          </div>

          <div class="p-3 rounded-lg bg-slate-50 border border-slate-200 flex items-center justify-between">
            <div>
              <span class="block text-sm font-semibold text-slate-800">Mau Dijual?</span>
              <span class="block text-xs text-slate-500">Tampilkan barang di marketplace publik</span>
            </div>
            <input type="checkbox" id="input-sellable" class="w-5 h-5 accent-navy-900 rounded cursor-pointer" />
          </div>

          <div id="asking-price-container" class="hidden">
            <input type="text" id="input-asking-price" inputmode="numeric" aria-label="Harga buka dalam rupiah" placeholder="Harga Buka (Rp)" class="w-full px-3 py-2.5 rounded-lg bg-white border border-navy-900/50 text-slate-900 text-sm focus:border-navy-900 focus:outline-none" />
          </div>
        </div>

        <section id="item-photo-step" class="hidden space-y-4" aria-labelledby="item-photo-step-title">
          <div class="rounded-xl border border-brand-100 bg-brand-50/50 p-4">
            <p id="item-photo-wizard-badge" class="text-xs font-bold uppercase tracking-wider text-brand-700">Langkah 2 dari 2</p>
            <h4 id="item-photo-step-title" class="mt-1 text-base font-bold text-slate-900">Upload foto barang</h4>
            <p class="mt-1 text-xs leading-relaxed text-slate-600">Pilih satu atau beberapa foto atau video. Foto diubah ke WebP hanya jika hasilnya lebih kecil; video dikompres ke MP4 agar ringan saat diputar.</p>
          </div>
          <label for="input-item-photos" class="flex min-h-28 cursor-pointer flex-col items-center justify-center rounded-xl border border-dashed border-slate-300 bg-slate-50 px-4 text-center transition-colors hover:border-navy-900 hover:bg-slate-100">
            <svg class="size-7 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M4 16l4.6-4.6a2 2 0 012.8 0L14 14m-1-1l1.6-1.6a2 2 0 012.8 0L20 16M5 20h14a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v14a1 1 0 001 1z"/></svg>
            <span class="mt-2 text-sm font-bold text-slate-800">Pilih foto atau video</span>
            <span class="mt-1 text-xs text-slate-500">Foto maksimal {maxPhotoMB} MB · video maksimal {maxVideoMB} MB</span>
          </label>
          <input id="input-item-photos" type="file" accept="image/*,video/*" multiple class="sr-only" />
          <div id="item-photo-carousel"></div>
          <button type="button" id="btn-clear-item-photos" class="hidden items-center justify-center gap-1.5 rounded-lg border border-rose-200 bg-rose-50 px-3 py-2 text-xs font-bold text-rose-700 transition-colors hover:bg-rose-100" aria-label="Hapus semua foto barang">
            <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" /></svg>
            Hapus semua foto
          </button>
        </section>

        <p id="item-form-error" class="hidden rounded-lg border border-rose-200 bg-rose-50 px-3 py-2 text-xs font-medium text-rose-700" role="alert"></p>
        <div class="flex items-center justify-between gap-3 pt-3 border-t border-slate-200">
          <button type="button" id="btn-delete-item" class="hidden px-3 py-2 text-sm font-bold text-rose-700 hover:text-rose-800">Hapus</button>
          <div class="ml-auto flex gap-3">
            <a href="/inventory/" class="inline-flex items-center justify-center rounded-full bg-slate-100 px-4 py-2 text-sm font-semibold text-slate-700 transition-colors hover:bg-slate-200">Batal</a>
            <button type="submit" id="btn-save-item" class="rounded-full bg-clay-600 px-4 py-2 text-sm font-bold text-white shadow-xs transition-colors hover:bg-clay-700">Simpan Barang</button>
          </div>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal: Add inventory category -->
  <div id="modal-category" class="fixed inset-0 z-50 hidden items-end justify-center bg-slate-900/50 p-4 sm:items-center" role="dialog" aria-modal="true" aria-labelledby="category-modal-title">
    <div class="w-full max-w-sm rounded-2xl border border-slate-200 bg-white p-5 shadow-xl">
      <div class="flex items-start justify-between gap-4">
        <div>
          <h2 id="category-modal-title" class="text-base font-bold text-slate-900">Kategori baru</h2>
          <p class="mt-0.5 text-xs text-slate-500">Gunakan nama yang mudah dikenali.</p>
        </div>
        <button id="btn-close-category-modal" type="button" aria-label="Tutup" class="flex size-8 shrink-0 items-center justify-center rounded-lg text-slate-500 transition-colors hover:bg-slate-100 hover:text-slate-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-900">×</button>
      </div>

      <form id="form-category" class="mt-5 space-y-4">
        <div>
          <label for="input-category-name" class="mb-1.5 block text-xs font-semibold text-slate-700">Nama kategori</label>
          <input id="input-category-name" type="text" maxlength="40" autocomplete="off" placeholder="Contoh: Koleksi film" class="min-h-11 w-full rounded-lg border border-slate-300 bg-white px-3 text-sm text-slate-900 outline-none transition-colors placeholder:text-slate-400 focus:border-navy-900 focus:ring-2 focus:ring-navy-900/10" />
          <p id="category-form-error" class="mt-1.5 hidden text-xs font-medium text-rose-700" role="alert"></p>
        </div>
        <div class="flex justify-end gap-2 border-t border-slate-100 pt-4">
          <button id="btn-cancel-category-modal" type="button" class="min-h-10 rounded-lg px-3 text-xs font-bold text-slate-700 transition-colors hover:bg-slate-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-900">Batal</button>
          <button type="submit" class="min-h-10 rounded-full bg-clay-600 px-4 text-xs font-bold text-white transition-colors hover:bg-clay-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-clay-500">Simpan</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    import { can, fetchAccessRights } from '../../../lib/authorization';
    import { initSlider } from '../../../lib/slider';
    import { applyMuteToAll, installVideoBehaviors, isVideoKey, videoMarkup, videoThumbMarkup } from '../../../lib/media';
    const PHOTOS_API = import.meta.env.PUBLIC_PHOTOS_URL || '/api';
    const INVENTORY_API = import.meta.env.PUBLIC_INVENTORY_URL || '/api/inventory';
    const MARKETPLACE_API = import.meta.env.PUBLIC_MARKETPLACE_URL || '/api/marketplace';
    const AUTH_API = `${import.meta.env.PUBLIC_AUTH_URL || '/auth-api'}/auth`;

    const itemId = new URLSearchParams(location.search).get('id');

    const session = () => { try { return JSON.parse(localStorage.getItem('stuff8_session') || 'null'); } catch { return null; } };
    const user = () => session()?.user;
    const authHeaders = () => ({ 'Content-Type': 'application/json', ...(session()?.token ? { 'Authorization': `Bearer ${session().token}` } : {}) });

    type UploadEntry = {
      id: string;
      file: File;
      kind: 'photo' | 'video';
      objectUrl: string;
      status: 'uploading' | 'error' | 'done';
      error?: string;
      controller: AbortController | null;
    };

    // Photos are usually added in the photo step AFTER the item is created and
    // already listed, so the marketplace projection must be re-synced whenever
    // the photo set changes on a sellable item (otherwise the public listing
    // keeps its old, photo-less state while the inventory shows the image).
    const syncToMarketplace = (item: any) => {
      if (!item?.id || !item.sellable) return Promise.resolve();
      return fetch(`${MARKETPLACE_API}/sync-item`, {
        method: 'POST',
        headers: authHeaders(),
        body: JSON.stringify({
          item_id: item.id,
          seller_id: item.owner_id,
          seller_name: user()?.name || user()?.username || 'Pemilik Stuff8',
          title: item.title,
          description: item.description,
          category: item.category,
          condition: item.condition,
          photos: item.photos || [],
          asking_price: item.asking_price ?? item.estimated_value ?? 0,
          general_location: item.storage_location || 'Area Lokal',
          sellable: true
        })
      }).catch(() => { /* best-effort; inventory save already succeeded */ });
    };

    let editingItemId: string | null = itemId;
    let loadedItem: any | null = null;
    let deleteConfirmationArmed = false;
    let photoUploadItem: any | null = null;
    let photoCarouselIndex = 0;
    let customInventoryCategories: string[] = [];
    let inventoryApiCategories: string[] = [];
    let pendingUploads: UploadEntry[] = [];
    let uploadIdCounter = 0;
    let photoPatchChain: Promise<unknown> = Promise.resolve();
    let carousel: { goTo: (index: number) => void; next: () => void; prev: () => void } | null = null;

    const DEFAULT_INVENTORY_CATEGORIES = ['Electronics', 'Cameras', 'Bicycles', 'Books', 'Musical Instruments', 'Furniture'];
    const CREATE_CATEGORY_LABEL = '+ Buat kategori baru';

    const form = document.getElementById('form-item') as HTMLFormElement | null;
    const formTitle = document.getElementById('form-page-title');
    const breadcrumbCurrent = document.getElementById('breadcrumb-current');
    const formError = document.getElementById('item-form-error');
    const detailsStep = document.getElementById('item-details-step');
    const photoStep = document.getElementById('item-photo-step');
    const photosInput = document.getElementById('input-item-photos') as HTMLInputElement | null;
    const photoCarousel = document.getElementById('item-photo-carousel');
    const deleteButton = document.getElementById('btn-delete-item') as HTMLButtonElement | null;
    const saveButton = document.getElementById('btn-save-item') as HTMLButtonElement | null;
    const inputSellable = document.getElementById('input-sellable') as HTMLInputElement;
    const askingPriceContainer = document.getElementById('asking-price-container');
    const pageNotice = document.getElementById('page-notice');

    const categoryNameInput = document.getElementById('input-category-name') as HTMLInputElement | null;
    const categoryFormError = document.getElementById('category-form-error');
    const modalCategory = document.getElementById('modal-category');

    function showNotice(message: string, isError = false) {
      if (!pageNotice) return;
      pageNotice.textContent = message;
      pageNotice.classList.remove('hidden');
      pageNotice.classList.toggle('border-rose-200', isError);
      pageNotice.classList.toggle('bg-rose-50', isError);
      pageNotice.classList.toggle('text-rose-700', isError);
      pageNotice.classList.toggle('border-slate-200', !isError);
      pageNotice.classList.toggle('bg-slate-50', !isError);
      pageNotice.classList.toggle('text-slate-700', !isError);
    }

    function showItemFormError(message: string) {
      if (!formError) return;
      formError.textContent = message;
      formError.classList.remove('hidden');
    }

    function parseRupiah(value: string) {
      const digits = value.replace(/\D/g, '');
      const amount = digits ? Number(digits) : null;
      return amount !== null && Number.isSafeInteger(amount) ? amount : null;
    }

    function formatRupiahInput(input: HTMLInputElement) {
      const amount = parseRupiah(input.value);
      input.value = amount === null ? '' : `Rp ${amount.toLocaleString('id-ID')}`;
    }

    function escapeHtml(value: string) {
      return value.replace(/[&<>'"]/g, char => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#039;', '"': '&quot;'
      }[char] || char));
    }

    function categoryLabel(category: string) {
      const labels: Record<string, string> = {
        Electronics: 'Elektronik', Cameras: 'Kamera', Bicycles: 'Sepeda',
        Books: 'Buku', 'Musical Instruments': 'Alat Musik', Furniture: 'Furnitur'
      };
      return labels[category] || category;
    }

    function categoryPreferenceKey() {
      return `stuff8_inventory_categories_${user()?.id || 'guest'}`;
    }

    function loadCategoryPreferences() {
      try {
        const saved = JSON.parse(localStorage.getItem(categoryPreferenceKey()) || '[]');
        customInventoryCategories = Array.isArray(saved)
          ? saved.filter(category => typeof category === 'string' && category.trim())
          : [];
      } catch {
        customInventoryCategories = [];
      }
    }

    function getSelectableInventoryCategories() {
      return Array.from(new Set([
        ...DEFAULT_INVENTORY_CATEGORIES,
        ...customInventoryCategories,
        ...inventoryApiCategories
      ])).sort((a, b) => categoryLabel(a).localeCompare(categoryLabel(b), 'id'));
    }

    function syncCategorySelects() {
      const categories = getSelectableInventoryCategories();
      const itemCategoryInput = document.getElementById('input-category') as HTMLInputElement | null;
      const categoryOptions = document.getElementById('inventory-category-options');
      if (itemCategoryInput && categoryOptions) {
        const currentCategory = categories.find(category => categoryLabel(category) === itemCategoryInput.value || category === itemCategoryInput.value);
        categoryOptions.innerHTML = `<option value="${CREATE_CATEGORY_LABEL}"></option>${categories.map(category =>
          `<option value="${escapeHtml(categoryLabel(category))}"></option>`
        ).join('')}`;
        if (currentCategory) itemCategoryInput.value = categoryLabel(currentCategory);
      }
    }

    function storagePhotoUrl(photoKey?: string) {
      return photoKey ? `${PHOTOS_API}/storage/content/${photoKey.split('/').map(encodeURIComponent).join('/')}` : '/images/no-item-image.webp';
    }

    function thumbStoragePhotoUrl(photoKey?: string) {
      if (!photoKey || isVideoKey(photoKey)) return storagePhotoUrl(photoKey);
      return `${PHOTOS_API}/storage/content/${photoKey.replace(/\.[a-z0-9]+$/i, '-thumb.webp').split('/').map(encodeURIComponent).join('/')}`;
    }

    function setItemPhotoStep(item: any | null) {
      photoUploadItem = item;
      photoCarouselIndex = 0;
      const uploadingPhotos = Boolean(item);
      detailsStep?.classList.toggle('hidden', uploadingPhotos);
      photoStep?.classList.toggle('hidden', !uploadingPhotos);
      if (saveButton) {
        saveButton.type = uploadingPhotos ? 'button' : 'submit';
        saveButton.textContent = uploadingPhotos ? 'Selesai' : (editingItemId ? 'Simpan Perubahan' : 'Simpan Barang');
      }
      if (photosInput) photosInput.value = '';
      resetPendingUploads();
      renderItemPhotoCarousel();
    }

    // Edit mode keeps the details form visible and shows the photo section
    // inline below it (no two-step wizard). Photos are saved immediately as
    // they are added/removed via the item PATCH, same as the create flow.
    function showEditPhotoSection(item: any) {
      photoUploadItem = item;
      photoCarouselIndex = 0;
      document.getElementById('item-photo-wizard-badge')?.classList.add('hidden');
      const title = document.getElementById('item-photo-step-title');
      if (title) title.textContent = 'Foto barang';
      photoStep?.classList.remove('hidden');
      if (photosInput) photosInput.value = '';
      resetPendingUploads();
      renderItemPhotoCarousel();
    }

    async function reorderPhotos(fromIndex: number, toIndex: number) {
      if (!photoUploadItem || !user()?.id) return;
      const photos = [...(photoUploadItem.photos || [])];
      if (fromIndex < 0 || fromIndex >= photos.length || toIndex < 0 || toIndex >= photos.length || fromIndex === toIndex) return;
      const [moved] = photos.splice(fromIndex, 1);
      photos.splice(toIndex, 0, moved);
      try {
        const response = await fetch(`${INVENTORY_API}/items/${photoUploadItem.id}`, {
          method: 'PATCH', headers: authHeaders(),
          body: JSON.stringify({ owner_id: user().id, photos })
        });
        if (!response.ok) throw new Error(await response.text());
        photoUploadItem = await response.json();
        photoCarouselIndex = toIndex;
        await syncToMarketplace(photoUploadItem);
        renderItemPhotoCarousel();
      } catch (error) {
        console.error('Failed to reorder photos:', error);
        window.stuff8Toast?.('Gagal mengubah urutan foto. Coba lagi.', { variant: 'error', title: 'Gagal' });
      }
    }

    async function movePhotoToFirst(index: number) {
      if (index <= 0) return;
      await reorderPhotos(index, 0);
    }

    function renderItemPhotoCarousel() {
      const clearButton = document.getElementById('btn-clear-item-photos');
      if (clearButton) {
        const hasCommitted = Boolean(photoUploadItem && (photoUploadItem.photos || []).length > 0);
        clearButton.classList.toggle('hidden', !hasCommitted);
        clearButton.classList.toggle('inline-flex', hasCommitted);
      }
      if (!photoCarousel) return;
      if (!photoUploadItem) {
        photoCarousel.innerHTML = '';
        return;
      }
      const slides = currentSlides();
      if (slides.length === 0) {
        photoCarousel.innerHTML = '<div class="rounded-xl border border-slate-200 bg-white p-4 text-center text-xs text-slate-500">Belum ada foto. Kamu dapat menambahkannya sekarang atau nanti dari detail barang.</div>';
        return;
      }
      photoCarouselIndex = Math.min(photoCarouselIndex, slides.length - 1);
      const uploadPreview = (entry: UploadEntry, opacityClass: string) =>
        entry.kind === 'video'
          ? `<video src="${entry.objectUrl}" muted autoplay playsinline loop preload="metadata" class="size-full object-contain ${opacityClass}" data-video></video>`
          : `<img src="${entry.objectUrl}" alt="Media sedang diunggah" loading="lazy" decoding="async" class="size-full object-contain ${opacityClass}" />`;
      const main = slides.map((slide, index) => {
        if (slide.kind === 'photo') {
          return isVideoKey(slide.key)
            ? videoMarkup({ src: storagePhotoUrl(slide.key), className: 'size-full shrink-0 object-contain', label: `Video barang ${index + 1}` })
            : `<img src="${storagePhotoUrl(slide.key)}" alt="Foto barang ${index + 1}" loading="lazy" decoding="async" class="size-full shrink-0 object-contain" />`;
        }
        const entry = slide.entry;
        if (entry.status === 'uploading') {
          return `
            <div class="relative size-full shrink-0 bg-slate-50">
              ${uploadPreview(entry, 'opacity-80')}
              <div class="absolute inset-0 flex items-center justify-center bg-white/30">
                <div class="flex items-center gap-2 rounded-full bg-white/95 px-3 py-1.5 shadow-md">
                  <svg class="size-4 animate-spin text-clay-600" fill="none" viewBox="0 0 24 24" aria-hidden="true"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 0 1 8-8v4a4 4 0 0 0-4 4H4z"></path></svg>
                  <span class="text-xs font-semibold text-slate-600">Mengunggah…</span>
                  <button type="button" data-cancel-upload="${entry.id}" class="rounded-full bg-slate-100 px-2 py-0.5 text-[11px] font-bold text-slate-700 transition-colors hover:bg-slate-200">Batal</button>
                </div>
              </div>
            </div>`;
        }
        return `
          <div class="relative size-full shrink-0 bg-slate-50">
            ${uploadPreview(entry, 'opacity-40')}
            <div class="absolute inset-0 flex flex-col items-center justify-center gap-2 bg-white/40 px-4 text-center">
              <span class="rounded-full bg-rose-50 px-3 py-1 text-xs font-bold text-rose-700">Gagal diunggah${entry.error ? ` · ${escapeHtml(entry.error)}` : ''}</span>
              <div class="flex gap-2">
                <button type="button" data-retry-upload="${entry.id}" class="rounded-full bg-navy-900 px-3 py-1.5 text-xs font-bold text-white transition-colors hover:bg-navy-800">Coba lagi</button>
                <button type="button" data-remove-upload="${entry.id}" class="rounded-full bg-white px-3 py-1.5 text-xs font-bold text-slate-700 shadow-sm transition-colors hover:bg-slate-100">Hapus</button>
              </div>
            </div>
          </div>`;
      }).join('');

      const arrows = slides.length > 1 ? `
        <button type="button" data-slide-prev class="absolute left-2 top-1/2 -translate-y-1/2 rounded-full bg-white/90 p-2 text-slate-800 shadow-sm transition hover:bg-white" aria-label="Foto sebelumnya"><svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m15 18-6-6 6-6" /></svg></button>
        <button type="button" data-slide-next class="absolute right-2 top-1/2 -translate-y-1/2 rounded-full bg-white/90 p-2 text-slate-800 shadow-sm transition hover:bg-white" aria-label="Foto berikutnya"><svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m9 18 6-6-6-6" /></svg></button>` : '';

      const thumbs = slides.map((slide, index) => {
        const active = index === photoCarouselIndex;
        const isCommitted = slide.kind === 'photo';
        const isCover = index === 0;
        const source = slide.kind === 'photo'
          ? isVideoKey(slide.key)
            ? videoThumbMarkup(`Video ${index + 1}`)
            : `<img src="${thumbStoragePhotoUrl(slide.key)}" alt="" class="size-full object-cover" loading="lazy" decoding="async" onerror="this.onerror=null;this.src='${storagePhotoUrl(slide.key)}'" />`
          : slide.entry.kind === 'video'
            ? videoThumbMarkup(`Video ${index + 1}`)
            : `<img src="${slide.entry.objectUrl}" alt="" class="size-full object-cover ${slide.entry.status === 'error' ? 'opacity-40' : 'opacity-80'}" loading="lazy" decoding="async" />`;
        const badge = slide.kind === 'upload' && slide.entry.status === 'uploading'
          ? `<span class="absolute inset-0 flex items-center justify-center bg-white/50"><svg class="size-4 animate-spin text-clay-600" fill="none" viewBox="0 0 24 24" aria-hidden="true"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 0 1 8-8v4a4 4 0 0 0-4 4H4z"></path></svg></span>`
          : '';
        const coverBtn = isCommitted && !isCover
          ? `<button type="button" data-cover-photo="${index}" class="absolute left-0.5 top-0.5 z-10 flex size-[18px] cursor-pointer items-center justify-center rounded-full bg-white/95 text-[10px] leading-none text-amber-500 shadow-sm transition hover:bg-amber-100 hover:text-amber-600" title="Jadikan foto utama" aria-label="Jadikan foto utama">&starf;</button>`
          : '';
        const coverBadge = isCommitted && isCover
          ? `<span class="absolute left-0.5 top-0.5 z-10 flex size-[18px] items-center justify-center rounded-full bg-amber-400 text-[9px] font-bold text-white shadow-sm" title="Foto utama">&starf;</span>`
          : '';
        return `<button type="button" data-slide-thumb="${index}" data-photo-idx="${isCommitted ? index : ''}" ${isCommitted ? 'draggable="true"' : ''} class="relative size-12 shrink-0 overflow-hidden rounded-md border transition ${active ? 'border-navy-900 ring-2 ring-navy-900/15' : 'border-slate-200'}">${source}${badge}${coverBtn}${coverBadge}</button>`;
      }).join('');

      photoCarousel.innerHTML = `
        <div class="overflow-hidden rounded-xl border border-slate-200 bg-slate-100">
          <div class="relative aspect-[4/3]">
            <div data-slide-track class="flex size-full" style="transition:transform .35s cubic-bezier(.4,0,.2,1)">${main}</div>
            <button type="button" data-remove-slide class="absolute right-2 top-2 inline-flex items-center gap-1 rounded-full bg-rose-600 px-2.5 py-1 text-[11px] font-bold text-white shadow-sm transition hover:bg-rose-700" aria-label="Hapus foto ini">Hapus</button>
            ${arrows}
          </div>
          ${slides.length > 1 ? `<div class="flex gap-2 overflow-x-auto p-2" data-thumb-strip>${thumbs}</div>` : ''}
        </div>`;

      carousel = initSlider(photoCarousel, {
        initialIndex: photoCarouselIndex,
        onIndexChange: index => {
          photoCarouselIndex = index;
          photoCarousel?.querySelectorAll<HTMLElement>('[data-slide-thumb]').forEach(thumb => {
            const active = Number(thumb.dataset.slideThumb) === index;
            thumb.classList.toggle('border-navy-900', active);
            thumb.classList.toggle('ring-2', active);
            thumb.classList.toggle('ring-navy-900/15', active);
            thumb.classList.toggle('border-slate-200', !active);
          });
        }
      });

      photoCarousel.querySelector('[data-remove-slide]')?.addEventListener('click', removeCurrentSlide);
      photoCarousel.querySelectorAll<HTMLElement>('[data-cancel-upload]').forEach(button => button.addEventListener('click', () => cancelUpload(button.dataset.cancelUpload!)));
      photoCarousel.querySelectorAll<HTMLElement>('[data-retry-upload]').forEach(button => button.addEventListener('click', () => retryUpload(button.dataset.retryUpload!)));
      photoCarousel.querySelectorAll<HTMLElement>('[data-remove-upload]').forEach(button => button.addEventListener('click', () => removePendingUpload(button.dataset.removeUpload!)));
      const thumbStrip = photoCarousel.querySelector<HTMLElement>('[data-thumb-strip]');
      if (thumbStrip) {
        let dragSourceIdx = -1;
        let touchStartX = 0;
        let touchStartY = 0;

        const getThumbAtTouch = (x: number, y: number) => {
          const thumbs = thumbStrip.querySelectorAll<HTMLElement>('[draggable]');
          for (const t of thumbs) {
            const r = t.getBoundingClientRect();
            if (x >= r.left && x <= r.right && y >= r.top && y <= r.bottom) return t;
          }
          return null;
        };

        thumbStrip.querySelectorAll<HTMLElement>('[draggable]').forEach(thumb => {
          thumb.style.touchAction = 'none';

          thumb.addEventListener('dragstart', (e) => {
            dragSourceIdx = parseInt((thumb as HTMLElement).dataset.photoIdx!);
            e.dataTransfer!.effectAllowed = 'move';
            (thumb as HTMLElement).classList.add('opacity-30');
          });
          thumb.addEventListener('dragend', () => {
            (thumb as HTMLElement).classList.remove('opacity-30');
            dragSourceIdx = -1;
            thumbStrip.querySelectorAll('[data-drag-over]').forEach(el => { delete el.dataset.dragOver; el.classList.remove('ring-2', 'ring-amber-400'); });
          });
          thumb.addEventListener('dragover', (e) => {
            e.preventDefault();
            e.dataTransfer!.dropEffect = 'move';
            if (dragSourceIdx >= 0 && dragSourceIdx !== parseInt((thumb as HTMLElement).dataset.photoIdx!)) {
              (thumb as HTMLElement).dataset.dragOver = '1';
              thumb.classList.add('ring-2', 'ring-amber-400');
            }
          });
          thumb.addEventListener('dragleave', () => {
            delete (thumb as HTMLElement).dataset.dragOver;
            thumb.classList.remove('ring-2', 'ring-amber-400');
          });
          thumb.addEventListener('drop', (e) => {
            e.preventDefault();
            delete (thumb as HTMLElement).dataset.dragOver;
            thumb.classList.remove('ring-2', 'ring-amber-400');
            const toIdx = parseInt((thumb as HTMLElement).dataset.photoIdx!);
            if (dragSourceIdx >= 0 && dragSourceIdx !== toIdx) {
              reorderPhotos(dragSourceIdx, toIdx);
            }
            dragSourceIdx = -1;
          });

          thumb.addEventListener('touchstart', (e) => {
            const t = e.touches[0];
            touchStartX = t.clientX;
            touchStartY = t.clientY;
            dragSourceIdx = parseInt((thumb as HTMLElement).dataset.photoIdx!);
            (thumb as HTMLElement).classList.add('opacity-30');
          }, { passive: true });

          thumb.addEventListener('touchmove', (e) => {
            e.preventDefault();
            const t = e.touches[0];
            thumbStrip.querySelectorAll('[data-drag-over]').forEach(el => { delete el.dataset.dragOver; el.classList.remove('ring-2', 'ring-amber-400'); });
            const target = getThumbAtTouch(t.clientX, t.clientY);
            if (target && dragSourceIdx >= 0 && dragSourceIdx !== parseInt(target.dataset.photoIdx!)) {
              target.dataset.dragOver = '1';
              target.classList.add('ring-2', 'ring-amber-400');
            }
          }, { passive: false });

          thumb.addEventListener('touchend', (e) => {
            (thumb as HTMLElement).classList.remove('opacity-30');
            thumbStrip.querySelectorAll('[data-drag-over]').forEach(el => { delete el.dataset.dragOver; el.classList.remove('ring-2', 'ring-amber-400'); });
            const t = e.changedTouches[0];
            const target = getThumbAtTouch(t.clientX, t.clientY);
            if (target && dragSourceIdx >= 0) {
              const toIdx = parseInt(target.dataset.photoIdx!);
              if (dragSourceIdx !== toIdx) {
                reorderPhotos(dragSourceIdx, toIdx);
              }
            }
            dragSourceIdx = -1;
          });

          thumb.addEventListener('touchcancel', () => {
            (thumb as HTMLElement).classList.remove('opacity-30');
            dragSourceIdx = -1;
            thumbStrip.querySelectorAll('[data-drag-over]').forEach(el => { delete el.dataset.dragOver; el.classList.remove('ring-2', 'ring-amber-400'); });
          });
        });
        thumbStrip.querySelectorAll<HTMLElement>('[data-cover-photo]').forEach(btn => {
          btn.addEventListener('click', (e) => {
            e.stopPropagation();
            const idx = parseInt(btn.dataset.coverPhoto!);
            movePhotoToFirst(idx);
          });
        });
      }
      installVideoBehaviors();
      applyMuteToAll();
    }

    const MAX_PHOTO_MB = Number(import.meta.env.PUBLIC_MAX_PHOTO_MB) || 10;
    const MAX_PHOTO_BYTES = MAX_PHOTO_MB * 1024 * 1024;
    const MAX_VIDEO_MB = Number(import.meta.env.PUBLIC_MAX_VIDEO_MB) || 200;
    const MAX_VIDEO_BYTES = MAX_VIDEO_MB * 1024 * 1024;
    const isVideoFile = (file: File) => file.type.startsWith('video/') || /\.(mp4|webm|m4v|mov|ogv|3gp|mkv|avi)$/i.test(file.name);
    const mediaCapMB = (kind: 'photo' | 'video') => kind === 'video' ? MAX_VIDEO_MB : MAX_PHOTO_MB;
    const mediaCapBytes = (kind: 'photo' | 'video') => kind === 'video' ? MAX_VIDEO_BYTES : MAX_PHOTO_BYTES;

    function currentSlides(): { kind: 'photo' | 'upload'; key?: string; entry?: UploadEntry }[] {
      const committed = (photoUploadItem?.photos || []).map(key => ({ kind: 'photo' as const, key }));
      const pending = pendingUploads.map(entry => ({ kind: 'upload' as const, entry }));
      return [...committed, ...pending];
    }

    function resetPendingUploads() {
      pendingUploads.forEach(entry => entry.controller?.abort());
      pendingUploads.forEach(entry => URL.revokeObjectURL(entry.objectUrl));
      pendingUploads = [];
      photoCarouselIndex = 0;
    }

    function addUploads(files: FileList) {
      if (!photoUploadItem || !user()?.id) return;
      const selected = Array.from(files);
      if (selected.length === 0) return;
      const entries: UploadEntry[] = selected.map(file => {
        const id = `upload-${++uploadIdCounter}`;
        const kind: 'photo' | 'video' = isVideoFile(file) ? 'video' : 'photo';
        const capMB = mediaCapMB(kind);
        const capBytes = mediaCapBytes(kind);
        const oversized = file.size > capBytes;
        return {
          id,
          file,
          kind,
          objectUrl: URL.createObjectURL(file),
          status: oversized ? 'error' : 'uploading',
          error: oversized ? `${kind === 'video' ? 'Video' : 'Foto'} terlalu besar (${(file.size / (1024 * 1024)).toFixed(1)} MB, maksimal ${capMB} MB)` : undefined,
          controller: null,
        };
      });
      pendingUploads.push(...entries);
      photoCarouselIndex = Math.max(currentSlides().length - 1, 0);
      renderItemPhotoCarousel();
      entries.forEach(entry => { if (entry.status === 'uploading') uploadEntry(entry); });
    }

    function enqueuePhotoPatch(key: string): Promise<void> {
      const task = photoPatchChain.then(async () => {
        if (!photoUploadItem || !user()?.id) return;
        const photos = [...(photoUploadItem.photos || []), key];
        const response = await fetch(`${INVENTORY_API}/items/${photoUploadItem.id}`, {
          method: 'PATCH', headers: authHeaders(),
          body: JSON.stringify({ owner_id: user().id, photos })
        });
        if (!response.ok) throw new Error(await response.text());
        photoUploadItem = await response.json();
      });
      photoPatchChain = task.catch(() => {});
      return task;
    }

    async function uploadEntry(entry: UploadEntry) {
      if (!photoUploadItem || !user()?.id) return;
      entry.controller = new AbortController();
      const timeoutMs = entry.kind === 'video' ? 5 * 60 * 1000 : 3 * 60 * 1000;
      const timeoutTimer = window.setTimeout(() => entry.controller?.abort(), timeoutMs);
      try {
        const body = new FormData();
        body.append('file', entry.file);
        body.append('owner_id', user().id);
        body.append('namespace', 'inventory');
        body.append('reference_id', photoUploadItem.id);
        const uploaded = await fetch(`${PHOTOS_API}/storage/objects`, {
          method: 'POST', body, signal: entry.controller.signal,
        });
        if (!uploaded.ok) throw new Error(await uploaded.text());
        const object = await uploaded.json();
        let objectKey = object.key;
        try {
          await enqueuePhotoPatch(objectKey);
        } catch (patchError) {
          // The object is in storage but couldn't be linked to the item — drop
          // it so we don't orphan bytes, then surface the real error.
          fetch(`${PHOTOS_API}/storage/objects/${objectKey.split('/').map(encodeURIComponent).join('/')}?owner_id=${encodeURIComponent(user()!.id)}`, { method: 'DELETE' })
            .catch(() => { /* best-effort cleanup */ });
          throw patchError;
        }
        entry.status = 'done';
        entry.controller = null;
        window.clearTimeout(timeoutTimer);
        URL.revokeObjectURL(entry.objectUrl);
        pendingUploads = pendingUploads.filter(pending => pending.id !== entry.id);
        photoCarouselIndex = Math.max(currentSlides().length - 1, 0);
        renderItemPhotoCarousel();
        await syncToMarketplace(photoUploadItem);
      } catch (error) {
        window.clearTimeout(timeoutTimer);
        if (error instanceof DOMException && error.name === 'AbortError') {
          // A timed-out upload should be retryable, not silently dropped.
          entry.status = 'error';
          entry.controller = null;
          entry.error = entry.kind === 'video'
            ? 'Unggahan video terlalu lama. Coba video yang lebih pendek.'
            : 'Unggahan foto terlalu lama. Periksa koneksi lalu coba lagi.';
          renderItemPhotoCarousel();
          return;
        }
        console.error('Failed to upload inventory media:', error);
        entry.status = 'error';
        entry.controller = null;
        const detail = error instanceof Error ? error.message : '';
        entry.error = detail && !/^Failed to fetch/.test(detail) ? detail : 'Periksa koneksi lalu coba lagi.';
        renderItemPhotoCarousel();
      }
    }

    function cancelUpload(id: string) {
      const entry = pendingUploads.find(pending => pending.id === id);
      if (!entry) return;
      entry.controller?.abort();
      removePendingUpload(id);
    }

    function retryUpload(id: string) {
      const entry = pendingUploads.find(pending => pending.id === id);
      if (!entry || !photoUploadItem) return;
      entry.status = 'uploading';
      entry.error = undefined;
      renderItemPhotoCarousel();
      uploadEntry(entry);
    }

    function removePendingUpload(id: string) {
      const entry = pendingUploads.find(pending => pending.id === id);
      pendingUploads = pendingUploads.filter(pending => pending.id !== id);
      if (entry) URL.revokeObjectURL(entry.objectUrl);
      photoCarouselIndex = Math.min(photoCarouselIndex, Math.max(currentSlides().length - 1, 0));
      renderItemPhotoCarousel();
    }

    function removeCurrentSlide() {
      if (!photoUploadItem) return;
      const slide = currentSlides()[photoCarouselIndex];
      if (!slide) return;
      if (slide.kind === 'upload') {
        removePendingUpload(slide.entry!.id);
        return;
      }
      if (!user()?.id) return;
      const photos = (photoUploadItem.photos || []).filter(key => key !== slide.key);
      if (photos.length === (photoUploadItem.photos || []).length) return;
      (async () => {
        try {
          // Drop the storage object (and its thumbnail sibling) first, then
          // detach it from the item so we never orphan bytes in S3/MinIO.
          const storageKey = slide.key!;
          await fetch(`${PHOTOS_API}/storage/objects/${storageKey.split('/').map(encodeURIComponent).join('/')}?owner_id=${encodeURIComponent(user()!.id)}`, { method: 'DELETE' })
            .catch(() => { /* best-effort; the PATCH below still detaches the key */ });
          const response = await fetch(`${INVENTORY_API}/items/${photoUploadItem!.id}`, {
            method: 'PATCH', headers: authHeaders(),
            body: JSON.stringify({ owner_id: user()!.id, photos })
          });
          if (!response.ok) throw new Error(await response.text());
          photoUploadItem = await response.json();
          photoCarouselIndex = Math.min(photoCarouselIndex, Math.max(currentSlides().length - 1, 0));
          await syncToMarketplace(photoUploadItem);
          renderItemPhotoCarousel();
        } catch (error) {
          console.error('Failed to remove inventory photo:', error);
          window.stuff8Toast?.('Foto belum dapat dihapus. Coba lagi.', { variant: 'error', title: 'Gagal menghapus foto' });
        }
      })();
    }

    function clearAllPhotos() {
      if (!photoUploadItem || !user()?.id) return;
      const keys = (photoUploadItem.photos || []).filter(Boolean);
      if (keys.length === 0) return;
      (async () => {
        try {
          const owner = encodeURIComponent(user()!.id);
          // Remove every storage object (each image + its thumbnail sibling)
          // so clearing the form truly frees the bytes.
          await Promise.all(keys.map(key =>
            fetch(`${PHOTOS_API}/storage/objects/${key.split('/').map(encodeURIComponent).join('/')}?owner_id=${owner}`, { method: 'DELETE' })
              .catch(() => { /* best-effort */ })
          ));
          const response = await fetch(`${INVENTORY_API}/items/${photoUploadItem!.id}`, {
            method: 'PATCH', headers: authHeaders(),
            body: JSON.stringify({ owner_id: user()!.id, photos: [] })
          });
          if (!response.ok) throw new Error(await response.text());
          photoUploadItem = await response.json();
          photoCarouselIndex = 0;
          await syncToMarketplace(photoUploadItem);
          renderItemPhotoCarousel();
          window.stuff8Toast?.('Semua foto sudah dihapus.', { variant: 'success', title: 'Foto dihapus' });
        } catch (error) {
          console.error('Failed to clear inventory photos:', error);
          window.stuff8Toast?.('Foto belum dapat dihapus. Coba lagi.', { variant: 'error', title: 'Gagal menghapus foto' });
        }
      })();
    }

    function openCategoryModal() {
      if (!modalCategory || !categoryNameInput) return;
      categoryFormError?.classList.add('hidden');
      categoryNameInput.value = '';
      modalCategory.classList.remove('hidden');
      modalCategory.classList.add('flex');
      requestAnimationFrame(() => categoryNameInput.focus());
    }

    function closeCategoryModal() {
      modalCategory?.classList.add('hidden');
      modalCategory?.classList.remove('flex');
    }

    function showCategoryError(message: string) {
      if (!categoryFormError) return;
      categoryFormError.textContent = message;
      categoryFormError.classList.remove('hidden');
    }

    async function load() {
      const currentUser = user();
      if (!currentUser?.id) {
        location.assign(`/auth/signup/?return_to=${encodeURIComponent(location.pathname + location.search)}`);
        return;
      }

      loadCategoryPreferences();
      syncCategorySelects();

      try {
        const response = await fetch(`${INVENTORY_API}/items?owner_id=${encodeURIComponent(currentUser.id)}&limit=1`, { headers: authHeaders() });
        if (response.ok) {
          const meta = await response.json();
          if (Array.isArray(meta.category_counts)) {
            inventoryApiCategories = meta.category_counts.map((entry: any) => entry.category);
            syncCategorySelects();
          }
        }
      } catch { /* selectable categories still come from defaults + local storage */ }

      if (!itemId) return;

      let item: any;
      try {
        const response = await fetch(`${INVENTORY_API}/items/${encodeURIComponent(itemId)}`, { headers: authHeaders() });
        if (!response.ok) throw new Error('not_found');
        item = await response.json();
      } catch {
        showNotice('Barang tidak ditemukan atau sudah dihapus.', true);
        setTimeout(() => location.assign('/inventory/'), 1800);
        return;
      }
      if (item.owner_id !== currentUser.id) {
        showNotice('Anda hanya dapat mengubah barang milik sendiri.', true);
        setTimeout(() => location.assign('/inventory/'), 1800);
        return;
      }

      editingItemId = item.id;
      loadedItem = item;
      (document.getElementById('input-title') as HTMLInputElement).value = item.title || '';
      (document.getElementById('input-category') as HTMLInputElement).value = categoryLabel(item.category || '');
      (document.getElementById('input-condition') as HTMLSelectElement).value = item.condition || '';
      (document.getElementById('input-description') as HTMLTextAreaElement).value = item.description || '';
      (document.getElementById('input-storage-location') as HTMLInputElement).value = item.storage_location || '';
      const purchasePriceInput = document.getElementById('input-purchase-price') as HTMLInputElement;
      purchasePriceInput.value = item.purchase_price == null ? '' : String(item.purchase_price);
      formatRupiahInput(purchasePriceInput);
      const saleValueInput = document.getElementById('input-estimated-value') as HTMLInputElement;
      saleValueInput.value = item.estimated_value == null ? '' : String(item.estimated_value);
      formatRupiahInput(saleValueInput);
      inputSellable.checked = Boolean(item.sellable);
      const askingPriceInput = document.getElementById('input-asking-price') as HTMLInputElement;
      askingPriceInput.value = item.asking_price == null ? '' : String(item.asking_price);
      formatRupiahInput(askingPriceInput);
      askingPriceContainer?.classList.toggle('hidden', !item.sellable);
      deleteButton?.classList.remove('hidden');
      if (formTitle) formTitle.textContent = 'Ubah Barang Inventaris';
      if (breadcrumbCurrent) breadcrumbCurrent.textContent = item.title || 'Ubah Barang';
      document.title = `${item.title || 'Ubah Barang'} - Stuff8`;
      showEditPhotoSection(item);
    }

    document.getElementById('input-category')?.addEventListener('input', event => {
      const input = event.currentTarget as HTMLInputElement;
      if (input.value !== CREATE_CATEGORY_LABEL) return;
      input.value = '';
      openCategoryModal();
    });
    document.getElementById('btn-close-category-modal')?.addEventListener('click', closeCategoryModal);
    document.getElementById('btn-cancel-category-modal')?.addEventListener('click', closeCategoryModal);
    document.getElementById('form-category')?.addEventListener('submit', event => {
      event.preventDefault();
      const category = categoryNameInput?.value.trim() || '';
      if (!category) {
        showCategoryError('Masukkan nama kategori terlebih dahulu.');
        categoryNameInput?.focus();
        return;
      }
      if (getSelectableInventoryCategories().some(existing => existing.toLocaleLowerCase() === category.toLocaleLowerCase())) {
        showCategoryError('Kategori ini sudah tersedia.');
        categoryNameInput?.focus();
        return;
      }
      customInventoryCategories.push(category);
      localStorage.setItem(categoryPreferenceKey(), JSON.stringify(customInventoryCategories));
      syncCategorySelects();
      const itemCategoryInput = document.getElementById('input-category') as HTMLInputElement | null;
      if (itemCategoryInput) itemCategoryInput.value = categoryLabel(category);
      closeCategoryModal();
    });

    inputSellable?.addEventListener('change', () => {
      const isChecked = inputSellable.checked;
      askingPriceContainer?.classList.toggle('hidden', !isChecked);
      if (isChecked) {
        const askingPriceInput = document.getElementById('input-asking-price') as HTMLInputElement | null;
        const estimatedValueInput = document.getElementById('input-estimated-value') as HTMLInputElement | null;
        if (askingPriceInput && estimatedValueInput && !askingPriceInput.value.trim()) {
          askingPriceInput.value = estimatedValueInput.value;
          formatRupiahInput(askingPriceInput);
        }
      }
    });

    ['input-purchase-price', 'input-estimated-value', 'input-asking-price'].forEach(id => {
      const input = document.getElementById(id) as HTMLInputElement | null;
      input?.addEventListener('input', () => formatRupiahInput(input));
    });

    photosInput?.addEventListener('change', () => {
      if (photosInput.files) addUploads(photosInput.files);
    });

    document.getElementById('btn-clear-item-photos')?.addEventListener('click', clearAllPhotos);

    saveButton?.addEventListener('click', () => {
      if (!photoUploadItem) return;
      if (editingItemId) return;
      resetPendingUploads();
      photoUploadItem = null;
      location.assign('/inventory/');
    });

    deleteButton?.addEventListener('click', async () => {
      if (!editingItemId || !user()?.id) return;
      if (!deleteConfirmationArmed) {
        deleteConfirmationArmed = true;
        deleteButton.textContent = 'Klik lagi untuk hapus';
        showItemFormError('Tindakan ini menghapus barang dari inventaris. Klik Hapus sekali lagi untuk mengonfirmasi.');
        return;
      }
      try {
        const response = await fetch(`${INVENTORY_API}/items/${editingItemId}?owner_id=${encodeURIComponent(user().id)}`, { method: 'DELETE' });
        if (!response.ok) throw new Error(await response.text());
        // Remove the public marketplace listing (if any) so a deleted item
        // doesn't stay up for sale.
        if (loadedItem) {
          await fetch(`${MARKETPLACE_API}/sync-item`, {
            method: 'POST',
            headers: authHeaders(),
            body: JSON.stringify({
              item_id: loadedItem.id,
              seller_id: loadedItem.owner_id,
              seller_name: user()?.name || user()?.username || 'Pemilik Stuff8',
              title: loadedItem.title || '',
              description: loadedItem.description || '',
              category: loadedItem.category || '',
              condition: loadedItem.condition || '',
              photos: loadedItem.photos || [],
              asking_price: loadedItem.asking_price ?? loadedItem.estimated_value ?? 0,
              general_location: loadedItem.storage_location || 'Area Lokal',
              sellable: false
            })
          }).catch(error => console.error('Failed to remove marketplace listing after delete:', error));
        }
        location.assign('/inventory/');
      } catch (error) {
        console.error('Failed to delete inventory item:', error);
        showItemFormError('Barang belum dapat dihapus. Pastikan Anda adalah pemilik barang ini.');
      }
    });

    form?.addEventListener('submit', async event => {
      event.preventDefault();
      formError?.classList.add('hidden');
      if (!user()?.id) {
        location.assign('/auth/signup/');
        return;
      }

      const title = (document.getElementById('input-title') as HTMLInputElement).value.trim();
      const categoryInput = (document.getElementById('input-category') as HTMLInputElement).value.trim();
      const category = getSelectableInventoryCategories().find(value => value === categoryInput || categoryLabel(value) === categoryInput);
      const condition = (document.getElementById('input-condition') as HTMLSelectElement).value;
      const description = (document.getElementById('input-description') as HTMLTextAreaElement).value.trim();
      const purchasePrice = parseRupiah((document.getElementById('input-purchase-price') as HTMLInputElement).value);
      const estimatedValueInput = (document.getElementById('input-estimated-value') as HTMLInputElement).value;
      const estimatedValue = estimatedValueInput ? parseRupiah(estimatedValueInput) : null;
      const storageLocation = (document.getElementById('input-storage-location') as HTMLInputElement).value.trim();
      const isSellable = inputSellable.checked;
      const askingPriceInput = (document.getElementById('input-asking-price') as HTMLInputElement).value;
      const askingPrice = isSellable && askingPriceInput ? parseRupiah(askingPriceInput) : null;

      if (!category) {
        showItemFormError('Pilih kategori dari daftar, atau buat kategori baru.');
        return;
      }
      if (purchasePrice === null || purchasePrice < 0 || (estimatedValue !== null && estimatedValue < 0) || (askingPrice !== null && askingPrice < 0)) {
        showItemFormError('Masukkan nilai harga yang valid.');
        return;
      }

      if (isSellable) {
        const sessionData = session();
        const freshPermissions = await fetchAccessRights(AUTH_API, sessionData?.token || '');
        const authorizedUser = { ...user(), permissions: freshPermissions.length ? freshPermissions : (user()?.permissions ?? []) };
        if (!can(authorizedUser, 'marketplace:publish')) {
          showItemFormError('Verifikasi email kamu dulu untuk bisa menjual barang di Marketplace. Periksa inbox atau klik "Kirim ulang email" di menu.');
          inputSellable.checked = false;
          askingPriceContainer?.classList.add('hidden');
          return;
        }
      }

      try {
        const response = await fetch(editingItemId ? `${INVENTORY_API}/items/${editingItemId}` : `${INVENTORY_API}/items`, {
          method: editingItemId ? 'PATCH' : 'POST',
          headers: authHeaders(),
          body: JSON.stringify({
            owner_id: user().id,
            title,
            category,
            condition,
            description,
            purchase_price: purchasePrice,
            estimated_value: estimatedValue,
            asking_price: askingPrice,
            storage_location: storageLocation || null,
            sellable: isSellable,
            status: isSellable ? 'sellable' : 'collection'
          })
        });
        if (!response.ok) {
          const detail = await response.text();
          throw new Error(detail || `Layanan inventaris merespons HTTP ${response.status}.`);
        }

        const newItem = await response.json();
        // Always mirror to the marketplace: sellable upserts the listing,
        // non-sellable removes it (so unchecking "Mau Dijual?" on edit pulls
        // the listing from the public marketplace).
        await fetch(`${MARKETPLACE_API}/sync-item`, {
          method: 'POST',
          headers: authHeaders(),
          body: JSON.stringify({
            item_id: newItem.id,
            seller_id: newItem.owner_id,
            seller_name: user()?.name || user()?.username || 'Pemilik Stuff8',
            title: newItem.title,
            description: newItem.description,
            category: newItem.category,
            condition: newItem.condition,
            photos: newItem.photos || [],
            asking_price: askingPrice ?? purchasePrice ?? 0,
            general_location: storageLocation || 'Area Lokal',
            sellable: isSellable
          })
        }).catch(() => { /* best-effort; inventory save already succeeded */ });

        if (editingItemId) {
          window.stuff8Toast?.('Perubahan barang sudah disimpan.', { variant: 'success', title: 'Inventaris diperbarui' });
          location.assign('/inventory/');
          return;
        }
        editingItemId = newItem.id;
        deleteConfirmationArmed = false;
        window.stuff8Toast?.('Barang ditambahkan ke inventaris.', { variant: 'success', title: 'Barang tersimpan' });
        setItemPhotoStep(newItem);
      } catch (error) {
        console.error('Failed to create inventory item:', error);
        showItemFormError('Barang belum dapat disimpan. Periksa koneksi layanan lalu coba lagi.');
      }
    });

    (window as any).inventoryPhotoPrevious = () => carousel?.prev();
    (window as any).inventoryPhotoNext = () => carousel?.next();
    (window as any).inventoryPhotoSelect = (index: number) => carousel?.goTo(index);

    load();
  </script>
</Layout>
