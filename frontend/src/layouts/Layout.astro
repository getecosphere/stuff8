---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Stuff8 — Catat Barang & Pasar Jual Beli", 
  description = "Rapiin barang-barang kamu dalam inventaris digital. Ada barang nganggur? Tinggal sekali klik langsung pajang di marketplace!" 
} = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
      body {
        font-family: 'Plus Jakarta Sans', sans-serif;
      }
    </style>
  </head>
  <body class="bg-slate-50 text-slate-900 flex flex-col min-h-screen">
    <header class="border-b border-slate-200/80 bg-white/90 backdrop-blur-md sticky top-0 z-40 shadow-xs">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-3 group">
          <img src="/logo.png" alt="Stuff8 Logo" class="h-8 w-auto object-contain group-hover:opacity-90 transition-opacity" />
          <span class="sr-only">Stuff8 - Manajemen Barang & Pasar Jual Beli</span>
        </a>

        <div id="header-user-badge" class="flex items-center gap-3">
          <!-- Authenticated State -->
          <div id="user-profile-pill" class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-slate-100 border border-slate-200 text-xs font-medium text-slate-800">
            <div class="w-5 h-5 rounded-full bg-navy-900 text-white flex items-center justify-center font-bold text-[10px]">
              <span id="user-avatar-initial">?</span>
            </div>
            <span id="user-display-name">Belum Masuk</span>
            <button id="btn-logout" title="Keluar / Ganti Akun" class="text-slate-400 hover:text-slate-700 ml-1 text-xs">✕</button>
          </div>

          <!-- Unauthenticated State Button -->
          <button id="btn-header-login" class="px-3 py-1.5 rounded-lg bg-navy-900 hover:bg-navy-800 text-white text-xs font-bold shadow-xs hidden transition-all">
            Masuk / Daftar
          </button>
        </div>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-slate-200 bg-white py-8">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center text-xs text-slate-500">
        <p>© 2026 Stuff8 — Catat Barang Pribadi & Pasar Jual Beli</p>
      </div>
    </footer>
  </body>
</html>

