---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Stuff8 — Personal Inventory First, Marketplace Second", 
  description = "Organize your physical belongings in a digital inventory. Optionally turn unused items into marketplace listings with a single click." 
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
      body {
        font-family: 'Plus Jakarta Sans', sans-serif;
      }
    </style>
  </head>
  <body class="bg-slate-950 text-slate-100 flex flex-col min-h-screen">
    <header class="border-b border-slate-800/80 bg-slate-950/90 backdrop-blur-md sticky top-0 z-40">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-3 group">
          <div class="w-8 h-8 rounded-lg bg-emerald-500 flex items-center justify-center font-black text-slate-950 text-sm shadow-md shadow-emerald-500/20 group-hover:scale-105 transition-transform">
            S8
          </div>
          <div class="flex flex-col">
            <span class="text-lg font-bold tracking-tight text-slate-100 leading-none">Stuff8</span>
            <span class="text-[10px] text-slate-400 font-medium tracking-wide">Personal Asset Manager</span>
          </div>
        </a>

        <div id="header-user-badge" class="flex items-center gap-3">
          <button id="btn-onboarding-wizard" class="px-3 py-1.5 rounded-lg bg-slate-900 hover:bg-slate-800 border border-slate-800 text-slate-300 text-xs font-semibold flex items-center gap-1.5 transition-all">
            <span>🧭 Onboarding Wizard</span>
          </button>
          
          <!-- Authenticated State -->
          <div id="user-profile-pill" class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-slate-900 border border-slate-800 text-xs font-medium text-slate-300">
            <div class="w-5 h-5 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-bold text-[10px]">
              <span id="user-avatar-initial">?</span>
            </div>
            <span id="user-display-name">Not Signed In</span>
            <button id="btn-logout" title="Sign Out / Switch Account" class="text-slate-500 hover:text-slate-200 ml-1 text-xs">✕</button>
          </div>

          <!-- Unauthenticated State Button -->
          <button id="btn-header-login" class="px-3 py-1.5 rounded-lg bg-emerald-500 hover:bg-emerald-400 text-slate-950 text-xs font-bold shadow-md shadow-emerald-500/10 hidden transition-all">
            Sign In / Sign Up
          </button>
        </div>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-slate-800 bg-slate-950 py-8">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center text-sm text-slate-500">
        <p>© 2026 Stuff8 — Personal Inventory & Bidding Marketplace (ECO DDD Estate)</p>
      </div>
    </footer>
  </body>
</html>
