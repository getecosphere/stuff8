---
import '../styles/global.css';

interface Props {
  description?: string;
}

const { 
  description = "Rapiin barang-barang kamu dalam inventaris digital. Ada barang nganggur? Tinggal sekali klik langsung pajang di marketplace!"
} = Astro.props;
const isInventory = Astro.url.pathname === '/';
const isMarketplace = Astro.url.pathname.startsWith('/marketplace');
const isEmailVerification = Astro.url.pathname.startsWith('/auth/verify-email');
// The public origin is deliberately taken from stuff8_bootstrap/ecompose.yml
// (`expose.hostname`), not from a browser-local URL or a hand-managed .env.
const siteUrl = 'https://stuff8.arunikaswarna.my.id';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const socialImageUrl = new URL('/images/stuff8-social-preview.webp', siteUrl).toString();
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Stuff8</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#0f172a" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content="Stuff8" />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Stuff8" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:secure_url" content={socialImageUrl} />
    <meta property="og:image:type" content="image/webp" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Koleksi barang pribadi yang tertata rapi dengan Stuff8" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Stuff8" />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content="Koleksi barang pribadi yang tertata rapi dengan Stuff8" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
      body {
        font-family: 'Plus Jakarta Sans', sans-serif;
      }
    </style>
  </head>
  <body class="bg-slate-50 text-slate-900 flex flex-col min-h-screen">
    <header class="border-b border-slate-200/80 bg-white/90 backdrop-blur-md sticky top-0 z-40 shadow-xs">
      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-2">
        <a href="/" class="flex items-center gap-3 group">
          <img src="/logo.png" alt="Stuff8 Logo" class="h-7 sm:h-8 w-auto object-contain group-hover:opacity-90 transition-opacity" />
          <span class="sr-only">Stuff8 - Manajemen Barang & Pasar Jual Beli</span>
        </a>
        <div class="flex items-center gap-2">
          <nav class="inline-flex min-h-10 items-center rounded-lg border border-slate-200 bg-white p-1 text-xs font-bold shadow-xs" aria-label="Navigasi utama">
            <a href="/" aria-current={isInventory ? 'page' : undefined} class:list={['inline-flex min-h-8 items-center rounded-md px-2.5 transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-900', isInventory ? 'bg-navy-900 text-white' : 'text-slate-600 hover:bg-slate-100 hover:text-navy-900']}>
              <span>Inventaris</span>
            </a>
            <a href="/marketplace/" aria-current={isMarketplace ? 'page' : undefined} class:list={['inline-flex min-h-8 items-center rounded-md px-2.5 transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-900', isMarketplace ? 'bg-navy-900 text-white' : 'text-slate-600 hover:bg-slate-100 hover:text-navy-900']}>
              <span class="sm:hidden">Pasar</span><span class="hidden sm:inline">Marketplace</span>
            </a>
            <a href="/chat/" aria-current={Astro.url.pathname.startsWith('/chat') ? 'page' : undefined} class:list={['inline-flex min-h-8 items-center gap-1 rounded-md px-2.5 transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-900', Astro.url.pathname.startsWith('/chat') ? 'bg-navy-900 text-white' : 'text-slate-600 hover:bg-slate-100 hover:text-navy-900']}>
              <svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M21 12c0 4.418-4.03 8-9 8a9.86 9.86 0 01-4.255-.949L3 20l1.278-3.833A7.72 7.72 0 013 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg><span>Inbox</span>
            </a>
          </nav>
          <button id="btn-sidebar-toggle" type="button" aria-label="Buka menu" aria-expanded="false" aria-controls="app-sidebar" class="inline-flex size-10 items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-700 shadow-xs transition-colors hover:bg-slate-50 hover:text-navy-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-900">
            <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7h16M4 12h16M4 17h16" /></svg>
          </button>
        </div>
      </div>
    </header>

    <div id="sidebar-backdrop" class="fixed inset-0 z-40 hidden bg-slate-950/35 backdrop-blur-[1px]" aria-hidden="true"></div>
    <aside id="app-sidebar" class="fixed inset-y-0 right-0 z-50 flex w-[min(20rem,calc(100vw-2rem))] translate-x-full flex-col border-l border-slate-200 bg-white p-5 shadow-2xl transition-transform duration-200 ease-out" aria-label="Menu utama">
      <div class="flex items-center justify-between border-b border-slate-200 pb-4">
        <img src="/logo.png" alt="Stuff8" class="h-7 w-auto object-contain" />
        <button id="btn-sidebar-close" type="button" aria-label="Tutup menu" class="inline-flex size-9 items-center justify-center rounded-lg text-slate-400 transition-colors hover:bg-slate-100 hover:text-slate-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-900">×</button>
      </div>

      <div id="sidebar-user-summary" class="mt-5 hidden items-center gap-3 rounded-xl border border-slate-200 bg-slate-50 p-3">
        <div class="flex size-9 items-center justify-center rounded-full bg-navy-900 text-sm font-bold text-white"><span id="sidebar-user-avatar">?</span></div>
        <div class="min-w-0"><p id="sidebar-user-name" class="truncate text-sm font-bold text-slate-900">Pengguna Stuff8</p><p class="text-xs text-slate-500">Inventaris pribadi</p></div>
      </div>

      <nav class="mt-5 space-y-2" aria-label="Navigasi dan aksi akun">
        <a href="/" aria-current={isInventory ? 'page' : undefined} class:list={['flex w-full items-center justify-between rounded-xl px-4 py-3 text-left text-sm font-semibold transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-900', isInventory ? 'bg-navy-900 text-white' : 'text-slate-700 hover:bg-slate-100']}><span>Inventaris</span><span aria-hidden="true">→</span></a>
        <a href="/marketplace/" aria-current={isMarketplace ? 'page' : undefined} class:list={['flex w-full items-center justify-between rounded-xl px-4 py-3 text-left text-sm font-semibold transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-900', isMarketplace ? 'bg-navy-900 text-white' : 'text-slate-700 hover:bg-slate-100']}><span>Marketplace</span><span aria-hidden="true">→</span></a>
        <a href="/chat/" aria-current={Astro.url.pathname.startsWith('/chat') ? 'page' : undefined} class:list={['flex w-full items-center justify-between rounded-xl px-4 py-3 text-left text-sm font-semibold transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-900', Astro.url.pathname.startsWith('/chat') ? 'bg-navy-900 text-white' : 'text-slate-700 hover:bg-slate-100']}><span>Inbox</span><span aria-hidden="true">→</span></a>
        <div class="my-2 border-t border-slate-200"></div>
        <button id="btn-sidebar-add-item" type="button" class="hidden w-full items-center justify-between rounded-xl px-4 py-3 text-left text-sm font-bold text-navy-900 transition-colors hover:bg-slate-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-900"><span>Tambah Barang</span><span aria-hidden="true">+</span></button>
        <a id="btn-sidebar-profile" href="/profile/" class="hidden w-full items-center justify-between rounded-xl px-4 py-3 text-left text-sm font-semibold text-slate-700 transition-colors hover:bg-slate-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-900"><span>Profil &amp; Keamanan</span><span aria-hidden="true">→</span></a>
        <button id="btn-sidebar-guide" type="button" class="flex w-full items-center justify-between rounded-xl px-4 py-3 text-left text-sm font-semibold text-slate-700 transition-colors hover:bg-slate-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-900"><span>Panduan Stuff8</span><span aria-hidden="true">→</span></button>
        <button id="btn-sidebar-login" type="button" class="flex w-full items-center justify-between rounded-xl px-4 py-3 text-left text-sm font-semibold text-slate-700 transition-colors hover:bg-slate-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-900"><span>Masuk / Daftar</span><span aria-hidden="true">→</span></button>
      </nav>

      <button id="btn-logout" type="button" class="mt-auto hidden w-full rounded-xl border border-slate-200 px-4 py-3 text-sm font-semibold text-slate-600 transition-colors hover:border-rose-200 hover:bg-rose-50 hover:text-rose-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-900">Keluar</button>
    </aside>

    <main class="flex-1">
      {!isEmailVerification && <div id="email-verification-banner" class="hidden border-b border-amber-200 bg-amber-50">
        <div class="mx-auto flex max-w-7xl flex-col gap-2 px-4 py-3 text-sm text-amber-950 sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8">
          <p><strong>Email belum diverifikasi.</strong> Inventaris pribadi tetap dapat digunakan, tetapi Marketplace dan negosiasi baru aktif setelah verifikasi. Tautan berlaku 24 jam.</p>
          <button id="resend-verification" type="button" class="shrink-0 font-bold text-amber-900 underline decoration-amber-400 underline-offset-4 hover:text-navy-900">Kirim ulang email</button>
        </div>
        <p id="email-verification-status" class="mx-auto hidden max-w-7xl px-4 pb-3 text-xs sm:px-6 lg:px-8" aria-live="polite"></p>
      </div>}
      <slot />
    </main>

    <footer class="border-t border-slate-200 bg-white py-8">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center text-xs text-slate-500">
        <p>© 2026 Stuff8</p>
      </div>
    </footer>
  </body>
  <script>
    const readStuff8Session = () => { try { return JSON.parse(localStorage.getItem('stuff8_session') || 'null'); } catch { return null; } };
    const authApi = import.meta.env.PUBLIC_AUTH_URL || '/auth-api';
    const verificationBanner = document.getElementById('email-verification-banner');
    const verificationStatus = document.getElementById('email-verification-status');
    const showVerificationBanner = (show: boolean) => verificationBanner?.classList.toggle('hidden', !show);
    const refreshVerificationState = async () => {
      const session = readStuff8Session();
      if (!session?.token || !session?.user) return;
      try {
        const response = await fetch(`${authApi}/auth/verification-status`, { headers: { Authorization: `Bearer ${session.token}` } });
        if (!response.ok) return;
        const status = await response.json();
        session.user.emailVerified = Boolean(status.emailVerified);
        localStorage.setItem('stuff8_session', JSON.stringify(session));
        showVerificationBanner(!status.emailVerified);
      } catch { showVerificationBanner(session.user.emailVerified === false); }
    };
    refreshVerificationState();
    document.getElementById('resend-verification')?.addEventListener('click', async () => {
      const session = readStuff8Session();
      if (!session?.token || !verificationStatus) return;
      verificationStatus.classList.remove('hidden');
      verificationStatus.textContent = 'Mengirim email verifikasi…';
      try {
        const response = await fetch(`${authApi}/auth/resend-verification`, { method: 'POST', headers: { Authorization: `Bearer ${session.token}` } });
        verificationStatus.textContent = response.ok ? 'Permintaan email verifikasi diterima oleh Brevo. Periksa inbox dan folder spam; tautan berlaku 24 jam.' : 'Email belum dapat dikirim. Coba lagi beberapa saat lagi.';
      } catch { verificationStatus.textContent = 'Email belum dapat dikirim. Coba lagi beberapa saat lagi.'; }
    });

    // The home page owns its richer inventory controls. Every other page still
    // receives a fully working, role-aware hamburger from this shared layout.
    if (location.pathname !== '/') {
      const session = readStuff8Session();
      const user = session?.user;
      const toggle = document.getElementById('btn-sidebar-toggle');
      const close = document.getElementById('btn-sidebar-close');
      const sidebar = document.getElementById('app-sidebar');
      const backdrop = document.getElementById('sidebar-backdrop');
      const closeSidebar = () => { sidebar?.classList.add('translate-x-full'); backdrop?.classList.add('hidden'); toggle?.setAttribute('aria-expanded', 'false'); };
      const openSidebar = () => { sidebar?.classList.remove('translate-x-full'); backdrop?.classList.remove('hidden'); toggle?.setAttribute('aria-expanded', 'true'); };
      toggle?.addEventListener('click', openSidebar);
      close?.addEventListener('click', closeSidebar);
      backdrop?.addEventListener('click', closeSidebar);
      if (user) {
        document.getElementById('sidebar-user-summary')?.classList.replace('hidden', 'flex');
        document.getElementById('sidebar-user-avatar')!.textContent = (user.name || user.username || 'U').charAt(0).toUpperCase();
        document.getElementById('sidebar-user-name')!.textContent = user.name || user.username;
        document.getElementById('btn-sidebar-add-item')?.classList.replace('hidden', 'flex');
        document.getElementById('btn-sidebar-profile')?.classList.replace('hidden', 'flex');
        document.getElementById('btn-sidebar-login')?.classList.add('hidden');
        document.getElementById('btn-logout')?.classList.remove('hidden');
      }
      document.getElementById('btn-sidebar-add-item')?.addEventListener('click', () => location.assign('/?add-item=1'));
      document.getElementById('btn-sidebar-login')?.addEventListener('click', () => location.assign('/auth/signup/'));
      document.getElementById('btn-sidebar-guide')?.addEventListener('click', () => location.assign('/?guide=1'));
      document.getElementById('btn-logout')?.addEventListener('click', () => { localStorage.removeItem('stuff8_session'); location.assign('/'); });
    }
  </script>
</html>
