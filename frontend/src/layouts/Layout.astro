---
import '../styles/global.css';
import SupportWidget from '../components/SupportWidget.astro';

interface Props {
  description?: string;
}

const { 
  description = "Rapiin barang-barang kamu dalam inventaris digital. Ada barang nganggur? Tinggal sekali klik langsung pajang di marketplace!"
} = Astro.props;
const isInventory = Astro.url.pathname === '/inventory' || Astro.url.pathname === '/inventory/' || Astro.url.pathname.startsWith('/inventory/');
const isMarketplace = Astro.url.pathname.startsWith('/marketplace');
const isEmailVerification = Astro.url.pathname.startsWith('/auth/verify-email');
const isChat = Astro.url.pathname.startsWith('/chat');
// The public origin is deliberately taken from stuff8_bootstrap/ecompose.yml
// (`expose.hostname`), not from a browser-local URL or a hand-managed .env.
const siteUrl = 'https://stuff8.arunikaswarna.my.id';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const socialImageUrl = new URL('/images/stuff8-social-preview.webp', siteUrl).toString();
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Stuff8</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#0f172a" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content="Stuff8" />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Stuff8" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:secure_url" content={socialImageUrl} />
    <meta property="og:image:type" content="image/webp" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Koleksi barang pribadi yang tertata rapi dengan Stuff8" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Stuff8" />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content="Koleksi barang pribadi yang tertata rapi dengan Stuff8" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,600;12..96,700;12..96,800&family=Onest:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
      body {
        font-family: 'Onest', ui-sans-serif, system-ui, sans-serif;
        font-feature-settings: 'cv02', 'cv03';
      }
    </style>
  </head>
  <body class:list={['bg-paper-50 text-navy-900 flex flex-col min-h-screen', isChat && 'h-dvh overflow-hidden']}>
    <header class="border-b border-navy-100 bg-white/90 backdrop-blur-md sticky top-0 z-40 shadow-[0_1px_2px_rgba(15,30,25,0.06)]">
      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-3">
        <a id="stuff8-logo-link" href="/" class="flex items-center gap-2.5 shrink-0 group">
          <img src="/logo.png" alt="Stuff8 Logo" class="h-7 sm:h-8 w-auto object-contain group-hover:opacity-90 transition-opacity" />
          <span class="hidden sm:block font-display text-lg font-bold tracking-tight text-navy-900">Stuff8</span>
          <span class="sr-only">Stuff8 - Manajemen Barang & Pasar Jual Beli</span>
        </a>

        <form id="global-search" class="hidden min-w-0 flex-1 max-w-md md:block" role="search" aria-label="Cari barang">
          <label class="relative block">
            <span class="sr-only">Cari barang di Marketplace</span>
            <svg class="pointer-events-none absolute left-3 top-1/2 size-4 -translate-y-1/2 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" stroke-width="2"/><path stroke-linecap="round" stroke-width="2" d="m16 16 4 4"/></svg>
            <input id="global-search-input" type="search" autocomplete="off" placeholder="Cari barang di Pasar…" class="h-10 w-full rounded-full border border-navy-100 bg-paper-50 pl-9 pr-4 text-sm text-navy-900 outline-none transition-colors placeholder:text-slate-400 focus:border-brand-500 focus:bg-white focus:ring-2 focus:ring-brand-500/20" />
          </label>
        </form>

        <div class="flex items-center gap-2">
          <nav class="inline-flex min-h-10 items-center rounded-full border border-navy-100 bg-white p-1 text-xs font-bold shadow-xs" aria-label="Navigasi utama">
            <a href="/inventory/" title="Inventaris" aria-label="Inventaris" aria-current={isInventory ? 'page' : undefined} class:list={['inline-flex h-8 items-center justify-center gap-1.5 rounded-full px-2.5 transition-colors lg:px-3 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-500', isInventory ? 'bg-navy-900 text-white' : 'text-slate-600 hover:bg-slate-100 hover:text-navy-900']}>
              <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M8 9l8-4" /></svg>
              <span class="hidden lg:inline">Inventaris</span>
              <span class="sr-only lg:hidden">Inventaris</span>
            </a>
            <a href="/marketplace/" title="Marketplace" aria-label="Marketplace" aria-current={isMarketplace ? 'page' : undefined} class:list={['inline-flex h-8 items-center justify-center gap-1.5 rounded-full px-2.5 transition-colors lg:px-3 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-500', isMarketplace ? 'bg-brand-600 text-white' : 'text-slate-600 hover:bg-slate-100 hover:text-navy-900']}>
              <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M5 10l1-5h12l1 5m-14 0v9h14v-9m-10 4h6" /></svg>
              <span class="hidden lg:inline">Pasar</span>
              <span class="sr-only lg:hidden">Pasar</span>
            </a>
            <a href="/chat/" title="Inbox" aria-label="Inbox" aria-current={Astro.url.pathname.startsWith('/chat') ? 'page' : undefined} class:list={['inline-flex h-8 items-center justify-center gap-1.5 rounded-full px-2.5 transition-colors lg:px-3 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-500', Astro.url.pathname.startsWith('/chat') ? 'bg-navy-900 text-white' : 'text-slate-600 hover:bg-slate-100 hover:text-navy-900']}>
              <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M21 12c0 4.418-4.03 8-9 8a9.86 9.86 0 01-4.255-.949L3 20l1.278-3.833A7.72 7.72 0 013 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
              <span class="hidden lg:inline">Inbox</span>
              <span class="sr-only lg:hidden">Inbox</span>
            </a>
          </nav>
          <div class="relative" id="notifications-bell-wrap">
            <button id="btn-notifications" type="button" aria-label="Notifikasi" aria-expanded="false" aria-controls="notifications-panel" class="relative hidden size-10 items-center justify-center rounded-full border border-navy-100 bg-white text-slate-700 shadow-xs transition-colors hover:bg-slate-50 hover:text-navy-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-500">
              <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>
              <span id="notifications-badge" class="absolute -right-1 -top-1 hidden min-w-[1.125rem] rounded-full bg-brand-600 px-1 py-px text-center text-[10px] font-bold leading-4 text-white shadow-xs">0</span>
            </button>
            <div id="notifications-panel" class="absolute right-0 top-12 z-50 hidden w-80 max-w-[calc(100vw-2rem)] overflow-hidden rounded-2xl border border-navy-100 bg-white shadow-2xl">
              <div class="flex items-center justify-between border-b border-navy-100 px-4 py-3">
                <p class="text-sm font-bold text-navy-900">Notifikasi</p>
                <button id="btn-notifications-read-all" type="button" class="text-xs font-bold text-brand-700 hover:underline">Tandai semua dibaca</button>
              </div>
              <div id="notifications-list" class="max-h-96 overflow-y-auto"></div>
            </div>
          </div>
          <button id="btn-sidebar-toggle" type="button" aria-label="Buka menu" aria-expanded="false" aria-controls="app-sidebar" class="inline-flex size-10 items-center justify-center rounded-full border border-navy-100 bg-white text-slate-700 shadow-xs transition-colors hover:bg-slate-50 hover:text-navy-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-500">
            <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7h16M4 12h16M4 17h16" /></svg>
          </button>
        </div>
      </div>
    </header>

    <div id="sidebar-backdrop" class="fixed inset-0 z-40 hidden bg-slate-950/35 backdrop-blur-[1px]" aria-hidden="true"></div>
    <aside id="app-sidebar" class="fixed inset-y-0 right-0 z-50 flex w-[min(20rem,calc(100vw-2rem))] translate-x-full flex-col border-l border-slate-200 bg-white p-5 pb-[max(1.25rem,env(safe-area-inset-bottom))] shadow-2xl transition-transform duration-200 ease-out" aria-label="Menu utama">
      <div class="flex items-center justify-between border-b border-slate-200 pb-4">
        <img src="/logo.png" alt="Stuff8" class="h-7 w-auto object-contain" />
        <button id="btn-sidebar-close" type="button" aria-label="Tutup menu" class="inline-flex size-9 items-center justify-center rounded-lg text-slate-400 transition-colors hover:bg-slate-100 hover:text-slate-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-900">×</button>
      </div>

      <a id="sidebar-user-summary" href="/profile/" class="mt-5 hidden items-center gap-3 rounded-xl border border-slate-200 bg-slate-50 p-3 transition-colors hover:bg-slate-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-900">
        <div id="sidebar-user-avatar-wrap" class="flex size-9 shrink-0 items-center justify-center overflow-hidden rounded-full bg-navy-900 text-sm font-bold text-white"><span id="sidebar-user-avatar">?</span></div>
        <div class="min-w-0"><p id="sidebar-user-name" class="truncate text-sm font-bold text-slate-900">Pengguna Stuff8</p><p class="text-xs text-slate-500">Inventaris pribadi</p></div>
      </a>

      <nav class="mt-5 space-y-2" aria-label="Navigasi dan aksi akun">
        <a href="/inventory/" aria-current={isInventory ? 'page' : undefined} class:list={['flex w-full items-center justify-between rounded-xl px-4 py-3 text-left text-sm font-semibold transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-900', isInventory ? 'bg-navy-900 text-white' : 'text-slate-700 hover:bg-slate-100']}><span>Inventaris</span><span aria-hidden="true">→</span></a>
        <a href="/marketplace/" aria-current={isMarketplace ? 'page' : undefined} class:list={['flex w-full items-center justify-between rounded-xl px-4 py-3 text-left text-sm font-semibold transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-900', isMarketplace ? 'bg-navy-900 text-white' : 'text-slate-700 hover:bg-slate-100']}><span>Marketplace</span><span aria-hidden="true">→</span></a>
        <a href="/chat/" aria-current={Astro.url.pathname.startsWith('/chat') ? 'page' : undefined} class:list={['flex w-full items-center justify-between rounded-xl px-4 py-3 text-left text-sm font-semibold transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-900', Astro.url.pathname.startsWith('/chat') ? 'bg-navy-900 text-white' : 'text-slate-700 hover:bg-slate-100']}><span>Inbox</span><span aria-hidden="true">→</span></a>
        <div class="my-2 border-t border-slate-200"></div>
        <button id="btn-sidebar-add-item" type="button" class="hidden w-full items-center justify-between rounded-xl px-4 py-3 text-left text-sm font-bold text-navy-900 transition-colors hover:bg-slate-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-900"><span>Tambah Barang</span><span aria-hidden="true">+</span></button>
        <a id="btn-sidebar-profile" href="/profile/" class="hidden w-full items-center justify-between rounded-xl px-4 py-3 text-left text-sm font-semibold text-slate-700 transition-colors hover:bg-slate-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-900"><span>Profil &amp; Keamanan</span><span aria-hidden="true">→</span></a>
        <button id="btn-sidebar-guide" type="button" class="flex w-full items-center justify-between rounded-xl px-4 py-3 text-left text-sm font-semibold text-slate-700 transition-colors hover:bg-slate-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-900"><span>Panduan Stuff8</span><span aria-hidden="true">→</span></button>
        <button id="btn-sidebar-login" type="button" class="flex w-full items-center justify-between rounded-xl px-4 py-3 text-left text-sm font-semibold text-slate-700 transition-colors hover:bg-slate-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-900"><span>Masuk / Daftar</span><span aria-hidden="true">→</span></button>
      </nav>

      <button id="btn-logout" type="button" class="mt-auto hidden w-full rounded-xl border border-slate-200 px-4 py-3 text-sm font-semibold text-slate-600 transition-colors hover:border-rose-200 hover:bg-rose-50 hover:text-rose-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-900">Keluar</button>
    </aside>

    <main class="min-h-0 flex-1">
      {!isEmailVerification && <div id="email-verification-banner" class="hidden border-b border-amber-200 bg-amber-50">
        <div class="mx-auto flex max-w-7xl flex-col gap-2 px-4 py-3 text-sm text-amber-950 sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8">
          <p><strong>Email belum diverifikasi.</strong> Inventaris pribadi tetap dapat digunakan, tetapi Marketplace dan negosiasi baru aktif setelah verifikasi. Tautan berlaku 24 jam.</p>
          <button id="resend-verification" type="button" class="shrink-0 font-bold text-amber-900 underline decoration-amber-400 underline-offset-4 hover:text-navy-900">Kirim ulang email</button>
        </div>
        <p id="email-verification-status" class="mx-auto hidden max-w-7xl px-4 pb-3 text-xs sm:px-6 lg:px-8" aria-live="polite"></p>
      </div>}
      <slot />
    </main>

    {!isChat && <footer class="border-t border-navy-100 bg-white py-10">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col items-center gap-4 text-center sm:flex-row sm:justify-between sm:text-left">
          <div class="flex items-center gap-2.5">
            <img src="/logo.png" alt="Stuff8" class="h-6 w-auto object-contain" />
            <span class="font-display text-base font-bold tracking-tight text-navy-900">Stuff8</span>
          </div>
          <p class="text-xs text-slate-500">Rapiin barang, tahu nilai &amp; lokasinya, jual saat kamu butuh.</p>
          <p class="text-xs text-slate-400">© 2026 Stuff8</p>
        </div>
      </div>
    </footer>}
    <div id="stuff8-toasts" class="pointer-events-none fixed inset-x-0 bottom-4 z-[120] flex flex-col items-center gap-2 px-4 pb-[env(safe-area-inset-bottom)] sm:bottom-5 sm:right-5 sm:items-end sm:px-0" aria-live="polite" aria-atomic="false"></div>
    <SupportWidget />
  </body>
  <script>
    // Global toast helper — used by every page for short, warm confirmations.
    (function initStuff8Toast() {
      if (window.stuff8Toast) return;
      const container = document.getElementById('stuff8-toasts');
      const visual: Record<string, { accent: string; chip: string; icon: string }> = {
        success: { accent: 'border-brand-600', chip: 'bg-brand-600 text-white', icon: '<svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke-width="2"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m8.5 12.5 2.5 2.5 4.5-5"/></svg>' },
        error: { accent: 'border-rose-600', chip: 'bg-rose-600 text-white', icon: '<svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke-width="2"/><path stroke-linecap="round" stroke-width="2" d="m9 9 6 6M15 9l-6 6"/></svg>' },
        info: { accent: 'border-navy-900', chip: 'bg-navy-900 text-white', icon: '<svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke-width="2"/><path stroke-linecap="round" stroke-width="2" d="M12 8h.01M12 12v4"/></svg>' }
      };
      window.stuff8Toast = (message: string, options: { variant?: 'success' | 'error' | 'info'; title?: string; duration?: number } = {}) => {
        if (!container) return;
        const variant = options.variant || 'info';
        const tone = visual[variant] || visual.info;
        const toast = document.createElement('div');
        toast.className = `stuff8-toast pointer-events-auto flex w-full max-w-sm items-start gap-3 rounded-2xl border border-navy-100 border-l-4 bg-white p-3.5 pr-3 shadow-lg shadow-navy-900/10 ${tone.accent}`;
        toast.setAttribute('role', variant === 'error' ? 'alert' : 'status');
        toast.innerHTML = `<span class="mt-0.5 inline-flex size-6 shrink-0 items-center justify-center rounded-full ${tone.chip}" aria-hidden="true">${tone.icon}</span><div class="min-w-0 flex-1"><p class="text-sm font-bold leading-snug text-navy-900">${options.title || (variant === 'error' ? 'Terjadi kendala' : variant === 'success' ? 'Berhasil' : 'Info')}</p>${message ? `<p class="mt-0.5 text-xs leading-relaxed text-slate-600">${message}</p>` : ''}</div><button type="button" class="stuff8-toast-close inline-flex size-6 shrink-0 items-center justify-center rounded-full text-slate-400 transition-colors hover:bg-slate-100 hover:text-navy-900" aria-label="Tutup notifikasi">×</button>`;
        container.append(toast);
        const dismiss = () => {
          if (toast.dataset.gone) return;
          toast.dataset.gone = '1';
          toast.classList.add('stuff8-toast-leave');
          toast.addEventListener('animationend', () => toast.remove(), { once: true });
        };
        toast.querySelector('.stuff8-toast-close')?.addEventListener('click', dismiss);
        window.setTimeout(dismiss, options.duration ?? (variant === 'error' ? 6000 : 4200));
        return dismiss;
      };
    })();

    const readStuff8Session = () => { try { return JSON.parse(localStorage.getItem('stuff8_session') || 'null'); } catch { return null; } };
    const logoLink = document.getElementById('stuff8-logo-link');
    if (readStuff8Session()?.user && logoLink) logoLink.setAttribute('href', '/inventory/');
    const authApi = import.meta.env.PUBLIC_AUTH_URL || '/auth-api';
    const profileApi = import.meta.env.PUBLIC_PROFILE_URL || '/api';
    const verificationBanner = document.getElementById('email-verification-banner');
    const verificationStatus = document.getElementById('email-verification-status');
    const showVerificationBanner = (show: boolean) => verificationBanner?.classList.toggle('hidden', !show);
    const refreshVerificationState = async () => {
      const session = readStuff8Session();
      if (!session?.token || !session?.user) return;
      try {
        const response = await fetch(`${authApi}/auth/verification-status`, { headers: { Authorization: `Bearer ${session.token}` } });
        if (!response.ok) return;
        const status = await response.json();
        session.user.emailVerified = Boolean(status.emailVerified);
        localStorage.setItem('stuff8_session', JSON.stringify(session));
        showVerificationBanner(!status.emailVerified);
      } catch { showVerificationBanner(session.user.emailVerified === false); }
    };
    refreshVerificationState();
    const setSidebarAvatar = (avatarUrl?: string, name?: string) => {
      const avatarWrap = document.getElementById('sidebar-user-avatar-wrap');
      if (!avatarWrap) return;
      avatarWrap.replaceChildren();
      if (avatarUrl) {
        const image = document.createElement('img');
        image.src = avatarUrl;
        image.alt = '';
        image.className = 'size-full object-cover';
        image.addEventListener('error', () => setSidebarAvatar(undefined, name), { once: true });
        avatarWrap.append(image);
        return;
      }
      const initial = document.createElement('span');
      initial.id = 'sidebar-user-avatar';
      initial.textContent = (name || 'U').charAt(0).toUpperCase();
      avatarWrap.append(initial);
    };
    const refreshSidebarProfile = async (session: any) => {
      if (!session?.token || !session?.user?.id) return;
      try {
        const response = await fetch(`${profileApi}/users/${encodeURIComponent(session.user.id)}`, { headers: { Authorization: `Bearer ${session.token}` } });
        if (!response.ok) return;
        const profile = await response.json();
        const name = profile.name || session.user.name || session.user.username;
        const avatarUrl = profile.avatarUrl || session.user.avatarUrl;
        session.user = { ...session.user, ...(name ? { name } : {}), ...(avatarUrl ? { avatarUrl } : {}) };
        localStorage.setItem('stuff8_session', JSON.stringify(session));
        setSidebarAvatar(avatarUrl, name || session.user.username);
        const sidebarName = document.getElementById('sidebar-user-name');
        if (sidebarName && name) sidebarName.textContent = name;
      } catch { /* The local session still provides a usable fallback. */ }
    };
    document.getElementById('resend-verification')?.addEventListener('click', async () => {
      const session = readStuff8Session();
      if (!session?.token || !verificationStatus) return;
      verificationStatus.classList.remove('hidden');
      verificationStatus.textContent = 'Mengirim email verifikasi…';
      try {
        const response = await fetch(`${authApi}/auth/resend-verification`, { method: 'POST', headers: { Authorization: `Bearer ${session.token}` } });
        const ok = response.ok;
        verificationStatus.textContent = ok ? 'Permintaan email verifikasi diterima oleh Brevo. Periksa inbox dan folder spam; tautan berlaku 24 jam.' : 'Email belum dapat dikirim. Coba lagi beberapa saat lagi.';
        window.stuff8Toast?.(ok ? 'Cek inbox dan folder spam — tautan berlaku 24 jam.' : 'Email belum dapat dikirim, coba lagi nanti.', { variant: ok ? 'success' : 'error', title: ok ? 'Email verifikasi terkirim' : 'Gagal mengirim' });
      } catch {
        verificationStatus.textContent = 'Email belum dapat dikirim. Coba lagi beberapa saat lagi.';
        window.stuff8Toast?.('Email belum dapat dikirim, coba lagi nanti.', { variant: 'error', title: 'Gagal mengirim' });
      }
    });

    // The home page owns its richer inventory controls. Every other page still
    // receives a fully working, role-aware hamburger from this shared layout.
    document.getElementById('global-search')?.addEventListener('submit', event => {
      event.preventDefault();
      const input = document.getElementById('global-search-input') as HTMLInputElement | null;
      const q = input?.value.trim() || '';
      location.assign(q ? `/marketplace/?q=${encodeURIComponent(q)}` : '/marketplace/');
    });
    if (location.pathname !== '/') {
      const session = readStuff8Session();
      const user = session?.user;
      const toggle = document.getElementById('btn-sidebar-toggle');
      const close = document.getElementById('btn-sidebar-close');
      const sidebar = document.getElementById('app-sidebar');
      const backdrop = document.getElementById('sidebar-backdrop');
      const closeSidebar = () => { sidebar?.classList.add('translate-x-full'); backdrop?.classList.add('hidden'); toggle?.setAttribute('aria-expanded', 'false'); };
      const openSidebar = () => { sidebar?.classList.remove('translate-x-full'); backdrop?.classList.remove('hidden'); toggle?.setAttribute('aria-expanded', 'true'); };
      toggle?.addEventListener('click', openSidebar);
      close?.addEventListener('click', closeSidebar);
      backdrop?.addEventListener('click', closeSidebar);
      if (user) {
        document.getElementById('sidebar-user-summary')?.classList.replace('hidden', 'flex');
        setSidebarAvatar(user.avatarUrl, user.name || user.username);
        document.getElementById('sidebar-user-name')!.textContent = user.name || user.username;
        refreshSidebarProfile(session);
        document.getElementById('btn-sidebar-add-item')?.classList.replace('hidden', 'flex');
        document.getElementById('btn-sidebar-profile')?.classList.replace('hidden', 'flex');
        document.getElementById('btn-sidebar-login')?.classList.add('hidden');
        document.getElementById('btn-logout')?.classList.remove('hidden');
      }
      document.getElementById('btn-sidebar-add-item')?.addEventListener('click', () => location.assign('/inventory/form/'));
      document.getElementById('btn-sidebar-login')?.addEventListener('click', () => location.assign('/auth/signup/'));
      document.getElementById('btn-sidebar-guide')?.addEventListener('click', () => location.assign('/?guide=1'));
      document.getElementById('btn-logout')?.addEventListener('click', () => { localStorage.removeItem('stuff8_session'); location.assign('/'); });
    }

    // ─── Notifications bell (every page) ─────────────────────────────────────
    const notificationsApi = import.meta.env.PUBLIC_NOTIFICATIONS_URL || '/api/notifications';
    const notificationsBell = document.getElementById('btn-notifications');
    const notificationsBadge = document.getElementById('notifications-badge');
    const notificationsPanel = document.getElementById('notifications-panel');
    const notificationsList = document.getElementById('notifications-list');
    let notificationsSocket: WebSocket | undefined;
    let notificationReconnectTimer: number | undefined;
    let notificationUnread = 0;
    let recentNotifications: any[] = [];

    const notificationHeaders = () => ({ 'Authorization': `Bearer ${readStuff8Session()?.token}` });
    const escapeNotification = (value: string) => value.replace(/[&<>"']/g, char => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' }[char] || char));
    const notificationTime = (value?: string) => {
      const date = new Date(value || 0);
      if (Number.isNaN(date.getTime())) return '';
      const seconds = Math.max(0, Math.floor((Date.now() - date.getTime()) / 1000));
      if (seconds < 60) return 'Baru saja';
      if (seconds < 3600) return `${Math.floor(seconds / 60)} menit lalu`;
      if (seconds < 86400) return `${Math.floor(seconds / 3600)} jam lalu`;
      return date.toLocaleDateString('id-ID', { day: 'numeric', month: 'short' });
    };
    const renderNotificationBadge = () => {
      if (!notificationsBadge) return;
      if (notificationUnread > 0) {
        notificationsBadge.textContent = notificationUnread > 99 ? '99+' : String(notificationUnread);
        notificationsBadge.classList.remove('hidden');
      } else {
        notificationsBadge.classList.add('hidden');
      }
    };
    const renderNotificationsList = () => {
      if (!notificationsList) return;
      if (!recentNotifications.length) {
        notificationsList.innerHTML = '<p class="p-6 text-center text-xs text-slate-500">Belum ada notifikasi. Aktivitas offer dan marketplace akan muncul di sini.</p>';
        return;
      }
      notificationsList.innerHTML = recentNotifications.map(notification => `
        <a href="${escapeNotification(notification.link || '#')}" data-notification-id="${escapeNotification(notification.id || '')}" class="flex gap-3 border-b border-slate-100 px-4 py-3 transition-colors hover:bg-slate-50 ${notification.read ? '' : 'bg-brand-50/40'}">
          <span class="mt-1.5 size-2 shrink-0 rounded-full ${notification.read ? 'bg-transparent' : 'bg-brand-600'}" aria-hidden="true"></span>
          <span class="min-w-0">
            <span class="block truncate text-xs font-bold text-slate-900">${escapeNotification(notification.title || 'Notifikasi')}</span>
            <span class="mt-0.5 line-clamp-2 block text-xs leading-relaxed text-slate-600">${escapeNotification(notification.body || '')}</span>
            <span class="mt-1 block text-[10px] text-slate-400">${notificationTime(notification.createdAt)}</span>
          </span>
        </a>`).join('');
      notificationsList.querySelectorAll<HTMLAnchorElement>('[data-notification-id]').forEach(link => {
        link.addEventListener('click', () => {
          const id = link.dataset.notificationId;
          if (!id) return;
          fetch(`${notificationsApi}/${encodeURIComponent(id)}/read`, { method: 'POST', headers: notificationHeaders() }).catch(() => {});
          const item = recentNotifications.find(entry => entry.id === id);
          if (item) item.read = true;
          notificationUnread = Math.max(0, notificationUnread - 1);
          renderNotificationBadge();
          renderNotificationsList();
        });
      });
    };
    const openNotificationsSocket = () => {
      const token = readStuff8Session()?.token;
      if (!token) return;
      window.clearTimeout(notificationReconnectTimer);
      const socket = new WebSocket(`${notificationsApi.replace(/^http/, 'ws')}/ws?token=${encodeURIComponent(token)}`);
      notificationsSocket = socket;
      socket.onmessage = event => {
        try {
          const payload = JSON.parse(event.data);
          if (payload.type === 'init') {
            notificationUnread = Number(payload.unread_count || 0);
            recentNotifications = Array.isArray(payload.notifications) ? payload.notifications : [];
            renderNotificationBadge();
            renderNotificationsList();
          } else if (payload.type === 'notification') {
            recentNotifications = [payload.notification, ...recentNotifications.filter(entry => entry.id !== payload.notification?.id)].slice(0, 50);
            renderNotificationsList();
          } else if (payload.type === 'unread') {
            notificationUnread = Number(payload.unread_count || 0);
            renderNotificationBadge();
          }
        } catch { /* ignore malformed frames */ }
      };
      socket.onclose = () => {
        if (notificationsSocket === socket) notificationsSocket = undefined;
        notificationReconnectTimer = window.setTimeout(openNotificationsSocket, 5000);
      };
      socket.onerror = () => { socket.close(); };
    };
    const loadNotifications = async () => {
      if (!readStuff8Session()?.token || !readStuff8Session()?.user?.id) return;
      notificationsBell?.classList.remove('hidden');
      notificationsBell?.classList.add('flex');
      try {
        const [listResponse, countResponse] = await Promise.all([
          fetch(`${notificationsApi}?limit=20`, { headers: notificationHeaders() }),
          fetch(`${notificationsApi}/unread-count`, { headers: notificationHeaders() })
        ]);
        if (listResponse.ok) recentNotifications = await listResponse.json();
        if (countResponse.ok) notificationUnread = Number((await countResponse.json()).unread_count || 0);
        renderNotificationBadge();
        renderNotificationsList();
      } catch { /* keep the bell hidden on failure */ }
      openNotificationsSocket();
    };
    notificationsBell?.addEventListener('click', event => {
      event.stopPropagation();
      const isOpen = notificationsPanel?.classList.toggle('hidden') === false;
      notificationsBell.setAttribute('aria-expanded', String(isOpen));
    });
    document.getElementById('btn-notifications-read-all')?.addEventListener('click', async event => {
      event.stopPropagation();
      if (!readStuff8Session()?.token) return;
      try { await fetch(`${notificationsApi}/read-all`, { method: 'POST', headers: notificationHeaders() }); } catch {}
      recentNotifications.forEach(entry => { entry.read = true; });
      notificationUnread = 0;
      renderNotificationBadge();
      renderNotificationsList();
    });
    document.addEventListener('click', event => {
      if (notificationsPanel?.classList.contains('hidden')) return;
      const wrap = document.getElementById('notifications-bell-wrap');
      if (wrap && !wrap.contains(event.target as Node)) {
        notificationsPanel.classList.add('hidden');
        notificationsBell?.setAttribute('aria-expanded', 'false');
      }
    });
    if (readStuff8Session()?.token && readStuff8Session()?.user?.id) loadNotifications();
  </script>
</html>
