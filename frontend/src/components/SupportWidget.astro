---
// Plug-and-play RAG support chat (bottom-right). Loads the standalone vanilla-JS
// widget from /support-widget.js (canonical copy: rag/widget/). Anonymous
// visitors see a sign-up/sign-in prompt (lead capture); signed-in users chat.
const ragUrl = import.meta.env.PUBLIC_RAG_URL || '/api/rag';
---
<script is:inline data-rag-url={ragUrl}>
  window.SupportWidgetConfig = {
    ragUrl: document.currentScript.getAttribute('data-rag-url'),
    siteName: 'Stuff8',
    requireLogin: true,
    signInUrl: '/auth/signin/',
    signUpUrl: '/auth/signup/',
    sessionMode: 'localStorage',
    sessionKey: 'stuff8_session'
  };
</script>
<script is:inline src="/support-widget.js" defer></script>
